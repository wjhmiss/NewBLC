                         //    for (var j = 0; j < by_orderdetailprocesss.length; j = j + 1) {
                         //        //QuotationDetailhtml += ' <td style="text-align: center;font-size: 8pt;width: 50px;border: 1px solid #000;">' + by_orderdetailprocesss[j].TechnologyName + '：' + by_orderdetailprocesss[j].SalePer + '+' + by_orderdetailprocesss[j].SaleMc + '=' + by_orderdetailprocesss[j].SaleTotal + '</td>';
                         //        QuotationDetailhtml += ' <td style="text-align: left;font-size: 8pt;width: 50px;border: 1px solid #000;">' + by_orderdetailprocesss[j].TechnologyName + '：' + by_orderdetailprocesss[j].SaleTotal + '</td>';
                         //    }
                         //    QuotationDetailhtml += '</tr></table></td></tr>';

                         //}
                     }



                     $("#tb_QuotationDetail").append(QuotationDetailhtml);
                     PriceSum += Number(QuotationDetail.SalesAmount);
                     if (QuotationDetail.DDCostPer > 0) {
