<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=EmulateIE11" />
    
    <title>登录页面</title>
    @*<link href="~/Content/Styles/learunui-framework.css" rel="stylesheet" />
    <script src="~/Content/Scripts/jquery/jquery-1.8.2.min.js"></script>
    <script src="~/Content/Scripts/learunui-framework.js"></script>
    <script src="~/Content/Scripts/jquery/jQuery.md5.js"></script>
    <link href="~/Content/Styles/learunui-login.css" rel="stylesheet" />
    <script src="~/Content/Scripts/cookie/jquery.cookie.js"></script>*@
    @Scripts.Render("~/Content/Scripts/frameworkjquery")
    @Styles.Render("~/Content/Styles/frameworkcss")
    @Scripts.Render("~/Content/Scripts/jquery/md5jquery")
    @Styles.Render("~/Content/Styles/logincss")
    @Scripts.Render("~/Content/Scripts/cookie/cookiejquery")
    <script>
        /*
        检查浏览器是否支持
        */

        var isIE = !!window.ActiveXObject;
        var isIE6 = isIE && !window.XMLHttpRequest;
        if (isIE6) {
            window.location.href = "../Error/Browser";
        }
        
        $(function () {
            $("#btlogin").click(function () {
                var txtaccount = $("#txtaccount").val();
                var txtpassword = $.md5($("#txtpassword").val());
                if (txtaccount == "admin" || txtaccount == "Admin") {
                    var txtpassword = $("#txtpassword").val();
                }
                if (txtaccount == "") {
                    $("#txtaccount").focus();
                    formMessage('登录账户不能为空', 'warning');
                    return false;
                } else if (txtpassword == "") {
                    $("#txtpassword").focus();
                    formMessage('登录密码不能为空', 'warning');
                    return false;
                } else {
                    formMessage('正在登录...', 'succeed');
                    window.setTimeout(function () {
                        var postData = {
                            Account: escape(txtaccount),
                            Password: escape(txtpassword)
                        }
                        getAjax('/Login/CheckLogin', postData, function (rs) {
                            if (parseInt(rs) == -1) {
                                $("#txtaccount").focus();
                                formMessage('登录账户不存在', 'error');
                            } else if (parseInt(rs) == 2) {
                                $("#txtaccount").focus();
                                formMessage('登录账户被系统锁定', 'error');
                            } else if (parseInt(rs) == 4) {
                                $("#txtaccount").focus();
                                $("#txtpassword").val("");
                                formMessage('登录密码错误', 'error');
                            } else if (parseInt(rs) == 3) {
                                formMessage('登录验证成功,正在跳转首页', 'succeed');
                                setInterval(Load, 1000);
                            } else if (parseInt(rs) == 100) {
                                formMessage('已过期！', 'error');
                                setInterval(LoadError, 1000);
                            } else {
                                alert(rs);
                            }
                        });
                    }, 500);
                }
            })

            $("#CheckBoxComplete").toggle(
function () {
    $('#txtaccount').val('Common');
    $('#txtpassword').val('Common');
    

},
function () {
    $('#txtaccount').val('');
    $('#txtpassword').val('');


}
);

            $("body").unbind("onkeydown");
            document.onkeydown = function (event) {
                var e = event || window.event || arguments.callee.caller.arguments[0];
                var tar = e.srcElement || e.target;
                if (e && e.keyCode == 13) {
                    if ($("#txtpassword").val() == "") {
                        $("#txtpassword").select();
                        return;
                    }
                    var btlogin = document.getElementById("btlogin");
                    if (btlogin) {
                        btlogin.focus();
                        btlogin.click();
                    }

                }
                if ($("#txtaccount").val() == "") {
                    $("#txtaccount").select();
                }

            };
        })
        //登录加载
        function Load() {
            var Index = $.cookie('UItheme');
            if (Index) {
                window.location.href = '@Url.Content("~/Home/")' + Index;
            } else {
                window.location.href = '@Url.Content("~/Home/TreeIndex")';
            }
            return false;
        }
        function LoadError() {
            window.location.href = '@Url.Content("~/Error/Index")';
            return false;
        }
        //提示信息
        function formMessage(msg, type) {
            $('.form-message').html('');
            $('.form-message').append('<div class="form-' + type + '-text">' + msg + '</div>');
        }
       

    </script>
</head>
<body class="Loginbody">
    <div class="logo">

        <div class="form-account" style="font-size: xx-large; color: white;">
            宁波皓丽金属有限公司
        </div>

    </div>

    <div class="content">
        <div class="Loginform">
            

            <div class="form-message">
            </div>
            <div class="form-account">
                账户
                <input id="txtaccount" type="text" />
            </div>
            <div class="form-password">
                密码
                <input id="txtpassword" type="password" />
            </div>
                        <div style="float:right;padding-top:15px;padding-right:0px;" align="right"><span class="item" style="cursor:pointer;">
                <a style="color:black" href="@Url.Content("~/WeiWebSite/WeiLogin/WeiIndex")" data-ignore="true">
                    <span>手机切换</span> 
                </a>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    <input type="checkbox" class="checkbox" name="checkbox" id="CheckBoxComplete" />
                    <label for="CheckBoxComplete">公共用户</label></span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</div>
            <div class="form-bottom">
                
                <div id="btlogin" class="btlogin"></div>
            </div>
            
        </div>
    </div>
    <div style="text-align: center; margin: 20px; font-family: Microsoft Yahei; color: #fff; margin: auto; width: 983px; padding-top: 30px;">
        <p>适用浏览器：IE8以上、360、FireFox、Chrome、Safari、Opera、傲游、搜狗、世界之窗. </p>
    </div>
    <div class="copyright">
        宁波皓丽金属有限公司
    </div>
</body>
</html>
