@{
    ViewBag.Title = "入仓表》表单页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    var KeyValue = GetQuery('KeyValue');//主键
    var Density = "";//密度
    $(function () {
        $("#InStockDate").val();
        BindCombobox();
        InitControl();
    })
    //初始化绑定下拉框
    function BindCombobox() {
        //产地下拉框
        BindDropItem("#PlaceOrigin", "SteelSource", "==请选择==");
        //外观类型下拉框
        BindDropItem("#SteelType", "FaceType", "==请选择==");
        //钢板状态下拉框
        //BindDropItem("#SteelStatus", "SteelStatus", "==请选择==");
        //客户编码自动补全
        CustomerAutocomplete();
        //钢种下拉框
        SteelAutocomplete();
    }

    function CustomerAutocomplete() {
        var $CustomerCode = $("#CustomerCode");
        $CustomerCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("CustomerCode", function (data) {
            $("#CustomerId").val(data.CustomerId);
            $("#CustomerCode").val(data.CustomerCode);
            $("#CustomerName").val(data.FullName);
        });
        //获取数据源
        function DataSource() {
            $("#CustomerId").val('');
            AjaxJson("/CommonModule/Base_Supplier/GetAutoCompleJson", { keywords: $CustomerCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="CustomerId" style="display: none;">' + DataJson[i].CustomerId + '</td>';
                    html += '<td id="CustomerCode" style="width: 30%;">' + DataJson[i].Code + '</td>';
                    html += '<td id="FullName" style="width: 70%;">' + DataJson[i].FullName + '</td>';
                    html += '<td id="ShortName" style="display: none;">' + DataJson[i].ShortName + '</td>';
                    html += '<td id="Sellpeople" style="display: none;">' + DataJson[i].Sellpeople + '</td>';
                    html += '<td id="SalesArea" style="display: none;">' + DataJson[i].Sellarea + '</td>';
                    html += '<td id="DiscountRate" style="display: none;">' + DataJson[i].DiscountRate + '</td>';
                    html += '<td id="TransitMode" style="display: none;">' + DataJson[i].TransitMode + '</td>';
                    html += '<td id="PaymentMode" style="display: none;">' + DataJson[i].PaymentMode + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("CustomerCode", "300px", "200px", html, function (data) {
                    $("#CustomerId").val(data.CustomerId);
                    $("#CustomerCode").val(data.CustomerCode);
                    $("#CustomerName").val(data.FullName);
                });
            });
        }
    }
    //钢材编码自动补全
    function SteelAutocomplete() {
        var $SteelCode = $("#SteelCode");
        $SteelCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("SteelCode", function (data) {
            $("#SteelId").val(data.SteelId);
            $("#SteelCode").val(data.SteelCode);
            $("#SteelDescription").val(data.SteelName);
            Density = data.Density;
            Conversion();
        });
        //获取数据源
        function DataSource() {
            AjaxJson("/CommonModule/Steel/GetAutoCompleJson", { keywords: $SteelCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="SteelId" style="display: none;">' + DataJson[i].SteelId + '</td>';
                    html += '<td id="SteelCode" style="width: 50%;">' + DataJson[i].SteelCode + '</td>';
                    html += '<td id="SteelName" style="width: 100%;">' + DataJson[i].SteelName + '</td>';
                    html += '<td id="Density" style="display: none;">' + DataJson[i].Density + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("SteelCode", $SteelCode.width() + "px", "200px", html, function (data) {
                    $("#SteelId").val(data.SteelId);
                    $("#SteelCode").val(data.SteelCode);
                    $("#SteelDescription").val(data.SteelName);
                    Density = data.Density;
                    Conversion();
                });
            });
        }
    }
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/StorageModule/BY_InStock/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
            });
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        //var Price = Number($("#Price").val());
        //if (Price <= 0) {
        //    tipCss("#Price", "单价必须大于0");
        //    return false;
        //}
        var Thick = Number($("#Thick").val());
        var Weigh = Number($("#Weigh").val());
        var Length = Number($("#Length").val());
        //判断是条料还是碎料
        //if (Weigh >= 200 && Length >= 200) {
            var weight = Number($("#Weight").val()) - Number($("#TheoryWeight").val());
            var diffWeight = Number($("#TheoryWeight").val()) * 0.05;
            //差异大于5%时给出提示
            if (Math.abs(weight) > diffWeight) {
                if (!confirm("钢种理论重量和实际重量相差太大是否继续保存？")) {
                    return false;
                }
            }
            $(".ui_state_highlight").attr("disabled", true);

            var postData = GetWebControls("#form1");
            AjaxJson("/StorageModule/BY_InStock/SubmitBoardForm?InStockType=0", postData, function (data) {
                tipDialog(data.Message, 3, data.Code);
                top.frames[tabiframeId()].windowload();
                window.setTimeout(function () {closeDialog();}, 500);
            })
        //} else
        //{
        //    tipDialog("长宽均小于200mm不允许走板件入仓!", 3, -1);
        //}
    }
    //计算理论重量
    function Conversion() {
        //理论重量=（厚计价余量厚 * 宽+计价余量宽 * 高+计价余量高）*密度*数量
        var Thick = Number($("#Thick").val());
        var Weigh = Number($("#Weigh").val());
        var Length = Number($("#Length").val());
        var Qty = Number($("#Qty").val());
        var _Weight = ((Thick * Weigh * Length) * Number(Density) * Qty) / 1000000;
        var BoreSize = $("#BoreSize").val();
        $("#TheoryWeight").val(FormatCurrency(_Weight));
        if (Thick != 0 && Length != 0 && Weigh == 0) {
            _Weight = (((Thick / 2) * (Thick / 2)* 3.14 *  (Length)) * Number(Density) * Qty) / 1000000
            if (!!BoreSize) {
                _Weight = _Weight - Length * (BoreSize / 2) * (BoreSize / 2) * 3.14 * Number(Density) / 1000000;
            }
            if (_Weight < 0) {
                return;
            }
            $("#TheoryWeight").val(FormatCurrency(_Weight));//理论重量
        }
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class='formTitle'>钢种编号：</th>
            <td class='formValue'>
                <input id="SteelId" type="hidden" class="txt" />
                <input id="SteelCode" maxlength="50" type="text" class="txt" datacol="yes" err="钢材编码" checkexpession="NotNull" />
            </td>
            <th class='formTitle'>钢种名称：</th>
            <td class='formValue'>
               <input id="SteelDescription" disabled  type="text" class="txt" />
            </td>
            @*<th class='formTitle'>产地：</th>
            <td class='formValue'>
                <select id="PlaceOrigin" class="txtselect" datacol="yes" err="产地" checkexpession="NotNull"></select>
            </td>*@
        </tr>
        <tr>
            <th class='formTitle'>编码：</th>
            <td class='formValue'>
                 <input id="SteelType" type="hidden" class="txt" />
                <input id="BatchCode"   type="text" class="txt"  datacol="yes" err="客户编码" checkexpession="NotNull" />
            </td>
            <th class='formTitle'>原始规格：</th>
            <td class='formValue'>
               <input id="OriginalSize"   type="text" class="txt" />
            </td>
            @*<th class='formTitle'>钢板状态：</th>
            <td class='formValue'>
                <select id="SteelStatus" class="txtselect" datacol="yes" err="钢板状态" checkexpession="NotNull"></select>
            </td>*@
        </tr>
        <tr>
            <th class="formTitle">供应商编码：</th>
                <td class="formValue">
                    <input id="CustomerId" type="hidden" />
                    <input id="CustomerCode" type="text" class="txt" style="width: 95%" />
                </td>
                <th class="formTitle">供应商名称：</th>
                <td class="formValue">
                    <input id="CustomerName" type="text" class="txt" style="width: 95%" />
                </td>

        </tr>
        <tr>
            <th class='formTitle'>厚度(直径)：</th>
            <td class='formValue'>
                <input id="Thick" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" onkeyup="Conversion()" value="0.00" datacol="yes" err="厚度" checkexpession="Double" />
            </td>
            <th class='formTitle'>宽：</th>
            <td class='formValue'>
                <input id="Weigh" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" onkeyup="Conversion()" value="0.00" datacol="yes" err="宽" checkexpession="Double" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>长：</th>
            <td class='formValue'>
                <input id="Length" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" onkeyup="Conversion()" value="0.00" datacol="yes" err="长" checkexpession="Double" />
            </td>
            <th class='formTitle'>件数：</th>
            <td class='formValue'>
                <input id="Qty" maxlength="10" type="text" class="txt" value="1" disabled />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>孔径：</th>
            <td class='formValue'>
                <input id="BoreSize" maxlength="50" type="text" class="txt" value="0" onkeyup="Conversion()" onfocus="IsMoney(this.id);" value="0.00" datacol="yes" err="长" checkexpession="Double" />
            </td>
            <th class='formTitle'>钢厂单号：</th>
            <td class='formValue'>
                <input id="FactoryCode" maxlength="50" type="text" class="txt" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>理论重量：</th>
            <td class='formValue'>
                <input id="TheoryWeight" maxlength="18" type="text" class="txt" datacol="yes" err="理论重量"  onfocus="IsMoney(this.id);" checkexpession="Double" />
            </td>
            <th class='formTitle'>实际重量：</th>
            <td class='formValue'>
                <input id="Weight" maxlength="18" type="text" class="txt" datacol="yes" err="实际重量"  onfocus="IsMoney(this.id);" checkexpession="Double" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>单价：</th>
            <td class='formValue'>
                <input id="Price" maxlength="18" type="text" class="txt" value="0.00" datacol="yes" err="单价"  onfocus="IsMoney(this.id);" checkexpession="Double" />
            </td>
            <th class='formTitle'>进仓时间：</th>
            <td class='formValue'>
                <input id="InStockDate" type="text" class="txt Wdate" value="@DNS.Utilities.DateTimeHelper.GetTime()" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 00:00'})" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>备注：</th>
            <td class='formValue' colspan="3">
                <input id="Remark" maxlength="200" type="text" class="txt" />
            </td>
        </tr>
    </table>
</form>
