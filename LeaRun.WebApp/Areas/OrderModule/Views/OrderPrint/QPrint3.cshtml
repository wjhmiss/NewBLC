            </tr>
            <tr>
                <td colspan="4">
                    <table border="0"  style="width: 100%; border-collapse: collapse;background-color:none;">
                        <tr>
                            <th style="width:40%;text-align:center;height:28px;line-height:28px;border-bottom:2px solid #000;" >客户确认及接收：</th>
                            <th style="width:20%;text-align:center;height:28px;line-height:28px;" ></th>
