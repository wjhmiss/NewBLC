    function OpearLog(outstockid, steelcode) {
        if (IsChecked(outstockid)) {
            var url = "/StorageModule/BY_OutStock/ChangeOuter?outstockid=" + outstockid + "&steelcode=" + escape(steelcode);
            openDialog(url, "Form", "材料出仓修改", 400, 250, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //刷新
