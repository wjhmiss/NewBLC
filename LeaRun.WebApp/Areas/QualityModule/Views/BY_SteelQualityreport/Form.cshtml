    function addforQuo(s) {
        var SortCode = 0;
        if (!!Number(GetJqGridValue("#gridTable", $("#gridTable").getGridParam("reccount"), "SortCode"))) {
            SortCode = Number(GetJqGridValue("#gridTable", $("#gridTable").getGridParam("reccount"), "SortCode")) + 1;
        }
        else {
            SortCode = 1;
        }
        var index = 0;
        if (!!$("#gridTable").getGridParam("reccount")) {
            index = $("#gridTable").getGridParam("reccount") + 1;
        }
        else {
            index = 1;
        }
        var entitys = s.split(';');
        for (var i = 0; i < entitys.length; i++) {
            var items = entitys[i].split(',');
            //s1 = s1 + myrow.steelcode + "," + myrow.SteelName + "," + myrow.length + ","
            //        + myrow.weigh + "," + myrow.thick + "," + myrow.quotationcode + "-"
            //        + myrow.linecode + "," + myrow.qty + "," + myrow.addlength + ","
            //        + myrow.addweigh + "," + myrow.addthick + "," + myrow.quotationdetailid + ","
            //        + myrow.weight + "," + myrow.density + "," + myrow.customerproduct + "," + myrow.ordertype + "," + myrow.shortname.replace(myrow.departname,""); + '、' + myrow.departname + ";";
            var boresize = 0;

            var size = "";
            if (items[3] > 0) {
                size = items[2] + "*" + items[3] + "*" + items[4];
            }
            else {
                size = "Φ" + items[4] + "*" + items[2] ;

            }

            var RowData = {
                SortCode: SortCode + i,
                OrderCodeLine: items[5],
                Size: size,
                Qty: items[6],
                Weight: items[11],
                CustomerProduct: items[13],
                ExecRemark: items[16],
                QuotationDetailId: items[10],
            }
            $('#gridTable').jqGrid('addRowData', index, RowData, "last");
            index += 1;
        }

    }
