@{
    ViewBag.Title = "费用申请单";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        //Loadlayout2();
        window.setTimeout(function () {
            GetGrid();
            //GetGridYS();
        }, 200);
        CustomerAutocomplete();
    })


    function Loadlayout2() {
        if ($('.layout2').length > 0) {
            $("#layout2").splitter({
                type: "v",
                outline: true,
                sizeLeft: 750,
                minLeft: 200,
                minRight: 100,
                anchorToWindow: true,
                accessKey: "L",
            });
        }
    }





    //加载表格
    function GetGrid() {
        var rowScrod = 0;
        var SelectRowIndx = 0;
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/CheckSheetModule/BY_ReimburseSheet/GridPageJsonLW")",
            datatype: "json",
            height: $(window).height() - 100,
            autowidth: true,
            colModel: [
                {
                    label: '客户', name: 'custermer', index: 'custermer', width: 80, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return $("#CustomerName").val();
                    }
                },
                    {
                        label: '日期', name: 'BuildDate', index: 'BuildDate', width: 80, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (rowObject.Remark == "合计") {
                                return "";
                            }
                            else {
                                if (!!cellvalue) {
                                    return formatDate(cellvalue, 'yyyy-MM-dd');

                                }
                                return cellvalue;
                            }
                        }
                    },
                    { label: '账户', name: 'BankNum', index: 'BankNum', width: 80, align: 'left', sortable: true },
                    {
                        label: '摘要', name: 'Remark', index: 'Remark', width: 120, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");

                            }
                            return "";
                        }
                    },
                    { label: '单号', name: 'Code', index: 'Code', width: 60, align: 'left', sortable: true },
                    { label: '类型', name: 'GetType', index: 'GetType', width: 60, align: 'left', sortable: true },
                    { label: '应收金额', name: 'TotalAmount', index: 'TotalAmount', width: 60, align: 'left', sortable: true },
                    { label: '实收', name: 'GetMoney', index: 'GetMoney', width: 60, align: 'left', sortable: true },
                    { label: '支付', name: 'PayMoney', index: 'PayMoney', width: 60, align: 'left', sortable: true },
                    { label: '折让', name: 'ZRMoney', index: 'ZRMoney', width: 60, align: 'left', sortable: true },
                    { label: '余额', name: 'NoGetMoney', index: 'NoGetMoney', width: 80, align: 'left', sortable: true },
                    { label: '其他收入', name: 'QTPayMoney', index: 'QTPayMoney', width: 80, align: 'left', sortable: true },
            ],
            viewrecords: true,
            rowNum: 999,
            rowList: [999, 999, 100, 500, 5000],
            pager: false,

            rownumbers: true,
            shrinkToFit: false,
            gridview: true,
            footerrow: false,
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
                $(".ui-jqgrid-bdiv").first().scrollTop(rowScrod);
                var data = $("#gridTable").jqGrid("getRowData");
                for (var i = 0; i < data.length; i++) {
                    var item = i + 1;
                    if (data[i].Code.indexOf("CS")>=0) {
                        $("#" + item).find('td').css("background-color", "#008800");
                    }
                   

                }


            },
            onSelectRow: function (rowid, status) {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
                rowScrod = $("#" + rowid).position().top;

            },
        });
    }

    //加载表格
    function GetGridYS() {
        var rowScrod = 0;
        var SelectRowIndx = 0;
        $("#gridTableYS").jqGrid({
            url: "@Url.Content("~/CheckSheetModule/BY_ReimburseSheet/GridPageJsonYS")?CustomerName=1",
            datatype: "json",
            height: $(window).height() - 100,
            autowidth: true,
            colModel: [
                    {
                        label: '日期', name: 'BuildDate', index: 'BuildDate', width: 80, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (rowObject.Remark == "合计") {
                                return "";
                            }
                            else {
                                if (!!cellvalue) {
                                    return formatDate(cellvalue, 'yyyy-MM-dd');

                                }
                                return cellvalue;
                            }
                        }
                    },

                    { label: '账户', name: 'BankNum', index: 'BankNum', width: 80, align: 'left', sortable: true },
                    {
                        label: '摘要', name: 'Remark', index: 'Remark', width: 120, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");

                            }
                            return "";
                        }
                    },
                    { label: '单号', name: 'Code', index: 'Code', width: 60, align: 'left', sortable: true },
                    { label: '类型', name: 'GetType', index: 'GetType', width: 60, align: 'left', sortable: true },
                    { label: '应付金额', name: 'TotalAmount', index: 'TotalAmount', width: 60, align: 'left', sortable: true },
                    { label: '实付金额', name: 'GetMoney', index: 'GetMoney', width: 60, align: 'left', sortable: true },
                    { label: '折让', name: 'ZRMoney', index: 'ZRMoney', width: 60, align: 'left', sortable: true },
                    { label: '余额', name: 'NoGetMoney', index: 'NoGetMoney', width: 80, align: 'left', sortable: true },
            ],
            viewrecords: true,
            rowNum: 999,
            rowList: [999, 999, 100, 500, 5000],
            pager: false,
            rownumbers: true,
            shrinkToFit: false,
            gridview: true,
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
                $(".ui-jqgrid-bdiv").first().scrollTop(rowScrod);

            },
            onSelectRow: function (rowid, status) {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
                rowScrod = $("#" + rowid).position().top;
            },
            
        });
    }


    //查询
    function btn_Search() {
        if ($("#CustomerName").val() == "") {
            alertDialog("请输入对应客户！", 0);
        }

        var CustomerCode = $("#CustomerCode").val();
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/CheckSheetModule/BY_ReimburseSheet/GridPageJsonLW")?CustomerCode=" + escape($("#CustomerCode").val()) + "&CreateDate_StartTime=" + $("#CreateDate_StartTime").val() + "&CreateDate_EndTime=" + $("#CreateDate_EndTime").val() + "&LType=" + $("#LType").val(), page: 1 }).trigger('reloadGrid');
        $("#gridTableYS").jqGrid('setGridParam', { url: "@Url.Content("~/CheckSheetModule/BY_ReimburseSheet/GridPageJsonYS")?CustomerCode=" + escape($("#CustomerCode").val()) + "&CreateDate_StartTime=" + $("#CreateDate_StartTime").val() + "&CreateDate_EndTime=" + $("#CreateDate_EndTime").val(), page: 1 }).trigger('reloadGrid');

    }

    function BCPrintPreview() {
        var CustomerCode = $("#CustomerCode").val();
        var CustomerName = $("#CustomerName").val();
        //JSON.parse('{' + reVal + '}')
        if (IsChecked(CustomerName)) {
            PrintDialog("/CheckSheetModule/BY_CheckSheet/PrintLW?CustomerCode=" + escape($("#CustomerCode").val()) + "&CustomerName=" + escape($("#CustomerName").val()) + "&StartTime=" + $("#CreateDate_StartTime").val() + "&EndTime=" + $("#CreateDate_EndTime").val() + "&LType=" + $("#LType").val()  , "PrintPage", "对账单打印", 850, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }

    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入

    }

    function btn_Export() {
        SetDeriveExcel("#gridTable", "应收款明细导出");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }
    function btn_Export1() {
        SetDeriveExcel("#gridTableYS", "预收及退款导出");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }

    //客户编码自动补全
    function CustomerAutocomplete() {
        var $CustomerCode = $("#CustomerName");
        $CustomerCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("CustomerName", function (data) {
            $("#CustomerName").val(data.FullName);
            $("#CustomerCode").val(data.CustomerCode);

        });
        //获取数据源
        function DataSource() {
            $("#CustomerId").val('');
            AjaxJson("/CommonModule/Customer/GetAutoCompleJson", { keywords: $CustomerCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="CustomerId" style="display: none;">' + DataJson[i].CustomerId + '</td>';
                    html += '<td id="CustomerCode" style="width: 30%;">' + DataJson[i].Code + '</td>';
                    html += '<td id="FullName" style="width: 70%;">' + DataJson[i].FullName + '</td>';
                    html += '<td id="ShortName" style="display: none;">' + DataJson[i].ShortName + '</td>';
                    html += '<td id="Sellpeople" style="display: none;">' + DataJson[i].Sellpeople + '</td>';
                    html += '<td id="SalesArea" style="display: none;">' + DataJson[i].Sellarea + '</td>';
                    html += '<td id="DiscountRate" style="display: none;">' + DataJson[i].DiscountRate + '</td>';
                    html += '<td id="TransitMode" style="display: none;">' + DataJson[i].TransitMode + '</td>';
                    html += '<td id="PaymentMode" style="display: none;">' + DataJson[i].PaymentMode + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("CustomerName", "300px", "200px", html, function (data) {
                    $("#CustomerName").val(data.FullName);
                    $("#CustomerCode").val(data.CustomerCode);
                });
            });
        }
    }

    function btn_Pint() {
    }
</script>

<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>日期 从：</th>
            <td>
                <input id="CreateDate_StartTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 00:00'})" style="width: 80px" value="@DNS.Utilities.DateTimeHelper.FirstDayOfMonth()"  />
            </td>
            <th style="width: 20px;">至：</th>
            <td>
                <input id="CreateDate_EndTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 23:59'})" style="width: 80px" value="@DNS.Utilities.DateTimeHelper.LastDayOfMonth()" />
            </td>

            <th style="width: 40px;">客户：</th>
            <td>
                <input id="CustomerName" type="text" class="txt" style="width: 80px" />
            </td>
            <td>
                <input id="CustomerCode" disabled type="text" class="txt" style="width: 80px" />
            </td>
            <th style="width: 40px;">类型：</th>
            <td>
                <select id="LType" class="select">
                    <option value="">全部</option>
                    <option value="GC">钢材</option>
                    <option value="LJ">配件</option>
                    <option value="RCL">热处理</option>
                </select>
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜索" onclick="btn_Search()" />
                <input id="btn_export" type="button" class="btnSearch" value="导出" onclick="btn_Export()" />
                @*<input id="btn_export1" type="button" class="btnSearch" value="预收及退款导出" onclick="btn_Export1()" />*@
                <input id="btn_dfexport1" type="button" class="btnSearch" value="对账单" onclick="BCPrintPreview()" />
                @*<input id="btn_expsdort1" type="button" class="btnSearch" value="全部导出" onclick="btn_ExportAll()" />*@
            </td>
        </tr>
    </table>
</div>






