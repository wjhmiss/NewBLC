                    function (iframe) {
                    top.frames[iframe].AcceptClick();
                },
                function (iframe) {
                    top.frames[iframe].AcceptClick2();
                });
            }
        }

        function DeliveryPrint(perType, printType, edit, deliverycodes) {
            //var DeliveryId = GetJqGridRowValue("#gridTable", "deliveryid");
