                    //OrderDetailhtml += '                    <td style="border: 1px solid #000;height:45px;" align="center">加工<BR/>条码</td>';
                    //OrderDetailhtml += '                    <td class="topline bottomline rightline" colspan="7" valign="middle" style="border-left:0px solid #000;text-align:center;">';
                    //OrderDetailhtml += '                        <div style="padding-top: 5px;border-collapse: separate;align="center">';
                    //OrderDetailhtml += '                            <div barcode=' + OrderEntiy.OrderCode + "-" + OrderDetail[i].LineCode + ' class="barcodeTarget"></div>';
                    //OrderDetailhtml += '                        </div>';
                    //OrderDetailhtml += '                    </td>';
                    //OrderDetailhtml += '                </tr>';
                    OrderDetailhtml += '                <tr  >';
                    OrderDetailhtml += '                    <td style="border: 1px solid #000;font-size: 12px;font-weight: bold;" align="center" >合同</td>';
