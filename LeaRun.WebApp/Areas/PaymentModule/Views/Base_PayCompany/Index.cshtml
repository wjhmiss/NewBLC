    //查询
    function btn_Search() {
        var tempstatus = "";
        if ($("#Status").prop("checked")) {
            tempstatus = 0;
        }
        if ($("#Status1").prop("checked")) {
            tempstatus = 1;
        }
        if ($("#Status1").prop("checked") && $("#Status").prop("checked")) {
            tempstatus = "";
        }
        var Parameter = [{
            paramName: "PayCompanyCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "AND",
        }, {
            paramName: "Type0",
            paramValue: $("#Type0").val(),
            Operation: "Equal",
            Logic: "AND",
        },
        {
            paramName: "Type1",
            paramValue: $("#Type1").val(),
            Operation: "Equal",
            Logic: "AND",
        },
        {
            paramName: "Type2",
            paramValue: $("#Type2").val(),
            Operation: "Equal",
            Logic: "AND",
        }, {
            paramName: "CustomerName",
            paramValue: $("#CustomerName").val(),
            Operation: "Like",
            Logic: "OR",
            LeftBrace: "("
        }, {
            paramName: "CustomerCode",
            paramValue: $("#CustomerName").val(),
            Operation: "Equal",
            Logic: "AND",
            RightBrace: ")"
        }
        , {
            paramName: "WorkerName",
            paramValue: $("#WorkerName").val(),
            Operation: "Equal",
            Logic: "AND"
        }
        , {
            paramName: "Status",
            paramValue: tempstatus,
            Operation: "Equal",
            Logic: "AND"
        }, {
            paramName: "CreateDate",
            paramValue: $("#CreateDate_StartTime").val(),
            Operation: "GreaterThan",
            Logic: "AND"
        }, {
            paramName: "CreateDate",
            paramValue: $("#CreateDate_EndTime").val(),
            Operation: "LessThan",
            Logic: "AND"
        }]

        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/PaymentModule/Base_PayCompany/GridPageJson1")?ParameterJson=" + escape(JSON.stringify(Parameter)), page: 1 }).trigger('reloadGrid');
    }
    //导出
    function btn_Export() {
        SetDeriveExcel("#gridTable", "其他付款报表");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }
</script>
<!--工具栏-->
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <td>单据号：
                <input id="keywords" type="text" class="txt" style="width: 100px" />
            员工姓名：
                <input id="WorkerName" type="text" class="txt" style="width: 100px" />
            供应商：
                <input id="CustomerName" type="text" class="txt" style="width: 100px" />
            
            
            选项：
                <select id="Type0" class="select" style="width:60px;" onchange="setType();"  datacol="yes" err="收款项0" checkexpession="NotNull">
                    <option value="">全部</option>
                    <option value="收款">收款</option>
                    <option value="付款">付款</option>
                </select>
                <select id="Type1" class="select" style="width:80px;" datacol="yes" err="收款项1" checkexpession="NotNull">
                </select>
                <select id="Type2" class="select" style="width:80px;" datacol="yes" err="收款项2" checkexpession="NotNull">
                </select>
            创建日期 从：
            
                <input id="CreateDate_StartTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd'})" style="width: 100px" />
                <input id="CreateDate_EndTime" type="text" class="txt Wdate"  onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd'})" style="width: 100px" />
            
                    <span class="item" style="cursor: pointer;">
                        <input type="checkbox" class="checkbox" name="checkbox" id="Status"  />
                        <label for="Status">未审核</label>
                    </span>
                 <span class="item" style="cursor: pointer;">
                        <input type="checkbox" class="checkbox" name="checkbox" id="Status1"  />
                        <label for="Status1">已审核</label>
                    </span>
               
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
                 <input id="btn_export" type="button" class="btnSearch" value="导 出" onclick="btn_Export()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
