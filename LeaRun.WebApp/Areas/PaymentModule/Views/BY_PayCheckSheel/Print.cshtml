    <script>
        //初始化
        $(function () {
            AjaxJson("/PaymentModule/BY_PayCheckSheel/PrintDataJson", { PayCheckSheetCode: GetQuery('PayCheckSheetCode') }, function (data) {
                //var Quotation = data.Quotation;
                //var QuotationDetail = data.QuotationDetail;
                //var Customer = data.Customer;

                var Name = GetQuery('Name');
                Name = "北仑机械锻造厂";
                var CheckData = data.CheckEntity;
                var CheckDataList = data.CheckEntityList;
                var base_customer = data.base_customer;

                $("#CheckCode").html(CheckData.PayCheckSheetCode);
                $("#CustomerAddress").html(base_customer.Address);
                $("#CheckName").html(CheckData.YearMonth + "月对账单");

                if (!CheckData.CustomerName) {
                    CheckData.CustomerName = ""
                }
                if (!CheckData.GSPhone) {
                    CheckData.GSPhone = ""
                }
                if (!CheckData.SellpeoplePhone) {
                    CheckData.SellpeoplePhone = ""
                }
                if (!CheckData.Fax) {
                    CheckData.Fax = ""
                }


                var index = 0;
                var pageindex = 0;
                var total = 0
                var pageNum = 35;
                var Orderhtml = '';
                if (CheckDataList.length % pageNum == 0) {
                    total = CheckDataList.length / pageNum;
                }
                else {
                    total = Math.floor(CheckDataList.length / pageNum) + 1
                }
                var pagepertem = 0;
                var PrintGroup = "";
                $.each(CheckDataList, function (i) {
                    if (index % pageNum == 0) {
                        pageindex++;
                        Orderhtml += '<div style="float:left;position: absolute; ">@*<img style="width: 60px;padding: 5px;" src="@Url.Content("~/Content/Images/111.jpg")" />*@</div><table id="tb_Order" border="0" class="form-print" style="width: 100%;">';
                        Orderhtml += '<tr><td colspan="4" align="center" style="padding: 2px;"><span style="font-size: 25px; font-weight: bold;">' + Name + '(' + pageindex + '/' + total + ')</span></td></tr>';
                        Orderhtml += '<tr><td colspan="4" align="center" style="height: 18.6px;line-height:18.6px;"></td></tr>';
                        Orderhtml += '<tr><th style="height: 18.6px;line-height:18.6px;">地址：</th><td style="height: 18.6px;line-height:18.6px;">宁波市北仑区大矸龙潭山三路15号</td><th style="height: 18.6px;line-height:18.6px;">电话：</th><td style="height: 18.6px;line-height:18.6px;">18892600521 </td></tr><tr><th style="height: 18.6px;line-height:18.6px;">传真：</th><td style="height: 18.6px;line-height:18.6px;">18892600521</td><th style="height: 18.6px;line-height:18.6px;">付款对账单：</th><td style="height: 18.6px;line-height:18.6px;">' + CheckData.PayCheckSheetCode + '</td></tr>';
                        Orderhtml += ' <tr><td colspan="4" align="center" style="border-top: 1px solid #000;padding-top:10px;height: 18.6px;line-height:18.6px;"><span style="font-size: 25px; font-weight: bold;" id="CheckName">' + CheckData.YearMonth + '(' + formatDate(CheckData.BeginDate, 'yyyy-MM-dd') + '至' + formatDate(CheckData.EndDate, 'yyyy-MM-dd') + ')月对账单</span></td></tr><tr><th style="height: 18.6px;line-height:18.6px;">供应商名称：</th><td>' + CheckData.CustomerName + '</td><th style="height: 18.6px;line-height:18.6px;">电话:</th><td>' + base_customer.GSPhone + '/' + base_customer.SellpeoplePhone + '</td></tr><tr><th style="height: 18.6px;line-height:18.6px;">传真:</th><td style="height: 18.6px;line-height:18.6px;">' + base_customer.Fax + '</td><th style="height: 18.6px;line-height:18.6px;">联系人：</th><td style="height: 18.6px;line-height:18.6px;">' + base_customer.Sellpeople + '</td></tr>';
                        Orderhtml += '<tr><td colspan="4" valign="top"><div ><table id="tb_QuotationDetail"  class="form-print" style="width: 100%; border-collapse:collapse;">';
                        Orderhtml += '<tr><td  align="center" style="border:solid 1px #000000;">序号</td>';
                        Orderhtml += '<td   style="border:solid 1px #000000;">类型</td>';
                        Orderhtml += '<td   style="border-bottom:1px solid;border-top:1px solid;">单号</td>';
                        Orderhtml += '<td   style="border:solid 1px #000000;">总金额（元)</td>';
                        Orderhtml += '<td   style="border:solid 1px #000000;">日期</td>';
                        Orderhtml += '<td   style="border:solid 1px #000000;">备注</td></tr>';
                    }
                    Orderhtml += '<tr>';
                    Orderhtml += '     <td style="border:solid 1px #000000;">' + (i + 1) + '</td>';
                    Orderhtml += '     <td style="border:solid 1px #000000;">' + CheckDataList[i].typename + '</td>';
                    Orderhtml += '     <td style="border:solid 1px #000000;">' + CheckDataList[i].codecc + '</td>';
                    Orderhtml += '     <td style="border:solid 1px #000000;">' + CheckDataList[i].totalamount + '</td>';
                    Orderhtml += '     <td style="border:solid 1px #000000;">' + CheckDataList[i].createdate.substr(0, 10) + '</td>';
                    Orderhtml += '     <td style="border:solid 1px #000000;">' + CheckDataList[i].remark + '</td>';
                    Orderhtml += '</tr>';
                    pagepertem += Number(CheckDataList[i].TotalAmount);
                    if ((index + 1) % pageNum == 0) {
                        Orderhtml += '<tr><td colspan="4" style="height:10mm;">本页小计：' + pagepertem.toFixed(2) + '</td></tr>';
                        Orderhtml += '</table></div></td></tr></table>';
                        pagepertem = 0;
                    }
                    index++;
                });
                Orderhtml += '<tr>';
                Orderhtml += '     <td colspan="3" align="center" >合   计</td>';
                Orderhtml += '     <td></td>';
                Orderhtml += '     <td>' + CheckData.TotalAmount + '</td>';
                Orderhtml += '</tr></table></div></td></tr>';

                
                Orderhtml += '<tr><td colspan="4">备注：以上账目敬请财务核对且在2个工作日内务必回传，超时视为默认。</td></tr><tr><td colspan="4" valign="top"><table  class="form-print" style="width: 100%; border-top: 1px solid #000;border-collapse:collapse;"><tr><td >制表人：@DNS.Utilities.ManageProvider.Provider.Current().UserName </td><td >审核人：</td><td >供应商确认：</td><td >确认日期：</td></tr></table></td></tr></table>';
                $("#my_area").append(Orderhtml);














            });
        })
        //确认打印
        function AcceptClick() {
            AjaxJson("/QuotationModule/QuotationPrint/StateModify", { KeyValue: GetQuery('QuotationId') }, function (data) {
                MyPreview();

            });
        }
    </script>
