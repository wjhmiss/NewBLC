                            size = parseFloat(QuotationDetail[i].Length) + ' x ' + parseFloat(QuotationDetail[i].Weigh) + ' x ' + parseFloat(QuotationDetail[i].Thick);
                        }
                    }
                    var sizeall = "";
                    if (QuotationDetail[i].Length > 0) {
                        if (parseFloat(QuotationDetail[i].Weigh) <= 0) {
                            var BoreSize = "";
                            if (!!QuotationDetail[i].BoreSize) {
                                BoreSize = "xφ" + QuotationDetail[i].BoreSize;
                            }
                            sizeall = "Φ" + parseFloat(QuotationDetail[i].Thick + QuotationDetail[i].AddThick) + BoreSize + ' x ' + parseFloat(QuotationDetail[i].Length + QuotationDetail[i].AddLength);
                        }
                        else {
                            sizeall = parseFloat(QuotationDetail[i].Length + QuotationDetail[i].AddLength) + ' x ' + parseFloat(QuotationDetail[i].Weigh + QuotationDetail[i].AddWeigh) + ' x ' + parseFloat(QuotationDetail[i].Thick + QuotationDetail[i].AddThick);
                        }
                    }

                    var QuotationDetailhtml = "";


                    if (QuotationDetail[i].LineCode == "99999") {
                        QuotationDetailhtml += '<tr>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ; ">合计</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;" ></td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;" ></td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;" ></td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;" ></td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].Qty + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;" ></td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;" ></td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;" ></td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].Weight + '</td>';
