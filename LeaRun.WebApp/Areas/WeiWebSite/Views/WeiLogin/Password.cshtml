@{
    ViewBag.Title = "修改密码";
    Layout = "~/Views/Shared/_LayoutMobile.cshtml";
}
<div id="mainPanel" class="panel" data-footer="main_footer">

    <!--修改密码-->
    <script type="text/javascript" src="~/Content/Scripts/Mobile/scripts/jquery/Validform_v5.3.2_min.js"></script>
    <script type="text/javascript">
        $(function () {
            $("#main_footer a.user").addClass("pressed");
            //初始化表单
            AjaxInitForm('#pwd_form', '#btnSubmit', 1);
        });
    </script>
    <header>
        <a onclick="history.back(-1);" class="backButton">返回</a>
        <h1>修改密码</h1>
        <a onclick="$.ui.toggleSideMenu()" class="menuButton"></a>
    </header>
    <form name="pwd_form" id="pwd_form" url="/WeiWebSite/WeiLogin/SetPassword">
        <div class="form-box">
            <dl>
                <dt>用户名</dt>
                <dd>wjhmiss</dd>
            </dl>
            <div>
                <input name="txtOldPassword" id="txtOldPassword" type="password" placeholder="请输入旧密码" datatype="*6-20" nullmsg="请输入旧密码" errormsg="密码范围在6-20位之间" sucmsg=" " /></div>
            <div>
                <input name="Password" id="Password" type="password" placeholder="请输入新密码" datatype="*6-20" nullmsg="请输入密码" errormsg="密码范围在6-20位之间" sucmsg=" " /></div>
            <div>
                <input name="txtPassword1" id="txtPassword1" type="password" placeholder="请再次输入新密码" datatype="*" recheck="Password" nullmsg="请再输入一次密码" errormsg="两次输入的密码不一致" sucmsg=" " /></div>
            <div>
                <input id="btnSubmit" name="btnSubmit" type="submit" value="确认修改" class="btn orange full" /></div>
        </div>
    </form>
    <!--/修改密码-->



    <!--版权信息-->
    @Html.Partial("_PartialMobileBottom")

    <!--/版权信息-->

</div>

