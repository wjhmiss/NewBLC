    function enterInput() {


        var e = e || window.event || arguments.callee.caller.arguments[0];
        var tar = e.srcElement || e.target;
        if (e && e.keyCode == 13) {//回车
            
            if ($(tar).attr('id') == "ProductName") {
                $("#SteelCode").focus();
            }
            else if ($(tar).attr('id') == "SteelCode") {
                $("#Thick").select();
            }



            else if ($(tar).attr('id') == "Thick") {
                $("#BoreSize").select();
            }
            else if ($(tar).attr('id') == "BoreSize") {
                $("#Length").select();
            }
            else if ($(tar).attr('id') == "Length") {
                $("#Weigh").select();
            }
            else if ($(tar).attr('id') == "Weigh") {
                $("#AddThick").select();
            }
            
           

            else if ($(tar).attr('id') == "AddThick") {
                $("#BoreSizeAdd").select();
            }

            else if ($(tar).attr('id') == "BoreSizeAdd") {
                $("#AddLength").select();
            }
            else if ($(tar).attr('id') == "AddLength") {
                $("#AddWeigh").select();
            }

            else if ($(tar).attr('id') == "AddWeigh") {
                $("#Qty").select();
            }



            else if ($(tar).attr('id') == "Qty") {
                if ($(tar).val() != "0") {
                    $("#MaterialPrice").select();
                }
            }
            else if ($(tar).attr('id') == "MaterialPrice") {
                $("#NowStatus").select();
            }
            
           
            else if ($(tar).attr('id') == "NowStatus") {
                $("#KSize").select();
            }
            else if ($(tar).attr('id') == "KSize") {
                $("#STSize").select();
            }
            
            else if ($(tar).attr('id') == "STSize") {
                
                    $("#Remark").select();
                    
                
            }
            else if ($(tar).attr('id') == "Remark") {
                if (!$("#Delivery").val()) {
                    $("#Delivery").select();

                }
                else {
                    $("#CustomerProduct").select();
                }
            }
           
            else if ($(tar).attr('id') == "Delivery") {
                $("#CustomerProduct").select();
            }
            else if ($(tar).attr('id') == "CustomerProduct") {
                $("#ProjectCode").select();
            }
            else if ($(tar).attr('id') == "ProjectCode") {
                $("#ZSize").select();
            }

            
            else if ($(tar).attr('id') == "ZSize") {
                
                $("#Hardness").select();
            }
            else if ($(tar).attr('id') == "Hardness") {
                if (!!KeyValue) {
                    //编辑
                    AcceptClick2(1);
                }
                else {
                    AcceptClick1();
                }
            }
            else {
                $("#ProductName").select();
            }
        }
    }
