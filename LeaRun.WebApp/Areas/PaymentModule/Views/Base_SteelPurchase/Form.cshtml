            var Price = $("#" + id + "_Price").val();
            var Qty = $("#" + id + "_Qty").val();
            if (Qty != 1) {
                //alertDialog("数量只能为1！", 0);
                tipDialog('数量只能为1', 1, 'warning');
                $("#" + id + "_Qty").val(1);
                $("#" + id + "_Qty").select();
                return;
            }
            var SteelCode = $("#" + id + "_SteelCode").val();
            var Density = GetJqGridValue("#gridTable", id, "Density");
            var weight = 0;
            if (OLength != 0 && OWeigh != 0 && OThick != 0) {
                weight = (OLength * OWeigh * OThick * Density / 1000000).toFixed(2);
            }
            if (OLength != 0 && OWeigh == 0 && OThick != 0) {
                weight = (OLength * (OThick / 2) * (OThick / 2) * 3.1415 * Density / 1000000).toFixed(2);
                //weight = (OLength * (OThick ) * (OThick ) * Density / 1000000).toFixed(2);
                if (!!BoreSize) {
                    weight = (weight - OLength * (BoreSize / 2) * (BoreSize / 2) * 3.1415 * Density / 1000000).toFixed(2);
                    //weight = (weight - OLength * (BoreSize ) * (BoreSize) * Density / 1000000).toFixed(2);
                }
            }
            $("#gridTable").jqGrid('setRowData', id, { TheoryWeight: (weight * Qty).toFixed(2) });
            if (SteelCode ==  "FY") {
                if (!!Qty && !!Price) {
                    $("#gridTable").jqGrid('setRowData', id, { TotalAmount: (Price * Qty).toFixed(2) });
                }
            }
            else {
                if (!!$("#" + id + "_OWeight").val() && !!Price) {
                    $("#gridTable").jqGrid('setRowData', id, { TotalAmount: ($("#" + id + "_OWeight").val() * Price).toFixed(2) });
                }
            }

            $("#" + id + "_OWeight").val((weight * Qty).toFixed(2));
            $("#gridTable").jqGrid('setRowData', id, { Weight: (weight * Qty).toFixed(2) });


            var data = $("#gridTable").jqGrid("getRowData");
            var TotalAmountall = 0;
            for (var i = 0; i < data.length; i++) {
                TotalAmountall = TotalAmountall + Number(data[i].TotalAmount);
            }
            $("#TotalAmount").val(TotalAmountall);

            $("#gridTable").jqGrid('setRowData', id, { Length: OLength });
            $("#gridTable").jqGrid('setRowData', id, { Weigh: OWeigh });
            $("#gridTable").jqGrid('setRowData', id, { Thick: OThick });
        }
        //新增一行
        $("#lr-add-Row").click(function () {

            var index = 0;
            if (!!$("#gridTable").getGridParam("reccount")) {
                index = $("#gridTable").getGridParam("reccount") + 1;
            }
            else {
                index = 1;
            }

            var SteelCode = "";
            var Price = 0;
            var SortCode = 0;
            var TypeName = "是";
            var PlaceOrigin = "";
            var Remark = "";
            if (!!Number(GetJqGridValue("#gridTable", $("#gridTable").getGridParam("reccount"), "SortCode"))) {
                SortCode = Number(GetJqGridValue("#gridTable", $("#gridTable").getGridParam("reccount"), "SortCode")) + 1;
            }
            else {
                SortCode = 1;
            }
            if (Number(GetJqGridValue("#gridTable", $("#gridTable").getGridParam("reccount"), "SortCode"))) {
                SteelCode = $("[name='SteelCode']").val();
                Price = $("[name='Price']").val();
                TypeName = $("[name='TypeName']").val();
                PlaceOrigin = $("[name='PlaceOrigin']").val();
                Remark = $("[name='Remark']").val();
            }




            var rowdata = {
                //InventoryId: '',
                SteelCode: SteelCode,
                Density:0,
                SteelDescription: '',
                OLength: '0',
                OWeigh: '0',
                OThick: '0',
                OWeight: '0',
                TheoryWeight: '0',
                Price: Price,
                TotalAmount: '0',
                Remark: Remark,
                BoreSize: '0',
                Qty:'1',
                TypeName: TypeName,
                SortCode: SortCode,
                Weightcheng:'0',
                PlaceOrigin: PlaceOrigin,
                SteelStatus: '',
                QuotationCodeLine: '',
                StoveCode: '',
                position: '',
                
            }
            $('#gridTable').jqGrid('restoreRow', index);
            $('#gridTable').jqGrid('addRowData', index, rowdata, "last");
            $("#gridTable").setSelection(index);
        });
        //删除
        $("#lr-delete-Row").click(function () {
            var Index = GetJqGridRowIndx("#gridTable");
            $("#gridTable").jqGrid("delRowData", Index);
        });
    }

    //查询
    function btn_Quotationquery() {
        openDialog("/QuotationModule/QuotationQuery/QueryQuotationForSteelP", "Query", "明细查询", 850, 560, function (iframe) {
            top.frames[iframe].AcceptClick()
        });
    }

    function addforQuo(s) {
        var SortCode = 0;
        if (!!Number(GetJqGridValue("#gridTable", $("#gridTable").getGridParam("reccount"), "SortCode"))) {
            SortCode = Number(GetJqGridValue("#gridTable", $("#gridTable").getGridParam("reccount"), "SortCode")) + 1;
        }
        else {
            SortCode = 1;
        }
        var index = 0;
        if (!!$("#gridTable").getGridParam("reccount")) {
            index = $("#gridTable").getGridParam("reccount") + 1;
        }
        else {
            index = 1;
        }
        var entitys = s.split(';');
        for (var i = 0; i < entitys.length; i++) {
            var items = entitys[i].split(',');
            //steelcode 0,steeldescription 1,boresize 2,theoryweight 3,length 4,weigh 5,thick 6,density 7,quotationcodeline 8，qty 9
            var boresize = 0;
            if (!!items[2]) {
                boresize = items[2];
            }
            var RowData = {
                SortCode: SortCode+i,
                Density: items[7],
                SteelCode: items[0],
                SteelDescription: items[1],
                OLength: items[4],
                OWeigh: items[5],
                OThick: items[6],
                BoreSize: boresize,
                Qty: items[9],
                Price: "0",
                TheoryWeight: items[3],
                OWeight: items[3],
                Weightcheng: "0",
                TypeName: "是",
                TotalAmount: "0",
                Remark: "",
                PlaceOrigin: "",
                SteelStatus: "",
                Length: items[4],
                Weigh: items[5],
                Thick: items[6],
                Weight: items[3],
                QuotationCodeLine: items[8],
            }
            $('#gridTable').jqGrid('addRowData', index, RowData, "last");
            index += 1;
        }

    }
</script>
