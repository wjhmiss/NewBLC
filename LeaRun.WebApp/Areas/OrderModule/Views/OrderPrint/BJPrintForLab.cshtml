                        QuotationEntiy.CustomerPO = "";
                    }
                    OrderDetailhtml += '                    <td class="topline bottomline rightline" colspan="7" style="text-align:left;font-size: 12px;font-weight: bold;text-align:left;" >' + QuotationEntiy.CustomerPO + '</td>';
                    OrderDetailhtml += '                </tr>';
                    OrderDetailhtml += '                <tr  >';
                    OrderDetailhtml += '                    <td style="border: 1px solid #000;font-size: 12px;font-weight: bold;" align="center" >订单</td>';
                    OrderDetailhtml += '                    <td class="topline bottomline rightline" colspan="7" style="text-align:left;font-size: 12px;font-weight: bold;text-align:left;"  >' + QuotationEntiy.MnemonicCode + '-' + OrderDetail[i].LineCode + '</td>';
                    OrderDetailhtml += '                </tr>';
                    OrderDetailhtml += '                <tr  >';
                    OrderDetailhtml += '                    <td style="border: 1px solid #000;font-size: 12px;font-weight: bold;" align="center" >模号</td>';
                    OrderDetailhtml += '                    <td class="topline bottomline rightline" colspan="7" style="text-align:left;font-size: 12px;font-weight: bold;text-align:left;" >' + OrderDetail[i].CustomerProduct + '</td>';
                    OrderDetailhtml += '                </tr>';
                    OrderDetailhtml += '                <tr  >';
                    OrderDetailhtml += '                    <td style="border: 1px solid #000;font-size: 12px;font-weight: bold;" align="center">客户</td>';
                    OrderDetailhtml += '                    <td class="topline bottomline rightline" colspan="7" style="text-align:left;font-size: 12px;font-weight: bold;text-align:left;">' + QuotationEntiy.CustomerName.split('-')[QuotationEntiy.CustomerName.split('-').length - 1] + '</td>';
                    OrderDetailhtml += '                </tr>';
                    OrderDetailhtml += '            </table>';
                    //OrderDetailhtml += '            <table class="form-print" style="margin-top: 5px;">';
                    //OrderDetailhtml += '                <tr>';
                    //OrderDetailhtml += '                    <th>负责人：</th>';
                    //OrderDetailhtml += '                    <td style="width: 100px;">' + QuotationEntiy.SalesMan + '</td>';
                    //OrderDetailhtml += '                    <th>开单人：</th>';
                    //OrderDetailhtml += '                    <td style="width: 100px;">' + QuotationEntiy.CreateUserName + '</td>';
                    //OrderDetailhtml += '                </tr>';
                    //OrderDetailhtml += '                <tr>';
                    //OrderDetailhtml += '                    <th>备&nbsp;&nbsp;注：</th>';
                    //OrderDetailhtml += '                </tr>';
                    //OrderDetailhtml += '            </table>';

                    OrderDetailhtml += '        </td>';
                    OrderDetailhtml += '    </tr>';
                    OrderDetailhtml += '</table>';
                    num += 1;
                    $('#my_area').append(OrderDetailhtml);
                });
            });
            $(".barcodeTarget").each(function () {
                $(this).barcode($(this).attr('barcode'), "code128", { barWidth: 1.5, barHeight: 20 });
            });
        });
        //确认打印
        function AcceptClick() {
            AjaxJson("/OrderModule/OrderPrint/UpdateOrderStatus", { OrderId: GetQuery('OrderId') }, function (data) {
                MyPreview();

            });
        }
    </script>
</head>
<body>
    <div id="my_area" style="background: #fff;">

    </div>




    <script language="javascript" type="text/javascript">
        function MyPreview() {
            var LODOP = getLodop();
            LODOP.PRINT_INIT("打印初始化");
            //A5:148*210MM    0.36
            //A6: 105 * 148MM   295*415px
            LODOP.SET_PRINT_PAGESIZE(1, "600", "400", "")
            var strHTML = document.getElementsByTagName("html")[0].innerHTML;
            LODOP.ADD_PRINT_HTM(0, 0, "100%", "100%", strHTML);
            LODOP.SET_SHOW_MODE("LANDSCAPE_DEFROTATED", 1);//横向时的正向显示
            LODOP.PREVIEW();
            tipDialog("打印成功", 3, 1);
            //top.frames[tabiframeId()].windowload();
            closeDialog();
            //if (LODOP.PRINTA()) {
            //    LODOP.PRINT();
            //    tipDialog("打印成功", 3, 1);
            //    top.frames[tabiframeId()].windowload();
            //    closeDialog();

            //}
            //else
            //    //alert("");
            //    tipDialog("放弃打印！", 3, 1);

        };
        function tabiframeId() {
            var tabs_container = top.$("#tabs_container");
            return "tabs_iframe_" + tabs_container.find('.selected').attr('id').substr(5);
        }
    </script>
</body>
