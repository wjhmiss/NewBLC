    //订单扫描事件
    function ScanOrder() {

        $(document).keypress(function (e) {
            //回车键事件
            if (e.which == 13) {
                if ($("#O_BillCode").val() == "") {
                    $("#O_BillCode").select();
                    return;
                }
                AjaxJsonNoMassge("/OrderModule/OrderQuery/GetOrderDetailScaleJson", { BarCode: $("#O_BillCode").val() + "--" }, function (data) {

                    if (!data[0] || data.Code == -1) {
                        tipDialog(data.Message, 3, -1);
                        $("#O_SteelCode").val("");
                        $("#O_SteelDescription").val("");
                        $("#O_OrderType").val("");
                        $("#O_CustomerName").val("");
                        $("#O_Thick").val("");
                        $("#O_Weigh").val("");
                        $("#O_Length").val("");
                        $("#O_Qty").val("");
                        $("#O_Weight").val("");
                        $("#O_TotalWeight").val("");
                        $("#O_BillCode").select();
                        $("#BatchCode").val("");
                        $("#Weight").val("");
                        $("#BeforeSize").val("");
                        $("#OpenSize").val("");
                        $("#AfterSize").val("");
                        $("#SteelDescription").val("");
                        $("#ScaleWeight").html("0");
                        $('#gridTable').jqGrid("clearGridData");
                        return false;
                    }
                    if (data[0].length == 0) {
                        tipDialog1("操作失败：此无需消数！", 2, 0);
                        return false;
                    }
                    AjaxJsonNoMassge("/CommonModule/Steel/GetSteelEntity", { SteelId: data[0].steelid }, function (steeldata) {
                        Density = Number(steeldata.Density);
                    })
                    //如果没有过磅就按理论
                    if (data[0].clearqty == 0) {
                        //data[0].clearqty = Number(data[0].qty) - Number(data[0].openqty);
                        //data[0].clearweight = (Number(data[0].clearqty) * Number(data[0].weight) / Number(data[0].qty)).toFixed(2)
                        data[0].clearqty = 0;
                        data[0].clearweight = 0
                    }
                    OrderData = data[0];
                    //OrderDetailId = data.orderdetailid;
                    $("#O_SteelCode").val($.trim(data[0].steelcode).replace("&nbsp;", ""));
                    $("#O_SteelDescription").val($.trim(data[0].steeldescription).replace("&nbsp;", ""));
                    $("#O_OrderType").val($.trim(data[0].ordertype).replace("&nbsp;", ""));
                    $("#O_CustomerName").val($.trim(data[0].customername).replace("&nbsp;", ""));
                    $("#O_Thick").val($.trim(data[0].thick).replace("&nbsp;", ""));
                    $("#O_Weigh").val($.trim(data[0].weigh).replace("&nbsp;", ""));
                    $("#O_Length").val($.trim(data[0].length).replace("&nbsp;", ""));
                    $("#ScaleWeight").html(data[0].clearweight);
                    if (data[0].openqty) {
                        $("#O_Qty").val($.trim(data[0].qty - data[0].openqty).replace("&nbsp;", ""));
                    }
                    else {
                        $("#O_Qty").val($.trim(data[0].qty).replace("&nbsp;", ""));
                    }

                    $("#O_Weight").val((Number(data[0].weight)  / Number(data[0].qty)).toFixed(2));
                    $("#O_TotalWeight").val(Number(data[0].weight));
                    $("#O_Qtyed").val($.trim(data[0].qty).replace("&nbsp;", ""));

                    //if (data[0].brokensteel && data[0].brokensteel != "null") {
                    //    $("#BatchCode").val($.trim(data[0].brokensteel).replace("&nbsp;", ""));
                    //    $("#Weight").val(Number($.trim(data[0].stockweight).replace("&nbsp;", "")).toFixed(2));
                    //}
                    //else {
                    //    $("#BatchCode").val($.trim(data[0].steelcode).replace("&nbsp;", ""));
                    //    $("#Weight").val(0);
                    //}
                    $("#BatchCode").val($.trim(data[0].steelcode).replace("&nbsp;", ""));
                    SetSteelControl();

                    $('#gridTable').jqGrid("clearGridData");
                    var index = 0;
                    var postData = {
                        OrderDetailId: OrderData.orderdetailid,
                        Type: OrderData.ordertype,
                        OrderCode: OrderData.ordercode,
                        SteelDescription: OrderData.steeldescription,
                        LineCode: OrderData.linecode,
                        SteelCode: OrderData.steelcode,
                        Qty: data[0].clearqty,
                        Thick: OrderData.thick,
                        Weigh: OrderData.weigh,
                        Length: OrderData.length,
                        UnCompleteQty: Number(OrderData.qty) - Number(OrderData.completeqty),
                        CustomerCode: OrderData.customercode,
                        Delivery: data[0].delivery,
                        TheoryWeight: (Number(data[0].clearqty) * Number($("#O_Weight").val())).toFixed(2),
                        Weight: $("#ScaleWeight").html(),
                        ScaleUser: "@DNS.Utilities.ManageProvider.Provider.Current().UserName",
            ScaleDate: CurrentTime()
        }
                    $('#gridTable').jqGrid('addRowData', index, postData, "first");
                    $("#gridTable").setSelection(index);
                    $("#OpenQty").val(data[0].clearqty);
                    $("#OpenTotalWeight").val(data[0].clearweight);

                    //$("#lr-edit-Row").click();
                    //lreditRow();
                    //$("#O_BillCode").select();
                    setTimeout(btn_save, 200);

                });
            }
        });
    }
