@{
    ViewBag.Title = "热处理费折扣";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    var KeyValue = GetQuery('KeyValue');//主键
    var CustomerId = GetQuery('CustomerId');//客户主键
    $(function () {
        $("#CustomerId").val(CustomerId);
        SteelAutocomplete();
        //工艺名称
        BindDropItem("#CraftTypeName", "CraftType", "==请选择==");
        //单位
        //BindDropItem("#Unit", "MeasureUnit", "==请选择==");
        InitControl();
        $("#CraftTypeName").change(function () {
            $("#CraftTypeCode").val($(this).val())
        })
        document.onkeydown = enterInput;
    })

    function enterInput() {
        var e = e || window.event || arguments.callee.caller.arguments[0];
        var tar = e.srcElement || e.target;
        if (e && e.keyCode == 13) {//回车
            window.event.keyCode = 9;
            if ($(tar).attr('id') == "Remark") {
                AcceptClick();
            }
            return;
        }
    }


    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/CommonModule/CustomerPrice/SetFormManage", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
                $("#CraftTypeName").val(data.CraftTypeCode);
                $("#EnabledTimeStart").val(formatDate(data.EnabledTimeStart, 'yyyy-MM-dd'));
                $("#EnabledTimeStart").val(formatDate(data.EnabledTimeStart, 'yyyy-MM-dd'))
                $("#ModifyDate").val(formatDate(data.ModifyDate, 'yyyy-MM-dd'))
            });
        }
    }
    //钢材编码自动补全
    function SteelAutocomplete() {
        var $SteelCode = $("#SteelCode");
        $SteelCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("SteelCode", function (data) {
            $("#SteelId").val(data.SteelId);
            $("#SteelCode").val(data.SteelCode);
            $("#SteelName").val(data.SteelName);
        });
        //获取数据源
        function DataSource() {
            AjaxJson("/CommonModule/Steel/GetAutoCompleJson", { keywords: $SteelCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="SteelId" style="display: none;">' + DataJson[i].SteelId + '</td>';
                    html += '<td id="SteelCode" style="width: 25%;">' + DataJson[i].SteelCode + '</td>';
                    html += '<td id="SteelName" style="width: 25%;">' + DataJson[i].SteelName + '</td>';
                    html += '<td id="SteelType"  style="display: none;" style="width: 25%;">' + DataJson[i].SteelType + '</td>';
                    html += '<td id="Price"  style="display: none;" style="width: 25%;">' + DataJson[i].Price + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("SteelCode", "200px", "200px", html, function (data) {
                    $("#SteelId").val(data.SteelId);
                    $("#SteelCode").val(data.SteelCode);
                    $("#SteelName").val(data.SteelName);
                });
            });
        }

    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        var postData = GetWebControls("#form1");
        postData["CraftTypeName"] = $("#CraftTypeName").find("option:selected").text();
        $(".ui_state_highlight").attr("disabled", true);
        AjaxJson("/CommonModule/CustomerPrice/SubmitFormManage?KeyValue=" + KeyValue, postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            //window.setTimeout(function () {closeDialog();}, 500);
            if (!!KeyValue) {
                window.setTimeout(function () {closeDialog();}, 500);
            }
            else {
                location.href = location.href;
            }
            
        }); 
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class='formTitle'>工艺名称：</th>
            <td class='formValue'>
                <input id="CustomerId" type="hidden" />
                <select id="CraftTypeName" class="txt" datacol="yes" err="工艺名称" checkexpession="NotNull" style=" width:40%">
                    <option value="">请选择</option>
                </select>
                <input id="CraftTypeCode" readonly maxlength="50" type="text" class="txt readonly"  style="width:45%" />
            </td>
            <th class='formTitle'>钢种：</th>
            <td class='formValue'>
                <input id="SteelId" type="hidden" />
                <input id="SteelCode" maxlength="50" type="text" class="txt"  style="width:75%;display:inline"  />
                <input id="SteelName" readonly type="text" class="txt readonly" style="width:20%;display:inline" disabled/>
            </td>
        </tr>
        <tr>
            <th class='formTitle'>单价：</th>
            <td class='formValue'>
                <input id="Price" maxlength="18" onfocus="IsMoney(this.id);" value="0" type="text" class="txt" datacol="yes" err="折扣率" checkexpession="NotNull" style="width: 90%; border-right: 1px solid #ccc;" />
                <input id="DiscountRate" maxlength="18" onfocus="IsMoney(this.id);" type="text" class="txt"  style=" border-right: 1px solid #ccc;display:none;" />
                @*<span style="color: red; font-weight: bold;">%</span>*@
            </td>
            <th class='formTitle'>单位：</th>
            <td class='formValue'>
                <select id="Unit" class="txt" datacol="yes" err="单位" checkexpession="NotNull">

                    <option value="公斤">公斤</option>
                </select>
            </td>
        </tr>
        <tr>
            <th class='formTitle'>有效时间 从：</th>
            <td class='formValue'>
                <input id="EnabledTimeStart" maxlength="23" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 00:00' })" value="@DNS.Utilities.DateTimeHelper.GetToday() 00:00" />
            </td>
            <th class='formTitle'>有效时间 至：</th>
            <td class='formValue'>
                <input id="EnabledTimeEnd" maxlength="23" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 23:59' })" value="@DateTime.Now.AddMonths(6).ToString("yyyy-MM-dd") 23:59"/>
            </td>
        </tr>
        <tr>
             
            <th class='formTitle'>每单最低金额：</th>
            <td class='formValue'>
                <input id="HeatLimitMoney" maxlength="18" onfocus="IsMoney(this.id);" value="0" type="text" class="txt"  />
            </td>


            <th class='formTitle'>有效：</th>
            <td class='formValue'>
                <span class="item">
                    <input type="checkbox" name="checkbox" checked="checked" id="Enabled" />
                    <label for="Enabled">有效</label>
                </span>
            </td>
        </tr>
        <tr>
            <th class='formTitle'>备注：</th>
            <td class='formValue' colspan="3">
                <textarea id="Remark" name="Description" maxlength="200" class="txtArea" rows="4"></textarea>
            </td>
        </tr>
        @*<tr>
            <th class='formTitle'>最近更新时间：</th>
            <td class='formValue'>
                <input id="ModifyDate" readonly maxlength="23" type="text" value="@DNS.Utilities.DateTimeHelper.GetTime()" class="txt readonly" />
            </td>
            <th class='formTitle'>最近更新人：</th>
            <td class='formValue'>
                <input id="ModifyUserName" readonly maxlength="50" type="text" value="@DNS.Utilities.ManageProvider.Provider.Current().UserName" class="txt readonly" />
            </td>
        </tr>*@
    </table>
</form>
