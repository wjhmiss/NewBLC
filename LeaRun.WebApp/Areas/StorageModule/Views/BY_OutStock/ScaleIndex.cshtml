                    $("#gridTable").jqGrid('setRowData', iRow - 1, { TheoryWeight: Number(qtya) * Number(weight) });
                    $("#gridTable").jqGrid('setRowData', iRow - 1, { Weight: Number(qtya) * Number(weight) });
