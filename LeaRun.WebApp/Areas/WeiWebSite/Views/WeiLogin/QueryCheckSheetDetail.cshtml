@{
    ViewBag.Title = "仓库";
    Layout = "~/Views/Shared/_LayoutMobile.cshtml";
}
<link href="~/Content/Scripts/Mobile/templates/mobile/css/mobiscroll.custom-2.6.2.min.css" rel="stylesheet" />
<script src="~/Content/Scripts/Mobile/templates/mobile/js/mobiscroll.custom-2.6.2.min.js"></script>
<script type="text/javascript">
    var CheckSheetCode = GetQuery('CheckSheetCode');
    $(document).ready(function (e) {
        if (CheckSheetCode == "") {
            tipDialog("错误：未能获取对账单信息", -1);
            location.href = "@Url.Content("~/WeiWebSite/WeiLogin/QueryOrder")";
            return;
        }
        AjaxJsonNoMassge("/CheckSheetModule/BY_CheckSheet/PrintDataJson", { CheckSheetCode: CheckSheetCode }, function (data) {
            var CheckData = data.CheckEntity;
            var CheckDataList = data.CheckEntityList;
            $("#CheckSheetCode").html(CheckData.CheckSheetCode);
            $("#BeginDate").html(CheckData.BeginDate.substr(0,7));
            $("#CustomerName").html(CheckData.CustomerName);
            $("#Qty").html(CheckData.Qty);
            $("#TotalAmount").html(CheckData.TotalAmount);
            $("#GetedAmount").html(CheckData.GetedAmount);
            $("#InvoiceAmount").html(CheckData.InvoiceAmount);
            $("#ContactName").html(CheckData.ContactName);
            $("#MobileCodeContactTel").html(CheckData.MobileCode+"/"+CheckData.ContactTel);
            $("#CustomerAddress").html(CheckData.CustomerAddress);
            $("#SalesArea").html(CheckData.SalesArea);
            $.each(CheckDataList, function (i) {
                var html = ' <div class="wrap-box"><h2>' + CheckDataList[i].DeliveryCode + '</h2><dl>';
                html += '<dt>报价单号</dt><dd>' + CheckDataList[i].QuotationCode + '</dd></dl><dl>';
                html += '<dt>总数量</dt><dd>' + CheckDataList[i].Qty + '</dd></dl><dl>';
                html += '<dt>总重量</dt><dd>' + CheckDataList[i].Weight + '</dd></dl><dl>';
                html += '<dt>总金额</dt><dd>' + CheckDataList[i].TotalAmount + '</dd></dl><dl>';
                html += '<dt>送货时间</dt><dd>' + CheckDataList[i].PrintDate.replace("T"," ") + '</dd></dl></div>';
                $("#listdetail").append(html);
            });

        });



    });

    function locationInputQuot() {
        location.href = "@Url.Content("~/WeiWebSite/WeiLogin/QueryOrder")";
    }



</script>
