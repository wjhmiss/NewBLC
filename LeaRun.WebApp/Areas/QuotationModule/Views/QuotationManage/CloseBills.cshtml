@{
    ViewBag.Title = "关闭报价单";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script>
    $(function () {
        //取消归类
        BindDropItem("#CancleReasonId", "Quotation_Reason_Sort", "==请选择==");
        $("#CancleReasonId").change(function () {
            $("#CancleReason").val($(this).find("option:selected").text() + ";");
        })
    })
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        Loading(true, "正在提交数据...");
        window.setTimeout(function () {
            var postData = {
                KeyValue: GetQuery('KeyValue'),
                CancleReason: $("#CancleReason").val()
            }
            AjaxJson("/QuotationModule/QuotationManage/SubmitCloseBills", postData, function (data) {
                tipDialog(data.Message, 3, data.Code);
                top.frames[tabiframeId()].windowload();
                window.setTimeout(function () {closeDialog();}, 500);
            });
        }, 200);
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class="formTitle">取消归类：</th>
            <td class="formValue">
                <select id="CancleReasonId" class="txtselect"></select>
            </td>
        </tr>
        <tr>
            <th class="formTitle">取消原因：</th>
            <td class="formValue">
                <textarea id="CancleReason" maxlength="200" class="txtArea" rows="4" datacol="yes" err="取消原因" checkexpession="NotNull"></textarea>
            </td>
        </tr>
    </table>
</form>
