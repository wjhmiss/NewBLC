    function setAdd() {
        AjaxJsonNoMassge("/CommonModule/Customer/GetEntity", { keywords: CustomerId }, function (DataJson) {
            $("#CPriceMessage").val(DataJson.PriceMessage);
            $("#CMateRemark").val(DataJson.MateRemark);
