    //钢材编码自动补全
    function SteelAutocomplete() {
        var $SteelCode = $("#SteelCode");
        $SteelCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            //DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("SteelCode", function (data) {
            if (!!data.SteelCode) {
                $("#SteelId").val(data.SteelId);
                $("#SteelCode").val(data.SteelCode);
                $("#SteelDescription").val(data.SteelName);
                Density = data.Density;
                SteelType = data.SteelType;
                $("#RepalceMl").val(data.RepalceMl);
                $("#SteelType").val(data.SteelType);
                ConversionkeyCode();
                //ConversionForRemarkkeyCode();
                //$("#AddThick").val("0");
                //$("#AddWeigh").val("0");
                //$("#AddLength").val("0");
            }
        });
        //获取数据源
        function DataSource() {
            AjaxJsonNoMassge("/CommonModule/Steel/GetAutoCompleJson", { keywords: $SteelCode.val(), type: 1 }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="SteelId" style="display: none;">' + DataJson[i].SteelId + '</td>';
                    html += '<td id="SteelCode" style="width: 40%;">' + DataJson[i].SteelCode + '</td>';
                    html += '<td id="SteelName" style="width: 60%;">' + DataJson[i].SteelName + '</td>';
                    html += '<td id="Density" style="display: none;">' + DataJson[i].Density + '</td>';
                    html += '<td id="SteelType" style="display: none;">' + DataJson[i].SteelType + '</td>';
                    html += '<td id="RepalceMl" style="display: none;">' + DataJson[i].RepalceMl + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("SteelCode", "150px", "250px", html, function (data) {
                    
                    $("#SteelId").val(data.SteelId);
                    $("#SteelCode").val(data.SteelCode);
                    $("#SteelDescription").val(data.SteelName);
                    Density = data.Density;
                    SteelType = data.SteelType;
                    $("#RepalceMl").val(data.RepalceMl);
                    $("#SteelType").val(data.SteelType);
                    ConversionkeyCode();
                    //ConversionForRemarkkeyCode()
                    //$("#AddThick").val("0");
                    //$("#AddWeigh").val("0");
                    //$("#AddLength").val("0");
                    //GetSteelStatus(data.SteelCode);
                });
            });
        }
        ////选择钢材，自动把钢材状态赋值
        //function GetSteelStatus(SteelCode) {
        //    AjaxJsonNoMassge("/CommonModule/SteelStatus/GetSteelStatusJson", { SteelCode: SteelCode }, function (data) {
        //        $("#SteelState").val(data.SteelStatus);
        //    });
        //}
    }
