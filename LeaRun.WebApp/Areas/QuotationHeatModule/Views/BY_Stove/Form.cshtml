    //客户编码自动补全
    function Autocomplete(objectname, id) {
        if (!objectname) {
            return;
        }
        var $CustomerCode = $("#" + objectname);
        $CustomerCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown(objectname, function (data) {
            $("[name='QuotationHeatCode']").val(data.QuotationHeatCode);
            $("#gridTable").jqGrid('setRowData', id, { QuotationHeatId: data.QuotationHeatId });
            $("#gridTable").jqGrid('setRowData', id, { CustomerName: data.CustomerName });
            $("#gridTable").jqGrid('setRowData', id, { SteelDescription: data.SteelDescription });
            $("#gridTable").jqGrid('setRowData', id, { ProductName: data.ProductName });
            $("#gridTable").jqGrid('setRowData', id, { Remark: data.Remark });
            $("#gridTable").jqGrid('setRowData', id, { Technology: data.Technology });
            $("#gridTable").jqGrid('setRowData', id, { TechnologQuery: data.TechnologQuery });
            $("#gridTable").jqGrid('setRowData', id, { Qty: data.Qty });
            $("#gridTable").jqGrid('setRowData', id, { Weight: data.Weight });
            return false;
        });
        //获取数据源
        function DataSource() {
            AjaxJson("/QuotationHeatModule/BY_QuotationHeat/GetAutoCompleJson", { QuotationHeatCode: $CustomerCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="QuotationHeatCode" >' + DataJson[i].QuotationHeatCode + '</td>';
                    html += '<td id="QuotationHeatId" style="display: none;">' + DataJson[i].QuotationHeatId + '</td>';
                    html += '<td id="CustomerName" style="display: none;">' + DataJson[i].CustomerName + '</td>';
                    html += '<td id="SteelDescription" style="display: none;">' + DataJson[i].SteelDescription + '</td>';
                    html += '<td id="ProductName" style="display: none;">' + DataJson[i].ProductName + '</td>';
                    html += '<td id="Remark" style="display: none;">' + DataJson[i].Remark + '</td>';
                    html += '<td id="Technology" style="display: none;">' + DataJson[i].Technology + '</td>';
                    html += '<td id="TechnologQuery" style="display: none;">' + DataJson[i].TechnologQuery + '</td>';
                    html += '<td id="Qty" style="display: none;">' + DataJson[i].Qty + '</td>';
                    html += '<td id="Weight" style="display: none;">' + DataJson[i].Weight + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete(objectname, "300px", "250px", html, function (data) {
                    $("[name='QuotationHeatCode']").val(data.QuotationHeatCode);
                    $("#gridTable").jqGrid('setRowData', id, { QuotationHeatId: data.QuotationHeatId });
                    $("#gridTable").jqGrid('setRowData', id, { CustomerName: data.CustomerName });
                    $("#gridTable").jqGrid('setRowData', id, { SteelDescription: data.SteelDescription });
                    $("#gridTable").jqGrid('setRowData', id, { ProductName: data.ProductName });
                    $("#gridTable").jqGrid('setRowData', id, { Remark: data.Remark });
                    $("#gridTable").jqGrid('setRowData', id, { Technology: data.Technology });
                    $("#gridTable").jqGrid('setRowData', id, { TechnologQuery: data.TechnologQuery });
                    $("#gridTable").jqGrid('setRowData', id, { Qty: data.Qty });
                    $("#gridTable").jqGrid('setRowData', id, { Weight: data.Weight });
                    return false;
                });
            });
        }
    }


        var lastsel;
    function GetGrid() {
        var lastselpostdate;
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/QuotationHeatModule/BY_StoveHeatList/GetListJson1")?StoveId=" + $("#StoveId").val(),
            datatype: "json",
            height: $(window).height() - 220,
            autowidth: true,
            colModel: [
                { label: '报价单明细ID', name: 'QuotationHeatId', hidden: true },
                { label: '序号', name: 'SortCode', width: 40, align: 'center', hidden: true },
                { label: '生产编号', name: 'QuotationHeatCode', index: 'QuotationHeatCode', width: 60, align: 'left', sortable: true },
                { label: '客户名称', name: 'CustomerName', index: 'CustomerName', width: 80, align: 'left', sortable: true },
                { label: '材质', name: 'SteelDescription', index: 'SteelDescription', width: 50, align: 'left', sortable: true },
                { label: '工件名称', name: 'ProductName', index: 'ProductName', width: 80, align: 'left', sortable: true },
                { label: '外形尺寸', name: 'Remark', index: 'Remark', width: 100, align: 'left', sortable: true },
                { label: '热处理类别', name: 'Technology', index: 'Technology', width: 60, align: 'left', sortable: true },
                { label: '技术要求', name: 'TechnologQuery', index: 'TechnologQuery', width: 60, align: 'left', sortable: true },
                { label: '实测硬度', name: 'TechnologQueryWrite', index: 'TechnologQueryWrite', width: 60, align: 'left', sortable: true, editable: true },
                { label: '状态', name: 'HeatStatus', index: 'HeatStatus', width: 60, align: 'left', sortable: true },
                { label: '件数', name: 'Qty', index: 'Qty', width: 40, align: 'left', sortable: true },
                { label: '重量', name: 'Weight', index: 'Weight', width: 40, align: 'left', sortable: true },
            ],
            viewrecords: true,
            rowNum: 999,
            rowList: [999, 999, 999, 999, 999],
            pager: false,
            shrinkToFit: false,
            rownumbers: true,
            altRows: false,
            sortname: 'QuotationHeatCode',
            sortorder: 'desc',
            altclass: 'altclass',
            gridview: true,
            cellsubmit: 'clientArray',
            onSelectRow: function (id) {
                var postData = {
                    QuotationHeatCode: $("[name='QuotationHeatCode']").val(),
                    TechnologQueryWrite: $("[name='TechnologQueryWrite']").val(),
                }
                if (id && id !== lastsel) {
                    $('#gridTable').jqGrid('restoreRow', lastsel);
                    $('#gridTable').jqGrid('editRow', id, { keys: false });
                    $('#gridTable').jqGrid('setRowData', lastsel, postData, '');
                }
                lastselpostdate = postData;
                lastsel = id;

                Autocomplete(id + "_QuotationHeatCode", id);

            },
            gridComplete: function () {
                //合计
            }

        });
        $("#lr-delete-Row").click(function () {
            var Index = GetJqGridRowIndx("#gridTable");
            $("#gridTable").jqGrid("delRowData", Index);
        });
    }
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/QuotationHeatModule/BY_Stove/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
            });
            updateMap(KeyValue);
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }

        var postData = {
            QuotationHeatCode: $("[name='QuotationHeatCode']").val(),
            TechnologQueryWrite: $("[name='TechnologQueryWrite']").val(),
        }
        $('#gridTable').jqGrid('setRowData', GetJqGridRowIndx('#gridTable'), postData, '');

        var postData = GetWebControls("#form2");
        postData["SteelListJson"] = JSON.stringify($("#gridTable").jqGrid("getRowData"));
        //postData["postData2"] = GetWebControls("#form2");

        AjaxJson("/QuotationHeatModule/BY_Stove/SubmitForm1?KeyValue=" + KeyValue + "&StoveCode=" + escape($("#StoveCode").val()) + "&StoveNum=" + escape($("#StoveNum").val()) + "&StartDateTime=" + escape($("#StartDateTime").val()) + "&StoveType=" + escape($("#StoveType").val()) + "&MethodBuilder=" + escape($("#MethodBuilder").val())
            + "&OperatorName=" + escape($("#OperatorName").val()) + "&OPname=" + escape($("#OPname").val()) + "&BuildMethod=" + escape($("#BuildMethod").val()) + "&Remark=" + escape($("#Remark").val()), postData, function (data) {
                tipDialog("保存成功！", 3, data.Code);
                if (data.Code == "1") {
                    $('#StoveId').val(data.Message);
                    $('#StoveCode').val(data.Attribute);
                    KeyValue = data.Message;
                    updateMap(KeyValue)
                    //jj
                    var chartTest = $('#container').highcharts();
                    var svgData = chartTest.getSVG();
                    $.post('/HighCharts/ManualExport', { filename: KeyValue, type: "image/jpeg", width: 1200, svg: svgData }, function (r) {
                    }, 'json');
                }
                else {
                    $('#StoveId').val("");
                    KeyValue = "";
                }
            top.frames[tabiframeId()].windowload();
        });
    }

    function Print() {
        if (!$('#StoveId').val()) {
            tipDialog("打印失败：请先保存！", 3, -1);
            return;
        }
        if ($('#StoveType').val() == "真空炉") {
            PrintDialog("/QuotationHeatModule/BY_Stove/PrintZK?StoveId=" + $('#StoveId').val(), "PrintPage", "打印", 1070, 600, function (iframe) {
                top.frames[iframe].AcceptClick();
                window.setTimeout(function () {closeDialog();}, 500);
            });
        }
        else {
            PrintDialog("/QuotationHeatModule/BY_Stove/PrintCG?StoveId=" + $('#StoveId').val(), "PrintPage", "打印", 1070, 600, function (iframe) {
                top.frames[iframe].AcceptClick();
                window.setTimeout(function () {closeDialog();}, 500);
            });
        }
    }


    function addforQuo(s) {

        var data = $("#gridTable").jqGrid("getRowData");




        var SortCode = 0;
        if (!!Number(GetJqGridValue("#gridTable", $("#gridTable").getGridParam("reccount"), "SortCode"))) {
            SortCode = Number(GetJqGridValue("#gridTable", $("#gridTable").getGridParam("reccount"), "SortCode")) + 1;
        }
        else {
            SortCode = 1;
        }
        var index = 0;
        if (!!$("#gridTable").getGridParam("reccount")) {
            index = $("#gridTable").getGridParam("reccount") + 1;
        }
        else {
            index = 1;
        }
        var entitys = s.split(';');
        var same = false;
        for (var i = 0; i < entitys.length; i++) {
            var items = entitys[i].split(',');
            //s1 = s1 + myrow.QuotationHeatId + "," + myrow.quotationheatcode + "," + myrow.customercode + "," + myrow.customername + "," + myrow.steeldescription + "," + myrow.productname + "," + myrow.remark
            //         + "," + myrow.technology + "," + myrow.technologquery + "," + myrow.qty + "," + myrow.weight + "," + myrow.billstatus + ";";

            for (var j = 0; j < data.length; j++) {
                if (data[j].QuotationHeatId == items[0]) {
                    same = true;
                }
            }


            if (same) {
                same = false;
                continue
            }

            var RowData = {
                SortCode: SortCode + i,
                QuotationHeatId: items[0],
                QuotationHeatCode: items[1],
                CustomerName: items[2],
                SteelDescription: items[3],
                ProductName: items[4],
                Remark: items[5],
                Technology: items[6],
                TechnologQuery: items[7],
                Qty: items[8],
                Weight: items[9],
            }
            $('#gridTable').jqGrid('addRowData', index, RowData, "last");
            index += 1;
        }

    }

