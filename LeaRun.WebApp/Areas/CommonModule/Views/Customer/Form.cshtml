            height: 250,
            width: 489,
            autowidth: true,
            colModel: [
                { label: '主键', name: 'CustomerRequeryID', hidden: true },
                { label: "部门", name: "DepartName", width: 80, editable: true },
                { label: "开料备注", name: "KLRequery", width: 300, align: 'left', editable: true, edittype: 'textarea', editoptions: { rows: "5" } },//收货地址:收货地址;
                { label: "铣磨备注", name: "XMRequery", width: 300, align: 'left', editable: true, edittype: 'textarea', editoptions: { rows: "5"} },

            ],
            pager: false,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            rownumbers: true,
            onSelectRow: function (id) {
                var postData = {
                    CustomerRequeryID: $("[name='CustomerRequeryID']").val(),
                    DepartName: $("[name='DepartName']").val(),
                    KLRequery: $("[name='KLRequery']").val(),
                    XMRequery: $("[name='XMRequery']").val(),
                }
                $('#gridTable2').jqGrid('restoreRow', lastsel2);
                $('#gridTable2').jqGrid('editRow', id, true);
                $('#gridTable2').jqGrid('setRowData', lastsel2, postData, '');
                lastselpostdate2 = postData;
                lastsel2 = id;
            }
        });
        //新增一行
        $("#lr-add-Row2").click(function () {
            var index = $("#gridTable2").getGridParam("reccount") + 1;
            var rowdata = {
                CustomerRequeryID: '',
                DepartName: '',
                KLRequery: '',
                XMRequery: '',
            }
            $('#gridTable2').jqGrid('restoreRow', index);
            $('#gridTable2').jqGrid('addRowData', index, rowdata, "last");
            $("#gridTable2").setSelection(index);

        });
        //删除
        $("#lr-delete-Row2").click(function () {
            var Index = GetJqGridRowIndx("#gridTable2");
            $("#gridTable2").jqGrid("delRowData", Index);
        });
    }


    function uploadify123() {

        if (!KeyValue) {
            alert("请先保存客户信息，之后再上传文件！");
            return;
        }

        try {
            if ($("#uploadify").length > 0) { //注意jquery下检查一个元素是否存在必须使用 .length >0 来判断
                $("#uploadify").uploadify('destroy');
            }
            $("#uploadify").uploadify({
                uploader: '/Utility/Upload?saveDocument=Customer&filenameid=' + KeyValue,
                swf: '/Content/Scripts/uploadify/uploadify.swf',
                buttonText: "上传",
                height: 24,
                width: 70,
                onFallback: function () {
                    alert("您未安装FLASH控件，无法上传！请安装FLASH控件后再试。");
                },
                onUploadSuccess: function (file, data, response) {
                    //var DataJson = JSON.parse(data);
                    //windowload();
                    //window.location.reload();
                    if (data == "-1" || !data) {
                        alert("请先保存客户信息，之后再上传文件！！");
                    }
                    else {
                        InitControl(KeyValue);

                    }

                }
            });
        } catch (e) {
        }
    }


</script>
