@{
    ViewBag.Title = "不合格品通知单";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        SteelAutocomplete();
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    //加载表格
    function GetGrid() {//StartTime, EndTime, BillCode, SteelCode, OrderCode, CustomerName
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/QualityModule/BY_FlawedNotice/GridPageListJson")?StartTime=" + $("#StartTime").val() + "&EndTime=" + $("#EndTime").val() + "&BillCode=" + escape($("#BillCode").val()) + "&SteelCode=" + escape($("#SteelCode").val()) + "&OrderCode=" + escape($("#OrderCode").val()) + "&CustomerName=" + escape($("#CustomerName").val()),
            datatype: "json",
            height: $(window).height() - 179,
            autowidth: true,
            colModel: [
                    { label: '不合格品通知单ID', name: 'flawednoticeid', index: 'flawednoticeid', width: 0, align: 'left', sortable: true, hidden: true },
                    { label: '不合格品单号', name: 'billcode', index: 'billcode', width: 90, align: 'left', sortable: true },
                    { label: '订单号', name: 'orderbarcode', index: 'orderbarcode', width: 90, align: 'left', sortable: true },
                    { label: '客户编号', name: 'customercode', index: 'customercode', width: 80, align: 'left', sortable: true },
                    { label: '客户简称', name: 'customername', index: 'customername', width: 100, align: 'left', sortable: true },
                    { label: '厚度', name: 'thick', index: 'thick', width: 50, align: 'left', sortable: true },
                    { label: '宽度', name: 'weigh', index: 'weigh', width: 50, align: 'left', sortable: true },
                    { label: '长度', name: 'length', index: 'length', width: 50, align: 'left', sortable: true },
                    { label: '钢种', name: 'steelcode', index: 'steelcode', width: 50, align: 'left', sortable: true },
                    { label: '件数', name: 'qty', index: 'qty', width: 50, align: 'left', sortable: true },
                    { label: '金额', name: 'salesamount', index: 'salesamount', width: 50, align: 'left', sortable: true },
                    { label: '罚款', name: 'fmoney', index: 'fmoney', width: 50, align: 'left', sortable: true },
                    { label: '重量', name: 'weight', index: 'weight', width: 50, align: 'left', sortable: true },
                    {
                        label: '开单日期', name: 'writedate', index: 'writedate', width: 65, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    { label: '开单人姓名', name: 'writeusername', index: 'writeusername', width: 60, align: 'left', sortable: true },
                    { label: '超差工序', name: 'errorprocess', index: 'errorprocess', width: 50, align: 'left', sortable: true },
                    { label: '主管姓名', name: 'directorname', index: 'directorname', width: 50, align: 'left', sortable: true },
                    {
                        label: '是否联客', name: 'isrelationcust', index: 'isrelationcust', width: 50, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return cellvalue == "1" ? "是" : "否";
                        }
                    },
                    { label: '责任人姓名', name: 'dutyusername', index: 'dutyusername', width: 60, align: 'left', sortable: true },
                    { label: '不合格品情况', name: 'situationcode', index: 'situationcode', width: 100, align: 'left', sortable: true },
                    { label: '不合格品原因', name: 'reasoncode', index: 'reasoncode', width: 100, align: 'left', sortable: true },
                    { label: '处理结果', name: 'dealresultcode', index: 'dealresultcode', width: 50, align: 'left', sortable: true },
                    {
                        label: '处理意见', name: 'remark', index: 'remark', width: 100, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");

                            }
                            return "";
                        }
                    }
            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'writedate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            footerrow: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                btn_edit();
            },
            gridComplete: function () {
                //合计
                $(this).footerData("set", {
                    "mnemoniccode": "合计",
                    "qty": FormatCurrency($("#gridTable").getCol('qty', false, 'sum')),
                    "salesamount": FormatCurrency($("#gridTable").getCol('salesamount', false, 'sum')),
                    "fmoney": FormatCurrency($("#gridTable").getCol('fmoney', false, 'sum')),
                    "weight": FormatCurrency($("#gridTable").getCol('weight', false, 'sum')),
                });
            },
        });
    }
    //编辑
    function btn_edit() {
        var KeyValue = GetJqGridRowValue("#gridTable", "flawednoticeid");
        if (IsChecked(KeyValue)) {
            var url = "/QualityModule/BY_FlawedNotice/FlawedNoticeInput?KeyValue=" + KeyValue;
            Dialog(url, "FlawedNoticeInput", "不合格品通知单编辑", 1000, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }

    //新增
    function btn_add() {
        var url = "/QualityModule/BY_FlawedNotice/FlawedNoticeInput";
        Dialog(url, "FlawedNoticeInput", "不合格品通知单新增", 1000, 500, function (iframe) {
            top.frames[iframe].AcceptClick();
        });
    }


    //删除
    function btn_delete() {
        var KeyValue = GetJqGridRowValue("#gridTable", "flawednoticeid");
        if (IsDelData(KeyValue)) {
            delConfig('/QualityModule/BY_FlawedNotice/Delete1?KeyValue=' + KeyValue);
        }
    }
    //明细
    function btn_detail() {
        var KeyValue = GetJqGridRowValue("#gridTable", "flawednoticeid");
        if (IsChecked(KeyValue)) {
            var url = "/QualityModule/BY_FlawedNotice/Detail?KeyValue=" + KeyValue;
            Dialog(url, "Detail", "不合格品通知单明细", 820, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入

    }
    //查询
    function btn_Search() {
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/QualityModule/BY_FlawedNotice/GridPageListJson")?StartTime=" + $("#StartTime").val() + "&EndTime=" + $("#EndTime").val() + "&BillCode=" + escape($("#BillCode").val()) + "&SteelCode=" + escape($("#SteelCode").val()) + "&OrderCode=" + escape($("#OrderCode").val()) + "&CustomerName=" + escape($("#CustomerName").val()), page: 1 }).trigger('reloadGrid');
    }
    //导出
    function btn_Export() {
        SetDeriveExcel("#gridTable", "不合格品单信息");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }
    //钢材编码自动补全
    function SteelAutocomplete() {
        var $SteelCode = $("#SteelCode");
        $SteelCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("SteelCode", function (data) {
            $("#SteelCode").val(data.SteelCode);
        });
        //获取数据源
        function DataSource() {
            AjaxJson("/CommonModule/Steel/GetAutoCompleJson", { keywords: $SteelCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="SteelId" style="display: none;">' + DataJson[i].SteelId + '</td>';
                    html += '<td id="SteelCode" style="width: 100%;">' + DataJson[i].SteelCode + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("SteelCode", $SteelCode.width() + "px", "200px", html, function (data) {
                    $("#SteelCode").val(data.SteelCode);
                });
            });
        }
    }

    function btn_Print() {
        var KeyValue = GetJqGridRowValue("#gridTable", "flawednoticeid");
        PrintDialog("/QualityModule/BY_FlawedNotice/Print?flawednoticeid=" + KeyValue, "cdscsd", "品质处罚单", 850, 500, function (iframe) {
            top.frames[iframe].AcceptClick();
        });
    }
    function btn_Print2() {
        var KeyValue = GetJqGridRowValue("#gridTable", "flawednoticeid");
        PrintDialog("/QualityModule/BY_FlawedNotice/Print2?flawednoticeid=" + KeyValue, "cdscsd", "品质返修单", 850, 500, function (iframe) {
            top.frames[iframe].AcceptClick();
        });
    }
</script>
<!--工具栏-->
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>开单日期：</th>
            <td>
                <input id="StartTime" type="text" class="txt Wdate"  style="width: 80px" onfocus="var endDate=$dp.$('EndTime');WdatePicker({onpicked:function(){EndTime.focus();},maxDate:'#F{$dp.$D(\'EndTime\')}'})" />
            </td>
            <td>-</td>
            <td>
                <input id="EndTime" type="text" class="txt Wdate"  style="width: 80px" onfocus="WdatePicker({minDate:'#F{$dp.$D(\'StartTime\')}'})" />
            </td>
            <th>不合格品单号：</th>
            <td>
                <input id="BillCode" maxlength="50" type="text" class="txt" style="width:80px;" />
            </td>
            <th>钢种：</th>
            <td>
                <input id="SteelCode" maxlength="50" type="text" class="txt" style="width:80px;" />
            </td>
            <th>加工单号：</th>
            <td>
                <input id="OrderCode" maxlength="50" type="text" class="txt" style="width:80px;" />
            </td>
            <th>客户名称：</th>
            <td>
                <input id="CustomerName" maxlength="50" type="text" class="txt" style="width:80px;" />
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
            </td>
            <td>
                <input id="btnExport" type="button" class="btnSearch" value="导 出" onclick="btn_Export()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
