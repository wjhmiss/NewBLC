                { label: '客户品名', name: 'ProductName', index: 'ProductName', width: 100 },
                 { label: '条件', name: 'WhereQ', hidden: true },
                { label: '条件', name: 'WhereQty', hidden: true },
                {
                    label: '条件', name: '', index: '', width: 100, hidden: true,
                    formatter: function (cellvalue, options, rowObject) {
                        var str = rowObject.WhereQ;
                        str += rowObject.WhereQty;
                        return str;
                    }
                },
                { label: '材料费', name: 'Price', index: 'Price', width: 60, align: 'center' },
                { label: '单位', name: 'Unit', index: 'Unit', width: 60, align: 'center' },
                {
                    label: '计算与或', name: 'OrOr', index: 'OrOr', width: 60, align: 'center',
                    formatter: function (cellvalue, options, rowObject) {
                        var str = "";
                        if (!cellvalue) {
                            str = "与";
                        }
                        else {
                            str = "或";
