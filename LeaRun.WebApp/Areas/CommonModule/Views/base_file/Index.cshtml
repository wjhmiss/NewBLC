@{
    ViewBag.Title = "base_file";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        GetGrid();
    })
    //加载表格
    function GetGrid() {
        $("#gridTable").jqGrid({
        url: "@Url.Content("~/CommonModule/base_file/GridPageJson")",
        datatype: "json",
        height: $(window).height() - 149,
        autowidth: true,
        colModel: [
                { label: 'Id', name: 'Id', index: 'Id', width: 0, align: 'left',sortable: true  },
                { label: 'Name', name: 'Name', index: 'Name', width: 0, align: 'left',sortable: true  },
                { label: 'Size', name: 'Size', index: 'Size', width: 0, align: 'left',sortable: true  },
                { label: 'Type', name: 'Type', index: 'Type', width: 0, align: 'left',sortable: true  },
                { label: 'Eextension', name: 'Eextension', index: 'Eextension', width: 0, align: 'left',sortable: true  },
                { label: 'CreateDate', name: 'CreateDate', index: 'CreateDate', width: 0, align: 'left',sortable: true  },
                { label: 'ModifyDate', name: 'ModifyDate', index: 'ModifyDate', width: 0, align: 'left',sortable: true  },
                { label: 'Path', name: 'Path', index: 'Path', width: 0, align: 'left',sortable: true  },
                { label: 'Status', name: 'Status', index: 'Status', width: 0, align: 'left',sortable: true  },
                { label: 'AttachId', name: 'AttachId', index: 'AttachId', width: 0, align: 'left',sortable: true  },
        ],
        viewrecords: true,
        rowNum: 30,
        rowList: [30, 50, 100, 500, 1000],
        pager: "#gridPager",
        sortname: 'CreateDate',
        sortorder: 'desc',
        rownumbers: true,
        shrinkToFit: false,
        gridview: true,
    });
}
    //新增
    function btn_add() {
        var url = "/CommonModule/base_file/Form"
        openDialog(url, "Form", "新增base_file", 770, 395, function (iframe) {
            top.frames[iframe].AcceptClick()
        });
    }
    //编辑
    function btn_edit() {
        var KeyValue = GetJqGridRowValue("#gridTable", "Id");
        if (IsChecked(KeyValue)) {
            var url = "/CommonModule/base_file/Form?KeyValue=" + KeyValue;
            openDialog(url, "Form", "编辑base_file", 770, 395, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //删除
    function btn_delete() {
        var KeyValue = GetJqGridRowValue("#gridTable", "Id");
        if (IsDelData(KeyValue)) {
            var delparm = 'KeyValue=' + KeyValue;
            delConfig('/CommonModule/base_file/Delete', delparm, KeyValue.split(",").length);
        }
    }
    //明细
    function btn_detail() {
        var KeyValue = GetJqGridRowValue("#gridTable", "Id");
        if (IsChecked(KeyValue)) {
            var url = "/CommonModule/base_file/Detail?KeyValue=" + KeyValue;
            Dialog(url, "Detail", "base_file明细", 820, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入
        
    }
</script>
<!--工具栏-->
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>关键字：</th>
            <td>
                <input id="keywords" type="text" class="txt" style="width: 200px" />
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
