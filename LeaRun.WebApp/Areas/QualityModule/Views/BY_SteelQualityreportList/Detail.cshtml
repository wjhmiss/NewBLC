@{
    ViewBag.Title = "BY_SteelQualityreportList》明细页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/QualityModule/BY_SteelQualityreportList/SetForm", { KeyValue: GetQuery('KeyValue') }, function (data) {
                SetWebControls(data);
            });
        }
    }
</script>
<form id="form1" style="margin: 1px">
    <table class="form">
        <tr>
            <th class='formTitle'>BY_SteelQualityreportListId：</th>
            <td class='formValue'>
                <label id="BY_SteelQualityreportListId" />
            </td>
            <th class='formTitle'>OrderDetailId：</th>
            <td class='formValue'>
                <label id="OrderDetailId" />
            </td>
            <th class='formTitle'>厚度：</th>
            <td class='formValue'>
                <label id="Thick" />
            </td>
            <th class='formTitle'>宽：</th>
            <td class='formValue'>
                <label id="Weigh" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>长：</th>
            <td class='formValue'>
                <label id="Length" />
            </td>
            <th class='formTitle'>数量：</th>
            <td class='formValue'>
                <label id="Qty" />
            </td>
            <th class='formTitle'>理论重量：</th>
            <td class='formValue'>
                <label id="Weight" />
            </td>
            <th class='formTitle'>客户货品号：</th>
            <td class='formValue'>
                <label id="CustomerProduct" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>执行备注信息：</th>
            <td class='formValue'>
                <label id="ExecRemark" />
            </td>
            <th class='formTitle'>有效：</th>
            <td class='formValue'>
                <label id="Enabled" />
            </td>
            <th class='formTitle'>排序码：</th>
            <td class='formValue'>
                <label id="SortCode" />
            </td>
            <th class='formTitle'>删除标记：</th>
            <td class='formValue'>
                <label id="DeleteMark" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>创建时间：</th>
            <td class='formValue'>
                <label id="CreateDate" />
            </td>
            <th class='formTitle'>创建用户主键：</th>
            <td class='formValue'>
                <label id="CreateUserId" />
            </td>
            <th class='formTitle'>创建用户：</th>
            <td class='formValue'>
                <label id="CreateUserName" />
            </td>
            <th class='formTitle'>修改时间：</th>
            <td class='formValue'>
                <label id="ModifyDate" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>修改用户主键：</th>
            <td class='formValue'>
                <label id="ModifyUserId" />
            </td>
            <th class='formTitle'>修改用户：</th>
            <td class='formValue'>
                <label id="ModifyUserName" />
            </td>
        </tr>
    </table>
</form>
