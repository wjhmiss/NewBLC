    function AcceptClick2(num, obj) {
        if (!!KeyValue) {
            if (($("#SteelCode").val() == "FY" ) && DKorQG) {

            }
            else if (!($("#SteelCode").val() == "FY" ) && !DKorQG) {

            }
            else {
                tipCss("#SteelCode", "此条明细钢材不能选择吊孔或气割！");
                return false;
            }
        }
        $("#Weigh").val(0);
        $("#AddWeigh").val(0);

        if (!CheckDataValid('#form1')) {
            return false;
        }
        var postData = GetWebControls("#form1");
        if (postData.Qty <= 0) {
            tipCss("#Qty", "数量必须大于0");
            return false;
        }
        if (postData.Thick <= 0 && $("#SteelCode").val() != "FY" && CustMaterial != "1") {
            tipCss("#Thick", "厚度必须大于0");
            return false;
        }
        //if (postData.Weigh <= 0) {
        //    tipCss("#Weigh", "宽度必须大于0");
        //    return false;
        //}
        if (postData.Length <= 0 && $("#SteelCode").val() != "FY" && CustMaterial != "1") {
            tipCss("#Length", "长度必须大于0");
            return false;
        }
        AjaxJsonNoMassge("/QuotationModule/QuotationInput/SubmitDetailForm?KeyValue=" + KeyValue + "&ShipDescription=" + $("#ShipDescription").val() + "&CustomerProduct=" + $("#CustomerProduct").val(), postData, function (data) {
            if (data.Code < 0) {
                //tipDialog(data.Message, 2, data.Code);
                tipCss("#Remark", data.Message);
                return false;
            }


            top.frames[tabiframeId()].windowload();
            $("#LineCode").val(Number($("#LineCode").val()) + Number(num));
            AjaxJsonNoMassge("/QuotationModule/QuotationInput/SetDetailFormByLine", { QuotationId: $("#QuotationId").val(), LineCode: Number($("#LineCode").val()) }, function (data) {
                if (!data.Qty) {
                    window.setTimeout(function () {closeDialog();}, 500);
                    return false;
                }
                SetWebControls(data);
                if ($("#SteelCode").val() == "FY" ) {
                    DKorQG = true;
                }
                else {
                    DKorQG = false;
                }
                KeyValue = data.QuotationDetailId;

                if (!!KeyValue && !!obj) {
                    //编辑
                    //$("#SteelCode").select();
                    obj.select();
                }
                else {
                    $("#Thick").select();
                }
            });
        });
    }
    function UP() {
        AcceptClick2(-1)
    }
    function Next() {
        AcceptClick2(1)
    }
