@{
    ViewBag.Title = "折扣设置";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script>
    var KeyValue = GetQuery('KeyValue');//主键
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    var postData;
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/CommonModule/Customer/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
                $("#DiscountRateStartTime").val(formatDate(data.DiscountRateStartTime, 'yyyy-MM-dd'));
                $("#DiscountRateEndTime").val(formatDate(data.DiscountRateEndTime, 'yyyy-MM-dd'));
                postData = data;
            });
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        postData.DiscountRate = $("#DiscountRate").val();
        postData.DiscountRateStartTime = $("#DiscountRateStartTime").val();
        postData.DiscountRateEndTime = $("#DiscountRateEndTime").val();
        $(".ui_state_highlight").attr("disabled", true);
        AjaxJson("/CommonModule/Customer/SubmitForm?KeyValue=" + KeyValue, postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].$("#gridTable").trigger("reloadGrid");
            window.setTimeout(function () {closeDialog();}, 500);
        });
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class='formTitle'>客户编号：</th>
            <td class='formValue'>
                <input id="Code" readonly type="text" class="txt readonly" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>客户名称：</th>
            <td class='formValue'>
                <input id="FullName" readonly type="text" class="txt readonly" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>客户简称：</th>
            <td class='formValue'>
                <input id="ShortName" readonly type="text" class="txt readonly" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>总折扣率：</th>
            <td class='formValue'>
                <input id="DiscountRate" maxlength="18" onfocus="IsMoney(this.id);" type="text" class="txt" datacol="yes" err="总折扣率" checkexpession="NotNull" style="width: 90%; border-right: 1px solid #ccc;" />
                <span style="color: red; font-weight: bold;">%</span>
            </td>
        </tr>
        <tr>
            <th class='formTitle'>有效时间 从：</th>
            <td class='formValue'>
                <input id="DiscountRateStartTime" type="text" class="txt Wdate" onfocus="var endDate=$dp.$('endDate');WdatePicker({onpicked:function(){DiscountRateEndTime.focus();},maxDate:'#F{$dp.$D(\'DiscountRateEndTime\')}'})" datacol="yes" err="有效时间 从" checkexpession="NotNull" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>有效时间 至：</th>
            <td class='formValue'>
                <input id="DiscountRateEndTime" type="text" class="txt Wdate" onfocus="WdatePicker({minDate:'#F{$dp.$D(\'DiscountRateStartTime\')}'})" datacol="yes" err="有效时间 至" checkexpession="NotNull" />
            </td>
        </tr>
    </table>
</form>
