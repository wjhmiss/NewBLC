<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>精料单打印预览</title>
    @* <link href="~/Content/Styles/learunui-framework.css" rel="stylesheet" />
    <script src="~/Content/Scripts/jquery/jquery-1.8.2.min.js"></script>
    <script src="~/Content/Scripts/learunui-framework.js"></script>
    <script src="~/Content/Scripts/lodop/LodopFuncs.js"></script>*@
    @Scripts.Render("~/Content/Scripts/frameworkjquery")
    <script src='http://127.0.0.1:8000/CLodopfuncs.js'></script>
     <style>

    .form-print th {
        font-size: 11pt;
        font-family: Arial;
        height: 20.6px;
        line-height:20.6px;
        white-space: nowrap;
        
        text-align: right;
        padding-right: 2px;
    }

    .form-print td {
        font-size: 11pt;
        font-family: Arial;
        
        height: 20.6px;
        line-height:20.6px;
        padding-right: 2px;
       
    }
</style>
    <script>
        var YH = GetQuery('YH');
        var JKCost = 0;
        var SmallCost = 0;
        var WorkPrice = 0;
        var DDCostPer = 0;
        var rownum = 20
        //初始化
        $(function () {
            AjaxJson("/QuotationHeatModule/BY_QuotationHeat/BCPrintDataJson", { QuotationHeatIds: GetQuery('QuotationHeatIds'), rownum: rownum }, function (data) {
                var QuotationDetail = data.QuotationDetail;
                var Customer = data.Customer;

                if (!!Customer.LeaderTele) {
                    $("#LeaderTele").text(Customer.LeaderTele.replace("&nbsp;", ""));
                }
                if (!!Customer.CheckFaxs) {
                    $("#CheckFaxs").text(Customer.CheckFaxs.replace("&nbsp;", ""));
                }
                if (!!Customer.Leader) {
                    $("#Leader").text(Customer.Leader.replace("&nbsp;", ""));
                }
                if (!!Customer.BankName) {
                    $("#BankName").text(Customer.BankName.replace("&nbsp;", ""));
                }
                if (!!Customer.TaxNumber) {
                    $("#TaxNumber").text(Customer.TaxNumber.replace("&nbsp;", ""));
                }
                if (!!Customer.Account) {
                    $("#Account").text(Customer.Account.replace("&nbsp;", ""));
                }
                if (!!data.QtySum) {
                    $("#QtySum").text(data.QtySum.toFixed(0));
                }
                if (!!data.WeightSum) {
                    $("#WeightSum").text(FormatCurrency(data.WeightSum));
                }

                if (!!Customer.PaymentMode) {
                    $("#PaymentMode").text(Customer.PaymentMode.replace("&nbsp;", ""));
                }
                if (!!Customer.ShipMode) {
                    $("#ShipMode").text(Customer.ShipMode.replace("&nbsp;", ""));
                }
                
                if (!!Customer.FullName) {
                    $("#CustomerName").text(Customer.FullName.replace("&nbsp;", ""));
                }
            

                var PriceSum = 0;
                var tempAddLength = 0;
                var tempAddWeigh = 0;

                $.each(QuotationDetail, function (i) {
                    if (!!QuotationDetail[i].QuotationHeatCode && QuotationDetail[i].QuotationHeatCode != "9999999" && QuotationDetail[i].QuotationHeatCode != "999999") {
                        $("#QuotationCode").text("NO：" + QuotationDetail[i].QuotationHeatCode);
                    }

                    var QuotationDetailhtml = "";

                    if (QuotationDetail[i].QuotationHeatCode == "9999999") {
                        QuotationDetailhtml += '<tr>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ; " colspan="4">合计</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].Qty + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].Weight + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;" ></td>';
                        QuotationDetailhtml += '     <td name="WorkPrice" style="border: 1px solid #000;text-align:center ;"></td>';
                        QuotationDetailhtml += '     <td name="WorkPrice" style="border: 1px solid #000;text-align:center ;"></td>';
                        QuotationDetailhtml += '     <td name="SmallCost" style="border: 1px solid #000;text-align:center ;"></td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].SalesAmount + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;" colspan="2"></td>';
                        QuotationDetailhtml += '</tr>';
                    }
                    else {
                        if (QuotationDetail[i].QuotationHeatCode=="999999") {
                            QuotationDetail[i].LineCode = "";
                            size = "";
                            sizeall = "";
                            QuotationDetail[i].MaterialPrice = "";
                            QuotationDetail[i].WorkPrice = "";
                            QuotationDetail[i].SmallCost = "";
                            QuotationDetail[i].JKCost = "";
                            QuotationDetail[i].DDCostPer = "";
                            QuotationDetail[i].Qty = "";
                            QuotationDetail[i].Weight = "";
                            QuotationDetail[i].SalesAmount = "";
                            QuotationDetail[i].WorkAmount = "";
                            QuotationDetail[i].QuotationHeatCode = "";
                            QuotationDetail[i].HeatPrice = "";
                        }

                        QuotationDetailhtml += '<tr>';
                        QuotationDetailhtml += '    <td style="border: 1px solid #000000; text-align: center;">' + QuotationDetail[i].QuotationHeatCode + '</td>';
                        QuotationDetailhtml += '    <td style="border: 1px solid #000000; text-align: center;">' + QuotationDetail[i].SteelCode + '</td>';
                        QuotationDetailhtml += '    <td style="border: 1px solid #000000; text-align: center;">' + ReturnEmpty(QuotationDetail[i].ProductName) + '</td>';
                        QuotationDetailhtml += '    <td style="border: 1px solid #000000; text-align: center;">' + QuotationDetail[i].Technology + '</td>';
                        QuotationDetailhtml += '    <td style="border: 1px solid #000000; text-align: center;">' + QuotationDetail[i].Qty + '</td>';
                        QuotationDetailhtml += '    <td style="border: 1px solid #000000; text-align: center;">' + QuotationDetail[i].Weight + '</td>';
                        QuotationDetailhtml += '    <td name="WorkPrice" style="border: 1px solid #000; text-align: center;">' + QuotationDetail[i].WorkPrice + '</td>';
                        QuotationDetailhtml += '    <td style="border: 1px solid #000000; text-align: center;">' + QuotationDetail[i].HeatPrice + '</td>';
                        QuotationDetailhtml += '    <td style="border: 1px solid #000000; text-align: center;">' + QuotationDetail[i].SalesAmount + '</td>';
                        QuotationDetailhtml += '    <td style="border: 1px solid #000000; text-align: left;">' + QuotationDetail[i].Remark + '</td>';
                        QuotationDetailhtml += '</tr>';

                    }



                    $("#tb_QuotationDetail").append(QuotationDetailhtml);
                    PriceSum += Number(QuotationDetail[i].SalesAmount);
                    if (QuotationDetail[i].DDCostPer > 0) {
                        DDCostPer = 1;
                    }
                    if (QuotationDetail[i].WorkPrice > 0) {
                        WorkPrice = 1;
                    }
                    if (QuotationDetail[i].SmallCost > 0) {
                        SmallCost = 1;
                    }
                    if (QuotationDetail[i].JKCost > 0) {
                        JKCost = 1;
                    }
                });
                $("#PriceSum").text(FormatCurrency(PriceSum));
                if (JKCost == 0) {
                    $("td[name='JKCost']").hide();
                    $("th[name='JKCost']").hide();
                }
                if (SmallCost == 0) {
                    $("td[name='SmallCost']").hide();
                    $("th[name='SmallCost']").hide();
                }
                if (WorkPrice == 0) {
                    $("td[name='WorkPrice']").hide();
                    $("th[name='WorkPrice']").hide();
                }
                if (DDCostPer == 0) {
                    $("td[name='DDCostPer']").hide();
                    $("th[name='DDCostPer']").hide();
                }
            });
        })
        //确认打印
        function AcceptClick() {
            //AjaxJson("/QuotationModule/QuotationPrint/StateModify", { KeyValue: GetQuery('QuotationId') }, function (data) {
            
            MyPreview();

            //});
        }
    </script>
</head>
<body style="overflow-x: hidden;">
    <div id="my_area" style="width: 95%; height: 95%; margin-left: 25px; margin-top: 30px;">
        <div style="float: left; position: absolute;">
            @*<img id="logo1" style="width: 60px;padding: 5px; padding-left:20px;" src="@Url.Content("~/Content/Images/111.jpg")" />*@
        </div>
        <table id="tb_Order" border="0" class="form-print" style="width: 100%;">
            <tr>
                <td colspan="4" align="center" style="padding: 2px;"><span style="font-size: 30px; font-weight: bold;">北仑机械锻造厂</span></td>
            </tr>
            <tr>
                <td colspan="4" align="center">DONGGUAN Xinze Steel Co.,Ltd.</td>
            </tr>
            <tr>
                <td colspan="4" align="center">地址：宁波市北仑区大矸龙潭山三路15号&nbsp;&nbsp;&nbsp;&nbsp;电话：18892600521&nbsp;&nbsp;&nbsp;&nbsp;邮箱：124176905@qq.com</td>
            </tr>
            
            <tr>
                <td colspan="4" align="center" style="padding: 2px;border-top: 2px solid #000;"><span style="font-size: 26px; font-weight: bold;">热处理合同(<label id="QuotationCode"></label>)</span></td>
            </tr>
          
            <tr>
                <th style="width: 10%">客&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;户：</th>
                <td style="width: 40%">
                    <label style="font-size: 11pt;font-family: Arial;" id="CustomerName"></label>
                </td>
                <th style="width: 10%">供&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;方：</th>
                <td >北仑机械锻造厂
                </td>
            </tr>
            <tr>
                <th >地&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;址：</th>
                <td>
                    <label style="font-size: 11pt;font-family: Arial;" id="CustomerAddress"></label>
                </td>
                <th>地&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;址：</th>
                <td>宁波市北仑区大矸龙潭山三路15号</td>
            </tr>
            <tr>
                <th >联&nbsp;系&nbsp;人：</th>
                <td>
                    <label style="font-size: 11pt;font-family: Arial;" id="Leader"></label>
                </td>
                <th>联&nbsp;系&nbsp;人：</th>
                <td>@DNS.Utilities.ManageProvider.Provider.Current().UserName</td>
            </tr>
            <tr>
                <th >电&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;话：</th>
                <td>
                    <label style="font-size: 11pt;font-family: Arial;" id="LeaderTele"></label>
                </td>
                <th>电&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;话：</th>
                <td>18892600521</td>
            </tr>
            <tr>
                <th>传&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;真：</th>
                <td>
                    <label style="font-size: 11pt;font-family: Arial;" id="CheckFaxs"></label>
                </td>
                <th>日&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;期：</th>
                <td>@DNS.Utilities.DateTimeHelper.GetDate(0)</td>
            </tr>
            <tr>
                <td colspan="4" valign="top">
                    <div>
                        <table id="tb_QuotationDetail" border="0" class="form-print" style="width: 100%; border-collapse: collapse">
                              <tr>
                                <th style="border: 1px solid #000000;  text-align: left;text-align: center;" >生产编号</th>
                                <th style="border: 1px solid #000000;  text-align: left;text-align: center;" >材料名称</th>
                                <th style="border: 1px solid #000000;  text-align: left;text-align: center;" >工件名称</th>
                                <th style="border: 1px solid #000000;  text-align: left;text-align: center;" >热处理项目</th>
                                <th style="border: 1px solid #000000;  text-align: left;text-align: center;" >件数</th>
                                <th style="border: 1px solid #000000;  text-align: left;text-align: center;" >重量</th>
                                <th  name="WorkPrice" style="border: 1px solid #000000;  text-align: left;text-align: center;" >单价(件)</th>
                                <th style="border: 1px solid #000000;  text-align: left;text-align: center;" >单价</th>
                                <th style="border: 1px solid #000000;  text-align: left;text-align: center;" >价税合计</th>
                                <th style="border: 1px solid #000000;  text-align: left;text-align: center;" >备注</th>
                            </tr>
                        </table>
                    </div>
                </td>
            </tr>

            <tr>
                <td colspan="4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;一、硬度、尺寸、表面等质量问题，请在收货后三天内提出。</td>
            </tr>
            <tr>
                <td colspan="4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;二、经双方检验确属我方造成的质量问题，我方最终所负责任不超过同等材料款额的责任。</td>
            </tr>
            <tr>
                <td colspan="4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;三、因材料成份不符或不达标准，所有质量问题客户自负。</td>
            </tr>
            <tr>
                <td colspan="4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;四、结算方式及期限：<label style="font-size: 11pt;font-family: Arial;" id="PaymentMode"></label>，超过约定付款时间，按每天万分之八承担违约金；</td>
            </tr>
            <tr>
                <td colspan="4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;五、工件小于1公斤，按1公斤计算，不能称重的小件，按件数收费。
                     <img id="logo"  style="z-index: -1; position: absolute;right:5px; width: 4cm;" src="@Url.Content("~/Content/Images/123.png")" />

                </td>
            </tr>
           
            <tr>
                <td colspan="4">
                    <table border="0"  style="width: 100%; border-collapse: collapse;background-color:none;">
                        <tr>
                            <th style="width:40%;text-align:center;height:28px;line-height:28px;border-bottom:2px solid #000;" >客户确认及接收：</th>
                            <th style="width:20%;text-align:center;height:28px;line-height:28px;" ></th>
                            <th style="width:40%;text-align:center;height:28px;line-height:28px;border-bottom:2px solid #000;" >本公司确认：</th>
                        </tr>
                        <tr>
                            <th style="width:40%;text-align:center;height:28px;line-height:28px;">客户签名及盖章：</th>
                            <th style="width:20%;text-align:center;height:28px;line-height:28px;" ></th>
                            <th style="width:40%;text-align:center;height:28px;line-height:28px;">北仑钢材：</th>
                        </tr>
                    </table>
                </td>
            </tr>

            <tr>
                <td colspan="4">
                    <br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;备注：请签名、签章后回传至 18892600521</td>
            </tr>
        </table>
    </div>
</body>
<script language="javascript" type="text/javascript">
