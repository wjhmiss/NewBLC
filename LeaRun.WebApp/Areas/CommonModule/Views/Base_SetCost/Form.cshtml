        <tr>
            <th class='formTitle'>超长：</th>
            <td class='formValue'>
                <input id="GreatLong" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" />
            </td>

            <th class='formTitle'>超宽：</th>
            <td class='formValue'>
                <input id="GreatWeigh" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" />
            </td>
            <th class='formTitle'>超长宽后价格：</th>
            <td class='formValue' colspan="3">
                <input id="GreatPrice" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" />
            </td>
        </tr>
        <tr>
            <th class='formTitle' rowspan="5">面积计算：</th>
            <td class='formValue' colspan="7">
                <span class="item" style="cursor: pointer;">
                    <input type="radio" name="SetAreaType" value="0" id="Print0"  />
                    <label for="Print0">光板
                        如果厚<60,则面积(长*宽*2)。
                                        如果60<=厚<80，则面积(长*宽+长*厚)*2。
                                        如果厚>=80，则面积(长*宽+长*厚+宽*厚)*2。精料(长*宽+长*厚+宽*厚)*2</label></span>
            </td>
        </tr>
        <tr>
            <td class='formValue' colspan="7">
                <span class="item" style="cursor: pointer;">
                    <input type="radio" name="SetAreaType" value="1" id="Print1"  />
                    <label for="Print1">统一精料光板
                        如果厚<60,则面积(长*宽*2)。
                                        如果60<=厚<80，则面积(长*宽+长*厚)*2。
                                        如果厚>=80，则面积(长*宽+长*厚+宽*厚)*2。</label></span>
            </td>
        </tr>
        <tr>
            <td class='formValue' colspan="7">
                <span class="item" style="cursor: pointer;">
                    <input type="radio" name="SetAreaType" value="2" id="Print2" />
                    <label for="Print2">统一精料光板(长*宽*2)</label></span>
            </td>
        </tr>
        <tr>
            <td class='formValue' colspan="7">
                <span class="item" style="cursor: pointer;">
                    <input type="radio" name="SetAreaType" value="3" id="Print3"  />
                    <label for="Print3">统一精料光板(长*宽+长*厚+宽*厚)*2</label></span>
            </td>
        </tr>
        <tr>
            <td class='formValue' colspan="7">
                <span class="item" style="cursor: pointer;">
                    <input type="radio" name="SetAreaType" value="4" id="Print4"  />
                    <label for="Print4">统一精料(长*宽+长*厚+宽*厚)*2，光板(长*宽*2)</label></span>
            </td>

        </tr>
        <tr>
            <th class='formTitle'>备注：</th>
            <td class='formValue' colspan="7">
                <textarea id="Remark" class="txtArea" rows="8"></textarea>
            </td>

        </tr>


    </table>
</form>
