    function PayMoney(KeyValue, CanUseMoney, CustomerName) {
        if (IsChecked(KeyValue)) {
            var s = "";
            var type = "";
            var totalmoneys = 0;
            if ($("#BJboard1").prop("checked") && !$("#BJboard2").prop("checked") && !$("#BJboard3").prop("checked")) {
                var selr = jQuery('#gridTable1').jqGrid('getGridParam', 'selarrrow');
                if (selr.length) {
                    for (var i = 0; i < selr.length; i++) {
                        var myrow = jQuery('#gridTable1').jqGrid('getRowData', selr[i]);
                        s = s + myrow.deliverycode + ",";
                        totalmoneys = totalmoneys + Number(myrow.nogetedamount);
                        if (CustomerName != myrow.customername) {
                            tipDialog("请选择相同公司！", 3, 0);
                            return false;
                        }
                    }
                }
                else {
                    tipDialog("请选择送货单！", 3, 0);
                    return false;
                }
                type = "1";
            }

            if (!$("#BJboard1").prop("checked") && $("#BJboard2").prop("checked") && !$("#BJboard3").prop("checked")) {
                var selr = jQuery('#gridTable2').jqGrid('getGridParam', 'selarrrow');
                if (selr.length) {
                    for (var i = 0; i < selr.length; i++) {
                        var myrow = jQuery('#gridTable2').jqGrid('getRowData', selr[i]);
                        s = s + myrow.CheckSheetCode + ",";
                        totalmoneys = totalmoneys + Number(myrow.NoAmount);
                        if (CustomerName != myrow.CustomerName) {
                            tipDialog("请选择相同公司！", 3, 0);
                            return false;
                        }
                    }
                }
                else {
                    tipDialog("请选择对账单！", 3, 0);
                    return false;
                }
                type = "2";
            }

            if (!$("#BJboard1").prop("checked") && !$("#BJboard2").prop("checked") && $("#BJboard3").prop("checked")) {
                tipDialog("操作失败：收款单不能使用预付款！", 3, 0);
                return false;
                type = "3";
            }
            openDialog("/CheckSheetModule/BY_ReimburseSheet/PayMoneyView?KeyValue=" + KeyValue + "&ids=" + s + "&type=" + type + "&totalmoneys=" + totalmoneys + "&CanUseMoney=" + CanUseMoney, "Query", "支付", 550, 160, function (iframe) {
                top.frames[iframe].AcceptClick()
            });
        }
    }
    function ReturnMoney(KeyValue) {
        if (IsChecked(KeyValue)) {
            openDialog("/CheckSheetModule/BY_ReimburseSheet/ReturnMoneyView?KeyValue=" + KeyValue, "Query", "退款", 550, 160, function (iframe) {
                top.frames[iframe].AcceptClick()
            });
        }
    }

