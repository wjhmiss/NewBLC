        }
        var getedamount = GetJqGridRowValue("#gridTable", "getedamount");
        if (getedamount > 0) {
            alertDialog("已收款，请删除后回退！", 0);
            return false;
        }
        var checksheetcode = GetJqGridRowValue("#gridTable", "checksheetcode");
        if (!!checksheetcode) {
            alertDialog("已对账，请删除后回退！", 0);
            return false;
        }

        var deliveryid = GetJqGridRowValue("#gridTable", "deliveryid");
        if (IsChecked(deliveryid)) {
            var url = "/DeliveryModule/BY_Delivery/Form?KeyValue=" + deliveryid;
            openDialog(url, "Form", "修改对账时间", 650, 460, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }

    function btn_Return() {
        var IsInvoice = GetJqGridRowValue("#gridTable", "audituserid");
        if (!!IsInvoice) {
            alertDialog("当前送货单已审核", 0);
            return false;
        }
        var getedamount = GetJqGridRowValue("#gridTable", "getedamount");
        if (getedamount > 0) {
            alertDialog("已收款，请删除后回退！", 0);
            return false;
        }
        var checksheetcode = GetJqGridRowValue("#gridTable", "checksheetcode");
        if (!!checksheetcode) {
            alertDialog("已对账，请删除后回退！", 0);
            return false;
        }

        var KeyValue = GetJqGridRowValue("#gridTable", "deliveryid");
        if (IsChecked(KeyValue)) {
            confirmDialog("提示", "确定要回退吗？", function (r) {
                if (r) {
                    Loading(true, "正在提交数据...");
                    window.setTimeout(function () {
                        AjaxJson("/DeliveryModule/BY_Delivery/Return", { KeyValue: KeyValue }, function (data) {
                            tipDialog(data.Message, 3, data.Code);
                            windowload();
                        });
                    }, 200);
                }
            });
        }
    }
    function btn_ReturnDetail() {
        var IsInvoice = GetJqGridRowValue("#gridTable", "audituserid");
        if (!!IsInvoice) {
            alertDialog("当前送货单已审核", 0);
            return false;
        }
        var getedamount = GetJqGridRowValue("#gridTable", "getedamount");
        if (getedamount > 0) {
            alertDialog("已收款，请删除后回退！", 0);
            return false;
        }
        var checksheetcode = GetJqGridRowValue("#gridTable", "checksheetcode");
        if (!!checksheetcode) {
            alertDialog("已对账，请删除后回退！", 0);
            return false;
        }
        var DeliveryDetailId = GetJqGridRowValue("#DetailgridTable", "DeliveryDetailId");
        if (IsChecked(DeliveryDetailId)) {
            confirmDialog("提示", "确定要回退吗？", function (r) {
                if (r) {
                    Loading(true, "正在提交数据...");
                    window.setTimeout(function () {
                        AjaxJson("/DeliveryModule/BY_Delivery/ReturnDetail", { KeyValue: DeliveryDetailId }, function (data) {
                            tipDialog(data.Message, 3, data.Code);
                            windowload();
                        });
                    }, 200);
                }
            });
        }
    }
        //刷新
        function windowload() {
            $("#gridTable").trigger("reloadGrid"); //重新载入

        }
        function windowload1() {
            $("#DetailgridTable").trigger("reloadGrid"); //重新载入

        }
        //加载表格
    function GetDetailgridTable() {
        var KeyValue = GetJqGridRowValue("#gridTable", "deliveryid");

        var Parameter = [{
            paramName: "DeliveryId",
            paramValue: "1",
            Operation: "Equal"
        }]
        $("#DetailgridTable").jqGrid({
            url: "@Url.Content("~/DeliveryModule/BY_DeliveryDetail/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)),
            datatype: "json",
            height: $(window).height() / 2 - 140,
            autowidth: true,
            colModel: [
                { label: '发运单明细ID', name: 'DeliveryDetailId', hidden: true },
                { label: 'Thick', name: 'Thick', hidden: true },
                { label: 'Weigh', name: 'Weigh', hidden: true },
                { label: 'Length', name: 'Length', hidden: true },
                { label: 'BoreSize', name: 'BoreSize', hidden: true },
                { label: 'SteelCode', name: 'SteelCode', hidden: true },
                { label: '行号', name: 'LineCode', index: 'LineCode', width: 40, align: 'left' },
                { label: '客户品名', name: 'ProductName', index: 'ProductName', width: 100, align: 'left' },
                { label: '钢种名称', name: 'SteelDescription', index: 'SteelDescription', width: 100, align: 'left' },

                {
                    label: '厚*宽*长', name: 'Length', index: 'Length', width: 120, align: 'left',
                    formatter: function (cellvalue, options, rowobject) {
                        if (rowobject.Length == 0) {
                            return '';
                        }
                        if (!!rowobject.Weigh) {
                            return rowobject.Thick + "*" + rowobject.Weigh + "*" + rowobject.Length;
                        }
                        else {
                            var BoreSize = "";
                            if (!!rowobject.BoreSize) {
                                BoreSize = "xΦ" + rowobject.BoreSize;
                            }
                            return "Φ" + rowobject.Thick + BoreSize + "*" + rowobject.Length;
                        }
                    }
                },
                { label: '数量', name: 'Qty', index: 'Qty', width: 60, align: 'left' },
                { label: '理重', name: 'TheoryWeight', index: 'TheoryWeight', width: 60, align: 'left' },
                { label: '重量', name: 'Weight', index: 'Weight', width: 60, align: 'left' },
                { label: '重量2', name: 'WorkWeight', index: 'WorkWeight', width: 60, align: 'left' },
                { label: '计价类型', name: 'JJtype', index: 'JJtype', width: 80, align: 'left', sortable: true },
                { label: '材料单价', name: 'MaterialPrice', index: 'MaterialPrice', width: 50, align: 'left' },
                { label: '金额（材料）', name: 'MaterialAmount', index: 'MaterialAmount', width: 50, align: 'left' },
                { label: '小件单价', name: 'WorkPrice', index: 'WorkPrice', width: 50, align: 'left' },
                { label: '金额（小件）', name: 'WorkAmount', index: 'WorkAmount', width: 50, align: 'left' },
                { label: '加工单价', name: 'SmallCost', index: 'SmallCost', width: 50, align: 'left' },
                { label: '金额（加工）', name: 'SmallAmount', index: 'SmallAmount', width: 50, align: 'left' },
                { label: '切角', name: 'DDCost', index: 'DDCost', width: 50, align: 'left' },
                { label: '锯弓费', name: 'JKCost', index: 'JKCost', width: 50, align: 'left' },
                { label: '工艺', name: 'Technology', index: 'Technology', width: 50, align: 'left' },
                { label: '热处理', name: 'HeatPrice', index: 'HeatPrice', width: 50, align: 'left' },
                { label: '面积', name: 'MianCostArea', index: 'MianCostArea', width: 50, align: 'left' },
                { label: '面积单价', name: 'MianCostPer', index: 'MianCostPer', width: 50, align: 'left' },
                { label: '面积总额', name: 'MianCost', index: 'MianCost', width: 50, align: 'left' },
                { label: '边长', name: 'BianCostLong', index: 'BianCostLong', width: 50, align: 'left' },
                { label: '边单价', name: 'BianCostPer', index: 'BianCostPer', width: 50, align: 'left' },
                { label: '边总额', name: 'BianCost', index: 'BianCost', width: 50, align: 'left' },

                { label: '合计费用', name: 'SalesAmount', index: 'SalesAmount', width: 80, align: 'left' },
                { label: '模号', name: 'CustomerProduct', index: 'CustomerProduct', width: 100, align: 'left' },
                { label: '发货说明', name: 'ShipDescription', index: 'ShipDescription', width: 100, align: 'left' },
                {
                    label: '备注', name: 'Remark', index: 'Remark', width: 100, align: 'left',
                    formatter: function (cellvalue, options, rowObject) {
                        if (!!cellvalue) {
                            return cellvalue.replace(/,/g, "，");;

                        }
                        return "";
                    }
                },
                { label: '配件号', name: 'ProjectCode', width: 80 },
            ],
            viewrecords: true,
            rowNum: 999,
            rowList: [30, 50, 100, 500, 5000],
            pager: false,
            sortname: 'LineCode',
            sortorder: 'asc',
            rownumbers: true,
            shrinkToFit: false,

            gridview: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {

                var audituserid = GetJqGridRowValue("#gridTable", "audituserid");
                if (!!audituserid && "@DNS.Utilities.ManageProvider.Provider.Current().UserName" != "超级管理员") {
                    alertDialog("已审核，请联系管理员修改！", 0);
                    return false;
                }
                var checksheetcode = GetJqGridRowValue("#gridTable", "checksheetcode");
                if (checksheetcode != "") {
                    alertDialog("已生成对账单，请删除对账单后修改", 0);
                    return false;
                }

                var getedamount = GetJqGridRowValue("#gridTable", "getedamount");
                var csgetedamount = GetJqGridRowValue("#gridTable", "csgetedamount");
                if (Number(getedamount) > 0 || Number(csgetedamount) > 0) {
                    alertDialog("当前送货单已收款，不能修改！", 0);
                    return false;
                }

                var KeyValue = GetJqGridRowValue("#DetailgridTable", "DeliveryDetailId");
                var deliveryid = GetJqGridRowValue("#gridTable", "deliveryid");
                var linecode = GetJqGridRowValue("#DetailgridTable", "LineCode");

                if (IsChecked(KeyValue)) {
                    var url = "/DeliveryModule/BY_DeliveryDetail/Form?deliveryid=" + deliveryid + "&linecode=" + linecode + "&customerid=" + customerid;
                    openDialog(url, "Form", "修改发货单", 850, 650, function (iframe) {
                        top.frames[iframe].AcceptClick();
                    });
                }
            }
        });
    }


    function showdeliver() {
        var url = "/DeliveryModule/InventoryComfirm/Index";
        Dialog(url, "GForm", "送货单生成", 1024, 600, function (iframe) {
            top.frames[iframe].AcceptClick();
        });
    }

        //搜索
        function btn_Search() {
            var Condition = JSON.stringify(GetWebControls("#QueryParameter", true));
            var keywords = $("#keywords").val();
            $("#gridTable").jqGrid('setGridParam', {
                url: "@Url.Content("~/DeliveryModule/BY_Delivery/GetGridPageJson")?Condition=" + escape(Condition), page: 1
            }).trigger('reloadGrid');
        }
        //列印
        function btn_Print() {
            var deliverycode = GetJqGridRowValue("#gridTable", "deliverycode");
            //var printType = $("input[name=Print]:checked").val()
            if (IsChecked(deliverycode)) {

                //openDialog("/DeliveryModule/BY_Delivery/ChoosePrint?KeyValue=" + DeliveryId, "DeriveDialog", "打印", 750, 400, function (iframe) {
                //    top.frames[iframe].AcceptClick();
                //});
                var customercode = GetJqGridRowValue("#gridTable", "customercode");
                var url = "/DeliveryModule/BY_Delivery/ChoosePrint?deliverycode=" + deliverycode + "&customercode=" + escape(customercode) + "&LType=GC";
                openDialogFName(url, "DeriveDialog", "打印", 750, 400, "直接打印", "编辑打印",
                    function (iframe) {
                    top.frames[iframe].AcceptClick();
                },
                function (iframe) {
                    top.frames[iframe].AcceptClick2();
                });
