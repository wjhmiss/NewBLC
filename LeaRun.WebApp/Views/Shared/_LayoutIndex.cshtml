    <script src="~/Content/Scripts/learunui-framework.js"></script>
    <!--框架必需end-->
    <!--jqgrid表格组件start-->
    <script src="~/Content/Scripts/jqgrid/jquery-ui-custom.min.js"></script>
    <script src="~/Content/Scripts/jqgrid/grid.locale-cn.js"></script>
    <link href="~/Content/Scripts/jqgrid/css/jqgrid.css" rel="stylesheet" />
    <script src="~/Content/Scripts/jqgrid/jqGrid.js"></script>
    <!--表格组件end-->
    <!--树形组件start-->
    <link href="~/Content/Scripts/tree/tree.css" rel="stylesheet" />
    <script src="~/Content/Scripts/tree/tree.js"></script>
    <!--树形组件end-->
    <!--布局组件start-->
    <script src="~/Content/Scripts/layout/splitter.js"></script>
    <!--布局组件end-->
    <!--日期组件start-->
    
    <!--日期组件start-->
    <!--表单验证组件start-->
    <script src="~/Content/Scripts/validator/learunui-validator.js"></script>
    <!--表单验证组件end-->*@

     @Scripts.Render("~/Content/Scripts/frameworkjquery")
     @Styles.Render("~/Content/Styles/frameworkcss")
    @Scripts.Render("~/Content/Scripts/jqgrid/jqgridjquery")
     @Styles.Render("~/Content/Scripts/jqgrid/css/jqgridcss")
            @Scripts.Render("~/Content/Scripts/tree/treejquery")
     @Styles.Render("~/Content/Scripts/tree/treecss")   
        @Scripts.Render("~/Content/Scripts/layout/layoutjquery")          
    <script src="~/Content/Scripts/datepicker/WdatePicker.js"></script>         
          @* @Scripts.Render("~/Content/Scripts/datepicker/datepickerjquery")   *@  
            @Scripts.Render("~/Content/Scripts/validator/validatorjquery")   
            
    <script type="text/javascript">
        $(document).ready(function () {
            Loadlayout();
        });
        function whichButton(event) {
            if (event.button == 1 || event.button == 0) {
                //左键
                top.linkAddTabMenu();
            }
            
        }

    </script>
        <style>
        .altclass {
            background: #fffccc;
        }
        .ui-jqgrid tr.ui-row-ltr td {
            border-bottom: 1px solid #ccc;
        }

        .ui-jqgrid .ui-jqgrid-htable th {
            line-height: 15px;
        }

            .ui-th-column, .ui-jqgrid .ui-jqgrid-htable th.ui-th-column {
                background: none;
            }

        .editable {
            height: 22px;
            background-color: #fff;
        }
    </style>
</head>
<body onmousedown="whichButton(event)"> 
    <div>
        @RenderBody()
    </div>
</body>
</html>
