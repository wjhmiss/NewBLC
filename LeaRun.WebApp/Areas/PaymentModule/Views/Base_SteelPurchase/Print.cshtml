                                    北仑机械锻造厂
                                </td>
                            </tr>
                             <tr>
                                <th>联系人：</th>
                                <td>
                                     <label id="ContactName"></label>
                                </td>
                                
                                <th>联系人：</th>
                                <td>
                                     <label id="CNAME"></label>
                                </td>
                            </tr>
                            <tr>
                                <th>电&nbsp;&nbsp;&nbsp;&nbsp;话：</th>
                                <td>
                                    <label id="ContactTel"></label>
                                </td>
                                
                                <th>电&nbsp;&nbsp;&nbsp;&nbsp;话：</th>
                                <td>
                                   18892600521-8633
                                </td>
                            </tr>
                            <tr>
                                <th>传&nbsp;&nbsp;&nbsp;&nbsp;真：</th>
                                <td>
                                    <label id="ContactFax"></label>
                                </td>
                                
                                <th>传&nbsp;&nbsp;&nbsp;&nbsp;真：</th>
                                <td>
                                   18892600521(fax)
                                </td>
                            </tr>
                            <tr>
                                <th>地&nbsp;&nbsp;&nbsp;&nbsp;址： </th>
                                <td>
                                    <label id="CustomerAddress"></label>
                                </td>
                                
                                <th>地&nbsp;&nbsp;&nbsp;&nbsp;址：</th>
                                <td >
                                    宁波市北仑区大矸龙潭山三路15号
                                </td>

                            </tr>
                        </table>
                    </div>
                </td>
            </tr>




            <tr>
                <td colspan="4" valign="top">
                    <div>
                        <table id="tb_QuotationDetail" border="1" class="form-print" style="width: 100%; border: 1px solid #000; border-collapse: collapse;">
                            <tr>
                                <td style="width: 5%" align="center">序号</td>
                                <td  align="center">钢种</td>
                                <td style="width: 20%" colspan="3" align="center">规格(厚/直径*宽*长)</td>
                                <td  align="center">件数</td>
                                <td  align="center">理重</td>
