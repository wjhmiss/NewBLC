@{
    ViewBag.Title = "仓库";
    Layout = "~/Views/Shared/_LayoutMobile.cshtml";
}
<link href="~/Content/Scripts/Mobile/templates/mobile/css/mobiscroll.custom-2.6.2.min.css" rel="stylesheet" />
<script src="~/Content/Scripts/Mobile/templates/mobile/js/mobiscroll.custom-2.6.2.min.js"></script>
<script type="text/javascript">
    $(document).ready(function (e) {
       

        $("#btnSubmit").click(function () {
            var FullName = $("#FullName").val();
            location.href = "@Url.Content("~/WeiWebSite/WeiLogin/QueryCustomers")?FullName=" + escape(FullName);
        });
        //初始化日期选择控件
        var opt = {
            preset: 'date', //日期
            display: 'modal', //显示方式 
            mode: 'scroller', //日期选择模式
            dateFormat: 'yy-mm-dd', // 日期格式
            setText: '确定', //确认按钮名称
            cancelText: '取消',//取消按钮名籍我
            dateOrder: 'yymmdd', //面板中日期排列格式
            dayText: '日', monthText: '月', yearText: '年', //面板中年月日文字
            endYear: new Date().getFullYear() //结束年份
        };
        $("#txtBirthday1").mobiscroll(opt).date(opt);
        $("#txtBirthday2").mobiscroll(opt).date(opt);

    });

    function locationInputQuot() {
        location.href = "@Url.Content("~/WeiWebSite/WeiLogin/QueryOrder")";
    }



</script>
<!--分类筛选-->
<div id="categoryPanel" class="panel" data-footer="none">
    <header>
        <a onclick="history.back(-1)" class="backButton">返回</a>
        <h1>客户条件筛选</h1>
        <a onclick="$.ui.toggleSideMenu()" class="menuButton"></a>
    </header>

    <ul class="category-bar">
        <!--大类-->

      
        
        
                <li>
            <h2><a href="javascript:;" data-ignore="true">客户名称或编号</a></h2>
            <p>
                <input name="FullName" id="FullName" type="text" maxlength="50" value="" style="width: 100%;" />
                
            </p>
        </li>

        <div >
            <input id="btnSubmit" name="btnSubmit" type="submit" value="查  询" class="btn orange full" />
        </div>
        <!--/大类-->
    </ul>
</div>
