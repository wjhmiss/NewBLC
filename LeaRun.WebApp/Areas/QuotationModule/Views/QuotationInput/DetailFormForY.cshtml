        //}
        if (postData.Length <= 0 && $("#SteelCode").val() != "FY" && CustMaterial != "1") {
            tipCss("#Length", "长度必须大于0");
            return false;
        }
        $("#Qty").val("1"); $("#Thick").val("0"); $("#Weigh").val("0"); $("#Length").val("0");
        //$("#AddThick").val("0");
        //$("#AddWeigh").val("0");
        //$("#AddLength").val("0");
        temp1 = 0;
        temp2 = 0;
        temp3 = 0;
        temp4 = 0;
        temp5 = 0;
        temp6 = 0;
        temp7 = 0;
        temp8 = 0;
        AjaxJsonNoMassge("/QuotationModule/QuotationInput/SubmitDetailForm?KeyValue=" + KeyValue + "&Insert=" + Insert, postData, function (data) {
            //tipDialog(data.Message, 1, data.Code);
