    //得到一个对象实体
    function SetSteelControl() {
        if (!GetQuery($("#BatchCode").val())) {
            AjaxJson("/StorageModule/BY_Inventory/GetEntityJson", { BatchCode: $("#BatchCode").val(), ChildBatch: "" }, function (data) {
                $("#Weight").val(Number($.trim(data.Weight).replace("&nbsp;", "")).toFixed(2));
                $("#SteelDescription").val($.trim(data.SteelDescription).replace("&nbsp;", ""));
                if ($.trim(data.MaterialType).replace("&nbsp;", "") == "1") {
                    $("#BeforeSize").val("");
                    $("#OpenSize").val("0.00").prop("disabled", true);
                    $("#OpenQty").prop("disabled", false);
                    $("#OpenTotalWeight").prop("disabled", false);

                    $("#AfterSize").val("");
                     GetOThick = 0;
                     GetOWeigh = 0;
                     GetOLength = 0;
                     isSuiliao = 1;
                }
                else {
                    $("#BeforeSize").val(data.Length + "*" + data.Weigh + "*" + data.Thick);
                    $("#OpenSize").val("0.00").prop("disabled", false);
                    $("#OpenQty").prop("disabled", false);
                    $("#OpenTotalWeight").prop("disabled", false);

                    $("#AfterSize").val("");
                    GetOThick = Number(data.Thick);
                    GetOWeigh = Number(data.Weigh);
                    GetOLength = Number(data.Length);
                    isSuiliao = 0;
                }

                KeyValue = data.InventoryId;
                //AjaxJsonNoMassge("/CommonModule/Steel/GetSteelEntity", { SteelId: $.trim(data.SteelId).replace("&nbsp;", "") }, function (steeldata) {
                //    Density1 = Number(steeldata.Density);
                //});
            });
        }
    }
