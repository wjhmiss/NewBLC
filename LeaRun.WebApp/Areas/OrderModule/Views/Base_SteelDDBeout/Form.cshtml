        }
        $('#gridTable').jqGrid('setRowData', GetJqGridRowIndx('#gridTable'), RowData, '');
        var data = $("#gridTable").jqGrid("getRowData");
        for (var i = 0; i < data.length; i++) {
            if ("" == data[i].SteelDescription) {
                tipDialog("钢材编码错误，请检查", 3, -1);
                return;
            }
        }
        var TotalAmountall = 0;
        for (var i = 0; i < data.length; i++) {
           TotalAmountall = TotalAmountall + Number(data[i].MaterialAmount);
        }
        $("#TotalAmount").val(TotalAmountall.toFixed(2));

