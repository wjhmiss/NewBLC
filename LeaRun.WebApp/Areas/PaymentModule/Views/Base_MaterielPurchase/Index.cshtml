@{
    ViewBag.Title = "物料购买申请";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        BindDropDepartmentName("#DepartmentName");


        window.setTimeout(function () {
            GetGrid();
            btn_Search();
        }, 200);

    })
    //加载表格
    function GetGrid() {
        var rowScrod = 0;
        var SelectRowIndx = 0;
        $("#gridTable").jqGrid({
        url: "@Url.Content("~/PaymentModule/Base_MaterielPurchase/GridPageJson")",
        datatype: "json",
        height: $(window).height() - 179,
        autowidth: true,
        colModel: [
                { label: '物料id', name: 'MaterielPurchaseId', index: 'MaterielPurchaseId', hidden: true },
                { label: '物料id', name: 'MaterielId', index: 'MaterielId', hidden: true },
                { label: '物料号', name: 'MaterielCode', index: 'MaterielCode', width: 80, align: 'left', sortable: true, hidden: true },
                { label: '供应商ID', name: 'CustomerId', index: 'CustomerId', hidden: true },
                { label: '报警库存', name: 'AlarmNumber', index: 'AlarmNumber', width: 60, align: 'left', sortable: true, hidden: true },



                { label: '申请单号', name: 'MaterielPurchaseCode', index: 'MaterielPurchaseCode', width: 100, align: 'left', sortable: true },
                { label: '对账单', name: 'PayCheckSheetCode', index: 'PayCheckSheetCode', width: 80, align: 'left', sortable: true },

            { label: '供应商编号', name: 'CustomerCode', index: 'CustomerCode', width: 100, align: 'left', sortable: true },
            { label: '供应商名称', name: 'CustomerName', index: 'CustomerName', width: 100, align: 'left', sortable: true },
            { label: '物料号', name: 'MaterielCode', index: 'MaterielCode', width: 100, align: 'left', sortable: true },
                { label: '物料名称', name: 'MaterielName', index: 'MaterielName', width: 100, align: 'left', sortable: true },
                { label: '物料类型', name: 'MaterielType', index: 'MaterielType', width: 80, align: 'left',sortable: true  },
                { label: '尺寸', name: 'MaterielSize', index: 'MaterielSize', width: 80, align: 'left',sortable: true  },
                { label: '单位', name: 'Unit', index: 'Unit', width: 60, align: 'left',sortable: true  },
                { label: '单价', name: 'PricePer', index: 'PricePer', width: 60, align: 'left',sortable: true  },
                { label: '数量', name: 'Qty', index: 'Qty', width: 60, align: 'left',sortable: true  },
                { label: '总金额', name: 'TotalAmount', index: 'TotalAmount', width: 60, align: 'left',sortable: true  },
                { label: '已付金额', name: 'GetedAmount', index: 'GetedAmount', width: 80, align: 'left', sortable: true },
                { label: '支付方式', name: 'PayType', index: 'PayType', width: 60, align: 'left', sortable: true },
                { label: '申请人姓名', name: 'WorkerName', index: 'WorkerName', width: 80, align: 'left', sortable: true },
                { label: '申报部门', name: 'DepartmentName', index: 'DepartmentName', width: 120, align: 'left', sortable: true },
                {
                    label: '备注', name: 'Remark', index: 'Remark', width: 120, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        if (!!cellvalue) {
                            return cellvalue.replace(/,/g, "，");;

                        }
                        return "";
                    }
                },
                {
                    label: '申请时间', name: 'CreateDate', index: 'CreateDate', width: 0, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd');
                    }
                },
                {
                    label: '审核状态', name: 'Status', index: 'Status', width: 50, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return cellvalue == "0" ? "否" : "是";
                    }
                },

        ],
        viewrecords: true,
        rowNum: 30,
        rowList: [30, 50, 100, 500, 5000],
        pager: "#gridPager",
        sortname: 'CreateDate',
        sortorder: 'desc',
        rownumbers: true,
        shrinkToFit: false,
        gridview: true,
        multiselect: true,
        ondblClickRow: function (rowid, iRow, iCol, e) {
            btn_edit();
        },
        footerrow: true,
        onSelectRow: function (rowid, status) {
            SelectRowIndx = GetJqGridRowIndx("#" + this.id);
            rowScrod = $("#" + rowid).position().top;
        },
        gridComplete: function () {
            $(".ui-jqgrid-bdiv").first().scrollTop(rowScrod);
            $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
            //合计
            $(this).footerData("set", {
                "MaterielName": "合计",
                "Qty": FormatCurrency($("#gridTable").getCol('Qty', false, 'sum')),
                "TotalAmount": FormatCurrency($("#gridTable").getCol('TotalAmount', false, 'sum')),
                "GetedAmount": FormatCurrency($("#gridTable").getCol('GetedAmount', false, 'sum')),
            });
            var data = $("#gridTable").jqGrid("getRowData");
            for (var i = 0; i < data.length; i++) {
                var item = i + 1;
                if (data[i].Status == "是") {
                    $("#" + item).find('td').css("background-color", "#00AA00");
                }
                if (data[i].IsPay == "是") {
                    $("#" + item).find('td').css("background-color", "#00AA88");
                }
                if (data[i].IsInvoice == "是") {
                    $("#" + item).find('td').css("background-color", "#2200AA");
                }


            }
        },
        multiselect: true,
    });
}
    //新增
    function btn_add() {
        var url = "/PaymentModule/Base_MaterielPurchase/Form"
        openDialog(url, "Form", "新增物料购买申请", 770, 395, function (iframe) {
            top.frames[iframe].AcceptClick()
        });
    }
    //编辑
    function btn_edit() {
        var Status = GetJqGridRowValue("#gridTable", "Status");
        if (Status=="是") {
            alertDialog("当前报价单已审核", 0);
            return false;
        }
        var IsPay = GetJqGridRowValue("#gridTable", "IsPay");
        if (IsPay == "是" ) {
            alertDialog("当前报价单已付款", 0);
            return false;
        }
        var IsInvoice = GetJqGridRowValue("#gridTable", "IsInvoice");
        if (IsInvoice == "是" ) {
            alertDialog("当前报价单已开票", 0);
            return false;
        }

        var GetedAmount = GetJqGridRowValue("#gridTable", "GetedAmount");
        if (GetedAmount > 0) {
            alertDialog("当前申请单已收款", 0);
            return false;
        }

        var PayCheckSheetCode = GetJqGridRowValue("#gridTable", "PayCheckSheetCode");
        if (!!PayCheckSheetCode) {
            alertDialog("当前申请单已对账", 0);
            return false;
        }


        var KeyValue = GetJqGridRowValue("#gridTable", "MaterielPurchaseId");
        if (IsChecked(KeyValue)) {
            var url = "/PaymentModule/Base_MaterielPurchase/Form?KeyValue=" + KeyValue;
            openDialog(url, "Form", "编辑物料购买申请", 770, 395, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }

    function WrithPrice() {

        var GetedAmount = GetJqGridRowValue("#gridTable", "GetedAmount");
        if (GetedAmount > 0) {
            alertDialog("当前申请单已收款", 0);
            return false;
        }
        var KeyValue = GetJqGridRowValue("#gridTable", "MaterielPurchaseId");
        if (IsChecked(KeyValue)) {
            var PayCheckSheetCode = GetJqGridRowValue("#gridTable", "PayCheckSheetCode");
            if (!!PayCheckSheetCode) {
                alertDialog("当前申请单已对账", 0);
                return false;
            }


            var url = "/PaymentModule/Base_MaterielPurchase/Form?KeyValue=" + KeyValue;
            openDialog(url, "Form", "编辑物料购买申请", 770, 395, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }

    //删除
    function btn_delete() {
        var selr = jQuery('#gridTable').jqGrid('getGridParam', 'selarrrow');
        var s1 = "";
        if (selr.length) {
            for (var i = 0; i < selr.length; i++) {
                var myrow = jQuery('#gridTable').jqGrid('getRowData', selr[i]);

                if (myrow.GetedAmount > 0) {
                    alertDialog("当前申请单已收款", 0);
                    return false;
                }
                if (!!myrow.PayCheckSheetCode) {
                    alertDialog("当前申请单已对账", 0);
                    return false;
                }

            }
            var KeyValue = GetJqGridRowValue("#gridTable", "MaterielPurchaseId");
            if (IsDelData(KeyValue)) {
                var delparm = 'KeyValue=' + KeyValue;
                delConfig('/PaymentModule/Base_MaterielPurchase/Delete1', delparm, KeyValue.split(",").length);
            }
        }
    }
    //明细
    function btn_detail() {
        var KeyValue = GetJqGridRowValue("#gridTable", "MaterielPurchaseId");
        if (IsChecked(KeyValue)) {
            var url = "/PaymentModule/Base_MaterielPurchase/Detail?KeyValue=" + KeyValue;
            Dialog(url, "Detail", "物料购买申请明细", 820, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
