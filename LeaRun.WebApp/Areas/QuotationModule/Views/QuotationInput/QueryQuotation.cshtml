@{
    ViewBag.Title = "报价单查询";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script>
    var LType = GetQuery('LType');
    $(function () {

        window.setTimeout(function () {
            GetGrid();
            //$('#gridTable').setGridWidth(630);
        }, 300);

    });
    //查询
    function btn_Search() {
        var Parameter = [{
            paramName: "CustomerCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR",
            LeftBrace: "("
        }, {
            paramName: "QuotationCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR"
        }, {
            paramName: "MnemonicCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "AND",
            RightBrace: ")"
            }, {
                paramName: "LType",
                paramValue: LType,
                Operation: "Equal",
                Logic: "AND"
            }, {
                paramName: "DeleteMark",
                paramValue: 0,
                Operation: "Equal",
                Logic: "AND"
            }]
        $("#gridTable").jqGrid('setGridParam', {
            url: "@Url.Content("~/QuotationModule/QuotationInput/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)), page: 1
        }).trigger('reloadGrid');
    }
    //报价单列表
    function GetGrid() {
        var Parameter = [{
            paramName: "CustomerCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR",
            LeftBrace: "("
        }, {
            paramName: "QuotationCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR"
        }, {
            paramName: "MnemonicCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "AND",
            RightBrace: ")"
        }, {
            paramName: "LType",
            paramValue: LType,
            Operation: "Equal",
            Logic: "AND"
            }, {
                paramName: "DeleteMark",
                paramValue: 0,
                Operation: "Equal",
                Logic: "AND"
            }]
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/QuotationModule/QuotationInput/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)) ,
            datatype: "json",
            height: $(window).height() - 111,
            autowidth: true,
            colModel: [
                    { label: '主键', name: 'QuotationId', hidden: true },
                    { label: '助记编码', name: 'MnemonicCode', index: 'MnemonicCode', width: 100, align: 'left', sortable: true },
                    {
                        label: '单据状态', name: 'BillStatus', index: 'BillStatus', width: 50, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowobject) {
                            if (!!cellvalue) {
                                return cellvalue;
                            } else {
                                return "<span style='color:red'>待提交</span>";
                            }
                        }
                    },
                    { label: '报价单号', name: 'QuotationCode', index: 'QuotationCode', width: 100, align: 'left', sortable: true },
                    { label: '客户编码', name: 'CustomerCode', index: 'CustomerCode', width: 100, align: 'left', sortable: true },
                    { label: '客户名称', name: 'CustomerName', index: 'CustomerName', width: 200, align: 'left', sortable: true },
                    { label: '客户简称', name: 'ShortName', index: 'ShortName', width: 100, align: 'left', sortable: true }

            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 1000],
            pager: "#gridPager",
            sortname: 'CheckStatus,CreateDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            ondblClickRow: function () {
                AcceptClick();
            }
        });
    }
    //确认事件
    function AcceptClick() {
        var QuotationCode = GetJqGridRowValue("#gridTable", "QuotationId");
        top.frames[tabiframeId()].InitControl(QuotationCode);
        window.setTimeout(function () {closeDialog();}, 500);
    }
</script>
<div class="leftline rightline topline QueryArea" style="margin: 1px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>关键字：</th>
            <td>
                <input id="keywords" type="text" class="txt" style="width: 200px" />
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="查 询" onclick="btn_Search()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
