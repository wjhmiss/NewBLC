                jQuery("#" + id + "_Weigh").keyup(function () {
                    countU(id);
                    self(id);
                    countUAmount(id);

                });
                jQuery("#" + id + "_AddWeigh").keyup(function () {
                    countU(id);
                    self(id);
                    countUAmount(id);

                });
                jQuery("#" + id + "_Thick").keyup(function () {
                    countU(id);
                    self(id);
                    countUAmount(id);

                });
                jQuery("#" + id + "_AddThick").keyup(function () {
                    countU(id);
                    self(id);
                    countUAmount(id);

                });
