@{
    ViewBag.Title = "订单状态变更";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {

        window.setTimeout(function () {
            GetGrid();
            GetGridDetail();
        }, 200);
    })
    //查询
    function btn_Search() {
        var Condition = GetParameterJson("QueryParameter");
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/OrderModule/OrderStatus/GridPageListJson")?Condition=" + escape(Condition), page: 1 }).trigger('reloadGrid');
        $("#gridTable_Detail").jqGrid('setGridParam', { url: "@Url.Content("~/OrderModule/OrderQuery/GridOrderDetailListJson")?OrderId=-1" }).trigger('reloadGrid');
    }
    //加载订单表格
    function GetGrid() {
        var SelectRowIndx = 1;
        var Condition = GetParameterJson("QueryParameter");
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/OrderModule/OrderStatus/GridPageListJson")?Condition=" + escape(Condition),
            datatype: "json",
            height: 170,
            autowidth: true,
            colModel: [
                    { label: '主键', name: 'OrderId', hidden: true },
                    { label: '订单单号', name: 'OrderCode', index: 'OrderCode', width: 100, align: 'left', sortable: true },
                    { label: '订单类型', name: 'OrderType', index: 'OrderType', width: 50, align: 'center', sortable: true },
                    { label: '数量', name: 'Qty', index: 'Qty', width: 50, align: 'left', sortable: true },
                    { label: '客户编号', name: 'CustomerCode', index: 'CustomerCode', width: 80, align: 'left', sortable: true },
                    { label: '客户名称', name: 'CustomerName', index: 'CustomerName', width: 200, align: 'left', sortable: true },
                    {
                        label: '入单日期', name: 'CreateDate', index: 'CreateDate', width: 65, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    { label: '入单人员', name: 'CreateUserName', index: 'CreateUserName', width: 80, align: 'left', sortable: true },
                    { label: '销售人员', name: 'SalesMan', index: 'SalesMan', width: 80, align: 'left', sortable: true },
                    {
                        label: '订单状态', name: 'OrderStatus', index: 'OrderStatus', width: 50, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowobject) {
                            if (cellvalue == "正常生产") {
                                return "<a  style='color:red' >" + cellvalue + "</a>";
                            }
                            else {
                                //return "<a class='alink' style='color:red' onclick='OpearLog(\"" + rowobject.orderid + "\",\"" + rowobject.ordercode + "\")'>" + cellvalue + "</a>";
                                return "<a  style='color:black'>" + cellvalue + "</a>";
                            }
                        }
                    }
            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'CreateDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            onSelectRow: function () {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
                var OrderId = GetJqGridRowValue("#gridTable", "OrderId");
                $("#gridTable_Detail").jqGrid('setGridParam', {
                    url: "@Url.Content("~/OrderModule/OrderQuery/GridOrderDetailListJson")?OrderId=" + OrderId
                }).trigger('reloadGrid');
                $("#lr-ModifyOrderStatus").removeClass('disabled');
                $("#lr-ModifyQty,#lr-ModifyLineStatus").addClass('disabled');
            },
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
            }
        });
            }
            //订单明细列表
            function GetGridDetail() {
                $("#gridTable_Detail").jqGrid({
                    url: "@Url.Content("~/OrderModule/OrderQuery/GridOrderDetailListJson")",
                    datatype: "json",
                    height: $(window).height() - 350,
                    autowidth: true,
                    colModel: [
                        { label: "主键", name: "OrderDetailId", hidden: true },
                        { label: "钢材编码", name: "SteelCode", index: "SteelCode", width: 50 },
                        { label: "钢材名称", name: "SteelDescription", index: "SteelDescription", width: 80 },
                        { label: "钢材状态", name: "SteelState", index: "SteelState", width: 50, align: "center" },
                        { label: "数量", name: "Qty", index: "Qty", width: 50, align: "center" },
                        { label: "钢种", name: "SteelId", index: "SteelId", width: 50, align: "center" },

                        { label: "厚度", name: "Thick", index: "Thick", width: 50, align: "center" },
                        { label: "宽度", name: "Weigh", index: "Weigh", width: 50, align: "center" },
                        { label: "长度", name: "Length", index: "Length", width: 50, align: "center" },
                        {
                            label: "订单状态", name: "BillStatus", index: "BillStatus", width: 50, align: "center",
                            formatter: function (cellvalue, options, rowobject) {
                                if (cellvalue == "正常生产") {
                                    return "<a  style='color:red' >" + cellvalue + "</a>";
                                }
                                else {
                                    //return "<a class='alink' style='color:red' onclick='OpearLog(\"" + rowobject.orderid + "\",\"" + rowobject.ordercode + "\")'>" + cellvalue + "</a>";
                                    return "<a  style='color:black'>" + cellvalue + "</a>";
                                }
                            }
                        },
                        { label: "备注", name: "ExecRemark", index: "ExecRemark", width: 300 },
                        { label: "重量", name: "Weight", hidden: true },
                    ],
                    pager: false,
                    rowNum: 1000,
                    sortname: 'LineCode',
                    sortorder: 'asc',
                    rownumbers: true,
                    shrinkToFit: false,
                    autoScroll: true,
                    altRows: true,
                    altclass: 'altclass',
                    gridview: true,
                    onSelectRow: function () {
                        //$("#gridTable").trigger('reloadGrid');
                        $("#lr-ModifyOrderStatus").addClass('disabled');
                        $("#lr-ModifyQty,#lr-ModifyLineStatus").removeClass('disabled');
                    }
                });
            }
            //整单变更状态
            function btn_ModifyOrderStatus() {
                var OrderId = GetJqGridRowValue("#gridTable", "OrderId");
                var OrderStatus = GetJqGridRowValue("#gridTable", "OrderStatus");
                if (OrderStatus.indexOf("正常生产") >= 0 || OrderStatus.indexOf("已取消") >= 0 || OrderStatus.indexOf("暂停") >= 0 || OrderStatus.indexOf("已审核") >= 0 || OrderStatus.indexOf("部分暂停") >= 0 || OrderStatus.indexOf("部分取消") >= 0) {
                    if (IsChecked(OrderId)) {
                        var url = "/OrderModule/OrderStatus/Form?OrderId=" + OrderId + "&BillStatus=" + escape(OrderStatus)
                        openDialog(url, "Form", "整单变更状态", 400, 120, function (iframe) {
                            top.frames[iframe].AcceptClick();
                        });
                    }
                } else {
                    tipDialog("当前订单状态不允许变更", 3, 0);
                }
            }
            //修改数量
            function btn_ModifyQty() {
                tipDialog("权限不足！", 3, 0);
                return false;
                var OrderDetailId = GetJqGridRowValue("#gridTable_Detail", "OrderDetailId");
                var BillStatus = GetJqGridRowValue("#gridTable_Detail", "BillStatus");
                var Qty = GetJqGridRowValue("#gridTable_Detail", "Qty");
                var Weight = GetJqGridRowValue("#gridTable_Detail", "Weight");
                if (BillStatus.indexOf("正常生产") >= 0) {
                    if (IsChecked(OrderDetailId)) {
                        var url = "/OrderModule/OrderStatus/UpdataNumber?OrderDetailId=" + OrderDetailId + "&present=" + escape(Qty) + "&Weight=" + escape(Weight)
                        openDialog(url, "Form", "修改数量", 400, 120, function (iframe) {
                            top.frames[iframe].AcceptClick();
                        });
                    }
                } else {
                    tipDialog("只有正常生产状态才允许变更", 3, 0);
                }
            }
            //某行变更状态
            function btn_ModifyLineStatus() {
                var OrderStatus = GetJqGridRowValue("#gridTable_Detail", "BillStatus");
                if (OrderStatus.indexOf("正常生产") >= 0 || OrderStatus.indexOf("已取消") >= 0 || OrderStatus.indexOf("暂停") >= 0 || OrderStatus.indexOf("已审核") >= 0) {

                }
                else {
                    tipDialog("当前订单状态不允许变更", 3, 0);
                    return false;
                }
                var OrderId = GetJqGridRowValue("#gridTable", "OrderId");
                var OrderDetailId = GetJqGridRowValue("#gridTable_Detail", "OrderDetailId");
                var BillStatus = GetJqGridRowValue("#gridTable_Detail", "BillStatus");
                if (BillStatus.indexOf("正常生产") >= 0 || BillStatus.indexOf("已取消") >= 0 || BillStatus.indexOf("暂停") >= 0 ) {
                    if (IsChecked(OrderDetailId)) {
                        var url = "/OrderModule/OrderStatus/OrderDetailStatus?OrderDetailId=" + OrderDetailId + "&BillStatus=" + escape(BillStatus) + "&OrderId=" + OrderId;
                        openDialog(url, "Form", "某行变更状态", 400, 120, function (iframe) {
                            top.frames[iframe].AcceptClick();
                        });
                    }
                } else {
                    tipDialog("当前订单状态不允许变更", 3, 0);
                }
            }
            function windowload() {
                $("#gridTable").trigger("reloadGrid"); //重新载入
                $("#gridTable_Detail").trigger("reloadGrid"); //重新载入
            }
</script>
<!--工具栏-->
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
    <script>
        $(function () {
            $("#lr-ModifyOrderStatus,#lr-ModifyQty,#lr-ModifyLineStatus").addClass('disabled');
        })
    </script>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table id="QueryParameter" border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>订单单号：</th>
            <td>
                <input id="OrderCode" type="text" class="txt" style="width: 120px" />
            </td>
            <th>订单日期 从：</th>
            <td>
                <input id="CreateDate_StartTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 00:00'})" style="width: 120px" />
            </td>
            <th>订单日期 至：</th>
            <td>
                <input id="CreateDate_EndTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 23:59'})" style="width: 120px" />
            </td>
            <td>&nbsp;&nbsp;&nbsp;
                <input id="btnSearch" type="button" class="btnSearch" value="查 询" onclick="btn_Search()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
<div class="topline rightline" style="margin: 1px; margin-bottom: 0px;">
    <table id="gridTable_Detail"></table>
</div>
