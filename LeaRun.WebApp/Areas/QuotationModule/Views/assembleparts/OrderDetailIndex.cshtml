    function btn_Search() {
        var Condition = GetParameterJson("QueryParameter");
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/ReportModule/Production/GridPageListJson")?Condition=" + escape(Condition), page: 1 }).trigger('reloadGrid');
