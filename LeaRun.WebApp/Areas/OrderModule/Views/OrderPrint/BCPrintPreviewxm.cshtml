                        Orderhtml += '            <span style="font-size: 22px; font-weight: bold;">' + data.company.ShortName + '生产单</span><span style="font-size: 12px; font-weight: bold;">（' + pageindex + '/' + total + '）' + quotitle + '</span>';
                        Orderhtml += '        </td>';
                        Orderhtml += '    </tr>';
                        Orderhtml += '    <tr>';
                        Orderhtml += '        <th style="height: 18px;line-height:18px;font-size: 10pt;">编码：</th>';
                        Orderhtml += '        <td style="height: 18px;line-height:18px;font-size: 10pt;" colspan="2">' + QuotationEntiy.CustomerCode + '</td>';
                        Orderhtml += '        <th style="height: 18px;line-height:18px;font-size: 10pt;">助记码：</th>';
                        Orderhtml += '        <td style="height: 18px;line-height:18px;font-size: 10pt;word-break:break-all" >' + QuotationEntiy.MnemonicCode + '</td>';
                        Orderhtml += '        <th style="height: 18px;line-height:18px;font-size: 10pt;">跟单：</th>';
                        Orderhtml += '        <td style="height: 18px;line-height:18px;font-size: 10pt;" >' + QuotationEntiy.CreateUserName + '</td>';
                        Orderhtml += '        <th style="height: 18px;line-height:18px;font-size: 10pt;">运输：</th>';
                        Orderhtml += '        <td style="height: 18px;line-height:18px;font-size: 10pt;" >' + data.Customer.TransitMode + '</td>';
                        Orderhtml += '    </tr>';
                        Orderhtml += '    <tr>';
                        Orderhtml += '        <th style="height: 18px;line-height:18px;font-size: 10pt;">下单：</th>';
                        Orderhtml += '        <td style="height: 18px;line-height:18px;font-size: 10pt;" colspan="2">' + formatDate(OrderEntiy.CreateDate, 'yyyy-MM-dd hh:mm') + '</td>';
                        Orderhtml += '        <th style="height: 18px;line-height:18px;font-size: 10pt;">交期：</th>';
                        Orderhtml += '        <td style="height: 18px;line-height:18px;font-size: 10pt;">' + OrderEntiy.Delivery + '</td>';
                        Orderhtml += '        <th style="height: 18px;line-height:18px;font-size: 10pt;">总件数：</th>';
                        Orderhtml += '        <td style="height: 18px;line-height:18px;font-size: 10pt;" >' + data.OrderDetailTotal + '</td>';
                        Orderhtml += '        <th style="height: 18px;line-height:18px;font-size: 10pt;">总重量：</th>';
                        Orderhtml += '        <td style="height: 18px;line-height:18px;font-size: 10pt;" >' + data.OrderDetailWeight + '</td>';

                        //Orderhtml += '    <td  style="text-align: center;width:180px;" >';
                        //Orderhtml += '            <div style="float: left; "><div id="barcodeTarget" style="margin-top: 0px;" barcode=' + OrderEntiy.OrderCode + "-" + OrderDetail[i].ScanCodeX + '  class="barcodeTarget"></div></div>';
                        //Orderhtml += '    </td>';



                        Orderhtml += '    </tr>';

                        //Orderhtml += '    <tr>';
                        //Orderhtml += '        <td colspan="2"  style="vertical-align:top;">';
                        //Orderhtml += '        下单：' + formatDate(OrderEntiy.CreateDate, 'yyyy-MM-dd');;
                        //Orderhtml += '        </td>';
                        //Orderhtml += '        <td colspan="2"  style="vertical-align:top;">';
                        //Orderhtml += '        交期：' + OrderEntiy.Delivery;
                        //Orderhtml += '        </td>';
                        //Orderhtml += '        <td colspan="2"  style="vertical-align:top;">';
                        //Orderhtml += '        件数：' + totalper;
                        //Orderhtml += '        </td>';
                        //Orderhtml += '        <td colspan="2"  style="vertical-align:top;">';
                        //Orderhtml += '        重量：' + totalweightPer.toFixed(2);
                        //Orderhtml += '        kg</td>';
                        //Orderhtml += '    </tr>';
                        Orderhtml += '    <tr>';
                        Orderhtml += '        <td colspan="10"  style="vertical-align:top;">';
                        Orderhtml += '            <table id="tb_OrderDetail" border="0" cellpadding="0" cellspacing="0" class="form-print" style="width: 100%;border-collapse:collapse;border: 1px solid #000;">';
                        Orderhtml += '          <tr style="height: 4mm;">';
                        Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;border: 1px solid #000; text-align: center;width:5%;" >序号</td>';
                        Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;border: 1px solid #000; text-align: center;width:10%;" >钢种</td>';
                        Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;border: 1px solid #000; text-align: center;width:5%;" >件数</td>';
                        Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;border: 1px solid #000; text-align: center;width:25%;" >规格</td>';
                        Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;border: 1px solid #000; text-align: center;width:30%;" >备注</td>';
                        Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;border: 1px solid #000; text-align: center;width:25%;" ></td>';
                        //Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;border: 1px solid #000; text-align: center;width:50px;" >边</td>';
                        Orderhtml += '</tr>';
                    }
                    if (!OrderDetail[i].SteelCode) {
                        Orderhtml += '<tr style="height: 14mm;">';
                        Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;border-bottom: 1px dashed #000;" >&nbsp;<br/>&nbsp;</td>';
                        Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;border-bottom: 1px dashed #000;" >&nbsp;</td>';
                        Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;border-bottom: 1px dashed #000;" >&nbsp;</td>';
                        Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;border-bottom: 1px dashed #000;" >&nbsp;</td>';
                        Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;border-bottom: 1px dashed #000;" >&nbsp;</td>';
                        Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;border-bottom: 1px dashed #000;" >&nbsp;</td>';
                        //Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;border-bottom: 1px dashed #000;" >&nbsp;</td>';

                        Orderhtml += '</tr>';

                    }
                    else {
                        Orderhtml += '<tr style="height: 4mm;">';
                        var tremark = "";

                        if (!!OrderDetail[i].RequeryRemark) {
                            tremark += OrderDetail[i].RequeryRemark.replace("&nbsp;", "").replace("，", ",").replace("。", ".").replace("；", ";") + ",";
                        }
                        if (!!OrderDetail[i].ShipDescription) {
                            tremark += OrderDetail[i].ShipDescription.replace("&nbsp;", "").replace("，", ",").replace("。", ".").replace("；", ";") + ",";
                        }
                        tremark = tremark.trim(',');


                        OrderDetail[i].ProductName = OrderDetail[i].ProductName.replace(/光板/g, "");
                        OrderDetail[i].ProductName = OrderDetail[i].ProductName.replace(/精板/g, "");
                        OrderDetail[i].ProductName = OrderDetail[i].ProductName.replace(/毛料/g, "");
                        OrderDetail[i].ProductName = OrderDetail[i].ProductName + OrderDetail[i].OrderType.substr(0, 2);
                        if (!OrderDetail[i].CustomerProduct) {
                            OrderDetail[i].CustomerProduct = "";
                        }
                        if (!OrderDetail[i].SteelDescription) {
                            OrderDetail[i].SteelDescription = "";
                        }
                        if (!OrderDetail[i].ExecRemark) {
                            OrderDetail[i].ExecRemark = "";
                        }
                        if (!OrderDetail[i].DingCode) {
                            OrderDetail[i].DingCode = "";
                        }
                        var area = 0;
                        var length = 0;
                        if (OrderDetail[i].Weigh > 0) {
                            var area = (OrderDetail[i].Length * OrderDetail[i].Weigh * 2 * OrderDetail[i].Qty / 1000000).toFixed(2);
                            var length = (((OrderDetail[i].Length * OrderDetail[i].Thick * 2 + OrderDetail[i].Weigh * OrderDetail[i].Thick * 2) * OrderDetail[i].Qty) / 1000000).toFixed(2);
                        }
                        else {
                            var area = (OrderDetail[i].Length * (OrderDetail[i].Thick/2)*3.14 * 2 * OrderDetail[i].Qty / 1000000).toFixed(2);
                        }

                        if (!OrderDetail[i].Fang) {
                            OrderDetail[i].Fang = "";
                        }
                        else {
                            OrderDetail[i].Fang + ","
                        }

                        if (!OrderDetail[i].ExecRemark) {
                            OrderDetail[i].ExecRemark = "";
                        }
                        else {
                            OrderDetail[i].ExecRemark = OrderDetail[i].ExecRemark + ",";

                        }
                        if (!OrderDetail[i].RemarkKL) {
                            OrderDetail[i].RemarkKL = "";
                        }
                        else {
                            OrderDetail[i].RemarkKL = "," + OrderDetail[i].RemarkKL;
                        }

                        var tfang = OrderDetail[i].Fang ;

                        if (!OrderDetail[i].Kprocess) {
                            OrderDetail[i].Kprocess = "";
                        }
                        if (!OrderDetail[i].LJtype1) {
                            OrderDetail[i].LJtype1 = "";
                        }
                        else { 
                            OrderDetail[i].LJtype1 = OrderDetail[i].LJtype1 + ":";

                        }
                        Orderhtml += '    <td  style="font-size: 10pt;border-bottom: 1px dashed #000;text-align: center;word-break: break-all;"  >' + OrderDetail[i].LineCode + '</td>';
                        Orderhtml += '    <td  style="font-size: 10pt;border-bottom: 1px dashed #000;text-align: center;word-break: break-all;line-height: 16.6px;"  >' + OrderDetail[i].LJtype1 + OrderDetail[i].ProductName + '</td>';
                        Orderhtml += '    <td style="font-size: 12pt;border-bottom: 1px dashed #000;text-align: center;word-break: break-all;" >' + OrderDetail[i].Qty + '</td>';
                        // Orderhtml += '    <td style="font-size: 10pt;border-bottom: 1px dashed #000;text-align: center;word-break: break-all;" >' + OrderDetail[i].Weight + '</td>';
                        Orderhtml += '    <td style="font-size: 12pt;border-bottom: 1px dashed #000;text-align: center;word-break: break-all;" >' + size + '</td>';
                        Orderhtml += '    <td  style="font-size: 12pt;border-bottom: 1px dashed #000;word-break:break-all;line-height: 16.6px;" >' + tfang + "(" + OrderDetail[i].OrderType + "," + OrderDetail[i].Kprocess + "," + OrderDetail[i].RemarkKL + "," + OrderDetail[i].ExecRemark + ")" + OrderDetail[i].CustomerProduct + '</td>';
                        Orderhtml += '    <td  style="text-align: center;border-bottom: 1px dashed #000;;center;" >';
                        //Orderhtml += '            <div style="display: flex;justify-content: space-between; "><div>扫描：</div><div style="margin-top: 0px;" barcode=' + OrderEntiy.OrderCode + "-" + OrderDetail[i].LineCode + '  class="barcodeTarget"></div><div>钢印：</div><div style="margin-top: 0px;" barcode=' + mo + '  class="barcodeTarget"></div></div>';
                        if (i % 2) {
                            Orderhtml += '            <div style="display: flex;justify-content: space-between; "><div></div><div style="margin-top: 0px;" barcode=""  class="barcodeTarget"></div><div>扫描：</div><div style="margin-top: 0px;" barcode=' + OrderEntiy.OrderCode + "-" + OrderDetail[i].LineCode + '  class="barcodeTarget"></div></div>';

                        }
                        else
                        {
                            Orderhtml += '            <div style="display: flex;justify-content: space-between; "><div>扫描：</div><div style="margin-top: 0px;" barcode=' + OrderEntiy.OrderCode + "-" + OrderDetail[i].LineCode + '  class="barcodeTarget"></div><div></div><div style="margin-top: 0px;" barcode=""  class="barcodeTarget"></div></div>';

                        }
                        Orderhtml += '    </td>';

                        Orderhtml += '</tr>';


                    }
                    if ((index + 1) % RowNum == 0) {
                        Orderhtml += '            </table>';

                        Orderhtml += '        </td>';
                        Orderhtml += '    </tr>';

                        Orderhtml += '    <tr>';
                        Orderhtml += '        <td style="height: 14pt;line-height:14pt;font-size: 14pt;text-align:left;border-bottom: 1px dashed #000;word-break:break-all;font-weight: bold;" colspan="10">铣磨要求：' + OrderEntiy.XMRequery + OrderEntiy.KLRequery + '</td>';

                        Orderhtml += '    </tr>';
                        Orderhtml += '    <tr>';
                        Orderhtml += '        <td  style="vertical-align:top;">';
                        Orderhtml += '        </td>';
                        Orderhtml += '        <td colspan="2"  style="vertical-align:top;">';
