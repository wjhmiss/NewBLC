                    var newleng = Length + AddLength;
                    var newweigh = Weigh + AddWeigh;
                    var newthick = Thick + AddThick;
                }
                weight = ((((Thick + AddThick)/2) * ((Thick + AddThick)/2) * (Length + AddLength) * Density * 3.14 * Qty) / 1000000).toFixed(2);
                //weight = ((((Thick + AddThick)) * ((Thick + AddThick)) * (Length + AddLength) * Density * Qty) / 1000000).toFixed(2);
            }
            $("#" + id + "_Weight").val(weight)



            //var MaterialPrice = $("#" + id + "_MaterialPrice").val();
            //var Weight = $("#" + id + "_Weight").val();
            //$("#gridTable").jqGrid('setRowData', id, { MaterialAmount: 0});

            //var data = $("#gridTable").jqGrid("getRowData");
            //var TotalAmountall = 0;
            //for (var i = 0; i < data.length; i++) {
            //    TotalAmountall = TotalAmountall + Number(data[i].MaterialAmount);
            //}
            //$("#TotalAmount").val(TotalAmountall);
        }
