                        var AddWeigh = parseFloat(QuotationDetail[i].Weigh + QuotationDetail[i].AddWeigh);
                        var AddThick = parseFloat(QuotationDetail[i].Thick + QuotationDetail[i].AddThick);
                        var weightper = (QuotationDetail[i].Weight / QuotationDetail[i].Qty).toFixed(2);
