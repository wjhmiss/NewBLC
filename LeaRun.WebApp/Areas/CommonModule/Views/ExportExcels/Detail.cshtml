@{
    ViewBag.Title = "ExportExcels》明细页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/CommonModule/ExportExcels/SetForm", { KeyValue: GetQuery('KeyValue') }, function (data) {
                SetWebControls(data);
            });
        }
    }
</script>
<form id="form1" style="margin: 1px">
    <table class="form">
        <tr>
            <th class='formTitle'>GUID：</th>
            <td class='formValue'>
                <label id="GUID" />
            </td>
            <th class='formTitle'>JsonColumn：</th>
            <td class='formValue'>
                <label id="JsonColumn" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>JsonData：</th>
            <td class='formValue'>
                <label id="JsonData" />
            </td>
            <th class='formTitle'>ExportField：</th>
            <td class='formValue'>
                <label id="ExportField" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>fileName：</th>
            <td class='formValue'>
                <label id="fileName" />
            </td>
        </tr>
    </table>
</form>
