            <th class='formTitle'>每个光硬保底面积：</th>
            <td class='formValue'>
                <input id="GYLimiteAreaPer" maxlength=18 type="text" class="txt" onfocus="IsMoney(this.id);"  />
            </td>
            <th class='formTitle'>每个光软保底面积：</th>
