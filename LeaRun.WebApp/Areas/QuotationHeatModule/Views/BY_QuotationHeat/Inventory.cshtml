@{
    ViewBag.Title = "BY_QuotationHeat";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
        }, 200);
        BindDropItem("#Technology", "CraftType", "==请选择==");
    })
    function btn_Search() {
        var Condition = GetParameterJson("QueryParameter");
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/QuotationHeatModule/BY_QuotationHeat/GridPageListJson")?Condition=" + escape(Condition), page: 1 }).trigger('reloadGrid');
    }
    function btn_add() {
        var url = "/QuotationHeatModule/BY_QuotationHeat/FormAll"
        openDialog(url, "Form", "热处理录入", 1200, 700, function (iframe) {
            top.frames[iframe].AcceptClick();
            windowload();
        });
    }
    //编辑
    function btn_edit() {
        var BillStatus = GetJqGridRowValue("#gridTable", "billstatus");
        if (BillStatus == "已完工") {
            alertDialog("已完工，不能删除", 0);
            return false;
        }
        var KeyValue = GetJqGridRowValue("#gridTable", "quotationheatid");
        if (IsChecked(KeyValue)) {
            var url = "/QuotationHeatModule/BY_QuotationHeat/Form?KeyValue=" + KeyValue;
            openDialog(url, "Form", "热处理编辑", 800, 550, function (iframe) {
                top.frames[iframe].AcceptClick();
            });

        }
    }
    function AcceptClick() {
        top.frames[tabiframeId()].windowload();
        window.setTimeout(function () {closeDialog();}, 500);
    }
    //删除
    function btn_delete() {

        // if ("@DNS.Utilities.ManageProvider.Provider.Current().UserName" != "超级管理员") {
        var BillStatus = GetJqGridRowValue("#gridTable", "billstatus");
        if (BillStatus == "已完工") {
            alertDialog("已完工，不能删除", 0);
            return false;
        }

        var KeyValue = GetJqGridRowValue("#gridTable", "quotationheatid");
        if (IsDelData(KeyValue)) {
            var delparm = 'KeyValue=' + KeyValue;
            delConfig('/QuotationHeatModule/BY_QuotationHeat/Delete', delparm, KeyValue.split(",").length);
        }
    }
    //明细

    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入
    }

    //加载表格
    function GetGrid() {
        var SelectRowIndx;
        var Condition = GetParameterJson("QueryParameter");
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/QuotationHeatModule/BY_QuotationHeat/GridPageListJson")?Condition=" + escape(Condition),
            datatype: "json",
            height: $(window).height() - 149,
            autowidth: true,
            colModel: [
                {
                    label: '录单时间', name: 'createdate', index: 'createdate', width: 70, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd');
                    }
                },
                    { label: '报价单明细ID', name: 'quotationheatid', hidden: true },
                    { label: '生产编号', name: 'quotationheatcode', index: 'quotationheatcode', width: 80, align: 'left', sortable: true },
                    { label: '客户编号', name: 'customercode', index: 'customercode', width: 70, align: 'left', sortable: true },
                    { label: '客户名称', name: 'customername', index: 'customername', width: 100, align: 'left', sortable: true },
                    { label: '材质', name: 'steeldescription', index: 'steeldescription', width: 50, align: 'left', sortable: true },
                    { label: '工件名称', name: 'productname', index: 'productname', width: 60, align: 'left', sortable: true },
                    { label: '外形尺寸', name: 'remark', index: 'remark', width: 100, align: 'left', sortable: true },
                    { label: '热处理类别', name: 'technology', index: 'technology', width: 60, align: 'left', sortable: true },
                    { label: '技术要求', name: 'technologquery', index: 'technologquery', width: 60, align: 'left', sortable: true },
                    { label: '件数', name: 'qty', index: 'qty', width: 50, align: 'left', sortable: true },
                    { label: '重量', name: 'weight', index: 'weight', width: 50, align: 'left', sortable: true },
                    { label: '状态', name: 'billstatus', index: 'billstatus', width: 60, align: 'left', sortable: true },
                    

            ],
            viewrecords: true,
            rowNum: 300,
            rowList: [300, 500, 1000, 2000, 5000],
            pager: "#gridPager",
            sortname: 'CreateDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            gridview: true,
            onSelectRow: function () {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
            },
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
            },
            ondblClickRow: function (rowid, iRow, iCol, e) {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
            },
            multiselect: true,
        });
    }

    function btn_confirm() {

        var selr = jQuery('#gridTable').jqGrid('getGridParam', 'selarrrow');
        var s = "";
        var customercode = "";
        if (selr.length) {
            for (var i = 0; i < selr.length; i++) {
                var myrow = jQuery('#gridTable').jqGrid('getRowData', selr[i]);
                if (i == 0) {
                    customercode = myrow.customercode;
                }
                if (customercode != myrow.customercode) {
                    alertDialog("操作失败：客户不一致，请重新选择！", 0);
                    return false;
                }
                s = s + myrow.quotationheatid + ",";
            }
            confirmDialog("提示", "确定要发运吗？", function (r) {
                if (r) {
                    Loading(true, "正在提交数据...");
                    window.setTimeout(function () {
                        AjaxJson("/QuotationHeatModule/BY_QuotationHeat/SureConfirm", { quotationheatids: s }, function (data) {
                            tipDialog(data.Message, 3, data.Code);
                            top.frames[tabiframeId()].windowload();
                            windowload();
                        });
                    }, 200);
                }
            });
        }


    }
</script>
<!--工具栏-->
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" id="QueryParameter" class="form-find" style="height: 45px;">
        <tr>
            <td>
                生产编号：
                <input id="BillStatus" type="hidden" value="检验通过" />
                <input id="isall" type="hidden" value="1" />
                <input id="QuotationHeatCode" type="text" class="txt" style="width: 80px" />
                客户：
                <input id="CustomerCode" type="text" class="txt" style="width: 80px" />
                材质：
                <input id="SteelDescription" type="text" class="txt" style="width: 80px"  />
                工件名称：
                <input id="ProductName" type="text" class="txt" style="width: 80px"  />
                外形尺寸：
                <input id="Remark" type="text" class="txt" style="width: 80px"  />
                热处理类型：
                <select id="Technology" class="select" onchange="btn_Search();">
                    <option value="">全部</option>
                </select>
                订单日期
                @*<input id="CreateDate_StartTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 00:00'})" value="@DNS.Utilities.DateTimeHelper.FirstDayOfMonth() 00:00" style="width: 100px"  />
        至：
        <input id="CreateDate_EndTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 23:59'})" value="@DNS.Utilities.DateTimeHelper.LastDayOfMonth() 23:59" style="width: 100px" />*@
                <input id="CreateDate_StartTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 00:00'})" style="width: 100px" />
                至：
                <input id="CreateDate_EndTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 23:59'})" style="width: 100px" />

                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
                <input id="btnBuild" type="button" class="btnSearch" value="生成送货单" onclick="btn_confirm()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
