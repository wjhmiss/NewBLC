@{
    ViewBag.Title = "碎料入仓";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    //加载表格
    function GetGrid() {
        $("#gridTable").jqGrid({
        url: "@Url.Content("~/StorageModule/BY_InStock/GridPageBroJson?InStockType=1")",
        datatype: "json",
        height: $(window).height() - 109,
        autowidth: true,
        colModel: [
                { label: '入库单ID', name: 'instockid', index: 'instockid', width: 0, align: 'left',sortable: true,hidden:true  },
                { label: '入仓编码', name: 'billcode', index: 'billcode', width: 100, align: 'left',sortable: true  },
                { label: '钢种', name: 'steelcode', index: 'steelid', width: 80, align: 'left',sortable: true  },
                { label: '钢种描述', name: 'steeldescription', index: 'steeldescription', width: 80, align: 'left',sortable: true  },
                { label: '类型', name: 'steeltype', index: 'steeltype', width: 80, align: 'left',sortable: true  },
                { label: '钢板状态', name: 'steelstatus', index: 'steelstatus', width: 80, align: 'left',sortable: true  },
                { label: '实际重量', name: 'weight', index: 'weight', width: 50, align: 'left',sortable: true  },
                { label: '备注', name: 'remark', index: 'remark', width: 100, align: 'left',sortable: true  },
                {
                    label: '创建时间', name: 'createdate', index: 'createdate', width: 120, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd');
                    }
                },
                { label: '创建用户', name: 'createusername', index: 'createusername', width: 80, align: 'left',sortable: true  }
        ],
        viewrecords: true,
        rowNum: 30,
        rowList: [30, 50, 100, 500, 5000],
        pager: "#gridPager",
        sortname: 'createdate',
        sortorder: 'desc',
        rownumbers: true,
        shrinkToFit: false,
        altRows: true,
        altclass: 'altclass',
        gridview: true,
    });
}
    //新增
    function btn_add() {
        var url = "/StorageModule/BY_InStock/BrokenForm"
        openDialog(url, "Form", "碎料入仓", 650, 200, function (iframe) {
            top.frames[iframe].AcceptClick()
        });
    }
    //编辑
    function btn_edit() {
        var KeyValue = GetJqGridRowValue("#gridTable", "instockid");
        if (IsChecked(KeyValue)) {
            var url = "/StorageModule/BY_InStock/Form?KeyValue=" + KeyValue;
            openDialog(url, "Form", "碎料入仓", 650, 200, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //删除
    function btn_delete() {
        var KeyValue = GetJqGridRowValue("#gridTable", "instockid");
        if (IsDelData(KeyValue)) {
            var delparm = 'KeyValue=' + KeyValue;
            delConfig('/StorageModule/BY_InStock/Delete', delparm, KeyValue.split(",").length);
        }
    }
    //明细
    function btn_detail() {
        var KeyValue = GetJqGridRowValue("#gridTable", "instockid");
        if (IsChecked(KeyValue)) {
            var url = "/StorageModule/BY_InStock/BrokenDetail?KeyValue=" + KeyValue;
            Dialog(url, "Detail", "碎料入仓", 650, 200, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入
        
    }
</script>
<div class="leftline rightline" style="margin-left: 1px; margin-right: 1px;">
    <div class="tools_bar" style="margin-top: 1px; margin-bottom: 0px;">
        <div class="PartialButton">
            @Html.Partial("_PartialButton")
        </div>
    </div>
    <div id="grid_List" class="topline" style="margin-top: 1px;">
        <table id="gridTable"></table>
        <div id="gridPager"></div>
    </div>
</div>
