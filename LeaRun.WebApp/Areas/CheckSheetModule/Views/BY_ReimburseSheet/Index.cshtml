@{
    ViewBag.Title = "费用申请单";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        BindDropItem("#BankNum", "银行名称", "==请选择==");
        setType();

        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    function setType() {
        if ($("#Type0").val() == "收款") {
            BindDropItemT2index("#Type1", "#Type2", "收款类型", "==请选择==");

        }
        else {
            BindDropItemT2index("#Type1", "#Type2", "CostType", "==请选择==");
        }
    }
    function btn_audit() {
        var KeyValue = GetJqGridRowValue("#gridTable", "ReimburseSheetID");
        var Status = GetJqGridRowValue("#gridTable", "Status");
        //if (IsComfirm == "是" ) {
        //    tipDialog("已审核，不能多次审核", 3, -1);
        //    return;
        //}
        if (IsChecked(KeyValue)) {
            confirmDialog("提示", "确定要审核通过？", function (r) {
                if (r) {
                    Loading(true, "正在提交数据...");
                    window.setTimeout(function () {
                        AjaxJson("/CheckSheetModule/BY_ReimburseSheet/Audit?KeyValue=" + KeyValue, "", function (data) {
                            tipDialog(data.Message, 3, data.Code);
                            windowload();
                        });
                    }, 200);
                }
            });
        }

    }
    //加载表格
    function GetGrid() {
        var Parameter = [{
            paramName: "ReimburseSheetCode",
            paramValue: "is",
            Operation: "Null",
        }]
        var rowScrod = 0;
        var SelectRowIndx = 0;
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/CheckSheetModule/BY_ReimburseSheet/GridPageJson11")?ParameterJson=" + escape(JSON.stringify(Parameter)),
            datatype: "json",
            height: $(window).height() - 200,
            autowidth: true,
            colModel: [
                    { label: '申请单ID', name: 'ReimburseSheetID', index: 'ReimburseSheetID', width: 0, align: 'left', sortable: true, hidden: true },
                    { label: '单号', name: 'ReimburseSheetCode', index: 'ReimburseSheetCode', width: 120, align: 'left', sortable: true, hidden: true },
                    { label: '助记码', name: 'MnemonicCode', index: 'MnemonicCode', width: 120, align: 'left', sortable: true, hidden: true },
                    { label: '报价单号', name: 'QuotationCode', index: 'QuotationCode', width: 120, align: 'left', sortable: true, hidden: true },
                    { label: 'CanUseMoney', name: 'CanUseMoney', index: 'CanUseMoney', width: 120, align: 'left', sortable: true, hidden: true },
                    {
                        label: '收款项', name: 'Type0', index: 'Type0', width: 50, align: 'left', sortable: true
                    },
                    {
                        label: '收款项1', name: 'Type1', index: 'Type1', width: 80, align: 'left', sortable: true
                    },
                    {
                        label: '收款项2', name: 'Type2', index: 'Type2', width: 80, align: 'left', sortable: true
                    },
                    {
                        label: '单号类型', name: 'Opions', index: 'Opions', width: 80, align: 'left', sortable: true
                    },
                    { label: '客户名称', name: 'CustomerName', index: 'CustomerName', width: 120, align: 'left', sortable: true },
                    { label: '人员', name: 'WorkerName', index: 'WorkerName', width: 80, align: 'left', sortable: true },
                    { label: '部门', name: 'DepartmentName', index: 'DepartmentName', width: 80, align: 'left', sortable: true },
                    {
                        label: '类型', name: 'GetType', index: 'GetType', width: 80, align: 'left', sortable: true
                    },
                     {
                         label: '类型', name: 'LType', index: 'LType', width: 50, align: 'left', sortable: true,
                         formatter: function (cellvalue, options, rowObject) {
                             if (cellvalue == "RCL") {
                                 return "热处理";;
                             }
                             else {
                                 return "钢材";;

                             }
                         }
                     },
                    { label: '关联单号', name: 'Code', index: 'Code', width: 120, align: 'left', sortable: true },
                    { label: '发票号', name: 'InvoiceNum', index: 'InvoiceNum', width: 120, align: 'left', sortable: true },
                    {
                        label: '计价金额', name: 'TotalAmount', index: 'TotalAmount', width: 50, align: 'left', sortable: true, hidden: true
                    },
                    {
                        label: '实收金额', name: 'GETMoney', index: 'GETMoney', width: 50, align: 'left', sortable: true
                    },
                    { label: '折让金额', name: 'ZRMoney', index: 'ZRMoney', width: 50, align: 'left', sortable: true, },
                    {
                        label: '剩余金额', name: 'NotGetMoney', index: 'NotGetMoney', width: 50, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (rowObject.Opions=="预收款") {
                                return rowObject.CanUseMoney;
                            }
                            else {
                                return cellvalue;
                            }
                        }
                    },
                    { label: '折让备注', name: 'ZRRemark', index: 'ZRRemark', width: 50, align: 'left', sortable: true, },
                    { label: '收款人', name: 'RequiredMan', index: 'RequiredMan', width: 60, align: 'left', sortable: true },
                    {
                        label: '收款日期', name: 'RequiredDate', index: 'RequiredDate', width: 120, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    { label: '收款银行', name: 'BankNum', index: 'BankNum', width: 120, align: 'left', sortable: true },

                    {
                        label: '单据备注', name: 'Remark1', index: 'Remark1', width: 100, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");
                            }
                            return "";
                        }
                    },
                     {
                         label: '备注', name: 'Remark', index: 'Remark', width: 100, align: 'left', sortable: true,
                         formatter: function (cellvalue, options, rowObject) {
                             if (!!cellvalue) {
                                 return cellvalue.replace(/,/g, "，");
                             }
                             return "";
                         }
                     },
                    { label: '审核人', name: 'AuditMan', index: 'AuditMan', width: 60, align: 'left', sortable: true, hidden: true },
                    {
                        label: '状态', name: 'Status', index: 'Status', width: 50, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (cellvalue == "1") {
                                return "审核通过";
                            }
                            if (cellvalue == "-1") {
                                return "拒绝";
                            }
                            if (cellvalue == "0") {
                                return "未审核";
                            }
                        }, hidden: true
                    },
                    { label: '备注', name: 'AuditRemark', index: 'AuditRemark', width: 240, align: 'left', sortable: true, hidden: true }
            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'CreateDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            gridview: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                btn_edit();
            },
            footerrow: true,
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
                //合计
                $(this).footerData("set", {
                    "Opions": "合计",
                    "TotalAmount": FormatCurrency($("#gridTable").getCol('TotalAmount', false, 'sum')),
                    "GETMoney": FormatCurrency($("#gridTable").getCol('GETMoney', false, 'sum')),
                    "ZRMoney": FormatCurrency($("#gridTable").getCol('ZRMoney', false, 'sum')),

                    "NotGetMoney": FormatCurrency($("#gridTable").getCol('NotGetMoney', false, 'sum')),

                });
                var data = $("#gridTable").jqGrid("getRowData");
                for (var i = 0; i < data.length; i++) {
                    var item = i + 1;
                    if (data[i].Status == "审核通过") {
                        $("#" + item).find('td').css("background-color", "#008800");
                    }
                }

                $(".ui-jqgrid-bdiv").first().scrollTop(rowScrod);
            },
            onSelectRow: function (rowid, status) {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
                rowScrod = $("#" + rowid).position().top;

            },
