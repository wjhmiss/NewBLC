<!--工具栏-->
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <td>日期 从：
                <input id="CreateDate_StartTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 00:00'})" style="width: 80px" />
           至：
                <input id="CreateDate_EndTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 23:59'})" style="width: 80px" />
           人员：
                <input id="WorkerName" type="text" class="txt" style="width: 80px" />
            关联/发票号：
                <input id="Code" type="text" class="txt" style="width: 80px" />
            客户：
                <input id="CustomerName" type="text" class="txt" style="width: 80px" />
            收款银行：
                <select id="BankNum" class="select">
                    <option value="">全部</option>
                </select>
           类型：
                <select id="LType" class="select">
                    <option value="">全部</option>
                    <option value="GC">钢材</option>
                    <option value="LJ">配件</option>
                    <option value="RCL">热处理</option>
                </select>
           选项：
                <select id="Opions" class="select" onchange="">
