        function calcLength(Thick, Weigh, BoreSize,Weight, Density) {
            var Length = 0;
            if (Weigh == 0) {
                if (BoreSize > 0) {
                    Length = (Weight / ((Thick / 2) * (Thick / 2) * Density * 3.14 / 1000000 - (BoreSize / 2) * (BoreSize / 2) * Density * 3.14 / 1000000)).toFixed(2);
                }
                else {
                    Length = (Weight * 1000000 / ((Thick / 2) * (Thick / 2) * 3.1415 * Density)).toFixed(2);
                }
            }
            else {
                Length = (Weight * 1000000 / (Thick * Weigh * Density)).toFixed(2);
            }
            return Length;
        }
