    function enterInput() {
        var e = e || window.event || arguments.callee.caller.arguments[0];
        var tar = e.srcElement || e.target;
        if (e && e.keyCode == 13) {//回车
            window.event.keyCode = 9;
            if ($(tar).attr('id') == "Remark") {
                AcceptClick();
            }
            return;
        }
    }
    //得到一个对象实体
    function InitControl() {
        if ($("#Type0").val() == "收款") {
            getAjax('/CommonModule/DataDictionary/BinDingItemsJson1', { Code: "收款类型", FullName: $("#Type1").val() }, function (data1) {
                $("#Type2").empty()
                var itemjson1 = eval("(" + data1 + ")");
                $.each(itemjson1, function (i) {
                    $("#Type2").append($("<option></option>").val(itemjson1[i].FullName).html(itemjson1[i].FullName));
                });
            });
        }
        else {
            getAjax('/CommonModule/DataDictionary/BinDingItemsJson1', { Code: "CostType", FullName: $("#Type1").val() }, function (data1) {
                $("#Type2").empty()
                var itemjson1 = eval("(" + data1 + ")");
                $.each(itemjson1, function (i) {
                    $("#Type2").append($("<option></option>").val(itemjson1[i].FullName).html(itemjson1[i].FullName));
                });
            });
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }

        $("#RequiredMoney").val(Number($("#GETMoney").val()) + Number($("#ZRMoney").val()))

        if ($("#Opions").val() != "应收款") {
            $("#Code").val("");
            if ($("#CustomerCode").val() == "") {
                tipDialog("请选择客户", 3, 0);
                $("#CustomerCode").select();
                return false;
            }
            if ($("#LType").val() == "") {
                tipDialog("请选择热处理或钢材！", 3, 0);
                $("#LType").focus();
                return false;
            }
        }
        if ($("#RequiredMoney").val() == "0") {
            tipDialog("请输入获取金额！", 3, 0);
            $("#GETMoney").select();
            return false;
        }
        if ($("#Code").val() == "" && $("#Opions").val() == "应收款") {
            tipDialog("请选择单号！", 3, 0);
            $("#Code").select();
            return false;
        }

        if (!checkCustomerName() && $("#Opions").val() == "应收款") {
            tipDialog("请选择相同客户单号！", 3, 0);
            return false
        }

        var postData = GetWebControls("#form1");
        AjaxJson("/CheckSheetModule/BY_ReimburseSheet/SubmitFormCost?Code1=" + $("#Code").val(), postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            //location.href = location.href;
            //window.setTimeout(function () {closeDialog();}, 500);
            $("#Code").val("");
            $("#CheckCodeGenMoney").val("");
            $("#GETMoney").val(0);
            $("#RequiredMoney").val(0);
            $("#GetType").val("现金");
            $("#Opions").val("应收款");
            $("#ZRMoney").val(0);
            $("#Remark").val("");
            btn_Search();
        });
    }
    var temp = 0;
    function setGenMoney() {
        if ($("#Code").val() != "") {
            AjaxJson("/CheckSheetModule/BY_CheckSheet/SetForm1", { Code: $("#Code").val(), CodeType: $("#CodeType").val() }, function (data) {
                if (data.Code == "1") {
                    temp = Number((data.Message)).toFixed(2);
                    $("#CheckCodeGenMoney").val("此单还剩：" + temp)
                    //$("#TotalAmount").val(temp.toFixed(2));
                    $("#CheckRemark").val((data.Attribute).toFixed(2));

                }
                else {
                    temp = 0;
                }
            });
        }
    }
    function setZRMoney() {
        //if ($("#GETMoney").val() != "") {
        //    $("#ZRMoney").val((temp - Number($("#GETMoney").val())).toFixed(2));
        //}
        if ($("#Opions").val() == "预收款") {
            $("#ZRMoney").val(0);

        }
    }
    function setFF() {
        if ($("#CheckCodeGenMoney").val().indexOf('-') >= 0) {
            if (!!Number($("#GETMoney").val())) {
                $("#GETMoney").val(-Math.abs($("#GETMoney").val()));

            }
            else {
                $("#GETMoney").val("");

            }
        }
        setZRMoney();
    }

    //客户编码自动补全
    function CustomerAutocomplete() {
        var $CustomerCode = $("#CustomerCode");
        $CustomerCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("CustomerCode", function (data) {
            $("#CustomerId").val(data.CustomerId);
            $("#CustomerCode").val(data.CustomerCode);
            $("#CustomerName").val(data.FullName);
            $("#PaymentMode").val(data.PaymentMode);
            btn_Search();
        });
        //获取数据源
        function DataSource() {
            $("#CustomerId").val('');
            AjaxJson("/CommonModule/Customer/GetAutoCompleJson", { keywords: $CustomerCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="CustomerId" style="display: none;">' + DataJson[i].CustomerId + '</td>';
                    html += '<td id="CustomerCode" style="width: 30%;">' + DataJson[i].Code + '</td>';
                    html += '<td id="FullName" style="width: 70%;">' + DataJson[i].FullName + '</td>';
                    html += '<td id="ShortName" style="display: none;">' + DataJson[i].ShortName + '</td>';
                    html += '<td id="Sellpeople" style="display: none;">' + DataJson[i].Sellpeople + '</td>';
                    html += '<td id="SalesArea" style="display: none;">' + DataJson[i].Sellarea + '</td>';
                    html += '<td id="DiscountRate" style="display: none;">' + DataJson[i].DiscountRate + '</td>';
                    html += '<td id="TransitMode" style="display: none;">' + DataJson[i].TransitMode + '</td>';
                    html += '<td id="PaymentMode" style="display: none;">' + DataJson[i].PaymentMode + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("CustomerCode", "300px", "200px", html, function (data) {
                    $("#CustomerId").val(data.CustomerId);
                    $("#CustomerCode").val(data.CustomerCode);
                    $("#CustomerName").val(data.FullName);
                    $("#PaymentMode").val(data.PaymentMode);
                    btn_Search();
                });

            });
        }
    }

    function dispalydiv() {
        if ($("#BJboard1").prop("checked") && !$("#BJboard2").prop("checked") && !$("#BJboard3").prop("checked") && !$("#BJboard5").prop("checked")) {
            $("#div1").show();
            $("#div2").hide();
            $("#div3").hide();
            $("#div5").hide();
        }

        if (!$("#BJboard1").prop("checked") && $("#BJboard2").prop("checked") && !$("#BJboard3").prop("checked") && !$("#BJboard5").prop("checked")) {
            $("#div2").show();
            $("#div1").hide();
            $("#div3").hide();
            $("#div5").hide();
        }

        if (!$("#BJboard1").prop("checked") && !$("#BJboard2").prop("checked") && $("#BJboard3").prop("checked") && !$("#BJboard5").prop("checked")) {
            $("#div3").show();
            $("#div5").hide();
            $("#div2").hide();
            $("#div1").hide();
        }
        if (!$("#BJboard1").prop("checked") && !$("#BJboard2").prop("checked") && !$("#BJboard3").prop("checked") && $("#BJboard5").prop("checked")) {
            $("#div5").show();
            $("#div3").hide();
            $("#div2").hide();
            $("#div1").hide();
        }
        btn_Search();
    }

    function clearCode() {
        if ($("#Opions").val() == "预收款") {
            $("#Code").val("");
            $("#ZRMoney").val(0);
            $("#LType").show();

        }
        else {
            $("#LType").hide();
            $("#LType").val("");

        }

    }

    function checkCustomerName() {
        if (($("#BJboard1").prop("checked") && !$("#BJboard2").prop("checked") && !$("#BJboard3").prop("checked")) && $("#Opions").val() != "预收款") {
            var selr = jQuery('#gridTable1').jqGrid('getGridParam', 'selarrrow');
            var customercode ="";
            if (selr.length) {
                for (var i = 0; i < selr.length; i++) {
                    var myrow = jQuery('#gridTable1').jqGrid('getRowData', selr[i]);
                    if (i==0) {
                        customercode = myrow.customercode;
                    }
                    if (myrow.customercode != customercode) {
                        return false;
                    }
                }
            }
            else {
                tipDialog("请选择送货单！", 3, 0);
                return false;
            }
        }

        if (!$("#BJboard1").prop("checked") && $("#BJboard2").prop("checked") && !$("#BJboard3").prop("checked")) {
            var selr = jQuery('#gridTable2').jqGrid('getGridParam', 'selarrrow');
            var customercode = "";
            if (selr.length) {
                for (var i = 0; i < selr.length; i++) {
                    var myrow = jQuery('#gridTable2').jqGrid('getRowData', selr[i]);
                    if (i == 0) {
                        customercode = myrow.CustomerCode;
                    }
                    if (myrow.CustomerCode != customercode) {
                        return false;
                    }
                }
            }
            else {
                tipDialog("请选择对账单！", 3, 0);
                return false;
            }
        }
        if (!$("#BJboard1").prop("checked") && !$("#BJboard2").prop("checked") && $("#BJboard3").prop("checked")) {
            var selr = jQuery('#gridTable3').jqGrid('getGridParam', 'selarrrow');
            var customercode = "";
            if (selr.length) {
                for (var i = 0; i < selr.length; i++) {
                    var myrow = jQuery('#gridTable3').jqGrid('getRowData', selr[i]);
                    if (i == 0) {
                        customercode = myrow.CustomerCode;
                    }
                    if (myrow.CustomerCode != customercode) {
                        return false;
                    }
                }
            }
            else {
                tipDialog("请选择账单！", 3, 0);
                return false;
            }
        }
        return true;
    }
</script>
