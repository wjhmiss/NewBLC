    @Scripts.Render("~/Content/Scripts/frameworkjquery")
    <script type="text/javascript">
        var count = 0;


        $(function () {
            updates();
            
        });


        function updates() {
            AjaxJsonNoMassge("@Url.Content("~/ReportModule/Production/GridPageListWorkDetail1")", { }, function (data) {
                count = data.length;
                var orderdetail = data;
                $('#items').html("");
                $.each(orderdetail, function (i) {
                        var OrderDetailhtml = '<tr>';
                        OrderDetailhtml += '                    <td nowrap class="td1" >' + orderdetail[i].workername + '</td>';
                        OrderDetailhtml += '                    <td nowrap class="td2" >' + orderdetail[i].k001 + '</td>';
                        OrderDetailhtml += '                    <td nowrap class="td3" >' + orderdetail[i].x002 + '</td>';
                        OrderDetailhtml += '                    <td nowrap class="td4" >' + orderdetail[i].j001 + '</td>';
                        OrderDetailhtml += '                    <td nowrap class="td5" >' + orderdetail[i].p001 + '</td>';
                        OrderDetailhtml += '                    <td nowrap class="td6" >' + orderdetail[i].m003 + '</td>';
                        OrderDetailhtml += '                    <td nowrap class="td7" >' + orderdetail[i].jy01 + '</td>';
                        OrderDetailhtml += '                </tr>';
                        $('#items').append(OrderDetailhtml);
                });
                
                setTimeout('updates()', 5000 * (count / 5 + 1));
            });
        }
        setTimeout('init_srolltextA1()', 4000);
    </script>
