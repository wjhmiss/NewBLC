            </td>
           @* <th>订单单号：</th>
            <td>
                <input id="OrderCode" type="text" class="txt" style="width: 100px" />
            </td>*@
            <th>入单日期 从：</th>
            <td>
                <input id="CreateDate_StartTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 00:00'})" style="width: 100px" />
            </td>
            <th>入单日期 至：</th>
            <td>
                <input id="CreateDate_EndTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 23:59'})" style="width: 100px" />
            </td>
            <td>&nbsp;&nbsp;&nbsp;
                <input id="btnSearch" type="button" class="btnSearch" value="查 询" onclick="btn_Search()" />
                &nbsp;&nbsp;&nbsp;
                <input id="btn_print4" type="button" class="btnSearch" value="打 印" onclick="btn_Print()" />
                @*<input id="btn_print2" type="button" class="btnSearch" value="开料单打印" onclick="BJPrintPreview2()" />
                <input id="btn_print3" type="button" class="btnSearch" value="加工单打印" onclick="BJPrintPreview3()" />
                <input id="btn_print4" type="button" class="btnSearch" value="钢印打印" onclick="BJPrintPreview4()" />
                <input id="btn_print1" type="button" class="btnSearch" value="汇总表" onclick="BJPrintPreview1()" />
                 <input id="btn_print00" type="button" class="btnSearch" value="毅昌检测单" onclick="YCPrint1()" />
                 <input id="btn_print01" type="button" class="btnSearch" value="毅昌材质单" onclick="YCPrint2()" />
                 <input id="btn_print02" type="button" class="btnSearch" value="群达检验单" onclick="QDPrint()" />
                 <input id="btn_print03" type="button" class="btnSearch" value="BYD检验单" onclick="BYDPrint()" />*@
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
