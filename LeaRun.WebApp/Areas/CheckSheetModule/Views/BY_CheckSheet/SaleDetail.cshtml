    function btn_Search() {
        var Condition = GetParameterJson("QueryParameter");
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/CheckSheetModule/BY_CheckSheet/SaleDetailPageJson")?Year=" + $("#year").find("select[name='year']").val() + "&Customer=" + escape($("#Customer").val()) + "&type=" + escape($("#Type").val()) + "&IsComfirm=" + $("#IsComfirm").prop("checked"), page: 1 }).trigger('reloadGrid');
    }
    function checkYuqi(montho, paytype) {
        var now = new Date();
        if (!paytype) {
            return false;
        }
        var month = Number(now.getMonth());
        if (paytype.indexOf("30") >=0) {
            if (month - montho > 0) {
                return true;
            } else {
                return false;
            }
        }
        if (paytype.indexOf("60") >= 0) {
            if (month - montho > 1) {
                return true;
            } else {
                return false;
            }
        }
        if (paytype.indexOf("90") >= 0) {
            if (month - montho > 2) {
                return true;
            } else {
                return false;
            }
        }
        if (paytype.indexOf("120") >= 0) {
            if (month - montho > 3) {
                return true;
            } else {
                return false;
            }
        }
        if (paytype.indexOf("150") >= 0) {
            if (month - montho > 4) {
                return true;
            } else {
                return false;
            }
        }
        if (paytype.indexOf("180") >= 0) {
            if (month - montho > 5) {
                return true;
            }
            else {
                return false;
            }
        }
        return true;
    }

