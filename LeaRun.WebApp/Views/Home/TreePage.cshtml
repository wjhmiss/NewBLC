    <script>
        var listA = [];
        var listB = [];
        var listC = [];
        $(function () {
            jQuery("#navigation1").Smartmenu({
                animationDuration: 350
            });
            jQuery("#navigation2").Smartmenu({
                animationDuration: 350
            });
            jQuery("#navigation3").Smartmenu({
                animationDuration: 350
            });
            jQuery("#navigation4").Smartmenu({
                animationDuration: 350
            });
            jQuery("#navigation5").Smartmenu({
                animationDuration: 350
            });
            AjaxJson("/Home/TaskMessageChart", {}, function (DataJson) {
                $("#Number_A").html(DataJson.A);
                $("#Number_B").html(DataJson.B);
                $("#Number_C").html(DataJson.C);
                $("#Number_D").html(DataJson.D);
                $("#Number_E").html(DataJson.E);
                var listA = DataJson.weekchartO;
                var listB = DataJson.weekchartQ;
                var listC = DataJson.weekchartD;
                $('#container').highcharts({
                    chart: {
                        type: 'spline'
                    },
                    title: {
                        text: '最近5周报价单、订单、送货单统计数量'
                    },
                    xAxis: {
                        categories: DataJson.names//['一周', '二周', '三周', '四周', '五周']
                    },
                    yAxis: {
                        title: {
                            text: '统计数量'
                        },
                        labels: {
                            formatter: function () {
                                return this.value + ''
                            }
                        }
                    },
                    tooltip: {
                        crosshairs: true,
                        shared: true
                    },
                    plotOptions: {
                        spline: {
                            marker: {
                                radius: 4,
                                lineColor: '#666666',
                                lineWidth: 1
                            }
                        }
                    },
                    exporting: {
                        url: '/Home/Export',  //1、自带导出按钮的请求路径
                        filename: 'MyChart',
                        width: 1200
                    },
                    series: [{
                        name: '报价单统计',
                        data: listB

                    }, {
                        name: '工单统计',
                        data: listA
                    },  {
                        name: '发运单统计',
                        data: listC

                    }]
                });
            })

            //AjaxJson("/OrderModule/OrderQuery/GetGQOrder", {}, function (DataJson) {
