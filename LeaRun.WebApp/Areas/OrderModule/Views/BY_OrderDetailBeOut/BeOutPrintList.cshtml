        ////var LODOP = getLodop();
        LODOP.PRINT_INIT("打印初始化");
        LODOP.SET_PRINT_COPIES(1);
        LODOP.SET_PRINT_PAGESIZE(2, "", "", "A5")
        var strHTML = document.getElementsByTagName("html")[0].innerHTML;
        LODOP.ADD_PRINT_HTM(0, 0, "100%", "100%", strHTML);
        LODOP.PREVIEW();

        //LODOP.PRINTA();
        top.frames[tabiframeId()].windowload();
        window.setTimeout(function () {closeDialog();}, 500);
        //if (LODOP.PRINTA()) {
        //    LODOP.PRINT();
        //    tipDialog("打印成功", 3, 1);
        //    top.frames[tabiframeId()].windowload();
        //    window.setTimeout(function () {closeDialog();}, 500);

        //}
        //else
        //    //alert("");
        //    tipDialog("放弃打印！", 3, 1);

    };
</script>
    <style>
    .form-print th {
        font-size: 10pt;
        font-family: sans-serif;
        background-color: #fff;
        height: 25px;
        line-height:25;
        white-space: nowrap;
        width: 80px;
        font-weight: bold;
        text-align: right;
        padding-right: 2px;
    }

    .form-print td {
        font-family: sans-serif;
        height: 25px;
        line-height:25px;
        padding-right: 2px;
        font-size: 10pt; 
        font-weight: bold;
    }

    .tb_Order_Detail td {
        border: 1px solid #000;
    }

    .tb_Order_Detail th {
        text-align: center;
    }

    .topline {
        border-top: 1px solid #000;
        text-align: center;
    }

    .rightline {
        border-right: 1px solid #000;
    }

    .bottomline {
        border-bottom: 1px solid #000;
    }
</style>
</html>
