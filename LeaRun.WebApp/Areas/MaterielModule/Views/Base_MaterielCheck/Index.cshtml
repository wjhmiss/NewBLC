@{
    ViewBag.Title = "物料盘点";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    //加载表格
    function GetGrid() {
        $("#gridTable").jqGrid({
        url: "@Url.Content("~/MaterielModule/Base_MaterielCheck/GridPageJson")",
        datatype: "json",
        height: $(window).height() - 179,
        autowidth: true,
        colModel: [
                { label: '物料id', name: 'MaterielCheckId', index: 'MaterielCheckId', hidden: true },
                { label: '物料号', name: 'MaterielCheckCode', index: 'MaterielCheckCode', hidden: true },
                { label: '物料id', name: 'MaterielId', index: 'MaterielId', hidden: true },
                { label: '物料号', name: 'MaterielCode', index: 'MaterielCode', width: 80, align: 'left', sortable: true },
                { label: '物料名称', name: 'MaterielName', index: 'MaterielName', width: 100, align: 'left', sortable: true },
                { label: '物料类型', name: 'MaterielType', index: 'MaterielType', width: 80, align: 'left',sortable: true  },
                { label: '尺寸', name: 'MaterielSize', index: 'MaterielSize', width: 100, align: 'left',sortable: true  },
                { label: '单位', name: 'Unit', index: 'Unit', width: 60, align: 'left',sortable: true  },
                { label: '客户ID', name: 'CustomerId', index: 'CustomerId', hidden: true },
                { label: '客户编号', name: 'CustomerCode', index: 'CustomerCode', hidden: true },
                { label: '供应商名称', name: 'CustomerName', index: 'CustomerName', width: 100, align: 'left', sortable: true },
                { label: '库存数量', name: 'BeforeQty', index: 'BeforeQty', width: 60, align: 'left',sortable: true  },
                { label: '实际盘点数量', name: 'NowQty', index: 'NowQty', width: 60, align: 'left',sortable: true  },
                { label: '盈亏数量', name: 'YSQty', index: 'YSQty', width: 60, align: 'left',sortable: true  },
                { label: '盘点员工姓名', name: 'WorkerName', index: 'WorkerName', width: 80, align: 'left',sortable: true  },
                {
                    label: '审核', name: 'Status', index: 'Status', width: 60, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return cellvalue == "0" ? "否" : "是";
                    }
                },
                {
                    label: '备注', name: 'Remark', index: 'Remark', width: 120, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        if (!!cellvalue) {
                            return cellvalue.replace(/,/g, "，");;

                        }
                        return "";
                    }
                },
                {
                    label: '创建时间', name: 'CreateDate', index: 'CreateDate', width: 100, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd');
                    }
                },
                { label: '创建用户', name: 'CreateUserName', index: 'CreateUserName', width: 80, align: 'left',sortable: true  },
                
        ],
        viewrecords: true,
        rowNum: 30,
        rowList: [30, 50, 100, 500, 5000],
        pager: "#gridPager",
        sortname: 'CreateDate',
        sortorder: 'desc',
        rownumbers: true,
        shrinkToFit: false,
        gridview: true,
        ondblClickRow: function (rowid, iRow, iCol, e) {
            btn_edit();
        },
        footerrow: true,
        gridComplete: function () {
            //合计
            $(this).footerData("set", {
                "MaterielName": "合计",
                "BeforeQty": FormatCurrency($("#gridTable").getCol('BeforeQty', false, 'sum')),
                "NowQty": FormatCurrency($("#gridTable").getCol('NowQty', false, 'sum')),
                "YSQty": FormatCurrency($("#gridTable").getCol('YSQty', false, 'sum')),
            });
            var data = $("#gridTable").jqGrid("getRowData");
            for (var i = 0; i < data.length; i++) {
                var item = i + 1;
                if (data[i].Status == "是") {
                    $("#" + item).find('td').css("background-color", "#00AA00");
                }

            }
        }
    });
}
    //新增
    function btn_add() {
        var url = "/MaterielModule/Base_MaterielCheck/Form"
        openDialog(url, "Form", "新增物料盘点", 770, 395, function (iframe) {
            top.frames[iframe].AcceptClick()
        });
    }
    //编辑
    function btn_edit() {
        var Status = GetJqGridRowValue("#gridTable", "Status");
        if (Status == "是") {
            alertDialog("当前报价单已审核", 0);
            return false;
        }
        var KeyValue = GetJqGridRowValue("#gridTable", "MaterielCheckId");
        if (IsChecked(KeyValue)) {
            var url = "/MaterielModule/Base_MaterielCheck/Form?KeyValue=" + KeyValue;
            openDialog(url, "Form", "编辑物料盘点", 770, 395, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //删除
    function btn_delete() {
        var Status = GetJqGridRowValue("#gridTable", "Status");
        if (Status == "是") {
            alertDialog("当前报价单已审核", 0);
            return false;
        }
        var KeyValue = GetJqGridRowValue("#gridTable", "MaterielCheckId");
        if (IsDelData(KeyValue)) {
            var delparm = 'KeyValue=' + KeyValue;
            delConfig('/MaterielModule/Base_MaterielCheck/Delete', delparm, KeyValue.split(",").length);
        }
    }
    //明细
    function btn_detail() {
        var KeyValue = GetJqGridRowValue("#gridTable", "MaterielCheckId");
        if (IsChecked(KeyValue)) {
            var url = "/MaterielModule/Base_MaterielCheck/Detail?KeyValue=" + KeyValue;
            Dialog(url, "Detail", "物料盘点明细", 820, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入
        
    }
    function btn_audit() {
        var Status = GetJqGridRowValue("#gridTable", "Status");
        if (Status == "是") {
            alertDialog("当前盘点单已审核", 0);
            return false;
        }
        var KeyValue = GetJqGridRowValue("#gridTable", "MaterielCheckId");
        if (IsChecked(KeyValue)) {
            confirmDialog("提示", "确定要审核通过？", function (r) {
                if (r) {
                    Loading(true, "正在提交数据...");
                    window.setTimeout(function () {
                        AjaxJson("/MaterielModule/Base_MaterielCheck/Update?Status=1&MaterielCheckId=" + KeyValue, "", function (data) {
                            tipDialog(data.Message, 3, data.Code);
                            windowload();
                        });
                    }, 200);
                }
            });
        }
    }

    //查询
    function btn_Search() {
        var Parameter = [{
            paramName: "MaterielName",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR",
            LeftBrace: "("
        }, {
            paramName: "MaterielCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR"
        }, {
            paramName: "MaterielType",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR"
        }, {
            paramName: "WorkerName",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR"
        }
        , {
            paramName: "CustomerName",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "AND",
            RightBrace: ")"
        }, {
            paramName: "Status",
            paramValue: $("#Status").prop("checked") == true ? "0" : "",
            Operation: "Equal",
            Logic: "AND"
        }]

        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/MaterielModule/Base_MaterielCheck/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)), page: 1 }).trigger('reloadGrid');
    }
    //导出
    function btn_Export() {
        SetDeriveExcel("#gridTable", "盘点报表");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }
</script>
<!--工具栏-->
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>关键字：</th>
            <td>
                <input id="keywords" type="text" class="txt" style="width: 200px" />
            </td>
            <td >
                    <span class="item" style="cursor: pointer;">
                        <input type="checkbox" class="checkbox" name="checkbox" id="Status" />
                        <label for="Status">未审核</label>
                    </span>

                </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
                 <input id="btn_export" type="button" class="btnSearch" value="导 出" onclick="btn_Export()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
