        $("#gridTable").trigger("reloadGrid"); //重新载入

    }
    //查询
    function btn_Search() {
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/StorageModule/BY_OutStock/GridPageListJson1")?StartTime=" + $("#StartTime").val() + "&EndTime=" + $("#EndTime").val() + "&SteelCode=" + escape($("#SteelCode").val()) + "&BillCode=" + escape($("#BillCode").val()) + "&BatchCode=" + escape($("#BatchCode").val()) + "&CustomerCode=" + escape($("#CustomerCode").val()), page: 1 }).trigger('reloadGrid');
    }
    //导出
    function btn_Export() {
        SetDeriveExcel("#gridTable", "订单出库信息");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }

    function btn_TJ() {
        AjaxJson("/StorageModule/BY_OutStock/TJB?StartTime=" + $("#StartTime").val() + "&EndTime=" + $("#EndTime").val() + "&SteelCode=" + escape($("#SteelCode").val()) + "&BillCode=" + escape($("#BillCode").val()) + "&BatchCode=" + escape($("#BatchCode").val()) + "&CustomerCode=" + escape($("#CustomerCode").val()), {}, function (DataJson) {
            if (!!DataJson.A[0].tj) {
                alertDialog("提醒：此时间段钢材损耗比为：" + DataJson.A[0].tj + "", 0);
            }

        })
    }


    //钢材编码自动补全
    function SteelAutocomplete() {
        var $SteelCode = $("#SteelCode");
        $SteelCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("SteelCode", function (data) {
            $("#SteelCode").val(data.SteelCode);
        });
        //获取数据源
        function DataSource() {
            AjaxJson("/CommonModule/Steel/GetAutoCompleJson", { keywords: $SteelCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="SteelId" style="display: none;">' + DataJson[i].SteelId + '</td>';
                    html += '<td id="SteelCode" style="width: 50%;">' + DataJson[i].SteelCode + '</td>';
                    html += '<td id="SteelName" style="width: 100%;">' + DataJson[i].SteelName + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("SteelCode", $SteelCode.width() + "px", "200px", html, function (data) {
                    $("#SteelCode").val(data.SteelCode);
                });
            });
        }
    }
