    //导出
    function btn_Export() {
        SetDeriveExcel("#gridTable", "生产报表");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }
</script>
<div class="leftline rightline topline QueryArea" style="margin: 1px; margin-bottom: 0px;">
    <table class="form-find" id="QueryParameter" style="height: 45px;">
        <tr>
            <th>落单时间</th>
                            <td>
                                <input id="Delivery_StartTime" type="text" value="@DNS.Utilities.DateTimeHelper.FirstDayOfMonth()" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd'})" style="width: 100px" />
                                <input id="Delivery_EndTime" type="text" class="txt Wdate" value="@DNS.Utilities.DateTimeHelper.LastDayOfMonth()" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd'})" style="width: 100px" />
                            </td>

            <th>助记编码：</th>
            <td>
                <input id="MnemonicCode" type="text" class="txt" style="width: 120px" />
            </td>
            <th>订单单号：</th>
            <td>
                <input id="OrderCode" type="text" class="txt" style="width: 120px" /></td>
            <th>客户名称：</th>
            <td>
                <input id="CustomerName" type="text" class="txt" style="width: 100px" />
            </td><td>
            <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
                <input id="btn_export" type="button" class="btnSearch" value="导 出" onclick="btn_Export()" />
</td>

        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
