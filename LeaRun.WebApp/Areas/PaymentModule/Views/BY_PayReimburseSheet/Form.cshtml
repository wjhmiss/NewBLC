                paramValue: " and  CustomerId = '" + $("#CustomerId").val() + "' AND TotalAmount - GetedAmount !=0 and (PayCheckSheetCode = '' or PayCheckSheetCode is null)  and Status =1 ",
                Operation: "SQL",
            }
            ]
        }
        var rowScrod = 0;
        var SelectRowIndx = 0;
        $("#gridTable8").jqGrid({
            url: "@Url.Content("~/PaymentModule/Base_PayCompany/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)),
            datatype: "json",
            height: $(window).height() - 335,
            autowidth: true,
            colModel: [
                { label: '选项0', name: 'Type0', index: 'Type0', width: 60, },
                 { label: '选项1', name: 'Type1', index: 'Type1', width: 50, },
                    { label: '选项2', name: 'Type2', index: 'Type2', width: 60, },
                    { label: '物料id', name: 'PayCompanyId', index: 'PayCompanyId', hidden: true },
                    { label: '供应商编号', name: 'CustomerCode', index: 'CustomerCode', width: 100, align: 'left', sortable: true, hidden: true },
                    { label: '付款单号', name: 'PayCompanyCode', index: 'PayCompanyCode', width: 100, align: 'left', sortable: true },
                    { label: '供应商名称', name: 'CustomerName', index: 'CustomerName', width: 100, align: 'left', sortable: true },
                    { label: '关联单号', name: 'Code', index: 'Code', width: 100, align: 'left', sortable: true },
                    { label: '付款事项', name: 'PayName', index: 'PayName', width: 100, align: 'left', sortable: true },
                    { label: '单价', name: 'PricePer', index: 'PricePer', width: 60, align: 'left', sortable: true },
                    { label: '数量', name: 'Qty', index: 'Qty', width: 60, align: 'left', sortable: true },
                    { label: '总金额', name: 'TotalAmount', index: 'TotalAmount', width: 60, align: 'left', sortable: true },
                { label: '已付金额', name: 'GetedAmount', index: 'PayedAmount', width: 80, align: 'left', sortable: true },
                {
                    label: '剩余金额', name: 'NoAmount', index: 'NoAmount', width: 50, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return (Number(rowObject.TotalAmount) - Number(rowObject.GetedAmount)).toFixed(2)
                    }
                },
                    { label: '支付方式', name: 'PayType', index: 'PayType', width: 80, align: 'left', sortable: true },
                    { label: '申请员工姓名', name: 'WorkerName', index: 'WorkerName', width: 80, align: 'left', sortable: true },
                    { label: '申报部门', name: 'DepartmentName', index: 'DepartmentName', width: 120, align: 'left', sortable: true },
                    {
                        label: '申请时间', name: 'CreateDate', index: 'CreateDate', width: 100, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    {
                        label: '备注', name: 'Remark', index: 'Remark', width: 120, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");;

                            }
                            return "";
                        }
                    },
                {
                    label: '剩余金额', name: 'NoAmount', index: 'NoAmount', width: 50, align: 'left', sortable: true, hidden: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return (Number(rowObject.TotalAmount) - Number(rowObject.GetedAmount)).toFixed(2)
                    }
                },
            ],
            viewrecords: true,
            rowNum: 999,
            rowList: [999, 999, 999, 999, 999],
            
            sortname: 'CreateDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            gridview: true,
            onSelectRow: function () {
                var PayCompanyCode = GetJqGridRowValue("#gridTable8", "PayCompanyCode");
                var getedamount = SumGetJqGridRowValue("#gridTable8", "NoAmount");

                $("#Code").val(PayCompanyCode)
                $("#GETMoney").val(0);
                $("#ZRMoney").val(0);
                $("#CheckCodeGenMoney").val("此单还剩：" + getedamount.toFixed(2))
                temp = getedamount.toFixed(2);


                var Type0 = GetJqGridRowValue("#gridTable8", "Type0");
                var Type1 = GetJqGridRowValue("#gridTable8", "Type1");
                var Type2 = GetJqGridRowValue("#gridTable8", "Type2");

                if (Type0 == "收款") {
                    $("#Type0").val(Type0);
                    getAjax('/CommonModule/DataDictionary/BinDingItemsJson', { Code: "收款类型" }, function (data) {
                        var itemjson = eval("(" + data + ")");
                        $("#Type1").empty()
                        $("#Type1").append($("<option></option>").val("").html("全部"));
                        $.each(itemjson, function (i) {
                            $("#Type1").append($("<option></option>").val(itemjson[i].Code).html(itemjson[i].FullName));
                        });
                        $("#Type1").val(Type1);
                    });

                    getAjax('/CommonModule/DataDictionary/BinDingItemsJson1', { Code: "收款类型", FullName: Type1 }, function (data1) {
                        var itemjson1 = eval("(" + data1 + ")");
                        $("#Type2").empty()
                        $("#Type2").append($("<option></option>").val("").html("全部"));
                        $.each(itemjson1, function (i) {
                            $("#Type2").append($("<option></option>").val(itemjson1[i].FullName).html(itemjson1[i].FullName));
                        });
                        $("#Type2").val(Type2);
                    });
                }
                else {
                    $("#Type0").val(Type0);
                    getAjax('/CommonModule/DataDictionary/BinDingItemsJson', { Code: "CostType" }, function (data) {
                        var itemjson = eval("(" + data + ")");
                        $("#Type1").empty()
                        $("#Type1").append($("<option></option>").val("").html("全部"));
                        $.each(itemjson, function (i) {
                            $("#Type1").append($("<option></option>").val(itemjson[i].Code).html(itemjson[i].FullName));
                        });
                        $("#Type1").val(Type1);
                    });

                    getAjax('/CommonModule/DataDictionary/BinDingItemsJson1', { Code: "CostType", FullName: Type1 }, function (data1) {
                        var itemjson1 = eval("(" + data1 + ")");
                        $("#Type2").empty()
                        $("#Type2").append($("<option></option>").val("").html("全部"));
                        $.each(itemjson1, function (i) {
                            $("#Type2").append($("<option></option>").val(itemjson1[i].FullName).html(itemjson1[i].FullName));
                        });
                        $("#Type2").val(Type2);
                    });

                }
            },
            footerrow: true,
            gridComplete: function () {
                //合计
                $(this).footerData("set", {
                    "CustomerCode": "合计",
                    "TotalAmount": FormatCurrency($("#gridTable8").getCol('TotalAmount', false, 'sum')),
                    "GetedAmount": FormatCurrency($("#gridTable8").getCol('GetedAmount', false, 'sum')),
                    "NoAmount": FormatCurrency($("#gridTable8").getCol('NoAmount', false, 'sum')),
                }, false);
            },
            multiselect: true,
        });
    }

    function PayMoney(KeyValue, CanUseMoney, CustomerCode) {
        if (IsChecked(KeyValue)) {
            var s = "";
            var type = "";
            var totalmoneys = 0;

            var selr = jQuery('#gridTable1').jqGrid('getGridParam', 'selarrrow');
            if (selr.length) {
                for (var i = 0; i < selr.length; i++) {
                    var myrow = jQuery('#gridTable1').jqGrid('getRowData', selr[i]);
                    s = s + myrow.Base_SteelDDBeoutCode + ",";
                    totalmoneys = totalmoneys + Number(myrow.NoAmount);
                    if (myrow.CustomerCode != CustomerCode) {
                        tipDialog("请选择相同公司！", 3, 0);
                        return false;
                    }
                }
                type = "Base_SteelDDBeoutCode";
            }

            selr = jQuery('#gridTable2').jqGrid('getGridParam', 'selarrrow');
            if (selr.length) {
                for (var i = 0; i < selr.length; i++) {
                    var myrow = jQuery('#gridTable2').jqGrid('getRowData', selr[i]);
                    s = s + myrow.Base_SteelDDPerchaseCode + ",";
                    totalmoneys = totalmoneys + Number(myrow.NoAmount);
                    if (myrow.CustomerCode != CustomerCode) {
                        tipDialog("请选择相同公司！", 3, 0);
                        return false;
                    }
                }
                type = "Base_SteelDDPerchaseCode";
            }


            selr = jQuery('#gridTable3').jqGrid('getGridParam', 'selarrrow');
            if (selr.length) {
                for (var i = 0; i < selr.length; i++) {
                    var myrow = jQuery('#gridTable3').jqGrid('getRowData', selr[i]);
                    s = s + myrow.PayCheckSheetCode + ",";
                    totalmoneys = totalmoneys + Number(myrow.NoAmount);
                    if (myrow.CustomerCode != CustomerCode) {
                        tipDialog("请选择相同公司！", 3, 0);
                        return false;
                    }
                }
                type = "PayCheckSheetCode";
            }


            selr = jQuery('#gridTable4').jqGrid('getGridParam', 'selarrrow');
            if (selr.length) {
                for (var i = 0; i < selr.length; i++) {
                    var myrow = jQuery('#gridTable4').jqGrid('getRowData', selr[i]);
                    s = s + myrow.MaterielPurchaseCode + ",";
                    totalmoneys = totalmoneys + Number(myrow.NoAmount);
                    if (myrow.CustomerCode != CustomerCode) {
                        tipDialog("请选择相同公司！", 3, 0);
                        return false;
                    }
                }
                type = "MaterielPurchaseCode";
            }

            selr = jQuery('#gridTable7').jqGrid('getGridParam', 'selarrrow');
            if (selr.length) {
                for (var i = 0; i < selr.length; i++) {
                    var myrow = jQuery('#gridTable7').jqGrid('getRowData', selr[i]);
                    s = s + myrow.SteelPurchaseCode + ",";
                    totalmoneys = totalmoneys + Number(myrow.NoAmount);
                    if (myrow.CustomerCode != CustomerCode) {
                        tipDialog("请选择相同公司！", 3, 0);
                        return false;
                    }
                }
                type = "SteelPurchaseCode";
            }
            selr = jQuery('#gridTable8').jqGrid('getGridParam', 'selarrrow');
            if (selr.length) {
                for (var i = 0; i < selr.length; i++) {
                    var myrow = jQuery('#gridTable8').jqGrid('getRowData', selr[i]);
                    s = s + myrow.PayCompanyCode + ",";
                    totalmoneys = totalmoneys + Number(myrow.NoAmount);
                    if (myrow.CustomerCode != CustomerCode) {
                        tipDialog("请选择相同公司！", 3, 0);
                        return false;
                    }
                }
                type = "PayCompanyCode";
            }


            if ($("#AN5").prop("checked")) {
                tipDialog("内部费用不能使用预付单！", 3, 0);
                return false;
            }
            openDialog("/PaymentModule/BY_PayReimburseSheet/PayMoneyView?KeyValue=" + KeyValue + "&ids=" + s + "&type=" + type + "&totalmoneys=" + totalmoneys + "&CanUseMoney=" + CanUseMoney, "Query", "支付", 550, 160, function (iframe) {
                top.frames[iframe].AcceptClick()
            });
        }
    }
    function ReturnMoney(KeyValue) {
        if (IsChecked(KeyValue)) {
            openDialog("/PaymentModule/BY_PayReimburseSheet/ReturnMoneyView?KeyValue=" + KeyValue, "Query", "退款", 550, 160, function (iframe) {
                top.frames[iframe].AcceptClick()
            });
        }
    }

</script>
