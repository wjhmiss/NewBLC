@{
    ViewBag.Title = "订单查询";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        CustomerAutocomplete();

        window.setTimeout(function () {
            GetGrid();
            GetGridDetail();
        }, 200);
    })
    function btn_tb() {
        var OrderCode = GetJqGridRowValue("#gridTable", "ordercode");
        if (IsChecked(OrderCode)) {
            AjaxJson("/OrderModule/OrderQuery/SetOrderStatus?OrderCode=" + OrderCode, {}, function (data) {
                //tipDialog(data.Message, 3, data.Code);
                windowload();
            })
        }
    }
    //客户编码自动补全
    function CustomerAutocomplete() {
        var $CustomerCode = $("#CustomerCode");
        $CustomerCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("CustomerCode", function (data) {
            $("#CustomerId").val(data.CustomerId);
            $("#CustomerCode").val(data.FullName);
            $("#CustomerName").val(data.FullName);
            $("#PaymentMode").val(data.PaymentMode);
            btn_Search();
        });
        //获取数据源
        function DataSource() {
            $("#CustomerId").val('');
            AjaxJson("/CommonModule/Customer/GetAutoCompleJsonNXJ", { keywords: $CustomerCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="CustomerId" style="display: none;">' + DataJson[i].CustomerId + '</td>';
                    html += '<td id="CustomerCode" style="width: 30%;">' + DataJson[i].Code + '</td>';
                    html += '<td id="FullName" style="width: 70%;">' + DataJson[i].FullName + '</td>';
                    html += '<td id="ShortName" style="display: none;">' + DataJson[i].ShortName + '</td>';
                    html += '<td id="Sellpeople" style="display: none;">' + DataJson[i].Sellpeople + '</td>';
                    html += '<td id="SalesArea" style="display: none;">' + DataJson[i].Sellarea + '</td>';
                    html += '<td id="DiscountRate" style="display: none;">' + DataJson[i].DiscountRate + '</td>';
                    html += '<td id="TransitMode" style="display: none;">' + DataJson[i].TransitMode + '</td>';
                    html += '<td id="PaymentMode" style="display: none;">' + DataJson[i].PaymentMode + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("CustomerCode", "300px", "200px", html, function (data) {
                    $("#CustomerId").val(data.CustomerId);
                    $("#CustomerCode").val(data.FullName);
                    $("#CustomerName").val(data.FullName);
                    $("#PaymentMode").val(data.PaymentMode);
                    btn_Search();
                });

            });
        }
    }
    //查询
    function btn_Search() {
        var Condition = GetParameterJson("QueryParameter");
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/OrderModule/OrderQuery/GridPageListJson")?Condition=" + escape(Condition), page: 1 }).trigger('reloadGrid');
        $("#gridTable_Detail").jqGrid('setGridParam', { url: "@Url.Content("~/OrderModule/OrderQuery/GridOrderDetailListJson")?OrderId=-1" }).trigger('reloadGrid');
    }
    function btn_DownLoad() {
        var Condition = GetParameterJson("QueryParameter");
        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "@Url.Content("~/OrderModule/OrderQuery/DownLoadExcel")?Condition=" + escape(Condition);
            Loading(false);
        }, 200);
    }
    function btn_DownLoad1() {
        var Condition = GetParameterJson("QueryParameter");
        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "@Url.Content("~/OrderModule/OrderQuery/DownLoadExcel1")?Condition=" + escape(Condition);
