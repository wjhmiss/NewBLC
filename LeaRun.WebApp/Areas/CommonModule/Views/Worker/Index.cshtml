@{
    ViewBag.Title = "员工表";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        GetTree();
        GetGrid();
    })
    var CompanyId = "", DepartmentId = "", DepartmentName = "";
    //加载左边树
    function GetTree() {
        var itemtree = {
            onnodeclick: function (item) {
                if (item.Type == "Company") {
                    DepartmentId = "";
                    CompanyId = item.CompanyId;     //公司ID
                    btn_Search();
                } else if (item.Type == "Department") {
                    CompanyId = item.parentnodes;
                    DepartmentId = item.id;         //部门ID
                    DepartmentName = item.text;     //部门名称
                    btn_Search();
                }
                $("#CenterTitle").html(" - " + item.text + "(" + item.value + ")");
            },
            url: "@Url.Content("~/CommonModule/Department/TreeJson")"
        };
        $("#ItemsTree").treeview(itemtree);
    }
    function btn_printall() {

        PrintDialog("/CommonModule/Worker/AllWorkerBarCode?DepartId=" + DepartmentId, "PrintPage", "打印员工条码", 900, 550, function (iframe) {
            top.frames[iframe].AcceptClick();
        });


    }
    //加载表格
    function GetGrid() {
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/CommonModule/Worker/GridPageListJson")?DepartId=" + DepartmentId,
            datatype: "json",
            height: $(window).height() - 129,
            autowidth: true,
            colModel: [
                    { label: '员工工号', name: 'workerid', index: 'workerid', width: 0, align: 'left', sortable: true, hidden: true },
                    { label: '员工姓名', name: 'workername', index: 'workername', width: 100, align: 'left', sortable: true },
                { label: '工号', name: 'workercode', index: 'workercode', width: 100, align: 'left', sortable: true },
                { label: '手机', name: 'mobile', index: 'mobile', width: 100, align: 'left', sortable: true },
                    { label: '部门', name: 'departname', index: 'departname', width: 100, align: 'left', sortable: true },
                    { label: '职务', name: 'degree', index: 'degree', width: 100, align: 'left', sortable: true },
                    {
                        label: '操作', width: 100, align: 'center',
                        formatter: function (cellvalue, options, rowObject) {
                            var temp = "<a class='alink' style='color:blue' onclick='PrintPreview(\"" + rowObject.workercode + "\",\"" + rowObject.workername + "\",\"" + rowObject.degree + "\",\"Z\")'>组长</a>,";
                            temp += "<a class='alink' style='color:blue' onclick='PrintPreview(\"" + rowObject.workercode + "\",\"" + rowObject.workername + "\",\"" + rowObject.degree + "\",\"J\")'>加工</a>,";
                            temp += "<a class='alink' style='color:blue' onclick='PrintPreview(\"" + rowObject.workercode + "\",\"" + rowObject.workername + "\",\"" + rowObject.degree + "\",\"K\")'>开料</a>";
                            return temp;
                        }
                    }
            ],
            viewrecords: true,
            rowNum: 100,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: '',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: false,
            altclass: 'altclass',
            gridview: true,
        });
    }
    //新增
    function btn_add() {
        var url = "/CommonModule/Worker/Form?CompanyId=" + CompanyId + "&DepartmentId=" + DepartmentId
        openDialog(url, "Form", "新增员工表", 650, 250, function (iframe) {
            top.frames[iframe].AcceptClick()
        });
    }
    //编辑
    function btn_edit() {
        var KeyValue = GetJqGridRowValue("#gridTable", "workerid");
        if (IsChecked(KeyValue)) {
            var url = "/CommonModule/Worker/Form?KeyValue=" + KeyValue;
            openDialog(url, "Form", "编辑员工表", 650, 250, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //删除
    function btn_delete() {
        var KeyValue = GetJqGridRowValue("#gridTable", "workerid");
        if (IsDelData(KeyValue)) {
            var delparm = 'KeyValue=' + KeyValue;
            delConfig('/CommonModule/Worker/Delete', delparm, KeyValue.split(",").length);
        }
    }
    //明细
    function btn_detail() {
        var KeyValue = GetJqGridRowValue("#gridTable", "workerid");
        if (IsChecked(KeyValue)) {
            var url = "/CommonModule/Worker/Detail?KeyValue=" + KeyValue;
            Dialog(url, "Detail", "员工表明细", 820, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入

    }
    //查询
    function btn_Search() {
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/CommonModule/Worker/GridPageListJson")?DepartId=" + DepartmentId, page: 1 }).trigger('reloadGrid');
    }
    //打印条码
    function PrintPreview(workercode, workname, degree,type) {
        if (IsChecked(workercode)) {
            PrintDialog("/CommonModule/Worker/WorkerBarCode?workercode=" + workercode + "&workname=" + escape(workname) + "&degree=" + escape(degree) + "&type=" + type, "PrintPage", "打印条码", 440, 450, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }


</script>
<div id="layout" class="layout">
    <!--左边-->
    <div class="layoutPanel layout-west">
        <div class="btnbartitle">
            <div>
                组织结构
            </div>
        </div>
        <div class="ScrollBar" id="ItemsTree"></div>
    </div>
    <!--中间-->
    <div class="layoutPanel layout-center">
        <div class="btnbartitle">
            <div>
                用户列表 <span id="CenterTitle"></span>
            </div>
        </div>
        <!--工具栏-->
        <div class="tools_bar" style="border-top: none; margin-bottom: 0px;">
            <div class="PartialButton">
                @Html.Partial("_PartialButton")
            </div>
        </div>
        <!--列表-->
        <div id="grid_List">
            <table id="gridTable"></table>
            <div id="gridPager"></div>
        </div>
    </div>
</div>
