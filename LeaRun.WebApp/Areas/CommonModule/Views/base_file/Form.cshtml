@{
    ViewBag.Title = "base_file》表单页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    var KeyValue = GetQuery('KeyValue');//主键
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/CommonModule/base_file/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
            });
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        var postData = GetWebControls("#form1");
        AjaxJson("/CommonModule/base_file/SubmitForm?KeyValue=" + KeyValue, postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            window.setTimeout(function () {closeDialog();}, 500);
        });
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class='formTitle'>Id：</th>
            <td class='formValue'>
                <input id="Id" maxlength=50 type="text" class="txt"   />
            </td>
            <th class='formTitle'>Name：</th>
            <td class='formValue'>
                <input id="Name" maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>Size：</th>
            <td class='formValue'>
                <input id="Size" maxlength=19 type="text" class="txt"   />
            </td>
            <th class='formTitle'>Type：</th>
            <td class='formValue'>
                <input id="Type" maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>Eextension：</th>
            <td class='formValue'>
                <input id="Eextension" maxlength=50 type="text" class="txt"   />
            </td>
            <th class='formTitle'>CreateDate：</th>
            <td class='formValue'>
                <input id="CreateDate" maxlength=10 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>ModifyDate：</th>
            <td class='formValue'>
                <input id="ModifyDate" maxlength=10 type="text" class="txt"   />
            </td>
            <th class='formTitle'>Path：</th>
            <td class='formValue'>
                <input id="Path" maxlength=100 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>Status：</th>
            <td class='formValue'>
                <input id="Status" maxlength=50 type="text" class="txt"   />
            </td>
            <th class='formTitle'>AttachId：</th>
            <td class='formValue'>
                <input id="AttachId" maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
        </tr>
    </table>
</form>
