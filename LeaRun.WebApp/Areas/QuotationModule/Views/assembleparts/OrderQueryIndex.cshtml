                    { label: '总金额', name: 'amount', index: 'amount', width: 50, align: 'right', sortable: true, hidden: true },
                    {
                        label: '订单状态', name: 'orderstatus', index: 'orderstatus', width: 60, align: 'center', sortable: true
                        //,
                        //formatter: function (cellvalue, options, rowobject) {
                        //    if (cellvalue == "正常生产") {
                        //        return "<a  style='color:red' onclick='OpearLog(\"" + rowobject.orderid + "\",\"" + rowobject.ordercode + "\")'>" + cellvalue + "</a>";
                        //    }
                        //    else{
                        //        //return "<a class='alink' style='color:red' onclick='OpearLog(\"" + rowobject.orderid + "\",\"" + rowobject.ordercode + "\")'>" + cellvalue + "</a>";
                        //        return "<a  style='color:black' onclick='OpearLog(\"" + rowobject.orderid + "\",\"" + rowobject.ordercode + "\")'>" + cellvalue + "</a>";
                        //    }
                        //}
                    },
                    { label: '发运备注', name: 'shipdescription', index: 'shipdescription', width: 100, align: 'left', sortable: true },
                { label: '状态变更备注', name: 'remark', index: 'remark', width: 100, align: 'left', sortable: true, hidden: true },
                    {
                        label: '落单日期', name: 'placeorderdate', index: 'placeorderdate', width: 80, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    { label: '落单人员', name: 'placeorderuserid', index: 'placeorderuserid', width: 70, align: 'left', sortable: true },

                    {
                        label: '审核日期', name: 'checkdate', index: 'checkdate', width: 100, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }, hidden: true
                    },
