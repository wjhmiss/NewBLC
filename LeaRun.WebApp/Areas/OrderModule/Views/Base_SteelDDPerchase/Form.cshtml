            gridComplete: function () {
                //加工费为空时补0，避免保存时数值转换失败
                var ids = $("#gridTable").jqGrid("getDataIDs");
                for (var i = 0; i < ids.length; i++) {
                    var workCost = $("#gridTable").jqGrid("getCell", ids[i], "WorkCost");
