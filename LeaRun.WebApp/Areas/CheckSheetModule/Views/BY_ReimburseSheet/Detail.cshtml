@{
    ViewBag.Title = "费用申请单》明细页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/CheckSheetModule/BY_ReimburseSheet/SetForm", { KeyValue: GetQuery('KeyValue') }, function (data) {
                SetWebControls(data);
            });
        }
    }
</script>
<form id="form1" style="margin: 1px">
    <table class="form">
        <tr>
            <th class='formTitle'>申请单ID：</th>
            <td class='formValue'>
                <label id="ReimburseSheetID" />
            </td>
            <th class='formTitle'>申请单号：</th>
            <td class='formValue'>
                <label id="ReimburseSheetCode" />
            </td>
            <th class='formTitle'>事由类型：</th>
            <td class='formValue'>
                <label id="ReasonType" />
            </td>
            <th class='formTitle'>申请人：</th>
            <td class='formValue'>
                <label id="RequiredMan" />
            </td>
            <th class='formTitle'>申请日期：</th>
            <td class='formValue'>
                <label id="RequiredDate" />
            </td>
            <th class='formTitle'>申请金额：</th>
            <td class='formValue'>
                <label id="RequiredMoney" />
            </td>
            <th class='formTitle'>实际到账金额：</th>
            <td class='formValue'>
                <label id="AuditMoney" />
            </td>
            <th class='formTitle'>审核人：</th>
            <td class='formValue'>
                <label id="AuditMan" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>状态0未审核，1已审核，-1拒绝：</th>
            <td class='formValue'>
                <label id="Status" />
            </td>
            <th class='formTitle'>备注：</th>
            <td class='formValue'>
                <label id="Remark" />
            </td>
            <th class='formTitle'>有效：</th>
            <td class='formValue'>
                <label id="Enabled" />
            </td>
            <th class='formTitle'>排序码：</th>
            <td class='formValue'>
                <label id="SortCode" />
            </td>
            <th class='formTitle'>删除标记：</th>
            <td class='formValue'>
                <label id="DeleteMark" />
            </td>
            <th class='formTitle'>创建时间：</th>
            <td class='formValue'>
                <label id="CreateDate" />
            </td>
            <th class='formTitle'>创建用户主键：</th>
            <td class='formValue'>
                <label id="CreateUserId" />
            </td>
            <th class='formTitle'>创建用户：</th>
            <td class='formValue'>
                <label id="CreateUserName" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>修改时间：</th>
            <td class='formValue'>
                <label id="ModifyDate" />
            </td>
            <th class='formTitle'>修改用户主键：</th>
            <td class='formValue'>
                <label id="ModifyUserId" />
            </td>
            <th class='formTitle'>修改用户：</th>
            <td class='formValue'>
                <label id="ModifyUserName" />
            </td>
        </tr>
    </table>
</form>
