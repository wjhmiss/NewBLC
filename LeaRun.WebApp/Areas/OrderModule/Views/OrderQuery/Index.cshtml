            }
            var url = "/OrderModule/OrderPrint/ChoosePrint?OrderDetailIds=" + s + "&customercode=" + CustomerCode;
            openDialogFName(url, "DeriveDialog", "打印", 850, 500, "直接打印", "编辑打印",
                function (iframe) {
                    top.frames[iframe].AcceptClick();
                },
            function (iframe) {
                top.frames[iframe].AcceptClick2();
            });
        }


    }

    function btn_Printlabel() {
        var selr = jQuery('#gridTable_Detail').jqGrid('getGridParam', 'selarrrow');
        var CustomerCode = GetJqGridRowValue("#gridTable", "customercode");
        var s = "";
        if (selr.length) {
            for (var i = 0; i < selr.length; i++) {
                var myrow = jQuery('#gridTable_Detail').jqGrid('getRowData', selr[i]);
                s = s + myrow.orderdetailid + ","
            }
            var url = "/OrderModule/OrderPrint/BJPrintForLab?ids=" + s ;
            openDialogFName(url, "DeriveDialog", "打印", 800, 550, "直接打印", "编辑打印",
                function (iframe) {
                    top.frames[iframe].AcceptClick();
                },
                function (iframe) {
                    top.frames[iframe].AcceptClick2();
                });
        }


    }

    //string OrderId, string OrderDetailIds,string QuotationId, string KL, int RowNum
    function DeliveryPrint(perType, printType, OrderId, OrderDetailIds, CustomerCode) {
        PrintDialog("/OrderModule/OrderPrint/" + printType + "?perType=" + perType + "&OrderId=" + OrderId + "&CustomerCode=" + CustomerCode + "&OrderDetailIds=" + OrderDetailIds, "PrintPage", "PrintPagess", 1024, 650, function (iframe) {
            top.frames[iframe].AcceptClick();
        });
    }
</script>
