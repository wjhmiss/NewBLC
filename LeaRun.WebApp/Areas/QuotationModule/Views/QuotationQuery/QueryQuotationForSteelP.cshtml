@{
    ViewBag.Title = "报价单查询";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script>
    $(function () {

        $("#SteelCode").val(GetQuery('SteelCode'));

        window.setTimeout(function () {
            GetGrid();
        }, 300);
        //if (GetQuery('steelPurchase') == "1") {
        //    $("#gridTable").jqGrid('setGridParam', {
        //        multiselect: true
        //    }).trigger('reloadGrid');
        //}

    });
    //查询
    function btn_Search() {

        $("#gridTable").jqGrid('setGridParam', {
            url: "@Url.Content("~/QuotationModule/QuotationQuery/GridPageListJson1")?Size=" + escape($("#Size").val()) + "&CustomerName=" + $("#CustomerName").val() + "&MnemonicCode=" + $("#MnemonicCode").val() + "&SteelCode=" + escape($("#SteelCode").val()) , page: 1
        }).trigger('reloadGrid');
    }
    //报价单列表
    function GetGrid() {
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/QuotationModule/QuotationQuery/GridPageListJson1")?Size=" + escape($("#Size").val()) + "&CustomerName=" + $("#CustomerName").val() + "&MnemonicCode=" + $("#MnemonicCode").val() + "&SteelCode=" + escape($("#SteelCode").val()) ,
            datatype: "json",
            height: 457,
            autowidth: true,
            colModel: [
                    { label: '主键', name: 'quotationdetailid', hidden: true },
            { label: '助记号', name: 'mnemoniccode', index: 'mnemoniccode', width: 120, align: 'left', sortable: true, hidden: true },
                    { label: '报价单号', name: 'quotationcode', index: 'quotationcode', width: 100, align: 'left', sortable: true },
                    { label: '行号', name: 'linecode', index: 'linecode', width: 50, align: 'center', sortable: true },
                    { label: '客户', name: 'customername', index: 'customername', width: 50, align: 'center', sortable: true },
                    { label: '客户品名', name: 'productname', index: 'productname', width: 100, align: 'left', sortable: true },
                    { label: '数量', name: 'qty', index: 'qty', width: 50, align: 'left', sortable: true },
                    { label: '厚', name: 'thick', index: 'thick', width: 50, align: 'left', sortable: true },
                    { label: '宽', name: 'weigh', index: 'weigh', width: 50, align: 'left', sortable: true },
                    { label: '长', name: 'length', index: 'length', width: 50, align: 'left', sortable: true },
                    { label: '厚余量', name: 'addthick', index: 'thick', width: 50, align: 'left', sortable: true },
                    { label: '宽余量', name: 'addweigh', index: 'weigh', width: 50, align: 'left', sortable: true },
                    { label: '长余量', name: 'addlength', index: 'length', width: 50, align: 'left', sortable: true },
                    { label: '公差', name: 'remark', index: 'remark', width: 120, align: 'left', sortable: true },
                    { label: '模号', name: 'customerproduct', index: 'customerproduct', width: 120, align: 'left', sortable: true },
                { label: '类型', name: 'ordertype', index: 'ordertype', width: 80, align: 'left', sortable: true },
                { label: '下料尺寸', name: 'ljsize', index: 'ljsize', width: 80, align: 'left', sortable: true },
                
                    { label: 'steelcode', name: 'steelcode', index: 'steelcode', hidden: true },
                    { label: 'steeldescription', name: 'steeldescription', index: 'steeldescription', hidden: true },
                    { label: 'boresize', name: 'boresize', index: 'boresize', hidden: true },
                    { label: 'weight', name: 'weight', index: 'weight', hidden: true },
                    { label: 'density', name: 'density', index: 'density', hidden: true },
                    { label: 'shortname', name: 'shortname', index: 'shortname', hidden: true },
                    { label: 'departname', name: 'departname', index: 'departname', hidden: true },
            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'quotationcode,linecode',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            ondblClickRow: function () {
                AcceptClick();
            },
            multiselect: true,
        });
    }
    //确认事件
    function AcceptClick() {
        var selr = jQuery('#gridTable').jqGrid('getGridParam', 'selarrrow');
        var s1 = "";
        if (selr.length) {
            for (var i = 0; i < selr.length; i++) {
                var myrow = jQuery('#gridTable').jqGrid('getRowData', selr[i]);
                //steelcode,steeldescription,boresize,theoryweight,length,weigh,thick,density,quotationcodeline，qty
                s1 = s1 + myrow.steelcode + "," + myrow.steeldescription + "," + myrow.length + ","
                    + myrow.weigh + "," + myrow.thick + "," + myrow.quotationcode + "-"
                    + myrow.linecode + "," + myrow.qty + "," + myrow.addlength + ","
                    + myrow.addweigh + "," + myrow.addthick + "," + myrow.quotationdetailid + ","
                    + myrow.weight + "," + myrow.density + "," + myrow.customerproduct + "," + myrow.ordertype + "," + myrow.shortname.replace(myrow.departname, "") + '、' + myrow.departname + "," + myrow.remark + "," + myrow.ljsize + ";";
            }
            s1 = s1.trim(';');

            confirmDialog("提示", "确定要钢材申请？", function (r) {
                if (r) {
                    top.Form.addforQuo(s1);
                    s1 = "";
                    window.setTimeout(function () {closeDialog();}, 500);
                }
            });
        }

    }
</script>
<div class="leftline rightline topline QueryArea" style="margin: 1px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>尺寸Φ：</th>
            <td>
                <input id="Size" type="text" class="txt" style="width: 100px" />
            </td>
            <th>编号：</th>
            <td>
                <input id="MnemonicCode" type="text" class="txt" style="width: 100px" />
            </td>
            <th>钢种：</th>
            <td>
                <input id="SteelCode" type="text" class="txt" style="width: 100px" />
            </td>
            <th>客户：</th>
            <td>
                <input id="CustomerName" type="text" class="txt" style="width: 100px" />
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="查 询" onclick="btn_Search()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
