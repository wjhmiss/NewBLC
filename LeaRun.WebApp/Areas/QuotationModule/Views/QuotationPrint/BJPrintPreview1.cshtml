                    $("#MyCompany2").text("东莞市振大模具钢有限公司");
                    $("#MyBank").text("农行宁波大矸支行39304001040001936");
                    $("#MyFax").text("330206144301208");
                }
                else {
                    $("#MyCompany").text("上海沿汉模具有限公司");
                    $("#MyCompany1").text("上海沿汉模具有限公司");
                    $("#MyCompany2").text("上海沿汉模具有限公司");
                    $("#MyBank").text("民生银行上海九亭支行 600714686");
                    $("#MyFax").text("310227071174622");

