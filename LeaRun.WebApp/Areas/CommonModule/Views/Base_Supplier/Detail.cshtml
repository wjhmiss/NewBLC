@{
    ViewBag.Title = "Base_Supplier》明细页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/CommonModule/Base_Supplier/SetForm", { KeyValue: GetQuery('KeyValue') }, function (data) {
                SetWebControls(data);
            });
        }
    }
</script>
<form id="form1" style="margin: 1px">
    <table class="form">
        <tr>
            <th class='formTitle'>供应商主键：</th>
            <td class='formValue'>
                <label id="CustomerId" />
            </td>
            <th class='formTitle'>供应商编号：</th>
            <td class='formValue'>
                <label id="Code" />
            </td>
            <th class='formTitle'>供应商名称：</th>
            <td class='formValue'>
                <label id="FullName" />
            </td>
            <th class='formTitle'>拼音：</th>
            <td class='formValue'>
                <label id="Spell" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>供应商简称：</th>
            <td class='formValue'>
                <label id="ShortName" />
            </td>
            <th class='formTitle'>账期：</th>
            <td class='formValue'>
                <label id="PaymentMode" />
            </td>
            <th class='formTitle'>销售大区：</th>
            <td class='formValue'>
                <label id="Sellregion" />
            </td>
            <th class='formTitle'>销售区域：</th>
            <td class='formValue'>
                <label id="Sellarea" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>销售人员：</th>
            <td class='formValue'>
                <label id="Sellpeople" />
            </td>
            <th class='formTitle'>开户行：</th>
            <td class='formValue'>
                <label id="BankName" />
            </td>
            <th class='formTitle'>税号：</th>
            <td class='formValue'>
                <label id="TaxNumber" />
            </td>
            <th class='formTitle'>账户：</th>
            <td class='formValue'>
                <label id="Account" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>备注：</th>
            <td class='formValue'>
                <label id="Remark" />
            </td>
            <th class='formTitle'>有效：</th>
            <td class='formValue'>
                <label id="Enabled" />
            </td>
            <th class='formTitle'>排序码：</th>
            <td class='formValue'>
                <label id="SortCode" />
            </td>
            <th class='formTitle'>删除标记：</th>
            <td class='formValue'>
                <label id="DeleteMark" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>创建时间：</th>
            <td class='formValue'>
                <label id="CreateDate" />
            </td>
            <th class='formTitle'>创建用户主键：</th>
            <td class='formValue'>
                <label id="CreateUserId" />
            </td>
            <th class='formTitle'>创建用户：</th>
            <td class='formValue'>
                <label id="CreateUserName" />
            </td>
            <th class='formTitle'>修改时间：</th>
            <td class='formValue'>
                <label id="ModifyDate" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>修改用户主键：</th>
            <td class='formValue'>
                <label id="ModifyUserId" />
            </td>
            <th class='formTitle'>修改用户：</th>
            <td class='formValue'>
                <label id="ModifyUserName" />
            </td>
            <th class='formTitle'>管理费：</th>
            <td class='formValue'>
                <label id="ManagementCostRate" />
            </td>
            <th class='formTitle'>单价信息：</th>
            <td class='formValue'>
                <label id="PriceMessage" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>采购说明：</th>
            <td class='formValue'>
                <label id="MateRemark" />
            </td>
        </tr>
    </table>
</form>
