@{
    ViewBag.Title = "对账单》表单页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
@Scripts.Render("~/Content/Scripts/Workday/kalendarjqueryyyyydd")
@Styles.Render("~/Content/Scripts/Workday/kalendarcss")
    @Scripts.Render("~/Content/Scripts/jqgrid/jqgridjquery")
     @Styles.Render("~/Content/Scripts/jqgrid/css/jqgridcss")


<script type="text/javascript">
    var CheckSheetId = GetQuery('CheckSheetId'); 
    $(function () {
        //客户编码自动补全

        getAjax('/CommonModule/Company/ListJson', { ParentId: "1" }, function (data) {
            $("#CompanyName").append($("<option></option>").val("").html("请选择！"));
            var itemjson = eval("(" + data + ")");
            $.each(itemjson, function (i) {
                $("#CompanyName").append($("<option></option>").val(itemjson[i].FullName).html(itemjson[i].FullName));
            });
            Loading(false);
        });



        CustomerAutocomplete();
        InitControl();
        window.setTimeout(function () {
            GetGrid();
            $("#cb_gridTable").click(function () {
                var selr = jQuery('#gridTable').jqGrid('getGridParam', 'selarrrow');
                var s1 = "";
                var temp = 0;
                if (selr.length) {
                    for (var i = 0; i < selr.length; i++) {
                        var myrow = jQuery('#gridTable').jqGrid('getRowData', selr[i]);
                        temp = temp + Number(myrow.totalamount);
                    }
                }
                $("#DTotalAmountOri").val(temp.toFixed(2));
                $("#DTotalAmount").val(temp.toFixed(2));
                
            });
        }, 200);
        
    })

   
    function InitControl() {
        if (!!CheckSheetId) {
            AjaxJson("/CheckSheetModule/BY_CheckSheet/SetForm", { KeyValue: CheckSheetId }, function (data) {
                SetWebControls(data);
            });
            $("#s41").prop("checked", false);
            $('input').customInput();

            //jQuery("#list13").jqGrid('setSelection', "13");


        }
        else {
            $("#CheckSheetCode").val("自动生成")
        }
    }
    //搜索
    function btn_Search() {
        var Condition = JSON.stringify(GetWebControls("#basic", true));
        $("#gridTable").jqGrid('setGridParam', {
            url: "@Url.Content("~/DeliveryModule/BY_Delivery/GetGridPageJson")?Condition=" + escape(Condition), page: 1
            }).trigger('reloadGrid');
        }
    function GetGrid() {
        var Condition = JSON.stringify(GetWebControls("#basic", true));
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/DeliveryModule/BY_Delivery/GetGridPageJson")?Condition=" + escape(Condition),
            datatype: "json",
            height: $(window).height() - 265,
            autowidth: true,
            colModel: [
                    { label: '发运单id', name: 'deliveryid', hidden: true },
                    { label: 'csgetedamount', name: 'csgetedamount', hidden: true },
                { label: '公司', name: 'companyname', index: 'companyname', width: 120, align: 'left', sortable: true },
                    { label: '客户名称', name: 'customername', index: 'customername', width: 120, align: 'left', sortable: true },
                    { label: '对账单号', name: 'checksheetcode', index: 'checksheetcode', width: 120, align: 'left', sortable: true },
                    { label: '客户订单', name: 'customerpo', index: 'customerpo', width: 100, align: 'left', sortable: true },
                    { label: '助记码', name: 'mnemoniccode', index: 'mnemoniccode', width: 100, align: 'left', sortable: true },
                    { label: '送货单号', name: 'deliverycode', index: 'deliverycode', width: 100, align: 'left', sortable: true },
                    { label: '订单号', name: 'ordercode', index: 'ordercode', hidden: true },
                    { label: '客户编号', name: 'customercode', index: 'customercode', width: 60, align: 'left', sortable: true, hidden: true },
                    
                    { label: '联系电话', name: 'contacttel', index: 'contacttel', width: 80, align: 'left', sortable: true, hidden: true },
                    { label: '联系人', name: 'contactname', index: 'contactname', width: 80, align: 'left', sortable: true, hidden: true },
                    { label: '送货地址', name: 'shipaddress', index: 'shipaddress', width: 150, align: 'left', sortable: true, hidden: true },
                     {
                         label: '客来料', name: 'custmaterial', index: 'custmaterial', width: 60, align: 'center', sortable: true, hidden: true,
                         formatter: function (cellvalue, options, rowobject) {
                             if (cellvalue == 1) {
                                 return "<a  style='color:red' >是</a>";
                             }
                             return "否";
                         }
                     },
                    { label: '送货方式', name: 'shipmode', index: 'shipmode', width: 70, align: 'left', sortable: true, hidden: true },
                    { label: '账期', name: 'paymentmode', index: 'paymentmode', width: 70, align: 'left', sortable: true, hidden: true },
                    { label: '数量', name: 'qty', index: 'qty', width: 50, align: 'left', sortable: true },
                    {
                        label: '含税', name: 'isinvoice', index: 'isinvoice', width: 50, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (cellvalue) {
                                return "<span style='color:blue'>含税</span>";
                            } else {
                                return "<span style='color:red' >不含税</span>";
                            }
                        }
                    },
                    { label: '总金额', name: 'totalamount', index: 'totalamount', width: 80, align: 'left', sortable: true },
                    { label: '已付金额', name: 'getedamount', index: 'getedamount', width: 80, align: 'left', sortable: true},
                    {
                        label: '创建时间', name: 'createdate', index: 'createdate', width: 100, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowobject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    {
                        label: '回单日期', name: 'comebackdate', index: 'comebackdate', width: 120, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowobject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    
                    { label: 'printuserid', name: 'printuserid', hidden: true },
                    { label: 'comebackuserid', name: 'comebackuserid', hidden: true },
                    { label: 'audituserid', name: 'audituserid', hidden: true },
                    { label: 'enabled', name: 'enabled', index: 'enabled', hidden: true },
                    { label: '备注', name: 'remark', index: 'remark', width: 100, align: 'left', sortable: true },

            ],
            viewrecords: true,
            rowNum: 200,
            rowList: [200, 500, 500, 500, 5000],
            pager: "#gridPager",
            sortname: 'DeliveryCode',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            footerrow: true,
            gridview: true,
            onSelectRow: function (rowid, status) {
            },
            gridComplete: function () {
                var data = $("#gridTable").jqGrid("getRowData");
                for (var i = 0; i < data.length; i++) {
                    var item = i + 1;
                    //黄
                    if (!!data[i].audituserid) {
                        $("#" + item).find('td').css("background-color", "#BBBB00");
                    }
                        //蓝
                    else if (!!data[i].comebackuserid) {
                        $("#" + item).find('td').css("background-color", "#33CCFF");
                    }
                        //绿色
                    else if (!!data[i].printuserid) {
                        $("#" + item).find('td').css("background-color", "#008800");
                    }
                    if (data[i].enabled == "-1") {
                        $("#" + item).find('td').css("background-color", "#CC0000");
                    }
                    if (data[i].checksheetcode == $("#CheckSheetCode").val()) {
                        jQuery("#gridTable").jqGrid('setSelection', item);
                    }
                }
                //合计
                $(this).footerData("set", {
                    "mnemoniccode": "合计",
                    "totalamount": FormatCurrency($("#gridTable").getCol('totalamount', false, 'sum')),
                    "qty": FormatCurrency($("#gridTable").getCol('qty', false, 'sum')),
                    "getedamount": FormatCurrency($("#gridTable").getCol('getedamount', false, 'sum')),

                });
            },
            onSelectRow: function (rowid, status) {
                var selr = jQuery('#gridTable').jqGrid('getGridParam', 'selarrrow');
                var s1 = "";
                var temp = 0;
                if (selr.length) {
                    for (var i = 0; i < selr.length; i++) {
                        var myrow = jQuery('#gridTable').jqGrid('getRowData', selr[i]);
                        temp = temp + Number(myrow.totalamount);
                    }
                }
                $("#DTotalAmountOri").val(temp.toFixed(2));
                $("#DTotalAmount").val(temp.toFixed(2));
                
            },
            multiselect: true,
            subGrid: true,
            subGridOptions: {
                "plusicon": "ui-icon-triangle-1-e",
                "minusicon": "ui-icon-triangle-1-s",
                "openicon": "ui-icon-arrowreturn-1-e"
            },
            subGridRowExpanded: function (subgrid_id, row_id) {
                var rowData = $("#gridTable").jqGrid('getRowData', row_id);
               
                var Parameter = [{
                    paramName: "DeliveryId",
                    paramValue: rowData["deliveryid"],
                    Operation: "Equal"
                }]

                var subgrid_table_id, pager_id;
                subgrid_table_id = subgrid_id + "_t";
                pager_id = "p_" + subgrid_table_id;
                $("#" + subgrid_id).html("<table id='" + subgrid_table_id + "' class='scroll'></table><div id='" + pager_id + "' class='scroll'></div>");
                jQuery("#" + subgrid_table_id).jqGrid({
                    url: "@Url.Content("~/DeliveryModule/BY_DeliveryDetail/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)),
                    datatype: "json",
                            height: $(window).height() / 2 - 115,
                            autowidth: true,
                            colModel: [
                               { label: '发运单明细ID', name: 'DeliveryDetailId', hidden: true },
                        { label: 'Thick', name: 'Thick', hidden: true },
                        { label: 'Weigh', name: 'Weigh', hidden: true },
                        { label: 'Length', name: 'Length', hidden: true },
                        { label: 'BoreSize', name: 'BoreSize', hidden: true },
                        { label: 'SteelCode', name: 'SteelCode', hidden: true },
                        { label: '行号', name: 'LineCode', index: 'LineCode', width: 40, align: 'left', sortable: true },
                        { label: '客户品名', name: 'ProductName', index: 'ProductName', width: 100, align: 'left', sortable: true },
                        { label: '钢种名称', name: 'SteelDescription', index: 'SteelDescription', width: 100, align: 'left', sortable: true },

                        {
                            label: '厚*宽*长', name: 'Length', index: 'Length', width: 120, align: 'left', sortable: true,
                            formatter: function (cellvalue, options, rowobject) {
                                if (rowobject.Length == 0) {
                                    return '';
                                }
                                if (!!rowobject.Weigh) {
                                    return rowobject.Thick + "*" + rowobject.Weigh + "*" + rowobject.Length;
                                }
                                else {
                                    var BoreSize = "";
                                    if (!!rowobject.BoreSize) {
                                        BoreSize = "xΦ" + rowobject.BoreSize;
                                    }
                                    return "Φ" + rowobject.Thick + BoreSize + "*" + rowobject.Length;
                                }
                            }
                        },
                        { label: '数量', name: 'Qty', index: 'Qty', width: 60, align: 'left', sortable: true },
                        { label: '理重', name: 'TheoryWeight', index: 'TheoryWeight', width: 60, align: 'left', sortable: true },
                        { label: '重量', name: 'Weight', index: 'Weight', width: 60, align: 'left', sortable: true },
                        { label: '材料单价', name: 'MaterialPrice', index: 'MaterialPrice', width: 50, align: 'left', sortable: true },
                        { label: '小件单价', name: 'WorkPrice', index: 'WorkPrice', width: 50, align: 'left', sortable: true },
                        { label: '加工单价', name: 'SmallCost', index: 'SmallCost', width: 50, align: 'left', sortable: true },
                        { label: '金额（材料）', name: 'MaterialAmount', index: 'MaterialAmount', width: 50, align: 'left', sortable: true },
                        { label: '金额（小件）', name: 'WorkAmount', index: 'WorkAmount', width: 50, align: 'left', sortable: true },
                        { label: '金额（加工）', name: 'SmallAmount', index: 'SmallAmount', width: 50, align: 'left', sortable: true },
                        { label: '合计费用', name: 'SalesAmount', index: 'SalesAmount', width: 80, align: 'left', sortable: true },
                        { label: '模号', name: 'CustomerProduct', index: 'CustomerProduct', width: 100, align: 'left', sortable: true },
                        { label: '发货说明', name: 'ShipDescription', index: 'ShipDescription', width: 100, align: 'left', sortable: true },
                        {
                            label: '备注', name: 'Remark', index: 'Remark', width: 100, align: 'left', sortable: true,
                            formatter: function (cellvalue, options, rowObject) {
                                if (!!cellvalue) {
                                    return cellvalue.replace(/,/g, "，");;

                                }
                                return "";
                            }
                        },
                { label: '配件号', name: 'ProjectCode', width: 80 },
                            ],
                            viewrecords: true,
                            rowNum: 30,
                            rowList: [30, 50, 100, 500, 5000],
                            pager: "#" + pager_id,
                            sortname: 'CreateDate',
                            sortorder: 'asc',
                            rownumbers: true,
                            shrinkToFit: false,
                            altRows: false,
                            altclass: 'altclass',
                            gridview: true,
                        });
                    }
        });
    }

    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        if (Number($("#month").find("select[name='year']").val()) + 1 == 13) {
            tipDialog("请选择月份！！", 3, 0);
            return false;

        }
        
        //if (!$("#LType").val()) {
        //    tipDialog("请选择送货单种类！！", 3, 0);
        //    return false;

        //}

        var selr = jQuery('#gridTable').jqGrid('getGridParam', 'selarrrow');
        var s = "";
        if (selr.length) {
            for (var i = 0; i < selr.length; i++) {
                var myrow = jQuery('#gridTable').jqGrid('getRowData', selr[i]);
                if (myrow.checksheetcode != $("#CheckSheetCode").val() && myrow.checksheetcode !="") {
                    tipDialog("选择项部分已生成对账单！", 3, 0);
                    return false;
                }
                s = s + myrow.deliverycode + "," ;
            }

            var postData = {
                Year: $("#year").find("select[name='year']").val(),
                Month: Number($("#month").find("select[name='year']").val()) + 1,
                CustomerId: $("#CustomerId").val(),
                deliverycodes: s,
                CheckSheetId: CheckSheetId,
                BeginDate: $("#BeginDate").val(),
                EndDate: $("#EndDate").val(),
                DTotalAmount: $("#DTotalAmount").val(),
                DTotalAmountOri: $("#DTotalAmountOri").val(),
                LType: $("#LType").val(),
                
            };
            $(".ui_state_highlight").attr("disabled", true);
            Loading(true, "正在提交数据...");
            AjaxJson("/CheckSheetModule/BY_CheckSheet/BuildCheckSheet", postData, function (data) {
                tipDialog(data.Message, 3, data.Code);
                top.frames[tabiframeId()].windowload();
                window.setTimeout(function () {closeDialog();}, 500);
            });
        }
        else {
            tipDialog("请选择送货单！", 3, 0);
        }

       
    }



    //客户编码自动补全
    function CustomerAutocomplete() {
        var $CustomerCode = $("#CustomerCode");
        $CustomerCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("CustomerCode", function (data) {
            $("#CustomerId").val(data.CustomerId);
            $("#CustomerCode").val(data.CustomerCode);
            $("#CustomerName").val(data.FullName);
            $("#PaymentMode").val(data.PaymentMode);
            btn_Search();
        });
        //获取数据源
        function DataSource() {
            $("#CustomerId").val('');
            AjaxJson("/CommonModule/Customer/GetAutoCompleJsonNXJ", { keywords: $CustomerCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="CustomerId" style="display: none;">' + DataJson[i].CustomerId + '</td>';
                    html += '<td id="CustomerCode" style="width: 30%;">' + DataJson[i].Code + '</td>';
                    html += '<td id="FullName" style="width: 70%;">' + DataJson[i].FullName + '</td>';
                    html += '<td id="ShortName" style="display: none;">' + DataJson[i].ShortName + '</td>';
                    html += '<td id="Sellpeople" style="display: none;">' + DataJson[i].Sellpeople + '</td>';
                    html += '<td id="SalesArea" style="display: none;">' + DataJson[i].Sellarea + '</td>';
                    html += '<td id="DiscountRate" style="display: none;">' + DataJson[i].DiscountRate + '</td>';
                    html += '<td id="TransitMode" style="display: none;">' + DataJson[i].TransitMode + '</td>';
                    html += '<td id="PaymentMode" style="display: none;">' + DataJson[i].PaymentMode + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("CustomerCode", "300px", "200px", html, function (data) {
                    $("#CustomerId").val(data.CustomerId);
                    $("#CustomerCode").val(data.CustomerCode);
                    $("#CustomerName").val(data.FullName);
                    $("#PaymentMode").val(data.PaymentMode);
                    btn_Search();
                });

            });
        }
    }
</script>
<form id="form1" style="margin: 1px">


    <div class="note-prompt" style="margin: 1px;">
        提示:选择年月后点击生成对账单,如果对账单日期重叠,对账单金额会错误,请选择正确日期后重新生成重叠的前后两个对账单
    </div>
    <div class="border" style="margin: 1px;">
    </div>
    <div style="overflow: auto;">
        <div id='wrap' style="float: inherit; width: 100%">
        </div>
    </div>
    <table  class="form"><tr>
                <th class='formTitle'>对账单号：</th>
                <td class='formValue' colspan="3">
                    <input id="CheckSheetCode" maxlength="50" type="text" class="txt" readonly />
                    <input id="Enabled" type="hidden" value="1" />
                </td>
            
               
            </tr></table>
    <div id="basic" class="tabPanel">
        <table class="form">
            
            <tr>
                <th class='formTitle'>客户编号：</th>
                <td class='formValue'>
                    <input id="CustomerCode" maxlength="50" type="text" class="txt required" datacol="yes" err="客户编号" checkexpession="NotNull" />
                    <input id="CustomerId" type="hidden" />

                </td>
                <th class='formTitle'>对账金额：</th>
                <td class='formValue'>
                    <input id="DTotalAmount" maxlength="50" onfocus="IsMoney(this.id);" type="text" class="txt required" datacol="yes" err="对账金额" checkexpession="NotNull" disabled />
                </td>
                <th class='formTitle' style="display:none">已选单金额：</th>
                <td class='formValue'  style="display:none">
                    <input id="DTotalAmountOri" maxlength="50" disabled type="text" class="txt required" datacol="yes" err="已选单金额" checkexpession="NotNull" disabled />
                </td>
                <th class='formTitle'>公司：</th>
                <td class='formValue'>
                    <select id="CompanyName" class="select required" style="width: 96%" onchange="btn_Search();" ></select>

                </td>

            </tr>
            <tr>
                <th class='formTitle'>开始日期：</th>
                <td class='formValue'>
                    <input id="BeginDate" type="text"     class="txt Wdate required" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 00:00',onpicked:function(){btn_Search();}})" style="width: 95%"  datacol="yes" err="开始日期" checkexpession="NotNull"/>
                </td>
                <th class='formTitle'>结束日期：</th>
                <td class='formValue'>
                    <input id="EndDate" type="text"   class="txt Wdate required"   onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 23:59',onpicked:function(){btn_Search();}})" style="width: 95%" datacol="yes" err="结束日期" checkexpession="NotNull"/>

                </td>
                 <th class='formTitle'>状态：</th>
                 <td class='formValue'>
                     <span class="item" style="cursor: pointer;">
                         <input type="checkbox" class="checkbox" name="checkbox" id="s41" onchange="btn_Search();" />
                         <label for="s41">已回单</label>
                     </span>
                     <span class="item" style="cursor: pointer;">
                         <input type="checkbox" class="checkbox" name="checkbox" id="s42" onchange="btn_Search();" />
                         <label for="s42">未对账</label>
                     </span>
                     种类<select id="LType" type="text" class="txt required" style="width:46%" onchange="btn_Search();">
                         <option value="">ALL</option>
                         <option value="GC">钢材</option>
                         <option value="LJ">配件</option>
                         <option value="RCL">热处理</option>
                     </select>
                 </td>
            </tr>
         
        </table>
    </div>
    <div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
</form>
