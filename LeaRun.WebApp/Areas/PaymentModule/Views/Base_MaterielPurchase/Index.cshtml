    //查询
    function btn_Search() {
        var tempstatus = "";

        var tii = $("#CreateDate_EndTime").val();
        if (!!tii) {
          tii =  $("#CreateDate_EndTime").val() + " 23:59:59"
        }

        if ($("#Status").prop("checked")) {
            tempstatus = 0;
        }
        if ($("#Status1").prop("checked")) {
            tempstatus = 1;
        }
        if ($("#Status1").prop("checked") && $("#Status").prop("checked")) {
            tempstatus = "";
        }
        var Parameter = [{
            paramName: "MaterielPurchaseCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR",
            LeftBrace: "("
        }, {
            paramName: "MaterielCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR"
        }, {
            paramName: "MaterielName",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR"
        }, {
            paramName: "CustomerName",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR"
        }, {
            paramName: "PayCheckSheetCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR"
        }, {
            paramName: "CustomerCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "AND",
            RightBrace: ")"
        }
        , {
            paramName: "DepartmentName",
            paramValue: $("#DepartmentName").val(),
            Operation: "Equal",
            Logic: "AND"
        }
        , {
            paramName: "WorkerName",
            paramValue: $("#WorkerName").val(),
            Operation: "Like",
            Logic: "AND"
        }
        , {
            paramName: "Status",
            paramValue: tempstatus,
            Operation: "Equal",
            Logic: "AND"
        }, {
            paramName: "CreateDate",
            paramValue: $("#CreateDate_StartTime").val(),
            Operation: "GreaterThan",
            Logic: "AND"
        }, {
            paramName: "CreateDate",
            paramValue: tii,
            Operation: "LessThan",
            Logic: "AND"
        }, {
            paramName: "MaterielType",
            paramValue: $("#MaterielType").val(),
            Operation: "Equal",
            Logic: "AND"
        }]

        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/PaymentModule/Base_MaterielPurchase/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)), page: 1 }).trigger('reloadGrid');
    }
    //导出
    function btn_Export() {
        SetDeriveExcel("#gridTable", "物料购买报表");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }

    function btn_printall() {
        var selr = jQuery('#gridTable').jqGrid('getGridParam', 'selarrrow');
        var s = "";
        var customerid = "";
        var num = 0;
        if (selr.length) {
            for (var i = 0; i < selr.length; i++) {
                var myrow = jQuery('#gridTable').jqGrid('getRowData', selr[i]);
                s = s + myrow.MaterielPurchaseId + ","
                if (customerid != myrow.CustomerCode) {
                    customerid = myrow.CustomerCode;
                    num += 1;
                }
            }
            if (num > 1) {
                tipDialog("操作失败:所选采购单，供应商不同！", 3, 0);
                return false;
            }
            //PrintDialog("/OrderModule/OrderPrint/BCPrintPreview?ids=" + s, "PrintPage", "打印", 850, 500, function (iframe) {
            //    top.frames[iframe].AcceptClick();
            //});
            PrintDialog("/PaymentModule/Base_MaterielPurchase/Print?MaterielPurchaseIds=" + s, "PrintPage", "打印", 850, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
