        });

        function self(id) {
            var id = Number(id);
            var e = e || window.event || arguments.callee.caller.arguments[0];
            var tar = e.srcElement || e.target;
            if (event.keyCode == 37) {//左
                if ($(tar).attr('id') == id + "_Length") {
                }
                else if ($(tar).attr('id') == id + "_Weigh") {
                    $("#" + id + "_Length").select();
                }
                else if ($(tar).attr('id') == id + "_Thick") {
                    $("#" + id + "_Weigh").select();
                }
                else if ($(tar).attr('id') == id + "_AddLength") {
                    $("#" + id + "_Thick").select();
                }
                else if ($(tar).attr('id') == id + "_AddWeigh") {
                    $("#" + id + "_AddLength").select();
                }
                else if ($(tar).attr('id') == id + "_AddThick") {
                    $("#" + id + "_AddWeigh").select();
                }
                else if ($(tar).attr('id') == id + "_Qty") {
                    $("#" + id + "_AddThick").select();
                }
                else if ($(tar).attr('id') == id + "_MaterialPrice") {
                    $("#" + id + "_Qty").select();
                }
                else if ($(tar).attr('id') == id + "_WorkCost") {
                    $("#" + id + "_MaterialPrice").select();
                }
                else if ($(tar).attr('id') == id + "_Remark") {
                    $("#" + id + "_WorkCost").select();
                }
                else {
                    $("#" + id + "_Length").select();
                }
                return true;
            }
            if (event.keyCode == 39) {//右
                if ($(tar).attr('id') == id + "_Length") {
                    $("#" + id + "_Weigh").select();
                }
                else if ($(tar).attr('id') == id + "_Weigh") {
                    $("#" + id + "_Thick").select();
                }
                else if ($(tar).attr('id') == id + "_Thick") {
                    $("#" + id + "_AddLength").select();
                }
                else if ($(tar).attr('id') == id + "_AddLength") {
                    $("#" + id + "_AddWeigh").select();
                }
                else if ($(tar).attr('id') == id + "_AddWeigh") {
                    $("#" + id + "_AddThick").select();
                }
                else if ($(tar).attr('id') == id + "_AddThick") {
                    $("#" + id + "_Qty").select();
                }
                else if ($(tar).attr('id') == id + "_Qty") {
                    $("#" + id + "_MaterialPrice").select();
                }
                else if ($(tar).attr('id') == id + "_MaterialPrice") {
                    $("#" + id + "_WorkCost").select();
                }
                else if ($(tar).attr('id') == id + "_WorkCost") {
                    $("#" + id + "_Remark").select();
                }
                else if ($(tar).attr('id') == id + "_Remark") {
                }
                else {
                    $("#" + id + "_Remark").select();
                }
                return true;
            }
            if (event.keyCode == 38) {//上
                var aaa = $(tar).attr('id');
                if (id == 1) {
                    return true;
                }
                $("#gridTable").setSelection(id - 1);
                var irow = id - 1;
                aaa = irow + aaa.substr(1, aaa.length);
                window.setTimeout(function () {
                    $("#" + aaa).select();
                }, 200);
                return true;
            }
            if (event.keyCode == 40 || event.keyCode == 13) {//下

                var aaa = $(tar).attr('id');

                var mun = Number($("#gridTable").getGridParam("reccount"));
                if (id >= 0 && id < mun) {
                    $("#gridTable").setSelection(id + 1);
                }
                else {
                    //$("#lr-add-Row").click();
                }
                var irow = id + 1;
                aaa = irow + aaa.substr(1, aaa.length);
                window.setTimeout(function () {
                    $("#" + aaa).select();
                }, 200);
                return true;
            }
            ////if (e && e.keyCode == 13) {//回车
            ////    //alert($("#gridTable").getGridParam("reccount"));
            ////    return false;
            ////}
            return false;
        }


        function countU(id) {
            var Density = Number(GetJqGridValue("#gridTable", id, "Density"));

            var Length = Number($("#" + id + "_Length").val());
            var Weigh = Number($("#" + id + "_Weigh").val());
            var Thick = Number($("#" + id + "_Thick").val());
            var AddLength = Number($("#" + id + "_AddLength").val());
            var AddWeigh = Number($("#" + id + "_AddWeigh").val());
            var AddThick = Number($("#" + id + "_AddThick").val());
            var AddThick = Number($("#" + id + "_AddThick").val());
            var Qty = Number($("#" + id + "_Qty").val());
            var weight = 0;

            if (Weigh > 0) {
                if (!!AddLength || !!AddWeigh || !!AddThick) {
                    var newleng = Length + AddLength;
                    var newweigh = Weigh + AddWeigh;
                    var newthick = Thick + AddThick;
                }
                weight = (((Length + AddLength) * (Weigh + AddWeigh) * (Thick + AddThick) * Density * Qty) / 1000000).toFixed(2);
            }
            else {
                if (!!AddLength || !!AddWeigh || !!AddThick) {
                    var newleng = Length + AddLength;
                    var newweigh = Weigh + AddWeigh;
                    var newthick = Thick + AddThick;
                }
                weight = ((((Thick + AddThick) / 2) * ((Thick + AddThick) / 2) * (Length + AddLength) * Density * 3.14 * Qty) / 1000000).toFixed(2);
                //weight = ((((Thick + AddThick)) * ((Thick + AddThick)) * (Length + AddLength) * Density * Qty) / 1000000).toFixed(2);
            }
            $("#" + id + "_Weight").val(weight)
            $("#" + id + "_TheoryWeight").val(weight)

        }

        function countUAmount(id) {

            var MaterialPrice = Number($("#" + id + "_MaterialPrice").val() || 0);
            var Weight = Number($("#" + id + "_Weight").val() || 0);
            var WorkCost = Number($("#" + id + "_WorkCost").val() || 0);
            $("#" + id + "_MaterialAmount").val((MaterialPrice * Weight + WorkCost).toFixed(2))
        }

        //删除
        $("#lr-delete-Row").click(function () {
            var Index = GetJqGridRowIndx("#gridTable");
            $("#gridTable").jqGrid("delRowData", Index);
        });
    }

