<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>粗料单打印预览</title>
    @*    <link href="~/Content/Styles/learunui-framework.css" rel="stylesheet" />
    <script src="~/Content/Scripts/jquery/jquery-1.8.2.min.js"></script>
    <script src="~/Content/Scripts/learunui-framework.js"></script>
    <script src="~/Content/Scripts/lodop/LodopFuncs.js"></script>*@
    @Scripts.Render("~/Content/Scripts/frameworkjquery")
    @Styles.Render("~/Content/Styles/frameworkcss")
    <script src='http://127.0.0.1:8000/CLodopfuncs.js'></script>
    <style>
        .form-print th {
            font-size: 10pt;
            font-family: Arial;
            font-weight: bold;
            background-color: #fff;
            height: 18.6px;
            line-height: 18.6px;
            white-space: nowrap;
            text-align: right;
            padding-right: 2px;
        }

        .form-print td {
            font-size: 10pt;
            font-family: Arial;
            font-weight: bold;
            height: 18.6px;
            line-height: 18.6px;
            padding-right: 2px;
        }
    </style>
    <script>
        var YH = GetQuery('YH');
        //初始化
        $(function () {
            if (YH != "1") {
                $("#MyCompany").text("北仑机械锻造厂");
                $("#logo").attr("src", "@Url.Content("~/Content/Images/123.png")");

            }
            else {
                $("#logo").attr("src", "@Url.Content("~/Content/Images/123.png")");
                $("#MyCompany").text("北仑机械锻造厂");
            }

            $("#CNAME").text("@DNS.Utilities.ManageProvider.Provider.Current().UserName".substr(0,1)+"小姐");
            

            AjaxJsonNoMassge("/PaymentModule/Base_SteelPurchase/PrintDataJson?SteelPurchaseId=" + GetQuery('SteelPurchaseId'), { A: 1 }, function (data) {

                $("#CustomerName").html(data.Base_Supplier.FullName);
                $("#ContactTel").html(data.Base_Supplier.SellpeoplePhone);
                $("#ContactFax").html(data.Base_Supplier.Fax);
                $("#ContactName").html(data.Base_Supplier.Sellpeople);
                $("#CustomerAddress").html(data.Base_Supplier.Address);
                $("#PaymentMode").html(data.Base_Supplier.PaymentMode);
                $("#TaxNumber").html(data.Base_Supplier.TaxNumber);
                $("#SteelPurchaseCode").html(data.Base_SteelPurchase.SteelPurchaseCode);

                var title = "";
                if (data.Base_SteelPurchase.TypeJC == "进仓") {
                    title = "钢材采购单";
                    $("#CheckName").html(title);
                }
                else {
                    title = "钢材退货单";
                    $("#CheckName").html(title);

                }

                $("#date").html("@DNS.Utilities.DateTimeHelper.GetDate(1)");
                $("#man").html("@DNS.Utilities.ManageProvider.Provider.Current().UserName");
                var SumTotalMoney = 0;
                var SumWeight = 0;
                var SumQty = 0;
                $.each(data.BY_Inventorys, function (i) {
                    var QuotationDetailhtml = "";
                    if (!data.BY_Inventorys[i].Remark) {
                        data.BY_Inventorys[i].Remark = "";
                    }

                    if (!data.BY_Inventorys[i].PlaceOrigin) {
                        data.BY_Inventorys[i].PlaceOrigin = "";
                    }

                    var size = "";
                    if (!!data.BY_Inventorys[i].OWeigh) {
                        size = parseFloat(data.BY_Inventorys[i].OLength) + "*" + parseFloat(data.BY_Inventorys[i].OWeigh) + "*" + parseFloat(data.BY_Inventorys[i].OThick);
                    }
                    else {
                        var BoreSize = "";
                        if (!!data.BY_Inventorys[i].BoreSize) {
                            BoreSize = "xΦ" + data.BY_Inventorys[i].BoreSize;
                        }
                        size = "Φ" + parseFloat(data.BY_Inventorys[i].OThick) + BoreSize + "*" + parseFloat(data.BY_Inventorys[i].OLength);
                    }
                    var money = 0;
                    if (data.BY_Inventorys[i].SteelDescription == "特定费用") {
                        size = "";
                        money = (data.BY_Inventorys[i].Qty * data.BY_Inventorys[i].Price).toFixed(2)
                    }
                    else {
                        money = (data.BY_Inventorys[i].OWeight * data.BY_Inventorys[i].Price).toFixed(2)
                    }
                    if (!data.BY_Inventorys[i].QuotationCodeLine) {
                        data.BY_Inventorys[i].QuotationCodeLine = "";
                    }
                    money = "";
                    if (i == 0) {
                        QuotationDetailhtml += '<tr>';
                        QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].SortCode + '</td>';
                        QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].SteelDescription + '</td>';
                        QuotationDetailhtml += '     <td colspan="3" align="center" style="font-size: 14pt;">' + size + '</td>';

                        QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].Qty + '</td>';
                        QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].OWeight + '</td>';
                        if (data.Base_SteelPurchase.TypeJC != "进仓") {
                            QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].TotalAmount + '</td>';
                        }
                        else {
                            QuotationDetailhtml += '     <td align="center"></td>';

                        }
                        QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].QuotationCodeLine + '</td>';
                        QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].PlaceOrigin + '</td>';
                        QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].Remark + '</td>';
                        QuotationDetailhtml += '     <td align="center" rowspan="' + data.BY_Inventorys.length + '">' + data.Base_SteelPurchase.Remark + '</td>';
                        QuotationDetailhtml += '</tr>';
                    }
                    else {
                        QuotationDetailhtml += '<tr>';
                        QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].SortCode + '</td>';
                        QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].SteelDescription + '</td>';
                        QuotationDetailhtml += '     <td colspan="3" align="center"  style="font-size: 14pt;">' + size + '</td>';
                        QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].Qty + '</td>';
                        QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].OWeight + '</td>';
                        if (data.Base_SteelPurchase.TypeJC != "进仓") {
                            QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].TotalAmount + '</td>';
                        }
                        else {
                            QuotationDetailhtml += '     <td align="center"></td>';

                        }
                        QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].QuotationCodeLine + '</td>';
                        QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].PlaceOrigin + '</td>';
                        QuotationDetailhtml += '     <td align="center">' + data.BY_Inventorys[i].Remark + '</td>';
                        QuotationDetailhtml += '</tr>';
                    }


                    $("#tb_QuotationDetail").append(QuotationDetailhtml);
                    SumTotalMoney = Number(SumTotalMoney) + Number(money);
                    if (data.BY_Inventorys[i].SteelDescription != "特定费用") {
                        SumQty = SumQty + data.BY_Inventorys[i].Qty;
                    }
                    SumWeight = Number(SumWeight) + Number(data.BY_Inventorys[i].OWeight);
                });

                var tempfoot = "";
                tempfoot += '<tr>';
                tempfoot += '     <td colspan="5" align="center">合   计</td>';

                tempfoot += '     <td align="center">' + Number(SumQty).toFixed(2) + '</td>';
                //tempfoot += '     <td colspan="2" align="center">' + SumWeight.toFixed(2) + '</td>';
                //tempfoot += '     <td align="center">￥' + SumTotalMoney.toFixed(2) + '</td>';
                tempfoot += '     <td align="center">' + Number(SumWeight).toFixed(2) + '</td>';
                if (data.Base_SteelPurchase.TypeJC != "进仓") {
                    tempfoot += '     <td align="center">' + data.Base_SteelPurchase.TotalAmount.toFixed(2) + '</td>';
                }
                else {
                    tempfoot += '     <td align="center"></td>';

                }
                tempfoot += '     <td align="center"></td>';
                tempfoot += '     <td align="center"></td>';
                tempfoot += '     <td align="center"></td>';
                tempfoot += '     <td align="center"></td>';
                tempfoot += '</tr>';

                $("#tb_QuotationDetail").append(tempfoot);
            });
        })
        //确认打印
        function AcceptClick() {
            //AjaxJson("/QuotationModule/QuotationPrint/StateModify", { KeyValue: GetQuery('QuotationId') }, function (data) {
            MyPreview();

            //});
        }
    </script>
</head>
