                        $("#gridTable").jqGrid('setRowData', ids[i], { WorkCost: "0" });
                    }
                }
                //合计
                var data = $("#gridTable").jqGrid("getRowData");
                var TotalAmountall = 0;
                var Qty = 0;
                var Weight = 0;
                for (var i = 0; i < data.length; i++) {
                    TotalAmountall = TotalAmountall + Number(data[i].MaterialAmount);
                    Qty = Qty + Number(data[i].Qty);
                    Weight = Weight + Number(data[i].Weight);
                }
                $("#TotalAmount").val(TotalAmountall.toFixed(2));
                $('#gridTable').setGridHeight(300);
                $("#Qty").val((Qty).toFixed(2));
                $("#Weight").val((Weight).toFixed(2));



