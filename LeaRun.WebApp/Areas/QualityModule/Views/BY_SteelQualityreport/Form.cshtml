    function SteelQualityreportCodeAutocomplete() {
        var $SteelQualityreportCode = $("#SteelQualityreportCode");
        $SteelQualityreportCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("SteelQualityreportCode", function (data) {
            if (!!data.SteelQualityreportCode) {
                $("#SteelQualityreportCode").val(data.SteelQualityreportCode);
            }
            KeyValue = "";
            setQuo();

        });
        //获取数据源
        function DataSource() {
            AjaxJson("/QualityModule/BY_SteelQualityreportT/SetForm1", { SteelQualityreportCode: escape($("#SteelQualityreportCode").val()) }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="SteelQualityreportCode" style="width: 100%;">' + DataJson[i].SteelQualityreportCode + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("SteelQualityreportCode", $SteelQualityreportCode.width() + "px", "280px", html, function (data) {
                    if (!!data.SteelQualityreportCode) {
                        $("#SteelQualityreportCode").val(data.SteelQualityreportCode);
                    }
                    KeyValue = "";
                    setQuo();

                },true);
            });
        }
    }
        var lastsel;
    function GetGrid() {
        var lastselpostdate;
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/QualityModule/BY_SteelQualityreportList/GetListJson1")?SteelQualityreportId=" + $("#SteelQualityreportId").val(),
            datatype: "json",
            height: $(window).height() - 150,
            autowidth: true,
            colModel: [
                //{ label: '主键', name: 'InventoryId', hidden: true },
                { label: 'BY_SteelQualityreportListId', name: 'BY_SteelQualityreportListId', hidden: true },
                { label: 'QuotationDetailId', name: 'QuotationDetailId', hidden: true },
                { label: '序号', name: 'SortCode', width: 40, align: 'center' },
                { label: '生产编号', name: 'OrderCodeLine', align: 'center', width: 120, editable: true },
                { label: "规格", name: "Size", align: 'center', width: 100, editable: true },
                { label: "件数", name: "Qty", width: 60, align: 'center', editable: true },
                { label: '重量', name: 'Weight', width: 60, align: 'center', editable: true },
                { label: '模号', name: 'CustomerProduct', width: 100, align: 'center', editable: true },
                { label: '备注', name: 'ExecRemark', width: 100, align: 'center', editable: true },
            ],
            viewrecords: true,
            rowNum: 999,
            rowList: [999, 999, 999, 999, 999],
            pager: false,
            shrinkToFit: false,
            rownumbers: true,
            altRows: false,
            sortname: 'SortCode',
            sortorder: 'asc',
            altclass: 'altclass',
            gridview: true,
            cellsubmit: 'clientArray',
            onSelectRow: function (id) {
                var postData = {
                    OrderCodeLine: $("[name='OrderCodeLine']").val(),
                    Size: $("[name='Size']").val(),
                    Qty: $("[name='Qty']").val(),
                    Weight: $("[name='Weight']").val(),
                    CustomerProduct: $("[name='CustomerProduct']").val(),
                    ExecRemark: $("[name='ExecRemark']").val(),
                }
                if (id && id !== lastsel) {
                    $('#gridTable').jqGrid('restoreRow', lastsel);
                    $('#gridTable').jqGrid('editRow', id, { keys: false });
                    $('#gridTable').jqGrid('setRowData', lastsel, postData, '');
                }
                lastselpostdate = postData;
                lastsel = id;

            },
            gridComplete: function () {
                //合计
            }

        });
        $("#lr-delete-Row").click(function () {
            var Index = GetJqGridRowIndx("#gridTable");
            $("#gridTable").jqGrid("delRowData", Index);
        });
    }

    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/QualityModule/BY_SteelQualityreport/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
            });
        }
    }
    function SteelAutocomplete() {
        var $SteelCode = $("#SteelCode");
        $SteelCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            //DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("SteelCode", function (data) {
            if (!!data.SteelCode) {
                $("#SteelId").val(data.SteelId);
                $("#SteelCode").val(data.SteelCode);
                $("#SteelName").val(data.SteelName);
            }
        });
        //获取数据源
        function DataSource() {
            AjaxJsonNoMassge("/CommonModule/Steel/GetAutoCompleJson", { keywords: $SteelCode.val(), isBanOrYuan: "", type: 1 }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="SteelId" style="display: none;">' + DataJson[i].SteelId + '</td>';
                    html += '<td id="SteelCode" style="width: 40%;">' + DataJson[i].SteelCode + '</td>';
                    html += '<td id="SteelName" style="width: 60%;">' + DataJson[i].SteelName + '</td>';
                    html += '<td id="Density" style="display: none;">' + DataJson[i].Density + '</td>';
                    html += '<td id="SteelType" style="display: none;">' + DataJson[i].SteelType + '</td>';
                    html += '<td id="RepalceMl" style="display: none;">' + DataJson[i].RepalceMl + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("SteelCode", "150px", "250px", html, function (data) {
                    $("#SteelId").val(data.SteelId);
                    $("#SteelCode").val(data.SteelCode);
                    $("#SteelName").val(data.SteelName);
                });
            });
        }
    }

    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }

        var RowData = {
            OrderCodeLine: $("[name='OrderCodeLine']").val(),
            Size: $("[name='Size']").val(),
            Qty: $("[name='Qty']").val(),
            Weight: $("[name='Weight']").val(),
            CustomerProduct: $("[name='CustomerProduct']").val(),
            ExecRemark: $("[name='ExecRemark']").val(),
        }
        $('#gridTable').jqGrid('setRowData', GetJqGridRowIndx('#gridTable'), RowData, '');
        var data = $("#gridTable").jqGrid("getRowData");
        for (var i = 0; i < data.length; i++) {
            if (!data[i].OrderCodeLine) {
                tipDialog("单号编码错误，请检查", 3, -1);
                return;
            }
            if (!data[i].Size) {
                tipDialog("部分尺寸错误，请检查", 3, -1);
                return;
            }
            if (!data[i].Qty) {
                tipDialog("部分数量错误，请检查", 3, -1);
                return;
            }
            if (!data[i].Weight) {
                tipDialog("部分重量错误，请检查", 3, -1);
                return;
            }
        }

        var postData = GetWebControls("#form1");
        postData["SteelListJson"] = JSON.stringify($("#gridTable").jqGrid("getRowData"));

        AjaxJson("/QualityModule/BY_SteelQualityreport/SubmitForm1?KeyValue=" + KeyValue, postData, function (data) {
            if (data.Code == "1") {
                tipDialog("保存成功!", 3, data.Code);
                top.frames[tabiframeId()].windowload();
                KeyValue = data.Message
                //window.setTimeout(function () {closeDialog();}, 500);
            }
        });
    }

