<!--列表-->
<div id="grid_List">
    <div class="bottomline QueryArea" id="QueryParameter" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
        <table border="0" class="form-find" style="height: 45px;">
            <tr>
                <td>
                    <fieldset style="padding: 5px; padding-bottom: 0px; width: 350px; display: inline;">
                        <legend>货期</legend>
                        <table border="0" class="form-find" style="margin-top: -10px;">
                            <tr>
                                <th style="width: 30px">从：</th>
                                <td>
                                    <input id="LType" type="hidden" value="GC" />
                                    <input id="CreateDate_StartTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 00:00'})" style="width: 120px" />
                                </td>
                                <th style="width: 30px">至：</th>
                                <td>
                                    <input id="CreateDate_EndTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 23:59'})" style="width: 120px" />
                                </td>
                            </tr>

                        </table>
                    </fieldset>
                </td>
                <th style="width: 30px; padding-top: 20px;">编码</th>
                <td style="padding-top: 20px;">
                    <input id="MnemonicCode" type="text" class="txt" style="width: 100px" />
                </td>
               @* <th style="width: 30px; padding-top: 20px;">订单</th>
                <td style="padding-top: 20px;">
                    <input id="OrderCode" type="text" class="txt" style="width: 100px" />
                </td>*@
                
                <td style="padding-top: 20px;">
                    <span class="item" style="cursor: pointer;">
                        <input type="checkbox" class="checkbox" name="checkbox" id="CheckBoxComplete" />
                        <label for="CheckBoxComplete">隐藏未完工</label>
                    </span>
                </td>
                <td style="padding-top: 20px;">
                    <span class="item" style="cursor: pointer;">
                        <input type="checkbox" class="checkbox" name="checkbox" id="Refresh" />
                        <label for="Refresh">每30秒自动刷新</label>
                    </span>

                </td>
                <td style="padding-top: 20px;">
                    <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
                    <input id="btnSearch1" type="button" class="btnSearch" value="生成" onclick="btn_confirm()()" />
                    <input id="btnSearch2" type="button" class="btnSearch" value="回退" onclick="deleteComplete()" />
                </td>
            </tr>


        </table>

    </div>
</div>

<div id="layout2" class="layout2">
    <!--左边-->
    <div class="layoutPanel layout-west" style=" ">
        <div class="btnbartitle">
            <div>
                订单信息
            </div>
        </div>
        <table id="gridTable"></table>
        <div id="gridPager"></div>
    </div>
    <!--中间-->
    <div class="layoutPanel layout-center">
        <div class="btnbartitle">
            <div>
                完工未发送确认信息
            </div>
        </div>
        <!--视图-->
        <table id="DeliverygridTable"></table>
        <div id="DeliverygridPager"></div>

        <div class="btnbartitle">
            <div>
                订单未完工信息
            </div>
        </div>
        <!--视图-->
        <table id="DetailgridTable"></table>
        <div id="DetailgridPager"></div>
    </div>
</div>
