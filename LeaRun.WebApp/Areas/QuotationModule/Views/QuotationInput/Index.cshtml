@{
    ViewBag.Title = "报价单录入";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}

<script type="text/javascript">
    var KeyValue = "";
    var addressDATA;
    $(function () {
        $("body").unbind("onkeydown");
        document.onkeydown = enterInput;

        $("#Detail_button").css({ top: $(".bd").offset().top + 2 });
        //加工类型
        //BindDropItem("#OrderType", "ProcessType", "==请选择==");
        //账期
        BindDropItem("#PaymentMode", "PaymentMode", "==请选择==");
        //送货方式
        BindDropItem("#ShipMode", "TransitMode", "==请选择==");
        //客户编码自动补全
        CustomerAutocomplete();


        getAjax('/CommonModule/Company/ListJson', { ParentId: "0" }, function (data) {
            $("#CompanyName").append($("<option></option>").val("").html("请选择！"));
            var itemjson = eval("(" + data + ")");
            $.each(itemjson, function (i) {
                $("#CompanyName").append($("<option></option>").val(itemjson[i].FullName).html(itemjson[i].FullName));
            });
            Loading(false);
        });

        //出货组织
        $("#ShipGroup").focus(function () {
            var objId = this.id;
            SelectTree(objId, "150px");
            var itemtree = {
                onnodeclick: function (item) {
                    $('#ShipGroup').val(item.text);
                },
                url: "@Url.Content("~/CommonModule/Company/TreeJson")"
            };
            $("#comboBoxTree" + objId).treeview(itemtree);
        });
        //明细表格
        window.setTimeout(function () {
            GetGrid();

        }, 200);
    })

    var SelectRowIndx = 0;
    function enterInput() {


        var e = e || window.event || arguments.callee.caller.arguments[0];
        var tar = e.srcElement || e.target;
        if (event.keyCode == 38) {//上
            if (SelectRowIndx == 0) {
                $("#gridTable").jqGrid('setSelection', 1);
            }
            else {
                $("#gridTable").jqGrid('setSelection', Number(SelectRowIndx) - 1);
            }
            //$(".ui-jqgrid-bdiv").first().scrollTop(rowScrod+50);
        }
        if (event.keyCode == 40) {//下
            if (SelectRowIndx == 0) {
                $("#gridTable").jqGrid('setSelection', 1);
            }
            else {
                $("#gridTable").jqGrid('setSelection', Number(SelectRowIndx) + 1);
            }
            $(".ui-jqgrid-bdiv").first().scrollTop(rowScrod - 30);
        }
        if (event.keyCode == 13) {//下
            $("#lr-edit-Row").click();
        }
    }

    //客户编码自动补全
    function CustomerAutocomplete() {
        var $CustomerCode = $("#CustomerCode");
        $CustomerCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("CustomerCode", function (data) {
            $("#CustomerId").val(data.CustomerId);
            $("#CustomerCode").val(data.CustomerCode);
            $("#CustomerName").val(data.FullName);
            $("#ShortName").val(data.ShortName);
            $("#SalesMan").val(data.Sellpeople);
            $("#SalesArea").val(data.SalesArea);
            if (data.DiscountRate && data.DiscountRate != "null") {
                $("#LessRate").val(data.DiscountRate);
            }
            else {
                $("#LessRate").val(0);
            }
            if (data.IsInvoice == 1) {
                $("#IsInvoice").prop("checked", true);
            }
            else {
                $("#IsInvoice").prop("checked", false);
            }
            $("#ShipMode").val(data.TransitMode);
            $("#PaymentMode").val(data.PaymentMode);
            $("#Category").val(data.Category);
            LoadContactName(data.CustomerId);
            LoadCustomerRequery(data.CustomerId);
            $('input').customInput();
            $("#LType").val("GC");
            $("#CompanyName").val(data.CompanyName);
        });
        //获取数据源
        function DataSource() {
            $("#CustomerId").val('');
            AjaxJson("/CommonModule/Customer/GetAutoCompleJson", { keywords: $CustomerCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="CustomerId" style="display: none;">' + DataJson[i].CustomerId + '</td>';
                    html += '<td id="CustomerCode" style="width: 30%;">' + DataJson[i].Code + '</td>';
                    html += '<td id="FullName" style="width: 70%;">' + DataJson[i].FullName + '</td>';
                    html += '<td id="ShortName" style="display: none;">' + DataJson[i].ShortName + '</td>';
                    html += '<td id="Sellpeople" style="display: none;">' + DataJson[i].Sellpeople + '</td>';
                    html += '<td id="SalesArea" style="display: none;">' + DataJson[i].Sellarea + '</td>';
                    html += '<td id="DiscountRate" style="display: none;">' + DataJson[i].DiscountRate + '</td>';
                    html += '<td id="TransitMode" style="display: none;">' + DataJson[i].TransitMode + '</td>';
                    html += '<td id="PaymentMode" style="display: none;">' + DataJson[i].PaymentMode + '</td>';
                    html += '<td id="Category" style="display: none;">' + DataJson[i].Category + '</td>';
                    html += '<td id="IsInvoice" style="display: none;">' + DataJson[i].IsInvoice + '</td>';
                    html += '<td id="CompanyName" style="display: none;">' + DataJson[i].CompanyName + '</td>';

                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("CustomerCode", "300px", "200px", html, function (data) {
                    $("#CustomerId").val(data.CustomerId);
                    $("#CustomerCode").val(data.CustomerCode);
                    $("#CustomerName").val(data.FullName);
                    $("#ShortName").val(data.ShortName);
                    $("#SalesMan").val(data.Sellpeople);
                    $("#SalesArea").val(data.SalesArea);
                    if (data.DiscountRate && data.DiscountRate != "null") {
                        $("#LessRate").val(data.DiscountRate);
                    }
                    else {
                        $("#LessRate").val(0);
                    }
                    if (data.IsInvoice == 1) {
                        $("#IsInvoice").prop("checked", true);
                    }
                    else {
                        $("#IsInvoice").prop("checked", false);
                    }

                    $("#ShipMode").val(data.TransitMode);
                    $("#PaymentMode").val(data.PaymentMode);
                    $("#Category").val(data.Category);
                    LoadContactName(data.CustomerId);
                    LoadCustomerRequery(data.CustomerId);
                    $('input').customInput();
                    $("#LType").val("GC");
                    $("#CompanyName").val(data.CompanyName);

                });

            });
        }
        //联系人
        function LoadContactName(CustomerId) {
            if (!!CustomerId) {
                AjaxJson("/CommonModule/Customer/CustomerAddressListJson", { CustomerId: CustomerId }, function (data) {
                    $("#ShipAddress").html('');
                    $("#CollectAddress").html('');
                    addressDATA = data.rows;
                    var datajson = data.rows;
                    $.each(datajson, function (i) {
                        $("#ShipAddress").append($("<option data='" + JSON.stringify(datajson[i]) + "'></option>").val(datajson[i].DetailAddress).html(datajson[i].DetailAddress));
                        if (datajson[i].MainDefault == "是") {
                            $("#ContactTel").val(datajson[i].Telephone);
                            $("#ContactFax").val(datajson[i].Fax);
                            $("#ContactMail").val(datajson[i].EmailAddress);
                            $("#MobileCode").val(datajson[i].Mobile);
                            $("#CustomerAddress").val(datajson[i].DetailAddress);
                            $("#ShipRoute").val(datajson[i].SendPath);
                            $("#ContactName").val(datajson[i].Contact);
                            $("#ShipAddress").val(datajson[i].DetailAddress);
                        }

                    });
                })
            }
        }
        //发货地址下拉框选择
        $("#ShipAddress").change(function () {
            var data = JSON.parse($(this).find("option:selected").attr('data'));
            $("#ContactTel").val(data.Telephone);
            $("#ContactFax").val(data.Fax);
            $("#ContactMail").val(data.EmailAddress);
            $("#MobileCode").val(data.Mobile);
            $("#CustomerAddress").val(data.DetailAddress);
            $("#ShipRoute").val(data.SendPath);
            $("#ContactName").val(data.Contact);
            $("#ShipAddress").val( data.DetailAddress);
        })
        //部门
        function LoadCustomerRequery(CustomerId) {
            if (!!CustomerId) {
                AjaxJson("/CommonModule/Customer/CustomerRequeryListJson", { CustomerId: CustomerId }, function (data) {
                    $("#DepartName").html('');
                    var datajson = data.rows;
                    $.each(datajson, function (i) {
                        $("#DepartName").append($("<option data='" + JSON.stringify(datajson[i]) + "'></option>").val(datajson[i].DepartName).html(datajson[i].DepartName));
                        $("#KLRequery").val(datajson[i].KLRequery);
                        $("#XMRequery").val(datajson[i].XMRequery);
                        $("#DepartName").val(datajson[i].DepartName);

                        $.each(addressDATA, function (a) {
                            if (addressDATA[a].Application == datajson[i].DepartName) {
                                $("#ShipAddress").val(addressDATA[a].DetailAddress);
                                $("#ContactTel").val(addressDATA[a].Telephone);
                                $("#ContactFax").val(addressDATA[a].Fax);
                                $("#ContactMail").val(addressDATA[a].EmailAddress);
                                $("#MobileCode").val(addressDATA[a].Mobile);
                                $("#CustomerAddress").val(addressDATA[a].DetailAddress);
                                $("#ShipRoute").val(addressDATA[a].SendPath);
                                $("#ContactName").val(addressDATA[a].Contact);
                                $("#ShipAddress").val(addressDATA[a].DetailAddress);
                            }
                        });
                    });
                })
            }
        }
        $("#DepartName").change(function () {
            var data = JSON.parse($(this).find("option:selected").attr('data'));
            $("#KLRequery").val(data.KLRequery);
            $("#XMRequery").val(data.XMRequery);
            $("#DepartName").val(data.DepartName);

            $.each(addressDATA, function (i) {
                if (addressDATA[i].Application == data.DepartName) {
                    $("#ShipAddress").val(addressDATA[i].DetailAddress);
                    $("#ContactTel").val(addressDATA[i].Telephone);
                    $("#ContactFax").val(addressDATA[i].Fax);
                    $("#ContactMail").val(addressDATA[i].EmailAddress);
                    $("#MobileCode").val(addressDATA[i].Mobile);
                    $("#CustomerAddress").val(addressDATA[i].DetailAddress);
                    $("#ShipRoute").val(addressDATA[i].SendPath);
                    $("#ContactName").val(addressDATA[i].Contact);
                    $("#ShipAddress").val(addressDATA[i].DetailAddress);
                }
            });

        })
    }




    //查询
    function btn_query() {
        openDialog("/QuotationModule/QuotationInput/QueryQuotation?LType=GC", "QueryQuotation", "报价单查询", 800, 500, function (iframe) {
            top.frames[iframe].AcceptClick()
        });
    }
    //新增
    function btn_add() {
        KeyValue = "";
        windowload();
        $("#tb_rderFrom").find("input,select,label").removeAttr('disabled').val('');
        $("#lr-add,#lr-edit,#lr-delete").addClass('disabled');
        $("#lr-save,#lr-cancel,#lr-submit,#lr-Delivery").removeClass('disabled');
        if ("@ViewBag.BillNo".trim() != "") {
            var QuotationCode = '@ViewBag.BillNo';
            $("#QuotationCode").val(QuotationCode);
        }
        else {
            $("#QuotationCode").val("保存后自动生成");
            $("#MnemonicCode").val("默认为报价单号");
        }

        $("#CheckStatusName").html("").attr('CheckStatus', "");
        $("#CustMaterial").removeAttr("checked");
        $("#FreeBill").removeAttr("checked");
        $("#IsEmergency").removeAttr("checked");
        $('input').customInput();
        $("#ShipGroup").val('@DNS.Utilities.ManageProvider.Provider.Current().CompanyName');
    }
    //编辑
    function btn_edit() {
        if ($("#lr-edit").hasClass('disabled') && "@DNS.Utilities.ManageProvider.Provider.Current().UserName" != "超级管理员") { return false; }
        $("#tb_rderFrom").find("input,select,label").removeAttr('disabled');
        $("#lr-add,#lr-edit,#lr-delete").addClass('disabled');
        $("#lr-save,#lr-cancel").removeClass('disabled');
        $('#OrderType').attr("disabled", "disabled");
    }
    //删除
    function btn_delete() {
        if ($("#lr-delete").hasClass('disabled') && "@DNS.Utilities.ManageProvider.Provider.Current().UserName" != "超级管理员") { return false; }
        //if ($("#lr-delete").hasClass('disabled')) { return false; }
        if (IsDelData(KeyValue)) {
            var delparm = 'KeyValue=' + KeyValue;
            confirmDialog("提示", "确认要删除报价单吗？", function (r) {
                if (r) {
                    Loading(true, "正在删除数据...");
                    window.setTimeout(function () {
                        AjaxJson("/QuotationModule/QuotationInput/Delete1", { KeyValue: KeyValue }, function (data) {
                            tipDialog(data.Message, 3, data.Code);
                            if (data.Code > 0) {
                                location.reload();
                            }
                        });
                    }, 200);
                }
            });
        }
    }

    function btn_Delivery() {
        if ($("#lr-Delivery").hasClass('disabled')) { return false; }
        @*if ("@DNS.Utilities.ManageProvider.Provider.Current().UserName" != "超级管理员") { return false; }*@
        if (IsDelData(KeyValue)) {
            confirmDialog("提示", "确认要直接发运吗？", function (r) {
                if (r) {
                    Loading(true, "正在发运...");
                    window.setTimeout(function () {

                        //提交
                        if ($("#lr-submit").hasClass('disabled')) { return false; }
                        if (!KeyValue) {
                            alertDialog("请先保存报价单信息", 0);
                            return false;
                        }
                        if ($("#gridTable").getGridParam("reccount") == 0) {
                            alertDialog("请输入报价单行明细", 0);
                            return false;
                        }
                        //AjaxJson("/QuotationModule/QuotationInput/SubmitAuditRun", { KeyValue: KeyValue, CheckStatus: 0 }, function (data) {
                        //    if (data.Code > 0) {
                        //        InitControl(KeyValue);
                        //    }
                        //    else {
                        //        tipDialog(data.Message, 3, data.Code);
                        //        return;
                        //    }
                        //});

                        AjaxJson("/QuotationModule/QuotationInput/ToDelivery", { KeyValue: KeyValue }, function (data) {
                            tipDialog(data.Message, 3, data.Code);
                            if (data.Code > 0) {
                                InitControl(KeyValue);
                            }
                            else {
                                tipDialog(data.Message, 3, data.Code);
                                return;
                            }
                        });
                    }, 200);
                }
            });
        }
    }


    //保存
    function btn_save() {
        if ($("#lr-save").hasClass('disabled')) { return false; }
        if (!CheckDataValid('#form1')) {
            return false;
        }
        Loading(true, "正在保存数据...");
        window.setTimeout(function () {
            $("#LType").val("GC");
            var postData = GetWebControls("#form1");
            AjaxJson("/QuotationModule/QuotationInput/SubmitQuotationInputForm?KeyValue=" + KeyValue, postData, function (data) {
                tipDialog(data.Message, 3, data.Code);
                KeyValue = data.Attribute;
                InitControl(KeyValue);
            });
        }, 200);
    }
    //取消
    function btn_cancel() {
        if ($("#lr-cancel").hasClass('disabled')) { return false; }
        if (!KeyValue) {
            $("#lr-add").removeClass('disabled');
            $("#lr-save,#lr-cancel").addClass('disabled');
            $("#tb_rderFrom").find("input,select,label").attr('disabled', 'disabled').val("");
            if ("@ViewBag.BillNo" != "") {
                var QuotationCode = '@ViewBag.BillNo';
                $("#QuotationCode").val(QuotationCode);
            }
            else {
                $("#QuotationCode").val("保存后自动生成");
            }

        } else {
            $("#lr-add,#lr-edit,#lr-delete").removeClass('disabled');
            $("#tb_rderFrom").find("input,select,label").attr('disabled', 'disabled');
            $("#lr-save,#lr-cancel").addClass('disabled');
        }
    }
    //提交
    function btn_submit() {
        if ($("#lr-submit").hasClass('disabled')) { return false; }
        if (!KeyValue) {
            alertDialog("请先保存报价单信息", 0);
            return false;
        }
        if ($("#gridTable").getGridParam("reccount") == 0) {
            alertDialog("请输入报价单行明细", 0);
            return false;
        }
        confirmDialog("提示", "您确认要提交报价单吗？", function (r) {
            if (r) {
                Loading(true, "正在提交数据...");
                window.setTimeout(function () {
                    AjaxJson("/QuotationModule/QuotationInput/SubmitAuditRun", { KeyValue: KeyValue, CheckStatus: 0 }, function (data) {
                        tipDialog(data.Message, 3, data.Code);
                        if (data.Code > 0) {
                            InitControl(KeyValue);
                        }
                    });
                }, 200);
            }
        });
    }

    //获取报价单对象
    function InitControl(_KeyValue) {
        KeyValue = _KeyValue;
        AjaxJson("/QuotationModule/QuotationInput/SetForm", { KeyValue: _KeyValue }, function (data) {
            SetWebControls(data);
            $("#CheckStatusName").attr('CheckStatus', data.CheckStatus);
            if (data.CheckStatus == 0) {
                $("#CheckStatusName").html("(待审核)")
                $("#CheckStatusName").attr("title", "");
            } else if (data.CheckStatus == 1) {
                $("#CheckStatusName").html("(已审核)")
                $("#CheckStatusName").attr("title", "");
            } else {
                $("#CheckStatusName").html("(未提交)")
                $("#CheckStatusName").attr("title", "");
            }
            if (data.CheckStatus != null) {
                $("input,select,label").attr('disabled', 'disabled');
                $("#lr-edit,#lr-delete,#lr-save,#lr-cancel,#lr-submit,#lr-Delivery").addClass('disabled');
            } else {
                $("#lr-save,#lr-cancel").addClass('disabled');
                $("#lr-add,#lr-edit,#lr-delete,#lr-submit,#lr-Delivery").removeClass('disabled');
                $("input,select,label").attr('disabled', 'disabled');
            }
            if (data.CheckStatus == '-1') {
                $("#CheckStatusName").html("(已驳回)")
                $("#CheckStatusName").attr("title", data.CheckRemark);
                $("#lr-add,#lr-edit,#lr-delete,#lr-submit,#lr-Delivery").removeClass('disabled');
            }

            AjaxJson("/CommonModule/Customer/CustomerAddressListJson", { CustomerId: data.CustomerId }, function (data) {
                var datajson = data.rows;
                addressDATA = data.rows;

                $.each(datajson, function (i) {
                        $("#ShipAddress").append($("<option data='" + JSON.stringify(datajson[i]) + "'></option>").val( datajson[i].DetailAddress).html( datajson[i].DetailAddress));

                });
            })
            $("#ShipAddress").val(data.ShipAddress);
            $("#CollectAddress").val(data.CollectAddress);


            AjaxJson("/CommonModule/Customer/CustomerRequeryListJson", { CustomerId: data.CustomerId }, function (data) {
                $("#DepartName").html('');
                var datajson = data.rows;
                $.each(datajson, function (i) {
                    $("#DepartName").append($("<option data='" + JSON.stringify(datajson[i]) + "'></option>").val(datajson[i].DepartName).html(datajson[i].DepartName));
                });
            })
            $("#DepartName").val(data.DepartName);
            $("#KLRequery").val(data.KLRequery);
            $("#XMRequery").val(data.XMRequery);



            windowload();
        });
    }
    /*明细begin=======================================*/
    //分录
    var rowScrod = 0;
    function GetGrid() {
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/QuotationModule/QuotationInput/GridDetail")",
            datatype: "json",
            height: $(window).height() - 311,
            autowidth: true,
            colModel: [
                { label: "行号", name: "LineCode", index: "LineCode", width: 40, frozen: true },
                { label: '加工类型', name: "OrderType", width: 70, frozen: true },
                { label: '钢材编码', name: 'SteelCode', width: 50, hidden: true, frozen: true },
                { label: '钢材名称', name: 'SteelDescription', width: 90, frozen: true },
                { label: '主键', name: 'QuotationDetailId', hidden: true },
                { label: '客户品名', name: 'ProductName', width: 90 },
                { label: '厚/直径', name: 'Thick', width: 50 },
                { label: '宽度', name: 'Weigh', width: 50 },
                { label: '长度', name: 'Length', width: 50 },


                { label: '孔径', name: 'BoreSize', width: 50 },
                { label: '数量', name: "Qty", width: 50 },

                {
                    label: '余量(厚宽长)', name: '余量', width: 80,
                    formatter: function (cellvalue, options, rowObject) {
                        return rowObject.AddLength + "*" + rowObject.AddWeigh + "*" + rowObject.AddThick;
                    }
                },
                { label: '倒角', name: 'IsChamfer', width: 100, hidden: true },
                { label: '吊孔', name: 'LiftingHole', width: 100, hidden: true },
                { label: 'CNC', name: 'CNC', width: 100, hidden: true },
                { label: '退火后研磨', name: 'YM', width: 100, hidden: true },
                { label: '锯切', name: 'JQ', width: 100, hidden: true },

                { label: '计价余量(厚)', name: 'AddThick', width: 50, hidden: true },
                { label: '计价余量(宽)', name: 'AddWeigh', width: 50, hidden: true },
                { label: '计价余量(长)', name: 'AddLength', width: 50, hidden: true },

                { label: '毛重', name: 'Weight', width: 50 },
                { label: '净重', name: 'TheoryWeight', width: 50 },
                { label: '重量2', name: 'WorkWeight', width: 50, hidden: true },
                { label: '材料单价', name: 'MaterialPrice', width: 50 },
                { label: '材料金额', name: 'MaterialAmount', width: 50 },
                { label: '加工单价', name: 'SmallCost', width: 50 },
                { label: '加工金额', name: 'SmallAmount', width: 50 },
                { label: '小件单价', name: 'WorkPrice', width: 50 },
                { label: '小件金额', name: 'WorkAmount', width: 50 },
                { label: '切角单价', name: 'DDCostPer', width: 50, hidden: true },
                { label: '切角金额', name: 'DDCost', width: 50 },

                { label: '加工费折扣率', name: 'WorkLess', width: 50, hidden: true },
                { label: '热处理工艺', name: 'Technology', width: 50, hidden: true },
                { label: '热处理单价', name: 'HeatPrice', width: 50 },
                { label: '热处理', name: 'HeatAmount', width: 50 },
                { label: '锯切几刀', name: 'JKCostQty', width: 50, hidden: true },
                { label: '锯切单价/件', name: 'JKCostPer', width: 50 },
                { label: '锯切金额', name: 'JKCost', width: 50 },
                { label: '面积', name: 'MianCostArea', width: 50 },
                { label: '面积单价', name: 'MianCostPer', width: 50 },
                { label: '面积金额', name: 'MianCost', width: 50 },
                { label: '边长', name: 'BianCostLong', width: 50 },
                { label: '边单价', name: 'BianCostPer', width: 50},
                { label: '边金额', name: 'BianCost', width: 50 },

                { label: '总销售金额', name: 'SalesAmount', width: 60 },
                { label: '成本', name: 'CostAmount', width: 60, hidden: true },
                { label: '品牌', name: 'Brand', width: 80, hidden: true },
                { label: '配件号', name: 'ProjectCode', width: 80 },
                { label: '边钉编码', name: 'DingCode', width: 80 },
                { label: '模号', name: "CustomerProduct", width: 80 },
                {
                    label: '开料说明', name: 'RemarkKL', width: 100,
                    formatter: function (cellvalue, options, rowObject) {
                        if (!!cellvalue) {
                            return cellvalue.replace(/,/g, "，");;

                        }
                        return "";
                    }
                },
                {
                    label: '加工备注', name: 'Remark', width: 100,
                    formatter: function (cellvalue, options, rowObject) {
                        if (!!cellvalue) {
                            return cellvalue.replace(/,/g, "，");;

                        }
                        return "";
                    }
                },
                { label: '送货说明', name: 'ShipDescription', width: 100 },

                { label: '钢材状态', name: 'SteelState', width: 50, hidden: true },
                { label: '模号', name: 'DieCode', width: 80, hidden: true },
                {
                    label: '特殊工艺', name: '特殊工艺', width: 80, hidden: true,
                    formatter: function (cellvalue, options, rowObject) {
                        var str = "";
                        if (rowObject.IsChamfer) {
