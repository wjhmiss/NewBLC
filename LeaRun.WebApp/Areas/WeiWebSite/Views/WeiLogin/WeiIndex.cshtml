@{
    ViewBag.Title = "首页";
    Layout = "~/Views/Shared/_LayoutMobile.cshtml";
}
<link rel="stylesheet" type="text/css" href="~/Content/Scripts/Mobile/templates/mobile/css/idangerous.swiper.css" />
    <script type="text/javascript" charset="utf-8" src="~/Content/Scripts/Mobile/templates/mobile/js/idangerous.swiper-2.1.min.js"></script>
<script>
        //初始化
    $(function () {
        var mySwiper = new Swiper('.swiper-container', {
            calculateHeight: true,
            resizeReInit: true,
            pagination: ".pagination",
            autoplay: 5000,
            paginationClickable: true
        });
        $("#main_footer a.home").addClass("pressed");
    })
</script>

