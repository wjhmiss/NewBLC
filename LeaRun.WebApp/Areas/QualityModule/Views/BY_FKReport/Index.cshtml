@{
    ViewBag.Title = "BY_FKReport";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}

<link href="~/Content/Scripts/uploadify/uploadify.css" rel="stylesheet" />
<script src="~/Content/Scripts/uploadify/native-uploadify.js?ver=@DateTime.Now.Ticks"></script>



<link href="~/Content/Scripts/imgGreate/00540/kao/css/index.css" rel="stylesheet" />
<script src="~/Content/Scripts/imgGreate/00540/kao/js/ToolTip.js"></script>


<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    //加载表格
    function GetGrid() {
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/QualityModule/BY_FKReport/GridPageJson")",
            datatype: "json",
            height: $(window).height() - 149,
            autowidth: true,
            colModel: [
                {
                    label: '测试时间', name: 'CreateDate', index: 'CreateDate', width: 80, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd');
                    }
                },
                { label: 'FKReportId', name: 'FKReportId', index: 'FKReportId', width: 0, align: 'left', sortable: true, hidden: true },
                { label: '产地', name: 'PlaceOrigin', index: 'PlaceOrigin', width: 0, align: 'left', sortable: true },
                { label: '钢种', name: 'SteelDescription', index: 'SteelDescription', width: 80, align: 'left', sortable: true },
                { label: '炉号', name: 'StoveCode', index: 'StoveCode', width: 80, align: 'left', sortable: true },
                { label: '报告结果', name: 'Remark', index: 'Remark', width: 80, align: 'left', sortable: true },
                { label: '测试人', name: 'CreateUserName', index: 'CreateUserName', width: 80, align: 'left', sortable: true },
                   {
                       label: '图示', name: 'imgshow', index: 'imgshow',
                       formatter: function (cellvalue, options, rowObject) {
                           if (!!rowObject.FKReportId) {
                               var nums = Math.random();
                               return "<div  ><img style='width:30px;' src='../../Resource/Document/BY_FKReport/" + rowObject.FKReportId + ".jpg?" + nums + "'  onMouseOver='toolTip(\"<img style=width:600px src=../../Resource/Document/BY_FKReport/" + rowObject.FKReportId + ".jpg?" + nums + ">\")' onMouseOut='toolTip()' /></div> ";
                           }
                           return "";
                       }
                   },
                        {
                            label: '操作', name: 'asdf', index: 'asdf',
                            formatter: function (cellvalue, options, rowObject) {
                                if (!!rowObject.FKReportId) {
                                    return '<div><input id="' + options.rowId + 'uploadify" name="uploadify" type="file" /></div>';
                                }
                                return "";
                            }
                        },
            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'CreateDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            gridview: true,
            gridComplete: function () {
                var data = $("#gridTable").jqGrid("getRowData");
                for (var i = 0; i < data.length; i++) {
                    var item = i + 1;
                    uploadify(item, data[i].FKReportId);
                }
            },
            ondblClickRow: function (rowid, iRow, iCol, e) {
                btn_edit();
            }
        });
    }

    function uploadify(id, FKReportId) {
        // $("#" + id + "uploadify").uploadify('destroy');
        try {
            if ($("#" + id + "uploadify").length > 0) { //注意jquery下检查一个元素是否存在必须使用 .length >0 来判断
                $("#" + id + "uploadify").uploadify('destroy');
            }
            $("#" + id + "uploadify").uploadify({
                uploader: '/Utility/Upload?saveDocument=BY_FKReport&filenameid=' + FKReportId,
                swf: '/Content/Scripts/uploadify/uploadify.swf',
                buttonText: "上传文件",
                height: 24,
                width: 70,
                onFallback: function () {
                    alert("您未安装FLASH控件，无法上传！请安装FLASH控件后再试。");
                },
                onUploadSuccess: function (file, data, response) {
                    //var DataJson = JSON.parse(data);
                    windowload();
                    //window.location.reload();
                }
            });
        } catch (e) {
        }
    }
    function DeleteFile(id) {
        var $Id = $("#" + id);
        var path = $Id.attr('path');
        AjaxJson("/Utility/DeleteFile", { Path: path }, function (Data) {
            $Id.parent().remove();
        });
    }

    function btn_edit() {
        var KeyValue = GetJqGridRowValue("#gridTable", "FKReportId");
        if (IsChecked(KeyValue)) {
            var url = "/QualityModule/BY_FKReport/Form?KeyValue=" + KeyValue;
            openDialog(url, "form", "超声波探伤编辑", 1000, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });

        }
    }

    //新增
    function btn_add() {
        var url = "/QualityModule/BY_FKReport/Form";
        openDialog(url, "form1", "超声波探伤新增", 1000, 500, function (iframe) {
            top.frames[iframe].AcceptClick();
        });
    }


    //删除
    function btn_delete() {
        var KeyValue = GetJqGridRowValue("#gridTable", "FKReportId");
        if (IsDelData(KeyValue)) {
            delConfig('/QualityModule/BY_FKReport/Delete?KeyValue=' + KeyValue);
        }
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入

    }

    function btn_Print() {
        var KeyValue = GetJqGridRowValue("#gridTable", "FKReportId");
        if (IsChecked(KeyValue)) {
            PrintDialog("/QualityModule/BY_FKReport/Print?KeyValue=" + KeyValue, "PrintPage12", "超声波检测打印", 850, 600, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    function btn_Search() {
        var Parameter = [{
            paramName: "PlaceOrigin",
            paramValue: escape($("#PlaceOrigin").val()),
            Operation: "Like",
            Logic: "AND",
        },
        {
            paramName: "CustomerName",
            paramValue: escape($("#CustomerName").val()),
            Operation: "Like",
            Logic: "AND",
        },
        {
            paramName: "SteelDescription",
            paramValue: escape($("#SteelDescription").val()),
            Operation: "Like",
            Logic: "AND",
        }, {
            paramName: "StoveCode",
            paramValue: escape($("#StoveCode").val()),
            Operation: "Like",
            Logic: "AND",
        }, {
            paramName: "Qty",
            paramValue: $("#Qty").val(),
            Operation: "Like",
            Logic: "AND",
        }, {
            paramName: "CustomerProduct",
            paramValue: escape($("#CustomerProduct").val()),
            Operation: "Like",
            Logic: "AND",
        }, ]

        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/QualityModule/BY_FKReport/GridPageJson")?ParameterJson=" + JSON.stringify(Parameter), page: 1 }).trigger('reloadGrid');
    }
</script>
<!--工具栏-->
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>产地：</th>
            <td>
                <input id="PlaceOrigin" type="text" class="txt" style="width: 100px" />
            </td>
            
             <th>钢种：</th>
            <td>
                <input id="SteelDescription" type="text" class="txt" style="width: 100px" />
            </td>
             <th>炉号：</th>
            <td>
                <input id="Size" type="text" class="txt" style="width: 100px" />
            </td>
             <th>数量：</th>
            <td>
                <input id="Qty" type="text" class="txt" style="width: 100px" />
            </td>
            
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
