        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;" id="QueryParameter">
        <tr>
            <th>关键字：</th>
            <td>
                <input id="keywords" type="text" class="txt" style="width: 100px" />
            </td>
            <th>员工姓名：</th>
            <td>
                <input id="WorkerName" type="text" class="txt" style="width: 100px" />
            </td>
            <th>物品类型：</th>
            <td>
                <input id="MaterielType" type="text" class="txt" style="width: 100px" />
            </td>
            <th >申报部门：</th>
            <td >
                <select id="DepartmentName" class="select" style="width: 100px" >
                    <option value="">全部</option>
                                        
                </select>
            </td>
            <th>创建日期 从：</th>
            <td>
                <input id="CreateDate_StartTime" type="text" value="@DNS.Utilities.DateTimeHelper.FirstDayOfMonth()"  class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd'})" style="width: 100px" />
                <input id="CreateDate_EndTime" type="text" class="txt Wdate" value="@DNS.Utilities.DateTimeHelper.LastDayOfMonth()"  onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd'})" style="width: 100px" />
            </td>

             <td >
                    <span class="item" style="cursor: pointer;">
                        <input type="checkbox" class="checkbox" name="checkbox" id="Status" />
                        <label for="Status">未审核</label>
                    </span>
                  <span class="item" style="cursor: pointer;">
                        <input type="checkbox" class="checkbox" name="checkbox" id="Status1"  />
                        <label for="Status1">已审核</label>
                    </span>
                </td>
             <td>
                 <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
                 <input id="btnSeafrch" type="button" class="btnSearch" value="价 格" onclick="WrithPrice()" />
                 <input id="btn_export" type="button" class="btnSearch" value="导 出" onclick="btn_Export()" />
                 <input id="btn_export" type="button" class="btnSearch" value="A5打印" onclick="btn_printall2()" />

             </td>
        </tr>
    </table>
</div>
