        //var IsInvoice = GetJqGridRowValue("#gridTable", "IsInvoice");
        //if (IsInvoice == "是") {
        //    alertDialog("当前报价单已开票", 0);
        //    return false;
        //}
        //var KeyValue = GetJqGridRowValue("#gridTable", "CheckCompanyId");
        //if (IsChecked(KeyValue)) {
        //    confirmDialog("提示", "确定要审核通过？", function (r) {
        //        if (r) {
        //            Loading(true, "正在提交数据...");
        //            window.setTimeout(function () {
        //                AjaxJson("/CheckSheetModule/BY_CheckCompany/Audit?KeyValue=" + KeyValue, "", function (data) {
        //                    tipDialog(data.Message, 3, data.Code);
        //                    windowload();
        //                });
        //            }, 200);
        //        }
        //    });
        //}
        var selr = jQuery('#gridTable').jqGrid('getGridParam', 'selarrrow');
        var s1 = "";
        if (selr.length) {
            for (var i = 0; i < selr.length; i++) {
                var myrow = jQuery('#gridTable').jqGrid('getRowData', selr[i]);
                s1 = s1 + myrow.CheckCompanyId + ",";
            }
            s1 = s1.trim(',');
            confirmDialog("提示", "确定要审核？", function (r) {
                if (r) {
                    Loading(true, "正在提交数据...");
                    window.setTimeout(function () {
                        AjaxJson("/CheckSheetModule/BY_CheckCompany/Audit?KeyValue=" + s1, "", function (data) {
                            tipDialog(data.Message, 3, data.Code);
                            windowload();
                        });
                    }, 200);
                }
            });
        }
    }
