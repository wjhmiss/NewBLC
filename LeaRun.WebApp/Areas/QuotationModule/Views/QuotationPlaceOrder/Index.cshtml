@{
    ViewBag.Title = "报价单确认";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    //查询
    function btn_Search() {
        var Parameter = [{
            paramName: "QuotationCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "AND"
        }, {
            paramName: "SureUserId",
            paramValue: "is",
            Operation: "NotNull",
            Logic: "AND"
        }, {
            paramName: "PlaceOrderUserId",
            paramValue: "is",
            Operation: "Null",
            Logic: "AND"
        },
        {
            paramName: "DeleteMark",
            paramValue: 0,
            Operation: "Equal",
            Logic: "AND"
        }]
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/QuotationModule/QuotationAudit/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)), page: 1 }).trigger('reloadGrid');
    }
    //加载表格
    function GetGrid() {
        var SelectRowIndx = 1;
        var Parameter = [{
            paramName: "SureUserId",
            paramValue: "is",
            Operation: "NotNull",
            Logic: "AND"
        }, {
            paramName: "PlaceOrderUserId",
            paramValue: "is",
            Operation: "Null"
        }]
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/QuotationModule/QuotationAudit/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)),
            datatype: "json",
            height: $(window).height() - 149,
            autowidth: true,
            colModel: [
                    { label: '报价单ID', name: 'QuotationId', hidden: true },
                    { label: 'Qty', name: 'Qty', hidden: true },
                    { label: '编号', name: 'MnemonicCode', index: 'MnemonicCode', width: 120, align: 'left', sortable: true },
                    { label: '报价单号', name: 'QuotationCode', index: 'QuotationCode', width: 120, align: 'left', sortable: true },
                    {
                        label: '入单日期', name: 'CreateDate', index: 'CreateDate', width: 100, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    {
                        label: '单据状态', name: 'BillStatus', index: 'BillStatus', width: 70, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (rowObject.PauseUserId) {
                                return "已暂挂";
                            } else {
                                return cellvalue;
                            }
                        }
                    },
                    { label: '客户编号', name: 'CustomerCode', index: 'CustomerCode', width: 80, align: 'left', sortable: true },
                    { label: '客户名称', name: 'CustomerName', index: 'CustomerName', width: 150, align: 'left', sortable: true },
                    { label: '客户简称', name: 'ShortName', index: 'ShortName', width: 80, align: 'left', sortable: true },
                    {
                        label: '审核日期', name: 'CheckDate', index: 'CheckDate', width: 100, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    {
                        label: '回传日期', name: 'SureDate', index: 'SureDate', width: 100, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    { label: '员工姓名', name: 'CreateUserName', index: 'CreateUserName', width: 80, align: 'left', sortable: true },
                    { label: '营业员', name: 'SalesMan', index: 'SalesMan', width: 80, align: 'left', sortable: true }
            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'SureDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            onSelectRow: function () {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
            },
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
            },
            ondblClickRow: function (rowid, iRow, iCol, e) {
                btn_AutoPlaceOrder();
            }
        });
    }
    //自动落单
    function btn_AutoPlaceOrder() {
        var BillStatus = GetJqGridRowValue("#gridTable", "BillStatus");
        if (BillStatus == "已暂挂" || BillStatus == "合同取消") {
            tipDialog("此报价单状态" + BillStatus+"，不能落单！", 3, -1);
            return false;
        }

        var KeyValue = GetJqGridRowValue("#gridTable", "QuotationId");
        if (IsChecked(KeyValue)) {
            confirmDialog("提示", "选中报价单确定要落单吗？", function (r) {
                if (r) {
                    Loading(true, "正在提交数据...");
                    window.setTimeout(function () {
                        AjaxJson("/QuotationModule/QuotationPlaceOrder/AutoPlaceOrder", { KeyValue: KeyValue }, function (data) {
                            tipDialog(data.Message, 3, data.Code);
                            windowload();
                        });
                    }, 200);
                }
            });
        }
    }
    //手动落单
    function btn_nonautomatic() {
        var BillStatus = GetJqGridRowValue("#gridTable", "BillStatus");
        if (BillStatus == "已暂挂" || BillStatus == "合同取消") {
            tipDialog("此报价单状态" + BillStatus + "，不能落单！", 3, -1);
            return false;
        }
        var KeyValue = GetJqGridRowValue("#gridTable", "QuotationId");
        var Qty = GetJqGridRowValue("#gridTable", "Qty");
        if (IsChecked(KeyValue)) {
            var url = "/QuotationModule/QuotationPlaceOrder/NonauTomatic?KeyValue=" + KeyValue + "&Qty=" + Qty;
            openDialog(url, "Form", "手动落单", 350, 140, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入
    }
</script>
<!--工具栏-->
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>报价单号：</th>
            <td>
                <input id="keywords" type="text" class="txt" style="width: 200px" />
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
