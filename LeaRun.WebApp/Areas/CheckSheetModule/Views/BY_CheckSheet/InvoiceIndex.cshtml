    function btn_Export() {
        SetDeriveExcel("#gridTable", "发票记录");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }

    function ReturnComfirm() {
        var status = GetJqGridRowValue("#gridTable", "status");
        if (status == "1") {
            alert("已审核，请先对账确认！");
            return;
        }
        var KeyValue = GetJqGridRowValue("#gridTable", "checksheetid");
        if (IsChecked(KeyValue)) {
            confirmDialog("提示", "确定要回退？", function (r) {
                if (r) {
                    Loading(true, "正在提交数据...");
                    window.setTimeout(function () {

                        AjaxJson("/CheckSheetModule/BY_CheckSheet/SubmitForm?KeyValue=" + KeyValue + "&IsComfirm=-1", "", function (data) {
                            tipDialog(data.Message, 3, data.Code);
                            windowload();
                        });
                    }, 200);
                }
            });
        }
    }

    function btn_Invoice() {
        var checksheetid = GetJqGridRowValue("#gridTable", "checksheetid");
        var customername = GetJqGridRowValue("#gridTable", "customername");
        var caninvoicemoney = GetJqGridRowValue("#gridTable", "caninvoicemoney");
        if (IsChecked(checksheetid)) {
            var url = "/CheckSheetModule/By_InvoiceForDetail/Form?checksheetid=" + checksheetid + "&customername=" + escape(customername) + "&caninvoicemoney=" + caninvoicemoney;
            openDialog(url, "Form", "发票", 870, 470, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }


    function btn_print(KeyValue, checksheetid) {
    if (IsChecked(KeyValue)) {
        PrintDialog("/CheckSheetModule/By_InvoiceForDetail/BJPrintPreview?KeyValue=" + KeyValue + "&checksheetid=" + checksheetid, "PrintPage12", "打印", 850, 500, function (iframe) {
            top.frames[iframe].AcceptClick();
        });
    }
    }


</script>
<!--工具栏-->
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>发票日期从：</th>
            <td>
                <input id="CreateDate_StartTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd'})" style="width: 100px" />
                <input id="CreateDate_EndTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd'})" style="width: 100px" />
            </td>
            <th>公司：</th>
            <td>
                <select id="CompanyName" class="select"></select>
            </td>
            <th>客户名称/编号：</th>
            <td>
                <input id="CustomerName" type="text" class="txt" style="width: 80px" />
            </td>
            <th style="width:60px;">对账单号：</th>
            <td>
                <input id="CheckCode" type="text" class="txt" style="width: 80px" />
            </td>
            <td>
                <select id="LType" type="text" class="select" onchange="btn_Search();">
                    <option value="">全部</option>
                    <option value="GC">钢材</option>
                    <option value="LJ">配件</option>
                    <option value="RCL">热处理</option>
                </select>
            </td>
            <td>
                <span class="item" style="cursor: pointer;">
                    <input type="checkbox" class="checkbox" name="checkbox" id="IsCompele" onchange="btn_Search();" />
                    <label for="IsCompele">未开</label>
                </span>
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜索" onclick="btn_Search()" />
                <input id="btnExport" type="button" class="btnSearch" value="导出" onclick="btn_Export()" />

            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
