                            Orderhtml += OrderEntiy.LJPlan;
                            Orderhtml += '        </td>';
                            Orderhtml += '    </tr>';
                        }
                        
                        Orderhtml += '    <tr>';
                        Orderhtml += '        <td colspan="6"  style="vertical-align:top;font-size: 10pt;">';
                        Orderhtml += '        下单：' + formatDate(OrderEntiy.CreateDate, 'yyyy-MM-dd');
                        Orderhtml += '        &nbsp;&nbsp;总重量：' + data.WeightTotal.toFixed(2) + "kg";
                        Orderhtml += '        &nbsp;&nbsp;总件数：' + data.OrderDetailTotal.toFixed(0);
                        Orderhtml += '        &nbsp;&nbsp;交期：' + Delivery;
                        Orderhtml += '        </td>';
