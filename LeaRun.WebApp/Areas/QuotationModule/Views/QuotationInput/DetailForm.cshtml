    //保存事件
    function AcceptClick() {

        if (!CheckDataValid('#form1')) {
            return false;
        }
        var postData = GetWebControls("#form1");
        if (postData.Qty <= 0) {
            tipCss("#Qty", "数量必须大于0");
            return false;
        }
        if (postData.Thick <= 0 && $("#SteelCode").val() != "FY" && CustMaterial != "1") {
            tipCss("#Thick", "厚度必须大于0");
            return false;
        }
        //if (postData.Weigh <= 0) {
        //    tipCss("#Weigh", "宽度必须大于0");
        //    return false;
        //}
        if (postData.Length <= 0 && $("#SteelCode").val() != "FY" && CustMaterial != "1") {
            tipCss("#Length", "长度必须大于0");
            return false;
        }

        AjaxJsonNoMassge("/QuotationModule/QuotationInput/SubmitDetailForm?KeyValue=" + KeyValue + "&Insert=" + Insert, postData, function (data) {
            if (data.Code < 0) {
                //tipDialog(data.Message, 2, data.Code);
                tipCss("#Remark", data.Message);
                return false;

            }
            top.frames[tabiframeId()].windowload();
            window.setTimeout(function () {closeDialog();}, 500);
        });
    }

