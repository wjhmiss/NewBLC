@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>欢迎使用</title>
    <!--框架必需start-->
    @* <link href="~/Content/Styles/learunui-framework.css" rel="stylesheet" />
        <link href="~/Content/Styles/learunui-accordion.css" rel="stylesheet" />*@
    <script src="~/Content/Scripts/jquery/jquery-1.8.2.min.js"></script>
    <script src="~/Content/Scripts/learunui-framework.js?n=123"></script>
    @*@Scripts.Render("~/Content/Scripts/frameworkjquery")*@
    @Styles.Render("~/Content/Styles/frameworkcss")
    @Styles.Render("~/Content/Styles/accordioncss")
    <!--框架必需end-->
    <!--第三方统计图start-->
    @*<script src="~/Content/Scripts/highcharts/highcharts.js"></script>
        <script src="~/Content/Scripts/highcharts/highcharts-more.js"></script>
        <script src="~/Content/Scripts/highcharts/modules/exporting.js"></script>*@
    @Scripts.Render("~/Content/Scripts/highcharts/highchartsjquery")
    <!--第三方统计图end-->
    <script>
        var listA = [];
        var listB = [];
        var listC = [];
        $(function () {
            AjaxJson("/Home/TaskMessageChart", {}, function (DataJson) {
                $("#Number_A").html(DataJson.A);
                $("#Number_B").html(DataJson.B);
                $("#Number_C").html(DataJson.C);
                $("#Number_D").html(DataJson.D);
                $("#Number_E").html(DataJson.E);
                listA.push(DataJson.ROWA[0].cnt1);
                listA.push(DataJson.ROWA[0].cnt2);
                listA.push(DataJson.ROWA[0].cnt3);
                listA.push(DataJson.ROWA[0].cnt4);
                listA.push(DataJson.ROWA[0].cnt5);
                listB.push(DataJson.ROWB[0].cnt1);
                listB.push(DataJson.ROWB[0].cnt2);
                listB.push(DataJson.ROWB[0].cnt3);
                listB.push(DataJson.ROWB[0].cnt4);
                listB.push(DataJson.ROWB[0].cnt5);
                listC.push(DataJson.ROWC[0].cnt1);
                listC.push(DataJson.ROWC[0].cnt2);
                listC.push(DataJson.ROWC[0].cnt3);
                listC.push(DataJson.ROWC[0].cnt4);
                listC.push(DataJson.ROWC[0].cnt5);
            })
            LodaChartData();
        })
        function LodaChartData() {
            $('#container').highcharts({
                chart: {
                    type: 'spline'
                },
                title: {
                    text: '销售产品统计表'
                },
                xAxis: {
                    categories: ['一周', '二周', '三周', '四周', '五周']
                },
                yAxis: {
                    title: {
                        text: '销售产品'
                    },
                    labels: {
                        formatter: function () {
                            return this.value + ''
                        }
                    }
                },
                tooltip: {
                    crosshairs: true,
                    shared: true
                },
                plotOptions: {
                    spline: {
                        marker: {
                            radius: 4,
                            lineColor: '#666666',
                            lineWidth: 1
                        }
                    }
                },
                series: [{
                    name: '工单统计',
                    data: listA
                }, {
                    name: '报价单统计',
                    data: listB

                }, {
                    name: '发运单统计',
                    data: listC

                }]
            });
        };
    </script>
</head>
<body>
    <div style="margin: 10px;">
        <table style="width: 100%">
            <tr>
                <td>
                    <div class="Task" style="background-color: #E7191B">
                        <i></i>
                        <div class="centre">
                            <div class="icon">
                                <img src="~/Content/Images/task-1.png" />
                            </div>
                            <div id="Number_A" class="Number">10</div>
                        </div>
                        <div class="text">
                            进行中的报价单
                        </div>
                    </div>
                </td>
                <td>
                    <div class="Task" style="background-color: #EEAE44">
                        <i></i>
                        <div class="centre">
                            <div class="icon">
                                <img src="~/Content/Images/task-2.png" />
                            </div>
                            <div id="Number_B" class="Number">11</div>
                        </div>
                        <div class="text">
                            进行中的工单
                        </div>
                    </div>
                </td>
                <td>
                    <div class="Task" style="background-color: #28B779">
                        <i></i>
                        <div class="centre">
                            <div class="icon">
                                <img src="~/Content/Images/task-3.png" />
                            </div>
                            <div id="Number_C" class="Number">20</div>
                        </div>
                        <div class="text">
                            完工未发运
                        </div>
                    </div>
                </td>
                <td>
                    <div class="Task" style="background-color: #2BA9E3">
                        <i></i>
                        <div class="centre">
                            <div class="icon">
                                <img src="~/Content/Images/task-4.png" />
                            </div>
                            <div id="Number_D" class="Number">78</div>
                        </div>
                        <div class="text">
                            报价单累计
                        </div>
                    </div>
                </td>
                <td>
                    <div class="Task" style="background-color: #C07FE7">
                        <div class="centre">
                            <div class="icon">
                                <img src="~/Content/Images/task-5.png" />
                            </div>
                            <div id="Number_E" class="Number">18</div>
                        </div>
                        <div class="text">
                            发运单累计
                        </div>
                    </div>
                </td>
            </tr>
        </table>
        <div style="margin-left: 20px; margin-right: 30px;">
            <div id="container"></div>
        </div>
    </div>
</body>
</html>
