                <label id="ScaleUser" />
            </td>
            <th class='formTitle'>磅重时间：</th>
            <td class='formValue'>
                <label id="ScaleDate" />
            </td>
            <th class='formTitle'>工序流程：</th>
            <td class='formValue'>
                <label id="ScaleProcess" />
            </td>
        </tr>
        <tr>
        </tr>
    </table>
</form>
