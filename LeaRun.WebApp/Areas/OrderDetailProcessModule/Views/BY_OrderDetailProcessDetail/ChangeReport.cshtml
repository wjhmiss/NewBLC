@{
    ViewBag.Title = "工单工序详情表";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    //加载表格
    var lastsel3;
    function GetGrid() {
        var Parameter = [{
            paramName: "OrderCode",
            paramValue: $.trim($("#keywords").val()),
            Operation: "Like",
            Logic: "AND"
        }, {
            paramName: "OperatorDate",
            paramValue: $.trim($("#CreateDate_EndTime").val()),
            Operation: "AfterDay",
            Logic: "AND"
        }, {
            paramName: "OperatorDate",
            paramValue: $.trim($("#CreateDate_StartTime").val()),
            Operation: "BeforeDay"
            , Logic: "AND"
        }
        , {
            paramName: "TechnologyId",
            paramValue: "K001",
            Operation: "Equal",
            Logic: "AND"
        }, {
            paramName: "OrderType",
            paramValue: "毛料生产",
            Operation: "NotEqual",
            Logic: "AND"
        }
        ]
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/OrderDetailProcessModule/BY_OrderDetailProcessDetail/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)),
            datatype: "json",
            height: $(window).height() - 149,
            autowidth: true,
            colModel: [
                    { label: 'ID', name: 'OrderDetailProcessDetailId', index: 'OrderDetailProcessDetailId', hidden: true },
                    { label: '工单号', name: 'OrderCode', index: 'OrderCode', width: 120, align: 'left', sortable: true },
                    { label: '行号', name: 'LineCode', index: 'LineCode', width: 40, align: 'left', sortable: true },
                    { label: '钢种编号', name: 'SteelCode', index: 'SteelCode', width: 60, align: 'left', sortable: true },
                    { label: '钢种名称', name: 'SteelDescription', index: 'SteelDescription', width: 60, align: 'left', sortable: true },
                    { label: '厚/直径', name: 'Thick', index: 'Thick', width: 40, align: 'left', sortable: true },
                    { label: '宽度', name: 'Weigh', index: 'Weigh', width: 40, align: 'left', sortable: true },
                    { label: '长度', name: 'Length', index: 'Length', width: 40, align: 'left', sortable: true },


                    { label: '工序编号', name: 'TechnologyId', index: 'TechnologyId', width: 80, align: 'left', sortable: true },
                    { label: '工序名称', name: 'TechnologyName', index: 'TechnologyName', width: 80, align: 'left', sortable: true },
                    { label: '数量', name: 'Qty', index: 'Qty', width: 40, align: 'left', sortable: true },
                    { label: '重量(公斤)', name: 'Weight', index: 'Weight', width: 60, align: 'left', sortable: true },
                    { label: '面积(平方米)', name: 'Area', index: 'Area', width: 60, align: 'left', sortable: true },
                    { label: '长度(米)', name: 'CalcLength', index: 'CalcLength', width: 60, align: 'left', sortable: true },
                    { label: '扫描人', name: 'OperatorName', index: 'OperatorName', width: 60, align: 'left', sortable: true },
                    {
                        label: '扫描时间', name: 'OperatorDate', index: 'OperatorDate', width: 100, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },


            ],
            //ondblClickRow: function (id) {
            //    if (id && id !== lastsel3) {
            //        var KeyValue = GetJqGridRowValue("#gridTable", "OrderDetailProcessDetailId");
            //        if (IsChecked(KeyValue)) {
            //            var url = "/OrderDetailProcessModule/BY_OrderDetailProcessDetail/Detail?KeyValue=" + KeyValue;
            //            Dialog(url, "Detail", "工单工序详情表明细", 820, 500, function (iframe) {
            //                top.frames[iframe].AcceptClick();
            //            });
            //        }
            //        lastsel3 = id;
            //    }
            //},
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'OperatorDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
        });
    }


    //搜索
    function btn_Search() {
        var Parameter = [{
            paramName: "OrderCode",
            paramValue: $.trim($("#keywords").val()),
            Operation: "Like",
            Logic: "AND"
        }, {
            paramName: "OperatorDate",
            paramValue: $.trim($("#CreateDate_EndTime").val()),
            Operation: "AfterDay",
            Logic: "AND"
        }, {
            paramName: "OperatorDate",
            paramValue: $.trim($("#CreateDate_StartTime").val()),
            Operation: "BeforeDay"
            ,Logic: "AND"
        }
        , {
            paramName: "TechnologyId",
            paramValue: "K001",
            Operation: "Equal",
            Logic: "AND"
        }, {
            paramName: "OrderType",
            paramValue: "毛料生产",
            Operation: "NotEqual",
            Logic: "AND"
        }
        ]
        $("#gridTable").jqGrid('setGridParam', {
            url: "@Url.Content("~/OrderDetailProcessModule/BY_OrderDetailProcessDetail/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)), page: 1
        }).trigger('reloadGrid');
        }

        //刷新
        function windowload() {
            $("#gridTable").trigger("reloadGrid"); //重新载入
        }


</script>
<div id="layout2" class="layout2">

    <!--中间-->
    <div class="layoutPanel layout-center" id="rightPane">
        <div class="btnbartitle">
            <div>
                订单转序查询 <span id="CenterTitle"></span>
            </div>
        </div>

        <!--列表-->
        <div id="grid_List">
            <div class="bottomline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
                <table border="0" class="form-find" style="height: 45px;">
                    <tr>
                        <th>扫描日期 从：</th>
                        <td>
                            <input id="CreateDate_StartTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 00:00'})" style="width: 120px" />
                        </td>
                        <th>至：</th>
                        <td>
                            <input id="CreateDate_EndTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 23:59'})" style="width: 120px" />
                        </td>
                        <th>扫描工序</th>
                        <td>
                            <input id="processtxt" type="text" class="txt" style="width: 120px" value="开料" disabled />
                        </td>
                        <th>工单号：
                        </th>
                        <td>
                            <input id="keywords" type="text" class="txt" style="width: 200px" />
                        </td>
                        <td>
                            <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
                        </td>
                    </tr>
                </table>
            </div>
            <table id="gridTable"></table>
            <div id="gridPager"></div>
        </div>
    </div>
</div>
