@{
    ViewBag.Title = "报价单审核";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    //查询
    function btn_Search() {
        var Parameter = [{
            paramName: "CheckStatus",
            paramValue: 0,
            Operation: "Equal",
            Logic: "AND"
        }, {
            paramName: "QuotationCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "AND"
        },
        {
            paramName: "DeleteMark",
            paramValue: 0,
            Operation: "Equal",
            Logic: "AND"
        }]
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/QuotationModule/QuotationAudit/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)), page: 1 }).trigger('reloadGrid');
    }
    //加载表格
    function GetGrid() {
        var SelectRowIndx = 1;
        var Parameter = [{
            paramName: "CheckStatus",
            paramValue: 0,
            Operation: "Equal",
            Logic: "AND"
        }, {
            paramName: "QuotationCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "AND"
        },
        {
            paramName: "DeleteMark",
            paramValue: 0,
            Operation: "Equal",
            Logic: "AND"
        }]
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/QuotationModule/QuotationAudit/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)),
            datatype: "json",
            height: $(window).height() - 149,
            autowidth: true,
            colModel: [
                    { label: '报价单ID', name: 'QuotationId', hidden: true },
                    { label: '编号', name: 'MnemonicCode', index: 'MnemonicCode', width: 120, align: 'left', sortable: true },
                    { label: '报价单号', name: 'QuotationCode', index: 'QuotationCode', width: 120, align: 'left', sortable: true },
                    {
                        label: '入单日期', name: 'CreateDate', index: 'CreateDate', width: 100, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    { label: '客户编号', name: 'CustomerCode', index: 'CustomerCode', width: 80, align: 'left', sortable: true },
                    { label: '客户名称', name: 'CustomerName', index: 'CustomerName', width: 150, align: 'left', sortable: true },
                    { label: '客户简称', name: 'ShortName', index: 'ShortName', width: 80, align: 'left', sortable: true },
                    { label: '联系人', name: 'ContactName', index: 'ContactName', width: 80, align: 'left', sortable: true },
                    { label: '联系电话', name: 'ContactTel', index: 'ContactTel', width: 60, align: 'left', sortable: true },
                    { label: '手机', name: 'MobileCode', index: 'MobileCode', width: 70, align: 'left', sortable: true },
                    { label: '客户地址', name: 'CustomerAddress', index: 'CustomerAddress', width: 200, align: 'left', sortable: true },
                    { label: '加工类型', name: 'OrderType', index: 'OrderType', hidden: true },
                    {
                        label: '审核标志', name: 'CheckStatus', index: 'CheckStatus', width: 50, align: 'center',
                        formatter: function (cellvalue, options, rowObject) {
                            if (cellvalue == '0') return "<span style='color:red'>待审核</span>";
                        }
                    },
            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'CreateDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            onSelectRow: function () {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
            },
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
            },
            ondblClickRow: function (rowid, iRow, iCol, e) {
                btn_audit();
            }
        });
    }
    //详细页面
    function btn_detail() {
        var KeyValue = GetJqGridRowValue("#gridTable", "QuotationId");
        if (IsChecked(KeyValue)) {
            AddTabMenu('3042eb10-9f95-4a60-ae33-b137599d7574', '@Url.Content("~/QuotationModule/QuotationAudit/Detail")?KeyValue=' + KeyValue, '报价单详细', "application_view_detail.png", true, true);
        }
    }
    //审核
    function btn_audit() {
        var KeyValue = GetJqGridRowValue("#gridTable", "QuotationId");
        if (IsChecked(KeyValue)) {
            confirmDialog("提示", "确定要审核此报价单吗？", function (r) {
                if (r) {
                    Loading(true, "正在提交数据...");
                    window.setTimeout(function () {
                        AjaxJson("/QuotationModule/QuotationAudit/SubmitAudit?KeyValue=" + KeyValue, { CheckStatus: 1 }, function (data) {
                            tipDialog(data.Message, 3, data.Code);
                            //confirmDialog("提示", "是否去落单？", function (r) {
                            //    if (r) {
                                    AjaxJson("/QuotationModule/QuotationSure/SureConfirm", { KeyValue: KeyValue }, function (data) {
                                        windowload();
                                        AddTabMenu("deae33ed-c0c1-4966-9bf7-405e66e6346b", "@Url.Content("~/QuotationModule/QuotationPlaceOrder/Index")", "报价落单确认", "document_check_compatibility.png", true);
                                    });
                            //    } else {
                            //        windowload();
                            //    }
                            //});
                        });
                    }, 200);
                }
            });
        }
    }
    //驳回
    function btn_turn() {
        var KeyValue = GetJqGridRowValue("#gridTable", "QuotationId");
        var QuotationCode = GetJqGridRowValue("#gridTable", "QuotationCode");
        if (IsChecked(KeyValue)) {
            var url = "/QuotationModule/QuotationAudit/Audit?KeyValue=" + KeyValue + "&BillCode=" + QuotationCode
            openDialog(url, "Form", "报价单驳回【" + QuotationCode + "】", 450, 150, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入
    }
</script>
<!--工具栏-->
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>报价单号：</th>
            <td>
                <input id="keywords" type="text" class="txt" style="width: 200px" />
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
