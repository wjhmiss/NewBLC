@{
    ViewBag.Title = "付款对账单》明细页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    $(function () {
        //供应商编码自动补全
        BindDropItem("#InvoiceWho", "公司", "==请选择==");
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/PaymentModule/BY_PayCheckSheel/SetForm", { KeyValue: GetQuery('KeyValue') }, function (data) {
                SetWebControls(data);
            });
        }
    }

    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        $(".ui_state_highlight").attr("disabled", true);
        Loading(true, "正在提交数据...");
        window.setTimeout(function () {
            var KeyValue = GetQuery('KeyValue');
            var postData = GetWebControls("#form1");
            AjaxJson("/PaymentModule/BY_PayCheckSheel/SubmitForm?KeyValue=" + KeyValue, postData, function (data) {
                tipDialog(data.Message, 3, data.Code);
                top.frames[tabiframeId()].windowload();
                window.setTimeout(function () {closeDialog();}, 500);
            });
        }, 200);
    }
</script>
<form id="form1" style="margin: 1px">
    <table class="form">
        <tr>
             <th class='formTitle'>对账单年月：</th>
            <td class='formValue'>
                <input id="YearMonth"   type="text" class="txt"  disabled  />
            </td>
            <th class='formTitle'>对账单单号：</th>
            <td class='formValue'>
                 <input id="PayCheckSheetId" type="hidden" />
                <input id="PayCheckSheetCode"   type="text" class="txt"  disabled  />

            </td>
            <th class='formTitle'>类型：</th>
            <td class='formValue'>
                <input id="PayType"   type="text" class="txt"  disabled  />

            </td>
           
        </tr>
         <tr>
            <th class='formTitle'>供应商名称：</th>
            <td class='formValue' >
                <input id="CustomerName"   type="text" class="txt"  disabled  />

            </td>
            <th class='formTitle'>供应商地址：</th>
            <td class='formValue' >
                <input id="CustomerAddress"   type="text" class="txt"  disabled  />

            </td>
            <th class='formTitle'>总金额：</th>
            <td class='formValue'>
                <input id="InvoiceMoney"   type="text" class="txt"  disabled  />

            </td>
        </tr>
   
       
        <tr>
            <th class='formTitle'>买方：</th>
            <td class='formValue' colspan="5" >
                
                <select id="InvoiceWho"  class="txtselect" datacol="yes" err="发票单位" checkexpession="NotNull">
                        </select>
            </td>
            
            
            
        </tr>

        <tr>
             <th class='formTitle'>发票单号：</th>
            <td class='formValue'>
                 <input id="InvoiceNum"  maxlength="50" type="text" class="txt"  />

            </td>
            <th class='formTitle'>发票金额：</th>
            <td class='formValue'>
                <input id="TotalAmount"  onfocus="IsMoney(this.id);" maxlength="50" type="text" class="txt"  />
            </td>
            <th class='formTitle'>发票日期：</th>
            <td class='formValue'>
                 <input id="InvoiceDate" type="text"  class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd HH:mm:ss'})"  />
            </td>
        </tr>

        <tr>
             <th class='formTitle'>备注：</th>
            <td class='formValue' colspan="5">
                    <input id="Remark" maxlength="50" type="text" class="txt" />
            </td>
        </tr>
      
    </table>
</form>
