                                BoreSize = "xφ" + QuotationDetail[i].BoreSize;
                            }
                            size = "Φ" + parseFloat(QuotationDetail[i].Thick) + BoreSize + ' x ' + parseFloat(QuotationDetail[i].Length);
                        }
