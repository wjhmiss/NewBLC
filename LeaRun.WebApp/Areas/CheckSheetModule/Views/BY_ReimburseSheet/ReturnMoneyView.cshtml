@{
    ViewBag.Title = "报价单审核";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script>
    var KeyValue = GetQuery('KeyValue');//主键
    $(function () {
        BindDropItem("#BankNum", "银行名称", "==请选择==");
    });

    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        Loading(true, "正在提交数据...");
        ffff();
        $(".ui_state_highlight").attr("disabled", true);
        window.setTimeout(function () {
            AjaxJson("/CheckSheetModule/BY_ReimburseSheet/ReturnMoney?KeyValue=" + KeyValue + "&Remark=" + escape($("#Remark").val()) + "&RequiredMoney=" + $("#RequiredMoney").val() + "&RequiredDate=" + escape($("#RequiredDate").val()) + "&GetType=" + escape($("#GetType").val()) + "&BankNum=" + escape($("#BankNum").val()), "", function (data) {
                    tipDialog(data.Message, 3, data.Code);
                    top.Form.btn_Search();
                    window.setTimeout(function () {closeDialog();}, 500);
                });
           
        }, 200);
    }
    function ffff() {
        if (Number($("#RequiredMoney").val()) < 0) {
            $("#RequiredMoney").val(-Number($("#RequiredMoney").val()))
        }
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class="formTitle">退款金额：
            </th>
            <td class="formValue">
                <input id="RequiredMoney" onfocus="IsMoney(this.id);" onkeyup="ffff();"  maxlength="18" type="text" class="txt required" datacol="yes" err="退款金额" checkexpession="NotNull" ></input>
            </td>
             <th class='formTitle'>退款日期：</th>
            <td class='formValue'>
                <input id="RequiredDate" type="text" class="txt Wdate" value="@DNS.Utilities.DateTimeHelper.GetTime()" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd HH:mm:ss'})" datacol="yes" err="收款日期" checkexpession="NotNull"/>
            </td>
        </tr>
        <tr>
            <th class='formTitle'>类型：</th>
            <td class='formValue'>
                <select id="GetType" class="txtselect">
                    <option value="现金">现金</option>
                    <option value="银行">银行</option>
                    <option value="承兑">承兑</option>
                </select>
            </td>
            <th class='formTitle'>银行账户：</th>
            <td class='formValue'>
                 <select id="BankNum"  class="txtselect" datacol="yes" err="银行账户" checkexpession="NotNull">
                 </select>
            </td>
        </tr>
        <tr>
            <th class="formTitle">退款备注：
            </th>
            <td class="formValue" colspan="3">
                <textarea id="Remark" maxlength="200" class="txtArea" rows="4" datacol="yes" err="备注" checkexpession="NotNull"  ></textarea>
            </td>
        </tr>
        
    </table>
</form>

