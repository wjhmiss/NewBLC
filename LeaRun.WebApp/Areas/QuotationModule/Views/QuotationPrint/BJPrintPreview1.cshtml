                            QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + Weigh + '</td>';
                            QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + Thick + '</td>';
                            QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].Qty + '</td>';
