@{
    ViewBag.Title = "库存表";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    var tempred = "";
    $(function () {
        //钢种下拉框
        //SteelAutocomplete();
        window.setTimeout(function () {
            GetGrid();
            jQuery("#gridTable").setGridParam().showCol("price").trigger("reloadGrid");
            jQuery("#gridTable").setGridParam().showCol("totalmoney").trigger("reloadGrid");
            $("#btn_showcusmerName").show();
            if ('@DNS.Utilities.ManageProvider.Provider.Current().ObjectId'.indexOf("9d04b362-c9fe-4c67-95a5-d24d6ad9177d") < 0 && '@DNS.Utilities.ManageProvider.Provider.Current().UserName' != "超级管理员") {
                jQuery("#gridTable").setGridParam().hideCol("price").trigger("reloadGrid");
                jQuery("#gridTable").setGridParam().hideCol("totalmoney").trigger("reloadGrid");
                $("#btn_showcusmerName").hide();
            }
            else {
                jQuery("#gridTable").setGridParam().showCol("price").trigger("reloadGrid");
                jQuery("#gridTable").setGridParam().showCol("totalmoney").trigger("reloadGrid");
                $("#btn_showcusmerName").show();
            }
            $("#btn_showcusmerName").toggle(
      function () {
          $("#btn_showcusmerName").val("隐藏价格");
          jQuery("#gridTable").setGridParam().showCol("price").trigger("reloadGrid");
          jQuery("#gridTable").setGridParam().showCol("totalmoney").trigger("reloadGrid");


      },
      function () {
          $("#btn_showcusmerName").val("显示价格");
          jQuery("#gridTable").setGridParam().hideCol("price").trigger("reloadGrid");
          jQuery("#gridTable").setGridParam().hideCol("totalmoney").trigger("reloadGrid");
      }
    );


        }, 200);
    })
    //加载表格
    function GetGrid() {
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/StorageModule/BY_Inventory/GridPageListJson")?MaterialType=" + $("input[name=MaterialType]:checked").val() + "&SteelCode=" + escape($.trim($("#SteelCode").val())) + "&BatchCode=" + escape($.trim($("#BatchCode").val())),
            datatype: "json",
            height: $(window).height() - 193,
            autowidth: true,
            colModel: [
                    { label: '库存ID', name: 'inventoryid', index: 'inventoryid', width: 0, align: 'left', sortable: true, hidden: true },
                    { label: '钢种编号', name: 'steelcode', index: 'steelcode', width: 80, align: 'left', sortable: true, hidden: true },
                    { label: '钢种名称', name: 'steeldescription', index: 'steeldescription', width: 100, align: 'left', sortable: true },
                    { label: '钢材编码', name: 'batchcode', index: 'batchcode', width: 120, align: 'left', sortable: true },
                    { label: '厚度(直径)', name: 'thick', index: 'thick', width: 60, align: 'left', sortable: true },
                    { label: '宽度', name: 'weigh', index: 'weigh', width: 60, align: 'left', sortable: true },
                { label: '长度', name: 'length', index: 'length', width: 60, align: 'left', sortable: true },


                    { label: '孔径', name: 'boresize', index: 'boresize', width: 60, align: 'left', sortable: true },
                    {
                        label: '重量', name: 'weight', index: 'weight', width: 80, align: 'left', sortable: true
                    },
                    {
                        label: '入库日期', name: 'instockdate', index: 'instockdate', width: 120, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd hh:mm');
                        }
                    },
                    { label: '采购单', name: 'remarksteelperchase', index: 'remarksteelperchase', width: 100, align: 'left', sortable: true },
                    { label: '供应商编码', name: 'customercode', index: 'customercode', hidden: true },
                    { label: '供应商名称', name: 'customername', index: 'customername', width: 100, sortable: true },
                    { label: '类型', name: 'typename', index: 'typename', width: 70, align: 'left', sortable: true },

                    { label: '单价', name: 'price', index: 'price', width: 70, align: 'left', sortable: true },
                    {
                        label: '剩余金额', name: 'totalmoney', index: 'totalmoney', width: 70, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.toFixed(2)
                            }
                            return 0;
                        }
                    },

                    { label: '原始尺寸', name: 'originalsize', index: 'originalsize', hidden: true },
                { label: '原始料号', name: 'stovecode', index: 'stovecode', width: 120, align: 'left', sortable: true },
                { label: '仓位', name: 'position', index: 'position', width: 120, align: 'left', sortable: true },
                { label: '备注', name: 'remark', index: 'remark', width: 120 },
                    { label: '创建人', name: 'createusername', index: 'createusername', hidden: true }, ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'instockdate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: false,
            altclass: 'altclass',
            gridview: true,
            footerrow: true,
            gridComplete: function () {
                //合计
                //var strred = tempred.trim(',').split(',');
                //for (i = 0; i < strred.length; i++) {
                //    $("#" + strred[i]).find('td').css("background-color", "red");
                //}
                //tempred = "";
                if ($("#alarmck").prop("checked")) {
                    $("#gridTable").find('td').css("background-color", "red");
                }

                $(this).footerData("set", {
                    "steelcode": "合计",
                    "weight": $("#gridTable").getCol('weight', false, 'sum'),
                    "totalmoney": $("#gridTable").getCol('totalmoney', false, 'sum'),
                });
            },
            ondblClickRow: function (rowid, iRow, iCol, e) {
                btn_edit();
            }
        });
    }
    //编辑
    function btn_edit() {
        var KeyValue = GetJqGridRowValue("#gridTable", "inventoryid");
        if (IsChecked(KeyValue)) {
            var url = "/StorageModule/BY_Inventory/Form?KeyValue=" + KeyValue;
            openDialog(url, "Form", "修改库存", 770, 170, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //删除
    function btn_delete() {
        var KeyValue = GetJqGridRowValue("#gridTable", "inventoryid");
        if (IsDelData(KeyValue)) {
            var delparm = 'KeyValue=' + KeyValue;
            delConfig('/StorageModule/BY_Inventory/Delete1', delparm, KeyValue.split(",").length);
        }
    }

    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入
    }
    //查询
    function btn_Search() {
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/StorageModule/BY_Inventory/GridPageListJson")?MaterialType=" + $("input[name=MaterialType]:checked").val() + "&SteelCode=" + escape($.trim($("#SteelCode").val())) + "&BatchCode=" + escape($.trim($("#BatchCode").val())) + "&Thick=" + $.trim($("#Thick").val()) + "&Weigh=" + $.trim($("#Weigh").val()) + "&Length=" + $.trim($("#Length").val()) + "&alarmck=" + $("#alarmck").attr("checked") + "&SteelPurchaseCode=" + $("#SteelPurchaseCode").val(), page: 1 }).trigger('reloadGrid');
    }
    //导出
    function btn_Export() {
        SetDeriveExcel("#gridTable", "库存信息");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }

    function btn_AllMoney() {
        AjaxJson("/StorageModule/BY_Inventory/GetSmoney", {}, function (data) {
            tipDialog("剩下条钢钢材等值金额：" + Number(data[0].ttotalmoney).toFixed(2), 3, 1);
            return;
        });
    }
    //钢材编码自动补全
    function SteelAutocomplete() {
        var $SteelCode = $("#SteelCode");
        $SteelCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("SteelCode", function (data) {
            $("#SteelCode").val(data.SteelCode);
        });
        //获取数据源
        function DataSource() {
            AjaxJson("/CommonModule/Steel/GetAutoCompleJson", { keywords: $SteelCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="SteelId" style="display: none;">' + DataJson[i].SteelId + '</td>';
                    html += '<td id="SteelCode" style="width: 50%;">' + DataJson[i].SteelCode + '</td>';
                    html += '<td id="SteelName" style="width: 100%;">' + DataJson[i].SteelName + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("SteelCode", $SteelCode.width() + "px", "200px", html, function (data) {
                    $("#SteelCode").val(data.SteelCode);
                });
            });
        }
    }
    //新增
    function btn_add() {
        var url = "/StorageModule/BY_InStock/BoardForm"
        openDialog(url, "Form", "板件入仓", 650, 230, function (iframe) {
            top.frames[iframe].AcceptClick()
        });
    }
</script>
<!--工具栏-->
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        
        <tr>
            <td>钢种：
                <input id="SteelCode" maxlength="50" type="text" class="txt" />
            钢材编号：
                <input id="BatchCode" maxlength="50" type="text" class="txt" />
            采购单：
                <input id="SteelPurchaseCode" maxlength="50" type="text" class="txt" />
            厚：
                <input id="Thick" maxlength="50" type="text" class="txt" style="width: 50px;" />
            宽：
                <input id="Weigh" maxlength="50" type="text" class="txt" style="width: 50px;" />
            长：
                <input id="Length" maxlength="50" type="text" class="txt" style="width: 50px;" />
            
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
                <input id="btnExport" type="button" class="btnSearch" value="导 出" onclick="btn_Export()" />
                <input id="btn_showcusmerName" type="button" class="btnSearch" value="显示价格"  />
            </td>
        </tr>
        <tr>
            <td colspan="4" style="display:none">
                <span class="item">
                    <input type="radio" name="MaterialType" value="-1" checked="checked" id="all" />
                    <label for="all">&nbsp; 全部&nbsp; &nbsp; </label>
                </span>
                <span class="item">
                    <input type="radio" name="MaterialType" value="0" id="board" />
                    <label for="board">&nbsp; 条钢（带规格） </label>
                </span>
                <span class="item">
                    <input type="radio" name="MaterialType" value="1" id="broken" />
                    <label for="broken">&nbsp; 碎料（只重量）</label>
                </span>
            </td>
           
            <td colspan="3"><span class="item" style="cursor: pointer;">
                <input type="checkbox" class="checkbox" name="checkbox" id="alarmck" />
                <label for="alarmck">报警</label>
            </span>(报警规则：重量小于1000kg)</td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
