    function btn_Print() {
        var OrderId = GetJqGridRowValue("#gridTable", "OrderId");
        var CustomerCode = GetJqGridRowValue("#gridTable", "CustomerCode");
        
        if (IsChecked(OrderId)) {
            var url = "/OrderModule/OrderPrint/ChoosePrint?OrderId=" + OrderId + "&CustomerCode=" + CustomerCode;
            openDialogFName(url, "DeriveDialog", "打印", 800, 550, "直接打印", "预览打印",
                function (iframe) {
                    top.frames[iframe].AcceptClick();
                },
            function (iframe) {
                top.frames[iframe].AcceptClick2();
            });
        }
    }
    function DeliveryPrint(perType, printType, OrderId, OrderDetailIds, QuotationId) {
        PrintDialog("/OrderModule/OrderPrint/" + printType + "?perType=" + perType + "&OrderId=" + OrderId  + "&OrderDetailIds=" + OrderDetailIds + "&QuotationId=" + QuotationId, "PrintPage", "PrintPagess", 1000, 550, function (iframe) {
            top.frames[iframe].AcceptClick();
        });
    }
</script>
<div class="leftline rightline topline QueryArea" style="margin: 1px; margin-bottom: 0px;">
    <table id="QueryParameter" border="0" class="form-find" style="height: 45px;">
        <tr>
