        }
        function self(id) {
           var id = Number(id);
            var e = e || window.event || arguments.callee.caller.arguments[0];
            var tar = e.srcElement || e.target;
            if (event.keyCode == 37) {//左
                if ($(tar).attr('id') == id + "_XLsize") {
                }
                else if ($(tar).attr('id') == id + "_MaterialPrice") {
                    $("#" + id + "_XLsize").focus();
                }
                else if ($(tar).attr('id') == id + "_WorkCost") {
                    $("#" + id + "_MaterialPrice").select();
                }
                else if ($(tar).attr('id') == id + "_Remark") {
                    $("#" + id + "_WorkCost").select();
                }
                else {
                    $("#" + id + "_XLsize").select();
                }
                return true;
            }
            if (event.keyCode == 39) {//右
                if ($(tar).attr('id') == id + "_XLsize") {
                    $("#" + id + "_MaterialPrice").focus();
                }
                else if ($(tar).attr('id') == id + "_MaterialPrice") {
                    $("#" + id + "_WorkCost").focus();
                }
                else if ($(tar).attr('id') == id + "_WorkCost") {
                    $("#" + id + "_Remark").focus();
                }
                else if ($(tar).attr('id') == id + "_Remark") {
                }
                else {
                    $("#" + id + "_Remark").select();
                }
                return true;
            }
            if (event.keyCode == 38) {//上
                var aaa = $(tar).attr('id');
                if (id ==1) {
                    return true;
                }
                $("#gridTable").setSelection(id - 1);
                var irow = id - 1;
                aaa = irow + aaa.substr(1, aaa.length);
                window.setTimeout(function () {
                    $("#" + aaa).select();
                }, 200);
                return true;
            }
            if (event.keyCode == 40 || event.keyCode == 13) {//下

                var aaa = $(tar).attr('id');
                if (aaa.indexOf("TypeName") >= 0) {
                    return true;
                }
                var mun = Number($("#gridTable").getGridParam("reccount"));
                if (id >= 0 && id < mun) {
                    $("#gridTable").setSelection(id + 1);
                }
                else {
                    $("#lr-add-Row").click();
                }
                var irow = id + 1;
                aaa = irow + aaa.substr(1, aaa.length);
                window.setTimeout(function () {
                    $("#" + aaa).select();
                }, 200);
                return true;
            }
            ////if (e && e.keyCode == 13) {//回车
            ////    //alert($("#gridTable").getGridParam("reccount"));
            ////    return false;
            ////}
            return false;
        }

        function countU(id) {



