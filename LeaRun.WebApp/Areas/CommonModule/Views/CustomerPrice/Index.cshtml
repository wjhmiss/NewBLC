                        if (rowObject.IsOutLength == "0") {
                            str += "(内)";
                        }
                        else {
                            str += "(外)";
                        }
                        return str;
                    }
                },
                { label: '长 至', name: 'LengthEnd', index: 'LengthEnd', width: 60, align: 'center', hidden: true },
                  {
                      label: '余量(长宽厚)', name: '余量', width: 80,
                      formatter: function (cellvalue, options, rowObject) {
                          return rowObject.AddLength + "*" + rowObject.AddWeigh + "*" + rowObject.AddThick;
                      }
                  },
                {
                    label: '说明', name: 'Remark', index: 'Remark', width: 100,
                    formatter: function (cellvalue, options, rowObject) {
                        if (!!cellvalue) {
                            return cellvalue.replace(/,/g, "，");;

                        }
                        return "";
                    }
                },
                {
                    label: '创建时间', name: 'CreateDate', index: 'CreateDate', width: 100,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd');
                    }
                },
                 { label: '修改人', name: 'ModifyUserName', index: 'ModifyUserName', width: 60, align: 'center' },
                {
                    label: '修改时间', name: 'ModifyDate', index: 'ModifyDate', width: 80,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd');
                    }
                },
            ],
            pager: "false",
            rowNum: 1000,
            sortname: 'SteelCode,CreateDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                $("#lr-edit-Row").click();
            },
            onSelectRow: function () {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
            },
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
            }
        });
    }
    /*材料费折扣end=====================*/

    /*热处理费折扣begin=================*/
    //热处理费折扣表格
    function ManageDiscountGrid() {
        var SelectRowIndx = 1;
        var CustomerId = GetJqGridRowValue("#gridTable", "customerid");
        $("#Manage_gridTable").jqGrid({
            url: "@Url.Content("~/CommonModule/CustomerPrice/GridManageList")?CustomerId=" + CustomerId,
            datatype: "json",
            height: $(window).height() - 430,
            autowidth: true,
            colModel: [
                { label: '主键', name: 'CustomerManageId', hidden: true },
                { label: '工艺编码', name: 'CraftTypeCode', index: 'CraftTypeCode', width: 100 },
                { label: '工艺名称', name: 'CraftTypeName', index: 'CraftTypeName', width: 100 },
                { label: '单位', name: 'Unit', index: 'Unit', width: 60, align: 'center' },
                { label: '单价', name: 'Price', index: 'Price', width: 60, align: 'center' },
                { label: '钢种', name: 'SteelCode', index: 'SteelCode', width: 60, align: 'center' },

                {
                    label: '说明', name: 'Remark', index: 'Remark', width: 100,
                    formatter: function (cellvalue, options, rowObject) {
                        if (!!cellvalue) {
                            return cellvalue.replace(/,/g, "，");;

                        }
                        return "";
                    }
                },
                {
                    label: '创建时间', name: 'CreateDate', index: 'CreateDate', width: 100,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd') ;
                    }
                },
                 { label: '修改人', name: 'ModifyUserName', index: 'ModifyUserName', width: 60, align: 'center' },
                {
                    label: '修改时间', name: 'ModifyDate', index: 'ModifyDate', width: 80,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd');
                    }
                },
            ],
            pager: "false",
            rowNum: 1000,
            rownumbers: true,
            sortname: 'CreateDate',
            sortorder: 'desc',
            shrinkToFit: false,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                $("#lr-edit-Row").click();
            },
            onSelectRow: function () {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
            },
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
            }
        });
    }
    /*热处理费折扣end===================*/

    function OverrideTabchange(id) {
        var CustomerId = GetJqGridRowValue("#gridTable", "customerid");
        if (!CustomerId) {
            alertDialog("请选择一行客户", 0);
        } else {
            Tabchange(id);
            if (id == "ProcessDiscount") {
                MaterialsDiscountGrid();
                var rrradio = $("input[name=checkbox]:checked").val();
                $("#Process_gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/CommonModule/CustomerPrice/GridProcessList")?CustomerId=" + CustomerId + "&rrradio=" + rrradio + "&SteelCode=" + escape($("#SteelCode2").val()) }).trigger('reloadGrid');
            } else if (id == "MaterialsDiscount") {
                MaterialsDiscountGrid();
                $("#Materials_gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/CommonModule/CustomerPrice/GridMaterialsList")?CustomerId=" + CustomerId + "&SteelCode=" + escape($("#SteelCode").val()) }).trigger('reloadGrid');
            } else if (id == "ManageDiscount") {
                ManageDiscountGrid()
                $("#Manage_gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/CommonModule/CustomerPrice/GridManageList")?CustomerId=" + CustomerId }).trigger('reloadGrid');
            }
        }
    }
    function ShowMaterials() {
    }
</script>
