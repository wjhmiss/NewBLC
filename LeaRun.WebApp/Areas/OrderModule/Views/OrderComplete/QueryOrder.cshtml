@{
    ViewBag.Title = "报价单查询";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script>
    $(function () {
        

        window.setTimeout(function () {
            GetGrid();
            $('#gridTable').setGridWidth(630);
            btn_Search();
        }, 300);
        
    });
    //查询
    function btn_Search() {
        var Parameter = [{
            CustomerCode: $("#CustomerCode").val(),
            MnemonicCode: $("#MnemonicCode").val(),
            DepartName: $("#DepartName").val(),
            LType: GetQuery('LType'),
            
        }]
        $("#gridTable").jqGrid('setGridParam', {
            url: "@Url.Content("~/OrderModule/OrderQuery/GridPageListJson")?Condition=" + escape(JSON.stringify(Parameter)), page: 1
        }).trigger('reloadGrid');
    }
    //报价单列表
    function GetGrid() {
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/OrderModule/OrderQuery/GridPageListJsons")",
            datatype: "json",
            height: 157,
            autowidth: true,
            colModel: [
                    { label: '主键', name: 'orderid', hidden: true },
                    { label: '编号', name: 'mnemoniccode', index: 'mnemoniccode', width: 120, align: 'left', sortable: true },
                    { label: '订单单号', name: 'ordercode', index: 'ordercode', width: 120, align: 'left', sortable: true },
                    { label: '客户编号', name: 'customercode', index: 'customercode', width: 80, align: 'left', sortable: true },
                    { label: '客户简称', name: 'shortname', index: 'shortname', width: 80, align: 'left', sortable: true },
                    { label: '客户PO', name: 'customerpo', index: 'customerpo', width: 80, align: 'left', sortable: true, hidden: true },
                    { label: '总数量', name: 'qty', index: 'qty', width: 50, align: 'right', sortable: true },
                    {
                        label: '订单状态', name: 'orderstatus', index: 'orderstatus', width: 60, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowobject) {
                            if (cellvalue == "正常生产") {
                                return "<a  style='color:red' onclick='OpearLog(\"" + rowobject.orderid + "\",\"" + rowobject.ordercode + "\")'>" + cellvalue + "</a>";
                            }
                            else {
                                //return "<a class='alink' style='color:red' onclick='OpearLog(\"" + rowobject.orderid + "\",\"" + rowobject.ordercode + "\")'>" + cellvalue + "</a>";
                                return "<a  style='color:black' onclick='OpearLog(\"" + rowobject.orderid + "\",\"" + rowobject.ordercode + "\")'>" + cellvalue + "</a>";
                            }
                        }
                    },

            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'issueddate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            ondblClickRow: function () {
                AcceptClick();
            },
            onSelectRow: function () {
                var mnemoniccode = GetJqGridRowValue("#gridTable", "mnemoniccode");
                top.frames[tabiframeId()].$("#mnemoniccode").val(mnemoniccode);
                top.frames[tabiframeId()].btn_Search();
            }
        });
    }
    //确认事件
    function AcceptClick() {
        var mnemoniccode = GetJqGridRowValue("#gridTable", "mnemoniccode");
        top.frames[tabiframeId()].$("#mnemoniccode").val(mnemoniccode);
        top.frames[tabiframeId()].btn_Search();
        window.setTimeout(function () {closeDialog();}, 500);
    }
</script>
<div class="leftline rightline topline QueryArea" style="margin: 1px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
           
           
            <th>客户号：</th>
            <td>
                <input id="CustomerCode" type="text" class="txt" style="width: 100px" />
            </td>
            
            <th>编码：</th>
            <td>
                <input id="MnemonicCode" type="text" class="txt" style="width: 100px" />
            </td>
            <th>部门：</th>
            <td>
                <input id="DepartName" type="text" class="txt" style="width: 100px" />
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="查 询" onclick="btn_Search()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
