@{
    ViewBag.Title = "期初应付";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        setType();
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    function setType() {
        if ($("#Type0").val() == "收款") {
            BindDropItemT2index("#Type1", "#Type2", "收款类型", "==请选择==");

        }
        else {
            BindDropItemT2index("#Type1", "#Type2", "CostType", "==请选择==");
        }
    }
    //加载表格
    function GetGrid() {
        var rowScrod = 0;
        var SelectRowIndx = 0;
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/PaymentModule/Base_PayCompany/GridPageJson1")",
            datatype: "json",
            height: $(window).height() - 179,
            autowidth: true,
            colModel: [
                 { label: '选项', name: 'Type0', index: 'Type0', width: 60, align: 'left', sortable: true },
                { label: '选项1', name: 'Type1', index: 'Type1', width: 60, align: 'left', sortable: true },
                { label: '选项2', name: 'Type2', index: 'Type2', width: 60, align: 'left', sortable: true },
                    { label: '物料id', name: 'PayCompanyId', index: 'PayCompanyId', hidden: true },
                    { label: '供应商编号', name: 'CustomerCode', index: 'CustomerCode', width: 100, align: 'left', sortable: true, hidden: true },
                    { label: '付款单号', name: 'PayCompanyCode', index: 'PayCompanyCode', width: 100, align: 'left', sortable: true },
                    { label: '对账单号', name: 'PayCheckSheetCode', index: 'PayCheckSheetCode', width: 100, align: 'left', sortable: true },
                    { label: '供应商名称', name: 'CustomerName', index: 'CustomerName', width: 100, align: 'left', sortable: true },
                    { label: '关联单号', name: 'Code', index: 'Code', width: 100, align: 'left', sortable: true },
                    { label: '付款事项', name: 'PayName', index: 'PayName', width: 100, align: 'left', sortable: true },
                    { label: '单价', name: 'PricePer', index: 'PricePer', width: 60, align: 'left', sortable: true },
                    { label: '数量', name: 'Qty', index: 'Qty', width: 60, align: 'left', sortable: true },
                    { label: '总金额', name: 'TotalAmount', index: 'TotalAmount', width: 60, align: 'left', sortable: true },
                    { label: '已付金额', name: 'GetedAmount', index: 'PayedAmount', width: 80, align: 'left', sortable: true },
                    { label: '支付方式', name: 'PayType', index: 'PayType', width: 80, align: 'left', sortable: true },
                    { label: '申请员工姓名', name: 'WorkerName', index: 'WorkerName', width: 80, align: 'left', sortable: true },
                    { label: '申报部门', name: 'DepartmentName', index: 'DepartmentName', width: 120, align: 'left', sortable: true },
                    {
                        label: '申请时间', name: 'CreateDate', index: 'CreateDate', width: 100, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    {
                        label: '备注', name: 'Remark', index: 'Remark', width: 120, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");;

                            }
                            return "";
                        }
                    },
                   {
                       label: '审核状态', name: 'Status', index: 'Status', width: 60, align: 'left', sortable: true,
                       formatter: function (cellvalue, options, rowObject) {
                           return cellvalue == "0" ? "否" : "是";
                       }
                   },
                   
            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'CreateDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            gridview: true,
            ondblClickRow: function (rowid, iRow, iCol, e) {
                btn_edit();
            },
            multiselect: true,
            footerrow: true,
            onSelectRow: function (rowid, status) {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
                rowScrod = $("#" + rowid).position().top;
            },
            gridComplete: function () {
                $(".ui-jqgrid-bdiv").first().scrollTop(rowScrod);
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
                //合计
                $(this).footerData("set", {
                    "CustomerName": "合计",
                    "Qty": FormatCurrency($("#gridTable").getCol('Qty', false, 'sum')),
                    "TotalAmount": FormatCurrency($("#gridTable").getCol('TotalAmount', false, 'sum')),
                });
                var data = $("#gridTable").jqGrid("getRowData");
                for (var i = 0; i < data.length; i++) {
                    var item = i + 1;
                    if (data[i].Status == "是") {
                        $("#" + item).find('td').css("background-color", "#00AA00");
                    }
                    if (data[i].IsPay == "是") {
                        $("#" + item).find('td').css("background-color", "#00AA88");
                    }
                    if (data[i].IsInvoice == "是") {
                        $("#" + item).find('td').css("background-color", "#2200AA");
                    }


                }
            }
        });
    }
    //新增
    function btn_add() {
        var url = "/PaymentModule/Base_PayCompany/Form"
        openDialog(url, "Form", "新增其他付款", 770, 395, function (iframe) {
            top.frames[iframe].AcceptClick()
        });
    }
    //编辑
    function btn_edit() {
        var Status = GetJqGridRowValue("#gridTable", "Status");
        if (Status == "是") {
            alertDialog("当前申请单已审核", 0);
            return false;
        }
        var IsPay = GetJqGridRowValue("#gridTable", "IsPay");
        if (IsPay == "是" ) {
            alertDialog("当前申请单已付款", 0);
            return false;
        }
        var IsInvoice = GetJqGridRowValue("#gridTable", "IsInvoice");
        if (IsInvoice == "是" ) {
            alertDialog("当前申请单已开票", 0);
            return false;
        }
        var GetedAmount = GetJqGridRowValue("#gridTable", "GetedAmount");
        if (GetedAmount > 0) {
            alertDialog("当前申请单已收款", 0);
            return false;
        }
        var KeyValue = GetJqGridRowValue("#gridTable", "PayCompanyId");
        if (IsChecked(KeyValue)) {
            var url = "/PaymentModule/Base_PayCompany/Form?KeyValue=" + KeyValue;
            openDialog(url, "Form", "编辑其他付款", 770, 395, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //删除
    function btn_delete() {
        var selr = jQuery('#gridTable').jqGrid('getGridParam', 'selarrrow');
        var s1 = "";
        if (selr.length) {
            for (var i = 0; i < selr.length; i++) {
                var myrow = jQuery('#gridTable').jqGrid('getRowData', selr[i]);
                if (myrow.Status == "是") {
                    tipDialog("操作失败：部分报价单已审核!", 3, 0);
                    return false;
                }
                if (myrow.GetedAmount > 0) {
                    alertDialog("当前申请单已收款", 0);
                    return false;
                }
            }
            var KeyValue = GetJqGridRowValue("#gridTable", "PayCompanyId");
            if (IsDelData(KeyValue)) {
                var delparm = 'KeyValue=' + KeyValue;
                delConfig('/PaymentModule/Base_PayCompany/Delete', delparm, KeyValue.split(",").length);
            }
        }
    }
    //明细
    function btn_detail() {
        var KeyValue = GetJqGridRowValue("#gridTable", "PayCompanyId");
        if (IsChecked(KeyValue)) {
            var url = "/PaymentModule/Base_PayCompany/Detail?KeyValue=" + KeyValue;
            Dialog(url, "Detail", "其他付款明细", 820, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入
        
    }

