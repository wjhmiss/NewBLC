    //新增
    function btn_add() {
        var url = "/CheckSheetModule/BY_CheckSheet/Form"
        openDialog(url, "Form", "对账单生成", 970, 595, function (iframe) {
            top.frames[iframe].AcceptClick()
        });
    }
    //编辑
    function btn_edit() {
        BuildInvioce();
    }
    //删除
    function btn_delete() {
        var status = GetJqGridRowValue("#gridTable", "status");
        if (status == "1") {
            alert("已审核，请先对账确认！");
            return;
        }
        var KeyValue = GetJqGridRowValue("#gridTable", "reimbursesheetid");
        if (IsDelData(KeyValue)) {
            var delparm = 'KeyValue=' + KeyValue;
            delConfig('/CheckSheetModule/BY_CheckSheet/Delete', delparm, KeyValue.split(",").length);
        }
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入

    }

