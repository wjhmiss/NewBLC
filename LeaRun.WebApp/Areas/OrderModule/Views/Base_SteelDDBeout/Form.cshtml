        }
        var index = 0;
        if (!!$("#gridTable").getGridParam("reccount")) {
            index = $("#gridTable").getGridParam("reccount") + 1;
        }
        else {
            index = 1;
        }

        var RowData = {
            SortCode: SortCode ,
            SteelCode: "",
            SteelDescription: "",
            Qty: "0",
            Price: "0",
            Weight: "0",
            WorkCost: "0",
            TotalAmount: "0",
            Remark: "",
            Length: "0",
            Weigh: "0",
            Thick: "0",
            QuotationCode: "",
            AddLength: "0",
            AddWeigh: "0",
            AddThick: "0",
            QuotationDetailId: "",
            XLsize: "",
            Density: "0",
        }
        $('#gridTable').jqGrid('restoreRow', index);
        $('#gridTable').jqGrid('addRowData', index, RowData, "last");
        $("#gridTable").setSelection(index);
    }
</script>
