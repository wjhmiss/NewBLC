                        <option value="热处理费">热处理费</option>
                        <option value="调账">调账</option>
                        <option value="货物互调">货物互调</option>
                        <option value="未税扣减">未税扣减</option>
                        <option value="其他">其他</option>
                    </select>
                    </td>
                    @*<th class="formTitle" colspan="2">板件名称：</th>
                <td class="formValue">
                    <input disabled id="BoardDescription" type="text" class="txt" /></td>*@


                    <th class="formTitle" colspan="2">钢材编码：</th>
                    <td class="formValue">
                        <input id="SteelId" type="hidden" />
                        <input id="SteelCode" type="text" class="txt" datacol="yes" err="钢材编码" checkexpession="NotNull" style="width: 45%" disabled value="FY" />
                        <input disabled id="SteelDescription" type="text" class="txt" style="width: 45%" value="费用" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle" colspan="2">单价/KG：</th>
                    <td class="formValue">
                        <input id="MaterialPrice" onfocus="IsMoney(this.id);" onkeyup="temp3 = temp3 + 1;CountTotalMoney();" type="text" class="txt" value="0.00" />
                    </td>
                    <th class="formTitle" colspan="2">理论重量：</th>
                    <td class="formValue">
                        <input id="Weight" onfocus="IsMoney(this.id);" onkeyup="CountTotalMoney()" type="text" class="txt" value="0.00" />
                    </td>
                </tr>
                <tr>
                    <th class="formTitle" colspan="2">数&nbsp;&nbsp;量：</th>
                    <td class="formValue">
                        <input id="Qty" onfocus="IsNumber(this.id);" type="text" class="txt" value="1" />
                    </td>
                    <th class="formTitle" colspan="2">备注：</th>
                    <td class="formValue">
                        <input id="CustomerProduct" type="text" class="txt" />
                    </td>



                </tr>
                <tr>
                    <th class="formTitle" colspan="2">品名：</th>
                    <td class="formValue">
                        <input id="ProductName" type="text" class="txt" datacol="yes" err="品名" checkexpession="NotNull" />
                    </td>
                    <th class="formTitle" colspan="2">销售额：</th>
                    <td class="formValue">
                        <input id="SalesAmount" type="text" class="txt" value="0.00" datacol="yes" err="销售额" checkexpession="NotNull" />
                    </td>

                </tr>
                <tr>
                    <td class="formValue" colspan="6" style="height:65px;">
                        <input id="LineCode" type="text" class="txt" style="height:65px;font-size: 30px; font-weight: bold;text-align: center; color:#FF0000" readonly />
                    </td>
                </tr>
            </table>
            <style>
                .form .formTitle {
                    width: 120px;
                }
            </style>
        </form>
