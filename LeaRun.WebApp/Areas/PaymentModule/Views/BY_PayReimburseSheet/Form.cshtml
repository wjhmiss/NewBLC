    function InitControl() {
        if ($("#Type0").val() == "收款") {
            getAjax('/CommonModule/DataDictionary/BinDingItemsJson1', { Code: "收款类型", FullName: $("#Type1").val() }, function (data1) {
                $("#Type2").empty()
                var itemjson1 = eval("(" + data1 + ")");
                $.each(itemjson1, function (i) {
                    $("#Type2").append($("<option></option>").val(itemjson1[i].FullName).html(itemjson1[i].FullName));
                });
            });
        }
        else {
            getAjax('/CommonModule/DataDictionary/BinDingItemsJson1', { Code: "CostType", FullName: $("#Type1").val() }, function (data1) {
                $("#Type2").empty()
                var itemjson1 = eval("(" + data1 + ")");
                $.each(itemjson1, function (i) {
                    $("#Type2").append($("<option></option>").val(itemjson1[i].FullName).html(itemjson1[i].FullName));
                });
            });
        }
    }
    var temp = 0;
    function setType() {
        InitControl();
        if ($("#Type0").val() == "收款") {
            $("#Type1").empty()
            BindDropItemT2("#Type1", "#Type2", "收款类型", "==请选择==");
            InitControl();

        }
        else {
            $("#Type1").empty()
            BindDropItemT2("#Type1", "#Type2", "CostType", "==请选择==");
            InitControl();

        }
    }
    function setZRMoney() {
        if ($("#GETMoney").val() != "" && $("#Opions").val() == "应付款") {
            $("#ZRMoney").val((temp - Number($("#GETMoney").val())).toFixed(2));
        }
    }
    function setFF() {
        if ($("#CheckCodeGenMoney").val().indexOf('-') >= 0) {
            if (!!Number($("#GETMoney").val())) {
                $("#GETMoney").val(-Math.abs($("#GETMoney").val()));

            }
            else {
                $("#GETMoney").val("");

            }
        }
        setZRMoney();
    }

    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }

        $("#RequiredMoney").val(Number($("#GETMoney").val()) + Number($("#ZRMoney").val()))



        //if (Number($("#RequiredMoney").val()) != temp && $("#Opions").val() == "应付款") {
        //    $("#GETMoney").select();
        //    tipDialog("实付金额+折让金额应等于可付金额！", 3, 0);
        //    return false;
        //}
        if ($("#Opions").val() != "应付款") {
            $("#Code").val("");
            $("#ZRMoney").val(0);
            if ($("#CustomerCode").val() == "" && !$("#AN5").prop("checked")) {
                tipDialog("请选择供应商", 3, 0);
                $("#CustomerCode").select();
                return false;
            }
        }
        if ($("#GETMoney").val() == "0") {
            tipDialog("请输入获取金额！", 3, 0);
            $("#GETMoney").select();
            return false;
        }
        if ($("#Code").val() == "" && $("#Opions").val() == "应付款") {
            tipDialog("请选择单号！", 3, 0);
            $("#Code").select();
            return false;
        }

        if (!checkCustomerName() && $("#Opions").val() == "应付款") {
            tipDialog("请选择相同供应商单号！", 3, 0);
            return false
        }
        //if (temp <= 0) {
        //    tipDialog("此单号已付清，不需多付！", 3, 0);
        //    $("#GETMoney").select();
        //    return false;
        //}

        var postData = GetWebControls("#form1");
        AjaxJson("/PaymentModule/BY_PayReimburseSheet/SubmitFormCost?Code1=" + $("#Code").val() + "&CodeType=" + escape($("#Opions").val()), postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            //location.href = location.href;
            //window.setTimeout(function () {closeDialog();}, 500);
            $("#Code").val("");
            $("#CheckCodeGenMoney").val("");
            $("#GETMoney").val(0);
            $("#RequiredMoney").val(0);
            $("#GetType").val("现金");
            $("#Opions").val("应付款");
            $("#ZRMoney").val(0);
            $("#Remark").val("");
            dispalydiv();
        });
    }

