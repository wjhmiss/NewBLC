@{
    ViewBag.Title = "材料费折扣";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    var KeyValue = GetQuery('KeyValue');//主键
    var CustomerId = GetQuery('CustomerId');//客户主键
    $(function () {
        $("#CustomerId").val(CustomerId);
        //钢材编码自动补全
        SteelAutocomplete();
        //加工类型
        BindDropItem("#ProcessType", "ProcessType", "==请选择==");
        //单位
        //BindDropItem("#Unit", "MeasureUnit", "==请选择==");
        InitControl();
        document.onkeydown = enterInput;
    })

    function enterInput() {
        var e = e || window.event || arguments.callee.caller.arguments[0];
        var tar = e.srcElement || e.target;
        if (e && e.keyCode == 13) {//回车
            window.event.keyCode = 9;
            if ($(tar).attr('id') == "Remark") {
                AcceptClick();
            }
            return;
        }
    }

    //钢材编码自动补全
    function SteelAutocomplete() {
        var $SteelCode = $("#SteelCode");
        $SteelCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("SteelCode", function (data) {
            $("#SteelId").val(data.SteelId);
            $("#SteelCode").val(data.SteelCode);
            $("#SteelName").val(data.SteelName);
        });
        //获取数据源
        function DataSource() {
            AjaxJson("/CommonModule/Steel/GetAutoCompleJson", { keywords: $SteelCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="SteelId" style="display: none;">' + DataJson[i].SteelId + '</td>';
                    html += '<td id="SteelCode" style="width: 25%;">' + DataJson[i].SteelCode + '</td>';
                    html += '<td id="SteelName" style="width: 25%;">' + DataJson[i].SteelName + '</td>';
                    html += '<td id="SteelType" style="width: 25%;display: none;">' + DataJson[i].SteelType + '</td>';
                    html += '<td id="Price" style="width: 25%;display: none;">' + DataJson[i].Price + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("SteelCode", "250px", "200px", html, function (data) {
                    $("#SteelId").val(data.SteelId);
                    $("#SteelCode").val(data.SteelCode);
                    $("#SteelName").val(data.SteelName);
                });
            });
        }

    }


    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/CommonModule/CustomerPrice/SetFormMaterials", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
                $("#EnabledTimeStart").val(formatDate(data.EnabledTimeStart, 'yyyy-MM-dd'));
                $("#EnabledTimeStart").val(formatDate(data.EnabledTimeStart, 'yyyy-MM-dd'))
                $("#ModifyDate").val(formatDate(data.ModifyDate, 'yyyy-MM-dd'))
            });
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }

        if (!$("#GuangSteel").prop("checked") && !$("#JingSteel").prop("checked") && !$("#MaoSteel").prop("checked")) {
            alertDialog("操作失败：请勾选类型！", 0);
            return false;
        }

        var postData = GetWebControls("#form1");
        $(".ui_state_highlight").attr("disabled", true);
        AjaxJson("/CommonModule/CustomerPrice/SubmitFormMaterials?KeyValue=" + KeyValue, postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            //window.setTimeout(function () {closeDialog();}, 500);
            if (!!KeyValue) {
                window.setTimeout(function () {closeDialog();}, 500);
            }
            else {
                location.href = location.href;
            }
           
        });
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class='formTitle'>性质：</th>
            <td class='formValue' colspan="3">
                <span class="item" style="width: 15%;display:inline;">
                    <input type="checkbox" name="checkbox"  id="MaoSteel" />
                    <label for="MaoSteel">毛料</label>
                </span>
                <span class="item" style="width: 15%;display:inline;">
                    <input type="checkbox" name="checkbox"  id="GuangSteel" />
                    <label for="GuangSteel">光板</label>
                </span>
                <span class="item" style="width: 15%;display:inline;">
                    <input type="checkbox" name="checkbox"  id="JingSteel" />
                    <label for="JingSteel">精板</label>
                </span>
            </td>
        </tr>
        <tr>
           <th class='formTitle'>钢材编码：</th>
            <td class='formValue' >
                <input id="CustomerId" type="hidden" />
                <input id="SteelId" type="hidden" />
                <input id="SteelCode" maxlength="50" type="text" class="txt"  style="width:75%;display:inline"  datacol="yes" err="钢材"  checkexpession="NotNull"/>
                <input id="SteelName" readonly type="text" class="txt readonly" style="width:20%;display:inline" />
            </td>
            <th class='formTitle'>单位：</th>
            <td class='formValue'>
                <select id="Unit" class="txt" datacol="yes" err="单位" checkexpession="NotNull">
                    <option value="公斤">公斤</option>
                </select>
            </td>
        </tr>
         <tr>
            <th class='formTitle'>重量由：</th>
            <td class='formValue'>
                <input id="KGfrom" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" value="0" />
            </td>
            <th class='formTitle'>重量至：</th>
            <td class='formValue'>
                <input id="KGto" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);"  value="0" style="width: 50%;display:inline;"/>
            </td>
        </tr>
        <tr>
            <th class='formTitle'>厚(直径)由：</th>
            <td class='formValue'>
                <input id="PachyStart" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);"  value="0" />
            </td>
            <th class='formTitle'>厚(直径)至：</th>
            <td class='formValue'>
                <input id="PachyEnd" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" style="width: 50%;display:inline;" value="0" />
                <span class="item" style="width: 40%;display:inline;float:right;">
                    <input type="checkbox" name="checkbox"  id="IsOutThick" />
                    <label for="IsOutThick">以外</label>
                </span>
            </td>
        </tr>
        <tr>
            <th class='formTitle'>宽 由：</th>
            <td class='formValue'>
                <input id="WidthStart" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" value="0" />
            </td>
            <th class='formTitle'>宽 至：</th>
            <td class='formValue'>
                <input id="WidthEnd" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);"  style="width: 50%;display:inline;"  value="0" />
                <span class="item" style="width: 40%;display:inline;float:right;">
                    <input type="checkbox" name="checkbox"  id="IsOutWidth" />
                    <label for="IsOutWidth">以外</label>
                </span>
            </td>
        </tr>
        <tr>
            <th class='formTitle'>长 由：</th>
            <td class='formValue'>
                <input id="LengthStart" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" value="0" />
            </td>
            <th class='formTitle'>长 至：</th>
            <td class='formValue'>
                <input id="LengthEnd" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);"  style="width: 50%;display:inline;" value="0" />
                <span class="item" style="width: 40%;display:inline;float:right;">
                    <input type="checkbox" name="checkbox"  id="IsOutLength" />
                    <label for="IsOutLength">以外</label>
                </span>
            </td>
        </tr>
       
        <tr>
            <th class='formTitle'>单价：</th>
            <td class='formValue'>
                <input id="Price" maxlength="18" onfocus="IsMoney(this.id);" type="text" class="txt" datacol="yes" err="单价" value="0" checkexpession="NotNull" style="width: 90%; border-right: 1px solid #ccc;" />
                <input id="DiscountRate" maxlength="18" onfocus="IsMoney(this.id);" type="text" class="txt"  style="display:none; border-right: 1px solid #ccc;" />
                <span style="color: red; font-weight: bold;">￥</span>
            </td>
            <th class='formTitle'>计算与或：</th>
            <td class='formValue' >
                <span class="item">
                    <input type="checkbox" name="checkbox"  id="OrOr" />
                    <label for="OrOr">或者</label>
                </span>
            </td>
        </tr>
               


       @* <tr>
            <th class='formTitle'>余量/长：</th>
            <td class='formValue'>
                <input id="AddLength" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" value="0"  />
            </td>
            <th class='formTitle'>余量/宽：</th>
            <td class='formValue'>
                <input id="AddWeigh" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" value="0" />
            </td>
        </tr>*@
        <tr>
           @* <th class='formTitle'>余量/厚：</th>
            <td class='formValue'>
                <input id="AddThick" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" value="0" />
            </td>*@
             <th class='formTitle'>客户材料名称：</th>
            <td class='formValue' colspan="3">
                <input id="ProductName" maxlength="18" type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>备注：</th>
            <td class='formValue' colspan="3">
                <textarea id="Remark" class="txtArea" rows="4"></textarea>
            </td>
        </tr>
       
    </table>
</form>