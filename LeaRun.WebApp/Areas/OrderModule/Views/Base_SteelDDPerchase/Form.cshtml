    //分配：按行理论重量(TheoryWeight)比例分配毛料合称重量，并同步重算总价
    //勾选/取消勾选行：仅记录IsFen标记，不触发行编辑
    function chkFenClick(e, obj, rowId) {
        if (e.stopPropagation) { e.stopPropagation(); } else { e.cancelBubble = true; }
        $('#gridTable').jqGrid('setRowData', rowId, { IsFen: obj.checked ? '1' : '0' });
    }
    function btn_ToFen() {
        if (!!Number($('#TotalWeights').val())) {
            //先保存当前正在编辑的行
            if (!!lastsel) {
                var RowData = {
                    Weight: $("[name='Weight']").val(),
                    TheoryWeight: $("[name='TheoryWeight']").val(),
                    MaterialPrice: $("[name='MaterialPrice']").val(),
                    WorkCost: $("[name='WorkCost']").val(),
                }
                $('#gridTable').jqGrid('setRowData', lastsel, RowData, '');
            }
            var data = $("#gridTable").jqGrid("getRowData");
            var ids = $("#gridTable").jqGrid("getDataIDs");
            //只统计勾选行（IsFen为'0'表示未勾选）的理论重量
            var totaltheory = 0;
            var fencount = 0;
            for (var i = 0; i < data.length; i++) {
                if (data[i].IsFen != '0') {
                    totaltheory = totaltheory + Number(data[i].TheoryWeight);
                    fencount++;
                }
            }
            if (fencount == 0) {
                tipDialog("请先勾选需要分配的行", 3, -1);
                return;
            }
            if (totaltheory <= 0) {
                tipDialog("勾选行的理论重量合计为0，无法分配", 3, -1);
                return;
            }
            var temweight = 0;
            var lastFenIdx = -1;
            for (var i = data.length - 1; i >= 0; i--) {
                if (data[i].IsFen != '0') { lastFenIdx = i; break; }
            }
            for (var i = 0; i < data.length; i++) {
                if (data[i].IsFen == '0') continue;
                var w;
                if (i == lastFenIdx) {
                    w = (Number($('#TotalWeights').val()) - temweight).toFixed(2);
                }
                else {
                    w = (Number(data[i].TheoryWeight) * Number($('#TotalWeights').val()) / totaltheory).toFixed(2);
                }
                temweight = temweight + Number(w);
                $("#gridTable").jqGrid('setRowData', ids[i], { Weight: w, MaterialAmount: (Number(data[i].MaterialPrice) * Number(w) + Number(data[i].WorkCost || 0)).toFixed(2) });
            }
            //汇总总金额
            var data2 = $("#gridTable").jqGrid("getRowData");
            var TotalAmountall = 0;
            for (var i = 0; i < data2.length; i++) {
                TotalAmountall = TotalAmountall + Number(data2[i].MaterialAmount);
            }
            $("#TotalAmount").val(TotalAmountall.toFixed(2));
            $('#TotalWeights').val('');
        }
    }
    //新增一行
    function addrow() {
        var SortCode = 0;
        if (!!Number(GetJqGridValue("#gridTable", $("#gridTable").getGridParam("reccount"), "SortCode"))) {
            SortCode = Number(GetJqGridValue("#gridTable", $("#gridTable").getGridParam("reccount"), "SortCode")) + 1;
        }
        else {
            SortCode = 1;
        }
        var index = 0;
        if (!!$("#gridTable").getGridParam("reccount")) {
            index = $("#gridTable").getGridParam("reccount") + 1;
        }
        else {
            index = 1;
        }

        var RowData = {
            SortCode: SortCode,
            Qty: 1,
            Price: "0",
            Weight: 0,
            TheoryWeight: 0,
            WorkCost: "0",
            TotalAmount: "0",
            Remark: "",
            OrderType: "",
            Length: 0,
            Weigh: 0,
            Thick: 0,
            QuotationCode: "",
            AddLength: 0,
            AddWeigh: 0,
            AddThick: 0,
            QuotationDetailId: "",
        }
        $('#gridTable').jqGrid('restoreRow', index);
        $('#gridTable').jqGrid('addRowData', index, RowData, "last");
        $("#gridTable").setSelection(index);
    }
</script>
