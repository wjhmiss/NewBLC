<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
        }, 200);
        BindDropItem("#TechnologyId", "Operation", "==请选择==");
    })
    //加载表格
    var lastsel3;
    function GetGrid() {
        var rowScrod = 0;
        var Parameter = [
            //{
