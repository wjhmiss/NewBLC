    function AcceptClick2(num, obj) {


        if (!CheckDataValid('#form1')) {
            return false;
        }
        var postData = GetWebControls("#form1");
        if (postData.Qty <= 0) {
            tipCss("#Qty", "数量必须大于0");
            return false;
        }
        if (postData.Thick <= 0 && $("#SteelCode").val() != "FY" && CustMaterial != "1") {
            tipCss("#Thick", "厚度必须大于0");
            return false;
        }
        //if (postData.Weigh <= 0) {
        //    tipCss("#Weigh", "宽度必须大于0");
        //    return false;
        //}
        if (postData.Length <= 0 && $("#SteelCode").val() != "FY" && CustMaterial != "1") {
            tipCss("#Length", "长度必须大于0");
            return false;
        }
        AjaxJsonNoMassge("/QuotationModule/QuotationInput/SubmitDetailForm?KeyValue=" + KeyValue + "&ShipDescription=" + $("#ShipDescription").val() + "&CustomerProduct=" + $("#CustomerProduct").val(), postData, function (data) {
            
            if (data.Code < 0 || !data.Code) {
                //tipDialog(data.Message, 2, data.Code);
                tipCss("#Remark", data.Message);
                return false;
            }
            if (data.Code > 0) {
                top.frames[tabiframeId()].windowload();
                $("#LineCode").val(Number($("#LineCode").val()) + Number(num));
                AjaxJsonNoMassge("/QuotationModule/QuotationInput/SetDetailFormByLine", { QuotationId: $("#QuotationId").val(), LineCode: Number($("#LineCode").val()) }, function (data1) {
                    if (!data1.Qty) {
                        window.setTimeout(function () { closeDialog(); }, 500);
                        return false;
                    }
                    else {
                        SetWebControls(data1);

                        KeyValue = data1.QuotationDetailId;

                        if (!!KeyValue && !!obj) {
                            //编辑
                            //$("#SteelCode").select();
                            obj.select();
                        }
                        else {
                            $("#Length").select();
                        }
                    }
                });
            }
        });
    }

    function setname() {
        var Mheipi = $("#Mheipi").prop("checked") == true ? 1 : 0;
        if (Mheipi == 1) {
            $("#ProductName").val($("#SteelDescription").val() + "净尺寸黑皮");
        }
        else {
            $("#ProductName").val($("#SteelDescription").val() + $("#OrderType").val().substr(0, 2));

            if ($("#ProductName").val().indexOf("板") >= 0) {
                var temp = $("#ProductName").val().replace(/板/g, "");
                $("#ProductName").val(temp + "板");
            }
        }

    }
