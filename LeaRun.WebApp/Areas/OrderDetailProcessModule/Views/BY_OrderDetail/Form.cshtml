@{
    ViewBag.Title = "订单转序》表单页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    var KeyValue = GetQuery('KeyValue');//主键
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/OrderDetailProcessModule/BY_OrderDetail/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
            });
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        $(".ui_state_highlight").attr("disabled", true);
        var postData = GetWebControls("#form1");
        AjaxJson("/OrderDetailProcessModule/BY_OrderDetail/SubmitForm?KeyValue=" + KeyValue, postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            window.setTimeout(function () {closeDialog();}, 500);
        });
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class='formTitle'>订单明细ID：</th>
            <td class='formValue'>
                <input id="OrderDetailId" maxlength=50 type="text" class="txt"   />
            </td>
            <th class='formTitle'>订单ID：</th>
            <td class='formValue'>
                <input id="OrderId" maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>行号：</th>
            <td class='formValue'>
                <input id="LineCode" maxlength=10 type="text" class="txt"   />
            </td>
            <th class='formTitle'>板件编码：</th>
            <td class='formValue'>
                <input id="BoardId" maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>板件描述：</th>
            <td class='formValue'>
                <input id="BoardDescription" maxlength=200 type="text" class="txt"   />
            </td>
            <th class='formTitle'>数量：</th>
