@{
    ViewBag.Title = "库存》表单页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    var KeyValue = GetQuery('KeyValue');//主键
    $(function () {
        InitControl();
        document.onkeydown = enterInput;
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/MaterielModule/Base_MaterielStorage/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
            });
        }
    }
    function enterInput() {
        var e = e || window.event || arguments.callee.caller.arguments[0];
        var tar = e.srcElement || e.target;
        if (e && e.keyCode == 13) {//回车
            window.event.keyCode = 9;
            if ($(tar).attr('id') == "Remark") {
                AcceptClick();
            }
            return;
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        $(".ui_state_highlight").attr("disabled", true);
        var postData = GetWebControls("#form1");
        AjaxJson("/MaterielModule/Base_MaterielStorage/SubmitForm?KeyValue=" + KeyValue, postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            location.href = location.href;
            //window.setTimeout(function () {closeDialog();}, 500);
        });
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class='formTitle'>物料id：</th>
            <td class='formValue'>
                <input id="MaterielStorageId" maxlength=50 type="text" class="txt"   />
            </td>
            <th class='formTitle'>物料id：</th>
            <td class='formValue'>
                <input id="MaterielId" maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>物料号：</th>
            <td class='formValue'>
                <input id="MaterielCode" maxlength=50 type="text" class="txt"   />
            </td>
            <th class='formTitle'>物料类型：</th>
            <td class='formValue'>
                <input id="MaterielType" maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>尺寸：</th>
            <td class='formValue'>
                <input id="MaterielSize" maxlength=50 type="text" class="txt"   />
            </td>
            <th class='formTitle'>单位：</th>
            <td class='formValue'>
                <input id="Unit" maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>供应商ID：</th>
            <td class='formValue'>
                <input id="CustomerId" maxlength=50 type="text" class="txt"   />
            </td>
            <th class='formTitle'>供应商编号：</th>
            <td class='formValue'>
                <input id="CustomerCode" maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
