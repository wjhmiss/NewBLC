@{
    ViewBag.Title = "发运单明细";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
            //GetGrid2();
        }, 200);

        //Loadlayout2();


    })
    function btn_Export1() {
        SetDeriveExcel("#gridTable", "业务绩效");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }
    function btn_Export2() {
        SetDeriveExcel("#gridTable2", "营业员绩效");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }
    function Loadlayout2() {
        if ($('.layout2').length > 0) {
            $("#layout2").splitter({
                type: "v",
                outline: true,
                sizeLeft: 650,
                minLeft: 200,
                minRight: 200,
                anchorToWindow: true,
                accessKey: "L",
            });
        }
    }


    //加载表格
    function GetGrid() {
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/ReportModule/Delivery/QuoSummarygrid")" + "?StartTime=" + escape($("#StartTime").val()) + "&EndTime=" + escape($("#EndTime").val()),
            datatype: "json",
            height: $(window).height() - 171,
            autowidth: true,
            colModel: [
                { label: '客户名称', name: 'fullname', index: 'fullname', width: 100, align: 'left', sortable: true },
                { label: '业务员', name: 'sellpeople', index: 'sellpeople', width: 100, align: 'left', sortable: true },
                { label: '类型', name: 'category', index: 'category', width: 100, align: 'left', sortable: true },

                { label: '已下单重量', name: 'gcweight', index: 'gcweight', width: 100, align: 'left', sortable: true },
                { label: '已下单金额', name: 'gcamount', index: 'gcamount', width: 100, align: 'left', sortable: true },
                { label: '未下单重量', name: 'ngcweight', index: 'ngcweight', width: 100, align: 'left', sortable: true },
                { label: '未下单金额', name: 'ngcamount', index: 'ngcamount', width: 100, align: 'left', sortable: true },
                { label: '免费重量', name: 'gcweightfree', index: 'gcweightfree', width: 100, align: 'left', sortable: true },


                { label: '已下单重量', name: 'ljweight', index: 'ljweight', width: 100, align: 'left', sortable: true },
                { label: '已下单金额', name: 'ljamount', index: 'ljamount', width: 100, align: 'left', sortable: true },
                { label: '未下单重量', name: 'nljweight', index: 'nljweight', width: 100, align: 'left', sortable: true },
                { label: '未下单金额', name: 'nljamount', index: 'nljamount', width: 100, align: 'left', sortable: true },
                { label: '免费重量', name: 'ljweightfree', index: 'ljweightfree', width: 100, align: 'left', sortable: true },


                { label: '已下单重量', name: 'rclweight', index: 'rclweight', width: 100, align: 'left', sortable: true },
                { label: '已下单金额', name: 'rclamount', index: 'rclamount', width: 100, align: 'left', sortable: true },



            ],
            viewrecords: true,
            rowNum: 9999,
            rowList: [9999, 9999, 9999, 9999, 9999],

            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,

            footerrow: true,
            gridComplete: function () {
                //合计
                $(this).footerData("set", {
                    "category": "合计",
                    "gcweight": FormatCurrency($("#gridTable").getCol('gcweight', false, 'sum')),
                    "gcamount": FormatCurrency($("#gridTable").getCol('gcamount', false, 'sum')),
                    "ngcweight": FormatCurrency($("#gridTable").getCol('ngcweight', false, 'sum')),
                    "ngcamount": FormatCurrency($("#gridTable").getCol('ngcamount', false, 'sum')),
                    "gcweightfree": FormatCurrency($("#gridTable").getCol('gcweightfree', false, 'sum')),
                    "ljweight": FormatCurrency($("#gridTable").getCol('ljweight', false, 'sum')),
                    "ljamount": FormatCurrency($("#gridTable").getCol('ljamount', false, 'sum')),
                    "nljweight": FormatCurrency($("#gridTable").getCol('nljweight', false, 'sum')),
                    "nljamount": FormatCurrency($("#gridTable").getCol('nljamount', false, 'sum')),
                    "ljweightfree": FormatCurrency($("#gridTable").getCol('ljweightfree', false, 'sum')),
                    "rclweight": FormatCurrency($("#gridTable").getCol('rclweight', false, 'sum')),
                    "rclamount": FormatCurrency($("#gridTable").getCol('rclamount', false, 'sum')),
                    "rclweightfree": FormatCurrency($("#gridTable").getCol('rclweightfree', false, 'sum')),
                    
                });
            }
        });
        //表头合并
        $("#gridTable").jqGrid('setGroupHeaders', {
            useColSpanStyle: true,
            groupHeaders: [
                { startColumnName: 'gcweight', numberOfColumns: 5, titleText: '钢材' },
                { startColumnName: 'ljweight', numberOfColumns: 5, titleText: '配件' },
                { startColumnName: 'rclweight', numberOfColumns: 3, titleText: '热处理' },

            ]
        });
    }

    //加载表格
    function GetGrid2() {
        $("#gridTable2").jqGrid({
            url: "@Url.Content("~/ReportModule/Delivery/SummeryDetailgrid2")",
            datatype: "json",
            height: $(window).height() - 171,
            autowidth: true,
            colModel: [
                     { label: '营业员', name: 'createusername', index: 'createusername', width: 80, align: 'left', sortable: true },
                    { label: '钢种', name: 'steeldescription', index: 'steeldescription', width: 80, align: 'left', sortable: true },
                    { label: '类型', name: 'technology', index: 'technology', width: 80, align: 'left', sortable: true },
                    { label: '重量(吨)', name: 'weight', index: 'weight', width: 60, align: 'left', sortable: true },
                    { label: '金额(万)', name: 'totalamount', index: 'totalamount', width: 60, align: 'left', sortable: true },
                    { label: '区域', name: 'sellarea', index: 'sellarea', width: 60, align: 'left', sortable: true },
            ],
            viewrecords: true,
            rowNum: 9999,
            rowList: [9999, 9999, 9999, 9999, 9999],

            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            footerrow: true,

            gridComplete: function () {
                //合计
                $(this).footerData("set", {
                    "createusername": "合计",
                    "weight": FormatCurrency($("#gridTable2").getCol('weight', false, 'sum')),
                    "totalamount": FormatCurrency($("#gridTable2").getCol('totalamount', false, 'sum')),

                });
            }
        });
    }


    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入

    }
    //查询
    function btn_Search() {
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/ReportModule/Delivery/QuoSummarygrid")?Sellpeople=" + escape($("#Sellpeople").val()) + "&StartTime=" + escape($("#StartTime").val()) + "&EndTime=" + escape($("#EndTime").val()) + "&fullname=" + escape($("#fullname").val()), page: 1 }).trigger('reloadGrid');
        //$("#gridTable2").jqGrid('setGridParam', { url: "@Url.Content("~/ReportModule/Delivery/SummeryDetailgrid2")?Sellpeople=" + escape($("#Sellpeople").val()) + "&CreateUserName=" + escape($("#CreateUserName").val()) + "&StartTime=" + escape($("#StartTime").val()) + "&EndTime=" + escape($("#EndTime").val()) + "&LType=" + escape($("#LType").val()), page: 1 }).trigger('reloadGrid');
    }

</script>

<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">

</div>

<div id="grid_List">
    <div class="bottomline QueryArea" id="QueryParameter" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
        <table border="0" class="form-find" style="height: 45px;">
            <tr>
                <th>创建日期 从：</th>
                <td>
                    <input id="StartTime" type="text" value="@DNS.Utilities.DateTimeHelper.GetToday()" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd'})" style="width: 100px" />至
                    <input id="EndTime" type="text" class="txt Wdate" value="@DNS.Utilities.DateTimeHelper.GetToday()" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd'})" style="width: 100px" />
                </td>

                <th>业务员：</th>
                <td>
                    <input id="Sellpeople" type="text" class="txt" style="width: 100px" />
                </td>
                <th>客户：</th>
                <td>
                    <input id="fullname" type="text" class="txt" style="width: 100px" />
                </td>

                <td>
                    <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
                    <input id="btn_expo2rt" type="button" class="btnSearch" value="导出" onclick="btn_Export1()" />
                    @*<input id="btn_expo3rt" type="button" class="btnSearch" value="营业员导出" onclick="btn_Export2()" />*@
                </td>
                @*<td>
                        <input id="btnEdit" type="button" class="btnSearch" value="编 辑" onclick="btn_Edit()" />
                    </td>*@
            </tr>
        </table>
    </div>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>

