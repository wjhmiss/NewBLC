                    Orderhtml += '                               <td style="border: 1px solid #000; text-align: center;width: 70px;font-size:10px;">签名</td>';
                    Orderhtml += '                               <td style="border: 1px solid #000; text-align: center;width: 100px;font-size:10px;">工艺要求</td>';
                    Orderhtml += '                               <td style="border: 1px solid #000; text-align: center;width: 20px;font-size:10px;">是否委外</td>';
