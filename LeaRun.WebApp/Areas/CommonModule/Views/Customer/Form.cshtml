<script type="text/javascript">
    var KeyValue = GetQuery('KeyValue');//主键

    $(function () {
        getAjax('/CommonModule/Company/ListJson', { ParentId: "0" }, function (data) {
            $("#CompanyName").append($("<option></option>").val("").html("请选择！"));
            var itemjson = eval("(" + data + ")");
            $.each(itemjson, function (i) {
                $("#CompanyName").append($("<option></option>").val(itemjson[i].FullName).html(itemjson[i].FullName));
            });
            Loading(false);
        });
        BindCombobox();
        InitControl();
        window.setTimeout(function () {
            GetGrid();
            GetGrid2();
        }, 300);
        $("#CustomerAddress").css('display', 'none');
        $("#Base_CustomerRequery").css('display', 'none');
        
        $('input').customInput();
    })
    //初始化绑定下拉框
    function BindCombobox() {
        BindDropItem("#Sellpeople", "XSY", "==请选择==");
        //客户分类
        BindDropItem("#Category", "CustomerSort", "==请选择==");
        //运输方式
        BindDropItem("#TransitMode", "TransitMode", "==请选择==");
        //账期
        BindDropItem("#PaymentMode", "PaymentMode", "==请选择==");
        //所在省
        $("#Sellregion").append("<option value=''>==请选择==</option>");
        $("#Sellarea").append("<option value=''>==请选择==</option>");
        AjaxJson("/Utility/GetProvinceCityListJson", { ParentId: 0 }, function (DataJson) {
            $.each(DataJson, function (i) {
                $("#Sellregion").append($("<option Code=" + DataJson[i].Code + "></option>").val(DataJson[i].FullName).html(DataJson[i].FullName));
            });
        })
        //所在市
        $("#Sellregion").change(function () {
            BindCityId();
        });
    }
    //所在市下拉框
    function BindCityId() {
        $("#Sellarea").html("");
        $("#Sellarea").append("<option value=''>==请选择==</option>");
        if (!$("#Sellregion").find("option:selected").attr('Code')) {
            return false;
        }
        AjaxJson("/Utility/GetProvinceCityListJson", { ParentId: $("#Sellregion").find("option:selected").attr('Code') }, function (DataJson) {
            $.each(DataJson, function (i) {
                $("#Sellarea").append($("<option></option>").val(DataJson[i].FullName).html(DataJson[i].FullName));
            });
        })
    }
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/CommonModule/Customer/SetFormForImg", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
                BindCityId();
                $("#Sellarea").val(data.Sellarea);


                $("#imgOrA").html(HtmlUtil.htmlDecode(data.Remark));
                //$("#Code").prop('disabled', true);
                //$("#FullName").prop('disabled', true);

            });
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }

        var RowData = {
            CustomerAddressId: $("[name='CustomerAddressId']").val(),
            AddressCode: $("[name='AddressCode']").val(),
            Application: $("[name='Application']").val(),
            SendPath: $("[name='SendPath']").val(),
            DetailAddress: $("[name='DetailAddress']").val(),
            Contact: $("[name='Contact']").val(),
            Telephone: $("[name='Telephone']").val(),
            Mobile: $("[name='Mobile']").val(),
            Fax: $("[name='Fax']").val(),
            EmailAddress: $("[name='EmailAddress']").val(),
            MainDefault: $("[name='MainDefault']").val(),
        }
        $('#gridTable').jqGrid('setRowData', GetJqGridRowIndx('#gridTable'), RowData, '');
        if ($("#gridTable").getGridParam("reccount") == 0) {
            alertDialog("请添加送货地址，如没有，请填写无！", 0);
            return false;
        }

        var RowData2 = {
            DepartName: $("[name='DepartName']").val(),
            KLRequery: $("[name='KLRequery']").val(),
            XMRequery: $("[name='XMRequery']").val(),
        }
        $('#gridTable2').jqGrid('setRowData', GetJqGridRowIndx('#gridTable2'), RowData2, '');

        var postData = GetWebControlsforCustemar("#form1");
        postData["CustomerAddressListJson"] = JSON.stringify($("#gridTable").jqGrid("getRowData"));
        postData["CustomerRequeryListJson"] = JSON.stringify($("#gridTable2").jqGrid("getRowData"));
        $(".ui_state_highlight").attr("disabled", true);
        AjaxJson("/CommonModule/Customer/SubmitFormCustomer?KeyValue=" + KeyValue, postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            window.setTimeout(function () {closeDialog();}, 500);
        });
    }
    /*客户地址begin=================================*/
    //加载表格
        var lastsel;
    function GetGrid() {
        var lastselpostdate;
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/CommonModule/Customer/CustomerAddressListJson")?CustomerId=" + KeyValue,
            datatype: "json",
            height: 250,
            width: 489,
            autowidth: true,
            colModel: [
                { label: '主键', name: 'CustomerAddressId', hidden: true },
                { label: "地址编码", name: "AddressCode", width: 50, editable: true, hidden: true },
                { label: "部门", name: "Application", width: 70, align: 'center', editable: true},//收货地址:收货地址;
                { label: "送货路线", name: "SendPath", width: 50, align: 'center', editable: true, edittype: 'select', editoptions: { value: "自提:自提;塔峙:塔峙;霞浦/清水:霞浦/清水;春晓:春晓;大矸:大矸;大港:大港;镇海:镇海;模具园区:模具园区;金华:金华;市区:市区;市外:市外" } },
                { label: "详细地址", name: "DetailAddress", width: 230, editable: true },
                { label: '联系人', name: 'Contact', width: 60, align: 'center', editable: true },
                { label: '电话', name: 'Telephone', width: 90, align: 'center', editable: true },
                { label: '手机', name: 'Mobile', width: 90, align: 'center', editable: true },
                { label: '传真', name: 'Fax', width: 90, align: 'center', editable: true, hidden: true },
                { label: '电子邮件', name: 'EmailAddress', width: 90, align: 'center', editable: true, hidden: true },
                {
                    label: '主要', name: 'MainDefault', width: 45, align: 'center', editable: true, edittype: 'select', editoptions: { value: "是:是;否:否" }
                },
            ],
            pager: false,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            rownumbers: true,
            onSelectRow: function (id) {
                var postData = {
                    CustomerAddressId: $("[name='CustomerAddressId']").val(),
                    AddressCode: $("[name='AddressCode']").val(),
                    Application: $("[name='Application']").val(),
                    SendPath: $("[name='SendPath']").val(),
                    DetailAddress: $("[name='DetailAddress']").val(),
                    Contact: $("[name='Contact']").val(),
                    Telephone: $("[name='Telephone']").val(),
                    Mobile: $("[name='Mobile']").val(),
                    Fax: $("[name='Fax']").val(),
                    EmailAddress: $("[name='EmailAddress']").val(),
                    MainDefault: $("[name='MainDefault']").val(),
                }
                if (id && id !== lastsel) {
                    $('#gridTable').jqGrid('restoreRow', lastsel);
                    $('#gridTable').jqGrid('editRow', id, true);
                    $('#gridTable').jqGrid('setRowData', lastsel, postData, '');
                }
                lastselpostdate = postData;
                lastsel = id;
            }
        });
        //新增一行
        $("#lr-add-Row").click(function () {
            var index = $("#gridTable").getGridParam("reccount") + 1;
            var rowdata = {
                CustomerAddressId: '',
                AddressCode: '',
                Application: '',
                SendPath: '',
                DetailAddress: '',
                Contact: '',
                Telephone: '',
                Mobile: '',
                Fax: '',
                EmailAddress: '',
                MainDefault: '',
            }
            $('#gridTable').jqGrid('restoreRow', index);
            $('#gridTable').jqGrid('addRowData', index, rowdata, "last");
            $("#gridTable").setSelection(index);

        });
        //删除
        $("#lr-delete-Row").click(function () {
            var Index = GetJqGridRowIndx("#gridTable");
            $("#gridTable").jqGrid("delRowData", Index);
        });
    }
    /*客户地址end===================================*/

    function GetGrid2() {
        var lastsel2;
        var lastselpostdate2;
        $("#gridTable2").jqGrid({
            url: "@Url.Content("~/CommonModule/Customer/CustomerRequeryListJson")?CustomerId=" + KeyValue,
