                        //QuotationDetail[i].Weigh = values[1];
                        //QuotationDetail[i].Thick = values[2];
                    }

                    var size = "";
                    if (QuotationDetail[i].Length > 0) {
                        if (parseFloat(QuotationDetail[i].Weigh) <= 0) {
                            var BoreSize = "";
