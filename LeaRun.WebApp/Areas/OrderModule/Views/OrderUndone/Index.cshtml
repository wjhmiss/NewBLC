@{
    ViewBag.Title = "订单未完工列表";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    //查询
    function btn_Search() {
        var Condition = GetParameterJson("QueryParameter");
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/OrderModule/OrderUndone/GridPageListJson")?Condition=" + escape(Condition), page: 1 }).trigger('reloadGrid');
    }
    //加载订单表格
    function GetGrid() {
        var SelectRowIndx = 1;
        var Condition = GetParameterJson("QueryParameter");
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/OrderModule/OrderUndone/GridPageListJson")?Condition=" + escape(Condition),
            datatype: "json",
            height: $(window).height() - 103,
            autowidth: true,
            colModel: [
                    { label: '订单单号', name: 'ordercode', index: 'ordercode', width: 100, align: 'left', sortable: true },
                    { label: '行号', name: 'linecode', index: 'linecode', width: 50, align: 'center', sortable: true },
                    { label: '板件编码', name: 'boardid', index: 'boardid', width: 50, align: 'left', sortable: true },
                    { label: '板件描述', name: 'boarddescription', index: 'boarddescription', width: 100, align: 'left', sortable: true },
                    { label: "钢材编码", name: "steelcode", index: "steelcode", width: 50 },
                    { label: "钢材名称", name: "steeldescription", index: "steeldescription", width: 50 },
                    { label: "钢材状态", name: "steelstate", index: "steelstate", width: 50, align: "center" },
                    { label: '数量', name: 'qty', index: 'qty', width: 50, align: 'right', sortable: true },
                    { label: '厚度', name: 'thick', index: 'thick', width: 50, align: 'right', sortable: true },
                    { label: '宽度', name: 'weigh', index: 'weigh', width: 50, align: 'right', sortable: true },
                    { label: '长度', name: 'length', index: 'length', width: 50, align: 'right', sortable: true },
                    { label: '理论重量', name: 'weight', index: 'weight', width: 50, align: 'right', sortable: true },
                    {
                        label: '列印时间', name: 'printdate', index: 'printdate', width: 110, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    { label: '订单状态', name: 'billstatus', index: 'billstatus', width: 80, align: 'center', sortable: true }
            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'PrintDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            onSelectRow: function () {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
            },
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
            }
        });
    }
    //导出Excel
    function btn_Export() {
        SetDeriveExcel("#gridTable", "未销订单");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);

    }
</script>
<div class="leftline rightline topline QueryArea" style="margin: 1px; margin-bottom: 0px;">
    <table id="QueryParameter" border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>订单单号：</th>
            <td>
                <input id="OrderCode" type="text" class="txt" style="width: 120px" />
            </td>
            <th>列印日期 ：</th>
            <td>
                <input id="PrintDate_StartTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 00:00'})" style="width: 120px" />
            </td>
            <td>至&nbsp;&nbsp;
                <input id="PrintDate_EndTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 23:59'})" style="width: 120px" />
            </td>
            <td>&nbsp;&nbsp;&nbsp;
                <input id="btnSearch" type="button" class="btnSearch" value="查 询" onclick="btn_Search()" />
                &nbsp;&nbsp;&nbsp;
                <input id="btn_export" type="button" class="btnSearch" value="导 出" onclick="btn_Export()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
