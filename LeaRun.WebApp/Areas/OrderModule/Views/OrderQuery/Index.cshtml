                { label: "加工类型", name: "ordertype", index: "ordertype", width: 50, align: "center" },


                {
                    label: "规格(厚宽长)", name: "thick", index: "thick", width: 170,
                    formatter: function (cellvalue, options, rowobject) {
                        if (!!rowobject.weigh) {
                            return parseFloat(rowobject.length) + "*" + parseFloat(rowobject.weigh) + "*" + parseFloat(rowobject.thick);
                        }
                        else {
                            var BoreSize = "";
                            if (!!rowobject.boresize) {
                                BoreSize = "xΦ" + rowobject.boresize;
                            }
                            return "Φ" + parseFloat(rowobject.thick) + BoreSize + "*" + parseFloat(rowobject.length);
                        }
                    }
                },
                { label: "模号", name: "customerproduct", index: "customerproduct", width: 180 },


                { label: "件数", name: "qty", index: "qty", width: 50, align: "right" },
                { label: "理重", name: "weight", index: "weight", width: 50, align: "right" },
                { label: "完工件数", name: "completeqty", index: "completeqty", width: 50, align: "right" },
                { label: "出货件数", name: "deliveryqty", index: "deliveryqty", width: 50, align: "right" },
                { label: '当前状态', name: 'billstatus1', index: 'billstatus', width: 60, align: 'center', sortable: true, hidden: true },
                { label: "交期", name: "delivery", index: "delivery", width: 80, align: "right" },

                {
                    label: "订单状态", name: "billstatus", index: "billstatus", width: 60, align: "center",
                    formatter: function (cellvalue, options, rowobject) {
                        if (rowobject.billstatus == "正常生产") {
                            return !!rowobject.billstatus1 ? rowobject.billstatus1 : "正在开料";
                        }
                        else {
                            return cellvalue;
                        }
                    }
                },
                {
                    label: "是否委外", name: "isbeout", index: "isbeout", width: 50,
                    formatter: function (cellvalue, options, rowobject) {
                        return cellvalue == 1 ? "<a style='color:red'>是</a>" : "否";
                    }
                },
                { label: "过磅数", name: "oqty", index: "oqty", width: 50, align: "right" },
                { label: "过磅重量", name: "oweight", index: "oweight", width: 50, align: "right" },
                {
                    label: '检查报告', name: 'dingcode', width: 380,
                    formatter: function (cellvalue, options, rowobject) {
                        return "<a  style='color:red;cursor:pointer' onclick='btn_Printlabel2(\"" + rowobject.orderdetailid + "\",\"" + rowobject.dingcode + "\")'>报告</a> " + rowobject.dingcode;
                    }
                },
                { label: '配件号', name: 'projectcode', width: 80 },
                { label: "加工备注", name: "execremark", index: "execremark", width: 180 },
                 {
                     label: '开料说明', name: 'remarkkl', width: 100,
                     formatter: function (cellvalue, options, rowObject) {
                         if (!!cellvalue) {
                             return cellvalue.replace(/,/g, "，");;

                         }
                         return "";
                     }
                 },
                { label: "送货备注", name: "shipdescription", index: "shipdescription", width: 180 },
                { label: "状态变更备注", name: "remark", index: "execremark", width: 180 },
                {
                    label: '特殊工艺', name: '特殊工艺', width: 100,
                    formatter: function (cellvalue, options, rowObject) {
                        var str = "";

                        if (rowObject.liftinghole) {
                            str += "吊孔,";
                        }
                        if (rowObject.cnc) {
                            str += "CNC,";
                        }
                        if (rowObject.ym) {
                            str += "退火后研磨,";
                        }
                        if (rowObject.jq) {
                            str += "锯切";
                        }
                        if (!!str) {
                            return "<a  style='color:red' >" + str + "</a>";
                        }
                        else return "无";
                    }
                },
        { label: '吊孔', name: 'liftinghole', width: 100, hidden: true },
        { label: 'CNC', name: 'cnc', width: 100, hidden: true },
        { label: '退火后研磨', name: 'ym', width: 100, hidden: true },
        { label: '锯切', name: 'jq', width: 100, hidden: true },
            ],
            pager: false,
            rowNum: 1000,
