        //    else {
        //        $("#Remark").select();
        //    }

        //}
        //if (event.keyCode == 40) {//下
        //    if ($(tar).attr('id') == "Weight") {
        //        $("#MaterialPrice").select();
        //    }
        //    else if ($(tar).attr('id') == "MaterialPrice") {
        //        $("#WorkPrice").select();
        //    }
        //    else if ($(tar).attr('id') == "WorkPrice") {
        //        $("#DDCostPer").select();
        //    }
        //    else if ($(tar).attr('id') == "DDCostPer") {
        //        $("#SortCode").select();
        //    }
        //    else if ($(tar).attr('id') == "SortCode") {
        //        $("#SalesAmount").select();
        //    }
        //    else if ($(tar).attr('id') == "SalesAmount") {
        //        $("#ProductName").select();
        //    }
        //    else if ($(tar).attr('id') == "ProductName") {
        //        $("#CustomerProduct").select();
