                <style>
               

    .form-print th {
        font-size: 11pt;
        font-family: Arial;
        font-weight: bold;
        background-color: #fff;
        height: 24.6px;
        line-height:24.6px;
        white-space: nowrap;
        
        text-align: right;
        padding-right: 2px;
    }

    .form-print td {
        font-size: 11pt;
