@{
    ViewBag.Title = "应收款管理";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        setType();
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    function setType() {
        if ($("#Type0").val() == "收款") {
            BindDropItemT2index("#Type1", "#Type2", "收款类型", "==请选择==");

        }
        else {
            BindDropItemT2index("#Type1", "#Type2", "CostType", "==请选择==");
        }
    }
    //加载表格
    function GetGrid() {
        var rowScrod = 0;
        $("#gridTable").jqGrid({
        url: "@Url.Content("~/CheckSheetModule/BY_CheckCompany/GridPageJson1")",
        datatype: "json",
        height: $(window).height() - 149,
        autowidth: true,
        colModel: [

                { label: '选项', name: 'Type0', index: 'Type0', width: 60, align: 'left', sortable: true },
                { label: '选项1', name: 'Type1', index: 'Type1', width: 60, align: 'left', sortable: true },
                { label: '选项2', name: 'Type2', index: 'Type2', width: 60, align: 'left', sortable: true },
                { label: '应收单ID', name: 'CheckCompanyId', index: 'CheckCompanyId', width: 0, align: 'left', sortable: true, hidden: true },
                { label: 'IsAudit', name: 'IsAudit', index: 'IsAudit', width: 0, align: 'left', sortable: true, hidden: true },
                { label: '客户编号', name: 'CustomerCode', index: 'CustomerCode', width: 60, align: 'left', sortable: true, hidden: true },


                { label: '应收单单号', name: 'CheckCompanyCode', index: 'CheckCompanyCode', width: 80, align: 'left',sortable: true  },
                { label: '客户名称', name: 'CustomerName', index: 'CustomerName', width: 100, align: 'left',sortable: true  },
                { label: '应收总金额', name: 'TotalAmount', index: 'TotalAmount', width: 80, align: 'left',sortable: true  },
                { label: '已收金额', name: 'GetedAmount', index: 'GetedAmount', width: 80, align: 'left', sortable: true },
                {
                    label: '剩余金额', name: 'NoAmount', index: 'NoAmount', width: 50, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return (Number(rowObject.TotalAmount) - Number(rowObject.GetedAmount))
                    }
                },
                {
                    label: '备注', name: 'Remark', index: 'Remark', width: 120, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        if (!!cellvalue) {
                            return cellvalue.replace(/,/g, "，");;

                        }
                        return "";
                    }
                },
                {
                    label: '是否开票', name: 'IsInvoice', index: 'IsInvoice', width: 50, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        if (cellvalue == "1") {
                            return "是"
                        }
                        return "否"
                    }
                },
                {
                    label: '是否审核', name: 'IsAudit', index: 'IsAudit', width: 50, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        if (cellvalue == "1") {
                            return "是"
                        }
                        return "否"
                    }
                },

                { label: '收款用户', name: 'CreateUserName', index: 'CreateUserName', width: 80, align: 'left', sortable: true },
                {
                    label: '收款时间', name: 'CreateDate', index: 'CreateDate', width: 100, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd');
                    }
                },

                { label: '联系人', name: 'ContactName', index: 'ContactName', width: 80, align: 'left', sortable: true },
                { label: '联系电话', name: 'ContactTel', index: 'ContactTel', width: 80, align: 'left', sortable: true },
                { label: '传真', name: 'ContactFax', index: 'ContactFax', width: 80, align: 'left', sortable: true },
                { label: '邮箱', name: 'ContactMail', index: 'ContactMail', width: 80, align: 'left', sortable: true },
                { label: '手机', name: 'MobileCode', index: 'MobileCode', width: 80, align: 'left', sortable: true },
                { label: '客户地址', name: 'CustomerAddress', index: 'CustomerAddress', width: 120, align: 'left', sortable: true },
                
                
               
        ],
        viewrecords: true,
        rowNum: 30,
        rowList: [30, 50, 100, 500, 5000],
        pager: "#gridPager",
        sortname: 'CreateDate',
        sortorder: 'desc',
        rownumbers: true,
        shrinkToFit: false,
        gridview: true,
        ondblClickRow: function (rowid, iRow, iCol, e) {
            btn_audit();
        },
        multiselect: true,
        onSelectRow: function (rowid, status) {
            rowScrod = $("#" + rowid).position().top;
        },
        gridComplete: function () {
            //合计
            $(this).footerData("set", {
                "CheckSheetCode": "合计",
                "NoAmount": $("#gridTable").getCol('NoAmount', false, 'sum'),
                "TotalAmount": $("#gridTable").getCol('TotalAmount', false, 'sum'),
                "GetedAmount": $("#gridTable").getCol('GetedAmount', false, 'sum')
            });
            var data = $("#gridTable").jqGrid("getRowData");
            for (var i = 0; i < data.length; i++) {
                var item = i + 1;

               
                if (data[i].IsAudit == "是") {
                    $("#" + item).find('td').css("background-color", "#00AA00");
                }
               
            }
            $(".ui-jqgrid-bdiv").first().scrollTop(rowScrod);
        },
    });
}
    //新增
    function btn_add() {
        var url = "/CheckSheetModule/BY_CheckCompany/Form"
        openDialog(url, "Form", "新增应收款管理", 770, 395, function (iframe) {
            top.frames[iframe].AcceptClick()
        });
    }
    //编辑
    function btn_edit() {
        var IsAudit = GetJqGridRowValue("#gridTable", "IsAudit");
        if (IsAudit == "是") {
            tipDialog("已审核", 3, 0);
            return false;
        }
        var IsInvoice = GetJqGridRowValue("#gridTable", "IsInvoice");
        if (IsInvoice == "是") {
            alertDialog("当前报价单已开票", 0);
            return false;
        }
        var KeyValue = GetJqGridRowValue("#gridTable", "CheckCompanyId");
        if (IsChecked(KeyValue)) {
            var url = "/CheckSheetModule/BY_CheckCompany/Form?KeyValue=" + KeyValue;
            openDialog(url, "Form", "编辑应收款管理", 770, 395, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //删除
    function btn_delete() {
        var selr = jQuery('#gridTable').jqGrid('getGridParam', 'selarrrow');
        var s1 = "";
        if (selr.length) {
            for (var i = 0; i < selr.length; i++) {
                var myrow = jQuery('#gridTable').jqGrid('getRowData', selr[i]);
                if (myrow.IsAudit == "是") {
                    tipDialog("操作失败：部分报价单已审核!", 3, 0);
                    return false;
                }
                if (myrow.GetedAmount  > 0) {
                    tipDialog("操作失败：已收费!", 3, 0);
                    return false;
                }
                

            }
            var KeyValue = GetJqGridRowValue("#gridTable", "CheckCompanyId");
            if (IsDelData(KeyValue)) {
                var delparm = 'KeyValue=' + KeyValue;
                delConfig('/CheckSheetModule/BY_CheckCompany/Delete', delparm, KeyValue.split(",").length);
            }
        }
    }
    //明细
    function btn_detail() {
        var KeyValue = GetJqGridRowValue("#gridTable", "CheckCompanyId");
        if (IsChecked(KeyValue)) {
            var url = "/CheckSheetModule/BY_CheckCompany/Detail?KeyValue=" + KeyValue;
            Dialog(url, "Detail", "应收款管理明细", 820, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入
        
    }
    //审核
    function btn_audit() {
        //var Status = GetJqGridRowValue("#gridTable", "IsAudit");
