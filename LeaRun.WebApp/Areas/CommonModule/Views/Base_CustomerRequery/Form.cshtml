@{
    ViewBag.Title = "Base_CustomerRequery》表单页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    var KeyValue = GetQuery('KeyValue');//主键
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/CommonModule/Base_CustomerRequery/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
            });
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        var postData = GetWebControls("#form1");
        $(".ui_state_highlight").attr("disabled", true);
        AjaxJson("/CommonModule/Base_CustomerRequery/SubmitForm?KeyValue=" + KeyValue, postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            window.setTimeout(function () {closeDialog();}, 500);
        });
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class='formTitle'>CustomerRequeryID：</th>
            <td class='formValue'>
                <input id="CustomerRequeryID" maxlength=50 type="text" class="txt"   />
            </td>
            <th class='formTitle'>客户主键：</th>
            <td class='formValue'>
                <input id="CustomerId" maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>KLRequery：</th>
            <td class='formValue'>
                <input id="KLRequery" maxlength=2000 type="text" class="txt"   />
            </td>
            <th class='formTitle'>XMRequery：</th>
            <td class='formValue'>
                <input id="XMRequery" maxlength=2000 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>DepartName：</th>
            <td class='formValue'>
                <input id="DepartName" maxlength=200 type="text" class="txt"   />
            </td>
            <th class='formTitle'>备注：</th>
            <td class='formValue'>
                <input id="Remark" maxlength=2000 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>有效：</th>
            <td class='formValue'>
                <input id="Enabled" maxlength=10 type="text" class="txt"   />
            </td>
            <th class='formTitle'>排序码：</th>
            <td class='formValue'>
                <input id="SortCode" maxlength=10 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>删除标记：</th>
            <td class='formValue'>
                <input id="DeleteMark" maxlength=10 type="text" class="txt"   />
            </td>
            <th class='formTitle'>创建时间：</th>
            <td class='formValue'>
                <input id="CreateDate" maxlength=23 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>创建用户主键：</th>
            <td class='formValue'>
                <input id="CreateUserId" maxlength=50 type="text" class="txt"   />
            </td>
            <th class='formTitle'>创建用户：</th>
            <td class='formValue'>
                <input id="CreateUserName" maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>修改时间：</th>
            <td class='formValue'>
                <input id="ModifyDate" maxlength=23 type="text" class="txt"   />
            </td>
            <th class='formTitle'>修改用户主键：</th>
            <td class='formValue'>
                <input id="ModifyUserId" maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>修改用户：</th>
            <td class='formValue'>
                <input id="ModifyUserName" maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
    </table>
</form>
