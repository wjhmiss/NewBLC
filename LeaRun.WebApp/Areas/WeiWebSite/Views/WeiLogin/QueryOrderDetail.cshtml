@{
    ViewBag.Title = "仓库";
    Layout = "~/Views/Shared/_LayoutMobile.cshtml";
}
<link href="~/Content/Scripts/Mobile/templates/mobile/css/mobiscroll.custom-2.6.2.min.css" rel="stylesheet" />
<script src="~/Content/Scripts/Mobile/templates/mobile/js/mobiscroll.custom-2.6.2.min.js"></script>
<script type="text/javascript">

    var orderid = GetQuery('orderid');
    var quotationcode = GetQuery('quotationcode');
    $(document).ready(function (e) {
        if (orderid == "") {
            tipDialog("错误：未能获取加工单信息", -1);
            location.href = "@Url.Content("~/WeiWebSite/WeiLogin/QueryOrder")";
            return;
        }

        $.ajax({
            url: "@Url.Content("~/OrderModule/OrderPrint/BCPrintDataJson")?orderid=" + escape(orderid),
            type: "post",
            dataType: "json",
            async: true,
            success: function (data) {
                $("#OrderCode").html(data.OrderEntiy.OrderCode);
                $("#quotationcode").html(quotationcode);
                $("#OrderStatus").html(data.OrderEntiy.OrderStatus);
                $("#CreateDate").html(data.OrderEntiy.CreateDate);
                $.each(data.OrderDetail, function (i) {
                    var html = '<div class="wrap-box"><h2>' + data.OrderDetail[i].SteelCode + '</h2><dl>';
                    html += '<dt>数量</dt><dd>' + data.OrderDetail[i].Qty + '</dd></dl><dl>';
                    html += '<dt>状态</dt><dd>' + data.OrderDetail[i].BillStatus + '</dd></dl><dl>';
                    html += '<dt>厚、宽、长</dt><dd>' + data.OrderDetail[i].Thick + '*' + data.OrderDetail[i].Weigh + '*' + data.OrderDetail[i].Length + '</dd></dl><dl>';
                    html += '<dt>理论重量</dt><dd>' + data.OrderDetail[i].Weight + 'kg</dd></dl><dl>';
                    html += '<dt>公差备注</dt><dd>' + data.OrderDetail[i].ExecRemark + '</dd></dl></div>';
                    $("#listdetail").append(html);
                });

            },
            error: function (data) {
                alert(data.responseText);
            }

        });

    });

    function locationInputQuot() {
        location.href = "@Url.Content("~/WeiWebSite/WeiLogin/QueryOrder")";
    }



</script>
