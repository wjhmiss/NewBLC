                        str += rowObject.JingSteel == 1 ? "精板," : "";
                        str += rowObject.GasCuttingSteel == 1 ? "气割," : "";
                        str += rowObject.LiftingHole == 1 ? "吊孔," : "";
                        str += rowObject.MandXSteel == 1 ? "铣磨," : "";
                        str += rowObject.MorXSteel == 1 ? "磨/铣," : "";
                        str += rowObject.BSteel == 1 ? "铣边," : "";
                        str += rowObject.JBSteel == 1 ? "精铣边," : "";
                        str += rowObject.JKCost == 1 ? "圆锯工费," : "";
                        str += rowObject.JKCost1 == 1 ? "板锯工费," : "";

