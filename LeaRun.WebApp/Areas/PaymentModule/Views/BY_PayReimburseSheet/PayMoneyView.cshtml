@{
    ViewBag.Title = "报价单审核";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script>
    var KeyValue = GetQuery('KeyValue');//主键
    $(function () {

        $("#totalmoneys").val(GetQuery('totalmoneys'));
        $("#CanUseMoney").val(GetQuery('CanUseMoney'));
        $("#Remark").val(GetQuery('Remark'));

    });
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }

        if (!GetQuery('KeyValue') || !GetQuery('type') || !GetQuery('totalmoneys') || !GetQuery('CanUseMoney') || !GetQuery('ids')) {
            alert("无可消金额")
            return false;
        }

        Loading(true, "正在提交数据...");
        $(".ui_state_highlight").attr("disabled", true);
        window.setTimeout(function () {
            AjaxJson("/PaymentModule/BY_PayReimburseSheet/PayMoney?KeyValue=" + GetQuery('KeyValue') + "&ids=" + GetQuery('ids') + "&type=" + GetQuery('type') + "&totalmoneys=" + GetQuery('totalmoneys') + "&CanUseMoney=" + GetQuery('CanUseMoney') + "&Remark=" + escape($("#Remark").val()) + "&zrmoney=" + $("#zrmoney").val() + "&RequiredDate=" + $("#RequiredDate").val(), "", function (data) {
                tipDialog(data.Message, 3, data.Code);
                top.Form.dispalydiv();
                window.setTimeout(function () {closeDialog();}, 500);
            });

        }, 200);
    }

</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class="formTitle">支付金额：
            </th>
            <td class="formValue">
                <input id="totalmoneys" disabled type="text" class="txt"></input>
            </td>
            <th class='formTitle'>预付款金额：</th>
            <td class='formValue'>
                <input id="CanUseMoney" disabled type="text" class="txt"></input>

            </td>


        </tr>
        <tr>
            <th class="formTitle">折让金额：
            </th>
            <td class="formValue">
                <input id="zrmoney" type="text" class="txt" value="0" datacol="yes" err="折让金额" checkexpession="NotNull"></input>
            </td>
            <th class='formTitle'>收款日期：</th>
            <td class='formValue'>
                <input id="RequiredDate" type="text" class="txt Wdate" value="@DNS.Utilities.DateTimeHelper.GetTime()" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd HH:mm:ss'})" datacol="yes" err="收款日期" checkexpession="NotNull"/>
            </td>
        </tr>
        <tr>
            <th class="formTitle">备注：
            </th>
            <td class="formValue" colspan="3">
                <textarea id="Remark" maxlength="200" class="txtArea" rows="4" datacol="yes" err="备注" checkexpession="NotNull" ></textarea>
            </td>
        </tr>

    </table>
</form>

