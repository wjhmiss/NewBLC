@{
    ViewBag.Title = "仓库";
    Layout = "~/Views/Shared/_LayoutMobile.cshtml";
}
<link href="~/Content/Scripts/Mobile/templates/mobile/css/mobiscroll.custom-2.6.2.min.css" rel="stylesheet" />
<script src="~/Content/Scripts/Mobile/templates/mobile/js/mobiscroll.custom-2.6.2.min.js"></script>
<script type="text/javascript">
    $(document).ready(function (e) {
        $("#btnSubmit").click(function () {
            var Delivery_StartTime = $("#Delivery_StartTime").val();
            var Delivery_EndTime = $("#Delivery_EndTime").val();
            var OrderCode = $("#OrderCode").val();
            var QuotationCode = $("#QuotationCode").val();
            var ShortName = $("#ShortName").val();
            var OrderType = $("#OrderType").val();
            var DeliveryCode = $("#DeliveryCode").val();
            location.href = "@Url.Content("~/WeiWebSite/WeiLogin/QueryDelivery")?Delivery_StartTime=" + escape(Delivery_StartTime) + "&Delivery_EndTime=" + escape(Delivery_EndTime) + "&OrderCode=" + escape(OrderCode) + "&QuotationCode=" + escape(QuotationCode) + "&ShortName=" + escape(ShortName) + "&OrderType=" + escape(OrderType) + "&DeliveryCode=" + escape(DeliveryCode);

        });
        //初始化日期选择控件
        var opt = {
            preset: 'date', //日期
            display: 'modal', //显示方式 
            mode: 'scroller', //日期选择模式
            dateFormat: 'yy-mm-dd', // 日期格式
            setText: '确定', //确认按钮名称
            cancelText: '取消',//取消按钮名籍我
            dateOrder: 'yymmdd', //面板中日期排列格式
            dayText: '日', monthText: '月', yearText: '年', //面板中年月日文字
            endYear: new Date().getFullYear() //结束年份
        };
        $("#Delivery_StartTime").mobiscroll(opt).date(opt);
        $("#Delivery_EndTime").mobiscroll(opt).date(opt);

    });

    function locationInputQuot() {
        location.href = "@Url.Content("~/WeiWebSite/WeiLogin/QueryDelivery")";
    }



</script>
<!--分类筛选-->
<div id="categoryPanel" class="panel" data-footer="none">
    <header>
        <a onclick="history.back(-1)" class="backButton">返回</a>
        <h1>发运单条件筛选</h1>
        <a onclick="$.ui.toggleSideMenu()" class="menuButton"></a>
    </header>

    <ul class="category-bar">
        <!--大类-->

        <li>
            <h2><a href="javascript:;" data-ignore="true">创建时间</a></h2>
            <p>
                <!--小类-->
                <div style="display: inline-block; float: left; width: 49%;">
                    <input name="Delivery_StartTime" id="Delivery_StartTime" type="text" value="@DNS.Utilities.DateTimeHelper.GetDate(-7)" readonly="" class="dwtd" disabled="" autocomplete="off">
                </div>
                <div style="display: inline-block; float: left; width: 49%;">
                    <input name="Delivery_EndTime" id="Delivery_EndTime" type="text" value="@DNS.Utilities.DateTimeHelper.GetToday()" readonly="" class="dwtd" disabled="" autocomplete="off">
                </div>

                <!--/小类-->
            </p>
        </li>
         <li>
            <h2><a href="javascript:;" data-ignore="true">发运单号</a></h2>
            <p>
                <input name="DeliveryCode" id="DeliveryCode" type="text" maxlength="50" value="" style="width: 100%;" />

            </p>
        </li>
        <li>
            <h2><a href="javascript:;" data-ignore="true">订单号</a></h2>
            <p>
                <input name="OrderCode" id="OrderCode" type="text" maxlength="50" value="" style="width: 100%;" />

            </p>
        </li>
         <li>
            <h2><a href="javascript:;" data-ignore="true">报价单号</a></h2>
            <p>
                <input name="QuotationCode" id="QuotationCode" type="text" maxlength="50" value="" style="width: 100%;" />

            </p>
        </li>
        <li>
            <h2><a href="javascript:;" data-ignore="true">客户名称</a></h2>
            <p>
                <input name="ShortName" id="ShortName" type="text" maxlength="50" value="" style="width: 100%;" />

            </p>
        </li>
         <li>
            <h2><a href="javascript:;" data-ignore="true">订单类型</a></h2>
            <p>
                <select name="OrderType" id="OrderType" >
                    <option value="">请选择</option>
                    <option value="BJ">精料单</option>
                    <option value="BC">粗料单</option>
                    </select>
            </p>
        </li>
        <div>
            <input id="btnSubmit" name="btnSubmit" type="submit" value="查  询" class="btn orange full" />
        </div>
        <!--/大类-->
    </ul>
</div>
