    <script>
        //初始化
$(function () {
    AjaxJson("/OrderModule/OrderPrint/BCPrintListJsonJYForLab", { OrderId: GetQuery('OrderId'), OrderDetails: GetQuery('ids'), QuotationId: GetQuery('QuotationId'), type: GetQuery('type') }, function (data) {

            // AjaxJson("/OrderModule/OrderPrint/BCPrintListJsonJYForLab", { OrderId: GetQuery('OrderId'), OrderDetails: GetQuery('ids') }, function (data) {
                var OrderEntiy = data.OrderEntiy;
                var OrderDetail = data.OrderDetail;
                var QuotationEntiy = data.QuotationEntiy;
                var Base_Customer = data.Base_Customer;
                var quotitle = "";
                if (QuotationEntiy.CustMaterial == "1") {
                    quotitle = quotitle + "客来料"
                }
                if (QuotationEntiy.FreeBill == "1") {
                    quotitle = quotitle + "免费单"
                }
                if (OrderEntiy.OrderCode.substr(0, 1) == "B") {
                    quotitle = quotitle + "补料单 "
                }
                var printed = ""
                if (OrderEntiy.PrintUserId) {
                    //$("#reprint").show();
                    printed = "";
                }
                var num = 1;
                $.each(OrderDetail, function (i) {
                    var size = "";
                    if (parseFloat(OrderDetail[i].Weigh) <= 0) {
                        var BoreSize = "";
                        if (!!OrderDetail[i].BoreSize) {
                            BoreSize = "*Φ" + OrderDetail[i].BoreSize;
                        }
                        size = "Φ" + parseFloat(OrderDetail[i].Thick) + BoreSize + ' * ' + parseFloat(OrderDetail[i].Length) + " - " + OrderDetail[i].Qty;
                    }
                    else {
                        size = parseFloat(OrderDetail[i].Length) + ' * ' + parseFloat(OrderDetail[i].Weigh) + ' * ' + parseFloat(OrderDetail[i].Thick) + " - " + OrderDetail[i].Qty;
                    }

                    var OrderDetailhtml = '';
                    OrderDetailhtml += '<table border="0" class="form-print" style="border-collapse:collapse;page-break-after:always;width:60mm;height:40mm;border:0px solid #000;">';
                    OrderDetailhtml += '    <tr>';
                    OrderDetailhtml += '        <td colspan="5" align="center" >';

                    OrderDetailhtml += '<div style=" display:inline;"> <div style="float: center;font-size: 14px; font-weight: bold;display:inline;">宁波市北仑机械锻造厂(迅虎)</div></div>';
                    OrderDetailhtml += '        </td>';
                    OrderDetailhtml += '    </tr>';
                    //OrderDetailhtml += '    <tr >';
                    //OrderDetailhtml += '        <td colspan="5" align="center" style="line-height: 20px;" >';
                    //OrderDetailhtml += '            <span style="font-size: 16px;font-weight: bold;">&nbsp;&nbsp;&nbsp;总数:' + data.OrderDetailQty + '(&nbsp;' + num + '/&nbsp;' + OrderDetail.length + ')&nbsp;&nbsp;' + printed + '</span>';
                    ////OrderDetailhtml += '            <span style="font-size: 20px; font-weight: bold;">' + OrderDetail[i].OrderType + '</span><span style="font-size: 16px;font-weight: bold;">&nbsp;&nbsp;' + QuotationEntiy.ShipRoute + '&nbsp;&nbsp;总数' + OrderEntiy.Qty + '&nbsp;&nbsp;(&nbsp;' + num + '/&nbsp;' + OrderDetail.length + ')&nbsp;&nbsp;' + printed + '</span>';
                    //OrderDetailhtml += '        </td>';
                    //OrderDetailhtml += '    </tr>';
                    //OrderDetailhtml += '    <tr style="font-weight: bold;">';
                    //OrderDetailhtml += '        <td align="right" style="white-space:nowrap;">助记码：</td>';
                    //OrderDetailhtml += '        <td style="font-size: 12pt;white-space:nowrap;">' + OrderEntiy.MnemonicCode + ' </td>';
                    //OrderDetailhtml += '        <td align="right" style="white-space:nowrap;">客户：</td>';
                    //OrderDetailhtml += '        <td style="font-size: 12pt;white-space:nowrap;">' + OrderEntiy.CustomerCode + '</td>';
                    //OrderDetailhtml += '        <td style="width:10%;"></td>';
                    //OrderDetailhtml += '    </tr>';

                    //OrderDetailhtml += '    <tr style=" font-weight: bold;">';
                    //OrderDetailhtml += '        <td align="right" style="white-space:nowrap;">钢&nbsp;&nbsp;种：</td>';
                    //OrderDetailhtml += '        <td style="font-size: 10pt;white-space:nowrap;">' + OrderDetail[i].ProductName + '</td>';
                    //OrderDetailhtml += '        <td align="right" style="white-space:nowrap;">代码：</td>';
                    //OrderDetailhtml += '        <td style="font-size: 12pt;white-space:nowrap;">' + OrderDetail[i].SteelCode + '</td>';
                    //OrderDetailhtml += '        <td style="width:10%;"></td>';
                    //OrderDetailhtml += '    </tr>';

                    OrderDetailhtml += '    <tr >';
                    OrderDetailhtml += '        <td colspan="5" style="vertical-align:top;">';
                    OrderDetailhtml += '            <table border="0" class="form-print tb_Order_Detail" style="width: 100%; border: 1px solid #000;border-collapse:collapse;">';
                    //OrderDetailhtml += '                <tr >';
                    //OrderDetailhtml += '                    <td style="border: 1px solid #000;width:15%;" align="center" >序号</td>';
                    //OrderDetailhtml += '                    <td class="topline bottomline rightline" colspan="6" style="width:65%;">长*宽*厚</td>';
                    //OrderDetailhtml += '                    <td class="topline bottomline rightline" style="width:20%;">比重</td>';
                    //OrderDetailhtml += '                </tr>';
                    //OrderDetailhtml += '                <tr  >';
                    //OrderDetailhtml += '                    <td style="border: 1px solid #000;font-size: 12pt;"  align="center" >' + OrderDetail[i].LineCode + '<BR/>&nbsp;</td>';
                    //OrderDetailhtml += '                    <td class="topline bottomline rightline"  style=" font-weight: bold;width:75%;font-size: 14pt;" colspan="6" align="center">' + size + '</td>';
                    //OrderDetailhtml += '                    <td class="topline bottomline rightline"  style=" font-weight: bold;" align="center">' + parseFloat(OrderDetail[i].Weight) + '</td>';
                    //OrderDetailhtml += '                </tr>';
                    OrderDetailhtml += '                <tr>';
                    OrderDetailhtml += '                    <td style="border: 1px solid #000;font-size: 12px;font-weight: bold;width:8mm;" align="center">钢种</td>';
                    OrderDetailhtml += '                    <td class="topline bottomline rightline"  style="border-left:0px solid #000;font-size: 12px;font-weight: bold;text-align:left;" colspan="7" >' + OrderDetail[i].ProductName + '</td>';
                    OrderDetailhtml += '                </tr>';
                    OrderDetailhtml += '                <tr>';
                    OrderDetailhtml += '                    <td style="border: 1px solid #000;font-size: 12px;font-weight: bold;" align="center">尺寸</td>';
                    OrderDetailhtml += '                    <td class="topline bottomline rightline"  style="border-left:0px solid #000;font-size: 12px;font-weight: bold;text-align:left;" colspan="7"  >' + size + '</td>';
                    OrderDetailhtml += '                </tr>';
