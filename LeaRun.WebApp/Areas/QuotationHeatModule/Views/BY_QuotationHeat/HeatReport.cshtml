@{
    ViewBag.Title = "BY_SteelQualityreport》表单页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
@Scripts.Render("~/Content/Scripts/jqgrid/jqgridjquery")
@Styles.Render("~/Content/Scripts/jqgrid/css/jqgridcss")

<link href="~/Content/Scripts/uploadify/uploadify.css" rel="stylesheet" />
<script src="~/Content/Scripts/uploadify/native-uploadify.js?ver=@DateTime.Now.Ticks"></script>
<link href="~/Content/Scripts/imgGreate/00540/kao/css/index.css" rel="stylesheet" />
<script src="~/Content/Scripts/imgGreate/00540/kao/js/ToolTip.js"></script>


<script type="text/javascript">
    var KeyValue = GetQuery('KeyValue');//主键
    $(function () {
        CustomerAutocomplete();
        SteelAutocomplete();
        SteelQualityreportCodeAutocomplete();

        BindDropItem("#Technology", "CraftType", "==请选择==");
        BindDropItem("#PlaceOrigin", "SteelSource", "==请选择==");
        BindDropItem("#Standard", "对应标准", "==请选择==");
        BindDropItem("#ForgingMethod", "冶炼方法", "==请选择==");
        BindDropItem("#DeliveryStatus", "交货状态", "==请选择==");
        BindDropItem("#ProcessingeUse", "加工用途", "==请选择==");

        InitControl();
        window.setTimeout(function () {
            GetGrid();
        }, 200);
        document.onkeydown = enterInput;
    })

    function enterInput() {
        var e = e || window.event || arguments.callee.caller.arguments[0];
        var tar = e.srcElement || e.target;
        if (e && e.keyCode == 13) {//回车
            if ($(tar).attr('id') == "CHStoveCode") {
                $("#TechnologQueryWrite").select();
            }
            else if ($(tar).attr('id') == "TechnologQueryWrite") {
                $("#QYLtimelong").select();
            }
            else if ($(tar).attr('id') == "QYLtimelong") {
                $("#OutCheck").select();
            }
            else if ($(tar).attr('id') == "OutCheck") {
                $("#ProductResult").select();
            }
            else if ($(tar).attr('id') == "ProductResult") {
                $("#Remark1").select();
            }
            else if ($(tar).attr('id') == "Remark1") {
            }
            else  {
                $("#CHStoveCode").select();
            }
        }
    }

    function SteelQualityreportCodeAutocomplete() {
        var $SteelQualityreportCode = $("#SteelQualityreportCode");
        $SteelQualityreportCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("SteelQualityreportCode", function (data) {
            if (!!data.SteelQualityreportCode) {
                $("#SteelQualityreportCode").val(data.SteelQualityreportCode);
            }
        

        });
        //获取数据源
        function DataSource() {
            AjaxJson("/QualityModule/BY_SteelQualityreportT/SetForm1", { SteelQualityreportCode: escape($("#SteelQualityreportCode").val()) }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="SteelQualityreportCode" style="width: 100%;">' + DataJson[i].SteelQualityreportCode + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("SteelQualityreportCode", $SteelQualityreportCode.width() + "px", "280px", html, function (data) {
                    if (!!data.SteelQualityreportCode) {
                        $("#SteelQualityreportCode").val(data.SteelQualityreportCode);
                    }
                    

                }, true);
            });
        }
    }
    function GetGrid() {
        var lastsel;
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/QuotationHeatModule/BY_QuotationHeat/GetListJsonhistory")?QuotationHeatCode=" + $("#QuotationHeatCode").val(),
            datatype: "json",
            height: 100,
            autowidth: true,
            colModel: [
                { label: '内容', name: 'HeatStatus', align: 'center', width: 120, },
                { label: "炉号", name: "StoveNum", align: 'center', width: 100, },
                {
                    label: "开炉时间", name: "SDDateTime", width: 120, align: 'center',
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd hh:mm');
                    }
                },
                { label: '开炉单号', name: 'StoveCode', width: 120, align: 'center', },
            ],
            viewrecords: true,
            rowNum: 999,
            rowList: [999, 999, 999, 999, 999],
            pager: false,
            shrinkToFit: false,
            rownumbers: true,
            altRows: false,
            sortname: 'SDDateTime',
            sortorder: 'asc',
            altclass: 'altclass',
            gridview: true,
            cellsubmit: 'clientArray',
            onSelectRow: function (id) {
                
                lastsel = id;

            },
            gridComplete: function () {
                //合计
            }

        });

    }

        //得到一个对象实体
        function InitControl() {
            if (!!GetQuery('KeyValue')) {
                AjaxJson("/QuotationHeatModule/BY_QuotationHeat/SetForm", { KeyValue: KeyValue }, function (data) {
                    SetWebControls(data);
                    uploadify(data.QuotationHeatCode);
                    var nums = Math.random();
                    var path = "../../Resource/Document/HeatReport/" + data.QuotationHeatCode + ".jpg?" + nums + "";
                    $("#imgtt").attr('src', path);
                });
                $("#CHStoveCode").select();
            }
        }
        function SteelAutocomplete() {
            var $SteelCode = $("#SteelCode");
            $SteelCode.bind("keyup", function (e) {
                if (e.which != 13 && e.which != 40 && e.which != 38) {
                    DataSource();
                }
            }).focus(function () {
                $(this).select();
                //DataSource();
            });
            //上，下键盘回调
            autocompletekeydown("SteelCode", function (data) {
                if (!!data.SteelCode) {
                    $("#SteelId").val(data.SteelId);
                    $("#SteelCode").val(data.SteelCode);
                    $("#SteelName").val(data.SteelName);
                }
            });
            //获取数据源
            function DataSource() {
                AjaxJsonNoMassge("/CommonModule/Steel/GetAutoCompleJson", { keywords: $SteelCode.val(), isBanOrYuan: "", type: 1 }, function (DataJson) {
                    var html = "";
                    $.each(DataJson, function (i) {
                        html += "<tr>";
                        html += '<td id="SteelId" style="display: none;">' + DataJson[i].SteelId + '</td>';
                        html += '<td id="SteelCode" style="width: 40%;">' + DataJson[i].SteelCode + '</td>';
                        html += '<td id="SteelName" style="width: 60%;">' + DataJson[i].SteelName + '</td>';
                        html += '<td id="Density" style="display: none;">' + DataJson[i].Density + '</td>';
                        html += '<td id="SteelType" style="display: none;">' + DataJson[i].SteelType + '</td>';
                        html += '<td id="RepalceMl" style="display: none;">' + DataJson[i].RepalceMl + '</td>';
                        html += "</tr>";
                    });
                    //点击事件回调
                    autocomplete("SteelCode", "150px", "250px", html, function (data) {
                        $("#SteelId").val(data.SteelId);
                        $("#SteelCode").val(data.SteelCode);
                        $("#SteelName").val(data.SteelName);
                    });
                });
            }
        }

        //保存事件
        function AcceptClick() {
            if (!CheckDataValid('#form1')) {
                return false;
            }

            var postData = GetWebControls("#form1");
            postData["SteelListJson"] = JSON.stringify($("#gridTable").jqGrid("getRowData"));
            $(".ui_state_highlight").attr("disabled", true);

            AjaxJson("/QuotationHeatModule/BY_QuotationHeat/SubmitForm2?KeyValue=" + KeyValue, postData, function (data) {
                tipDialog(data.Message, 3, data.Code);
                top.frames[tabiframeId()].windowload();
                window.setTimeout(function () {closeDialog();}, 500);
            });
        }

        //客户编码自动补全
        function CustomerAutocomplete() {
            var $CustomerCode = $("#CustomerCode");
            $CustomerCode.bind("keyup", function (e) {
                if (e.which != 13 && e.which != 40 && e.which != 38) {
                    DataSource();
                }
            }).focus(function () {
                $(this).select();
                DataSource();
            });
            //上，下键盘回调
            autocompletekeydown("CustomerCode", function (data) {
                $("#CustomerId").val(data.CustomerId);
                $("#CustomerCode").val(data.CustomerCode);
                $("#CustomerName").val(data.FullName);

            });
            //获取数据源
            function DataSource() {
                $("#CustomerId").val('');
                AjaxJson("/CommonModule/Customer/GetAutoCompleJson", { keywords: $CustomerCode.val() }, function (DataJson) {
                    var html = "";
                    $.each(DataJson, function (i) {
                        html += "<tr>";
                        html += '<td id="CustomerId" style="display: none;">' + DataJson[i].CustomerId + '</td>';
                        html += '<td id="CustomerCode" style="width: 30%;">' + DataJson[i].Code + '</td>';
                        html += '<td id="FullName" style="width: 70%;">' + DataJson[i].FullName + '</td>';
                        html += '<td id="ShortName" style="display: none;">' + DataJson[i].ShortName + '</td>';
                        html += '<td id="Sellpeople" style="display: none;">' + DataJson[i].Sellpeople + '</td>';
                        html += '<td id="SalesArea" style="display: none;">' + DataJson[i].Sellarea + '</td>';
                        html += '<td id="DiscountRate" style="display: none;">' + DataJson[i].DiscountRate + '</td>';
                        html += '<td id="TransitMode" style="display: none;">' + DataJson[i].TransitMode + '</td>';
                        html += '<td id="PaymentMode" style="display: none;">' + DataJson[i].PaymentMode + '</td>';
                        html += '<td id="Category" style="display: none;">' + DataJson[i].Category + '</td>';
                        html += '<td id="IsInvoice" style="display: none;">' + DataJson[i].IsInvoice + '</td>';

                        html += "</tr>";
                    });
                    //点击事件回调
                    autocomplete("CustomerCode", "300px", "200px", html, function (data) {
                        $("#CustomerId").val(data.CustomerId);
                        $("#CustomerCode").val(data.CustomerCode);
                        $("#CustomerName").val(data.FullName);
                    });

                });
            }
        }




        function uploadify(QuotationHeatCode) {
            // $("#lr-add-Row").uploadify('destroy');
            try {
                if ($("#lr-add-Row").length > 0) { //注意jquery下检查一个元素是否存在必须使用 .length >0 来判断
                    $("#lr-add-Row").uploadify('destroy');
                }
                $("#lr-add-Row").uploadify({
                    uploader: '/Utility/Upload?saveDocument=HeatReport&filenameid=' + QuotationHeatCode,
                    swf: '/Content/Scripts/uploadify/uploadify.swf',
                    buttonText: "上传文件",
                    height: 24,
                    width: 70,
                    onFallback: function () {
                        alert("您未安装FLASH控件，无法上传！请安装FLASH控件后再试。");
                    },
                    onUploadSuccess: function (file, data, response) {
                        ////
                        Loading(true, "正在提交数据...");
                        window.setTimeout(function () {
                            AjaxJson("/QuotationHeatModule/BY_QuotationHeat/Update?BillStatus=" + escape("检验通过") + "&quotationheatids=" + KeyValue, "", function (data) {
                                top.frames[tabiframeId()].windowload();
                                window.setTimeout(function () {closeDialog();}, 500);
                            });
                        }, 200);
                        ////
                        var nums = Math.random();
                        var path = "../../Resource/Document/HeatReport/" + $("#QuotationHeatCode").val() + ".jpg?" + nums + "";
                        $("#imgtt").attr('src', path);
                    }
                });
            } catch (e) {
            }
        }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <div>
        <div style="font-family: 华文楷体; font-size: x-large; height: 40px; line-height: 40px; text-align: center;">
            热处理质量报告
        </div>
    </div>
    <table class="form">
        <tr>
            <th class='formTitle'>生产编号：</th>
            <td class='formValue'>
                <input type="hidden" id="QuotationHeatId" />
                <input id="QuotationHeatCode" maxlength="50" type="text" class="txt" disabled />
            </td>
            <th class='formTitle'>客户名称：</th>
            <td class='formValue'>
                <input id="CustomerName" maxlength="50" type="text" class="txt" datacol="yes" err="客户名称" checkexpession="NotNull" disabled />
            </td>

            <th class='formTitle'>钢材：</th>
            <td class='formValue'>
                <input type="hidden" id="SteelId" />
                <input type="hidden" id="SteelDescription" />
                <input id="SteelCode" maxlength="50" type="text" class="txt" datacol="yes" err="钢材" checkexpession="NotNull" disabled />
            </td>
            <th class='formTitle'>工件名称：</th>
            <td class='formValue'>
                <input id="ProductName" maxlength="50" type="text" class="txt" datacol="yes" err="工件名称" checkexpession="NotNull" disabled />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>外形尺寸：</th>
            <td class='formValue'>
                <input id="Remark" maxlength="50" type="text" class="txt" disabled />
            </td>
            <th class='formTitle'>热处理类型：</th>
            <td class='formValue'>
                <select id="Technology" class="txtselect" datacol="yes" err="热处理类型" checkexpession="NotNull" disabled>
                </select>
            </td>
            <th class='formTitle'>硬度要求：</th>
            <td class='formValue'>
                <input id="TechnologQuery" maxlength="50" type="text" class="txt" disabled />
            </td>
            <th class='formTitle'>数量：</th>
            <td class='formValue'>
                <input id="Qty" maxlength="50" type="text" class="txt" onfocus="IsMoney(this.id);" datacol="yes" err="数量" checkexpession="NotNull" disabled />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>时间：</th>
            <td class='formValue'>
                <input id="CreateDate" maxlength="50" type="text" class="txt" onfocus="IsMoney(this.id);" datacol="yes" err="重量" checkexpession="NotNull" disabled />
            </td>
            <th class='formTitle'>重量：</th>
            <td class='formValue'>
                <input id="Weight" maxlength="50" type="text" class="txt" onfocus="IsMoney(this.id);" datacol="yes" err="重量" checkexpession="NotNull" disabled />
            </td>

        </tr>
        <tr>
            <th class='formTitle'>硬度最大值：</th>
            <td class='formValue'>
                <input id="TechnologQueryMax" maxlength="50" type="text" class="txt" />

            </td>
            <th class='formTitle'>硬度最小值：</th>
            <td class='formValue'>
                <input id="TechnologQueryMin" maxlength="50" type="text" class="txt" />

            </td>
            <th class='formTitle'>硬度均值：</th>
            <td class='formValue'>
                <input id="TechnologQueryWrite" maxlength="50" type="text" class="txt" />

            </td>
            <th class='formTitle'>去应力时长：</th>
            <td class='formValue'>
                <input id="QYLtimelong" maxlength="50" type="text" class="txt" />
            </td>
        </tr>
        <tr>
            
            <th class='formTitle'>外观检测：</th>
            <td class='formValue'>
                <input id="OutCheck" maxlength="50" type="text" class="txt" value="合格" />
            </td>
            <th class='formTitle'>产品判断：</th>
            <td class='formValue'>
                <input id="ProductResult" maxlength="50" type="text" class="txt" value="合格" />
            </td>
            <th class='formTitle'>检验结果：</th>
            <td class='formValue' colspan="3" >
                <input id="Remark1" maxlength="50" type="text" class="txt" value="合格"  />
            </td>
        </tr>
        
    </table>


    <div class="rightline">
        <table id="gridTable"></table>
        <div id="gridPager"></div>
    </div>
    <div class="nui-toolbar leftline rightline">
        <div id="toolbar_a">
            <div id="lr-add-Row" class="nui-toolbar-item ">
                <span class="nui-btn-text">图片导入</span>
            </div>
        </div>
    </div>
    <div>
        <img id="imgtt" style="height: 350px;" />
    </div>
</form>
