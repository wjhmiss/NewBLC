@{
    ViewBag.Title = "BY_QuotationHeatBeout";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    //加载表格
    function GetGrid() {
        $("#gridTable").jqGrid({
        url: "@Url.Content("~/QuotationHeatModule/BY_QuotationHeatBeout/GridPageJson")",
        datatype: "json",
        height: $(window).height() - 179,
        autowidth: true,
        colModel: [
                { label: '类型', name: 'TypeJC', index: 'TypeJC', width: 80, align: 'left', sortable: true },
                { label: '物料id', name: 'QuotationHeatBeoutId', index: 'QuotationHeatBeoutId', hidden: true },
                { label: '物料号', name: 'QuotationHeatBeoutCode', index: 'QuotationHeatBeoutCode', width: 80, align: 'left',sortable: true  },
                { label: '客户ID', name: 'CustomerId', index: 'CustomerId', hidden: true },
                { label: '客户编号', name: 'CustomerCode', index: 'CustomerCode', hidden: true },
                { label: '客户名称', name: 'CustomerName', index: 'CustomerName', width: 80, align: 'left',sortable: true  },
                { label: '总数量', name: 'Qty', index: 'Qty', width: 60, align: 'left', sortable: true },
                { label: '总重量', name: 'Weight', index: 'Weight', width: 60, align: 'left', sortable: true },
                { label: '总金额', name: 'TotalAmount', index: 'TotalAmount', width: 60, align: 'left',sortable: true  },
                { label: '已获金额', name: 'GetedAmount', index: 'GetedAmount', width: 60, align: 'left', sortable: true },
                { label: '备注', name: 'Remark', index: 'Remark', width: 100, align: 'left',sortable: true  },
               
                { label: '对账单单号', name: 'PayCheckSheetCode', index: 'PayCheckSheetCode', width: 80, align: 'left',sortable: true  },
                {
                    label: '确认时间', name: 'ComfirmDate', index: 'ComfirmDate', width: 80, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd');
                    }
                },
                {
                    label: '交期', name: 'Delivery', index: 'Delivery', width: 80, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd');
                    }
                },
                { label: '审核', name: 'Status', index: 'Status', width: 50, align: 'left', sortable: true, hidden: true },
                {
                    label: '创建时间', name: 'CreateDate', index: 'CreateDate', width: 80, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd');
                    }
                },
                { label: '创建用户', name: 'CreateUserName', index: 'CreateUserName', width: 80, align: 'left', sortable: true },
        ],
        viewrecords: true,
        rowNum: 30,
        rowList: [30, 50, 100, 500, 5000],
        pager: "#gridPager",
        sortname: 'QuotationHeatBeoutCode',
        sortorder: 'desc',
        rownumbers: true,
        shrinkToFit: false,
        gridview: true,
        footerrow: true,
        gridComplete: function () {
            var data = $("#gridTable").jqGrid("getRowData");
            for (var i = 0; i < data.length; i++) {
                var item = i + 1;
                if (data[i].Status == "1") {
                    $("#" + item).find('td').css("background-color", "#00AA00");
                }
            }
            $(this).footerData("set", {
                "QuotationHeatBeoutCode": "合计",
                "Qty": FormatCurrency($("#gridTable").getCol('Qty', false, 'sum')),
                "Weight": FormatCurrency($("#gridTable").getCol('Weight', false, 'sum')),
                "TotalAmount": FormatCurrency($("#gridTable").getCol('TotalAmount', false, 'sum')),
                "GetedAmount": FormatCurrency($("#gridTable").getCol('GetedAmount', false, 'sum')),

            });
        },
        ondblClickRow: function (rowid, iRow, iCol, e) {
            btn_edit();
        },
        subGrid: true,
        subGridOptions: {
            "plusicon": "ui-icon-triangle-1-e",
            "minusicon": "ui-icon-triangle-1-s",
            "openicon": "ui-icon-arrowreturn-1-e"
        },
        subGridRowExpanded: function (subgrid_id, row_id) {
            var rowData = $("#gridTable").jqGrid('getRowData', row_id);
            var subgrid_table_id, pager_id;
            subgrid_table_id = subgrid_id + "_t";
            pager_id = "p_" + subgrid_table_id;
            $("#" + subgrid_id).html("<table id='" + subgrid_table_id + "' class='scroll'></table><div id='" + pager_id + "' class='scroll'></div>");
            jQuery("#" + subgrid_table_id).jqGrid({
                url: "@Url.Content("~/QuotationHeatModule/BY_QuotationHeatBeoutDetail/GetListJson1")?QuotationHeatBeoutCode=" + rowData["QuotationHeatBeoutCode"],
                datatype: "json",
                height: $(window).height() - 250,
                width: 189,
                autowidth: true,
                colModel: [
                    { label: '报价单明细ID', name: 'QuotationHeatId', hidden: true },
                { label: '序号', name: 'SortCode', width: 40, align: 'center', hidden: true },
                { label: '生产编号', name: 'QuotationHeatCode', index: 'QuotationHeatCode', width: 60, align: 'left' },
                { label: '客户名称', name: 'CustomerName', index: 'CustomerName', width: 80, align: 'left', sortable: true },
                { label: '材质', name: 'SteelDescription', index: 'SteelDescription', width: 50, align: 'left', sortable: true },
                { label: '工件名称', name: 'ProductName', index: 'ProductName', width: 80, align: 'left', sortable: true },
                { label: '外形尺寸', name: 'Remark', index: 'Remark', width: 100, align: 'left', sortable: true },
                { label: '热处理类别', name: 'Technology', index: 'Technology', width: 60, align: 'left', sortable: true },
                { label: '技术要求', name: 'TechnologQuery', index: 'TechnologQuery', width: 60, align: 'left', sortable: true },
                { label: '件数', name: 'Qty', index: 'Qty', width: 40, align: 'left', sortable: true },
                { label: '重量', name: 'Weight', index: 'Weight', width: 40, align: 'left', sortable: true },
                { label: '单价', name: 'HeatPrice', index: 'HeatPrice', width: 60, align: 'left', sortable: true, editable: true },
                { label: '金额', name: 'HeatAmount', index: 'HeatAmount', width: 60, align: 'left' },
                ],
                viewrecords: true,
                rowNum: 999,
                rowList: [999, 999, 999, 999, 999],
                pager: false,
                shrinkToFit: false,
                rownumbers: true,
                sortname: 'SortCode',
                sortorder: 'asc',
                gridview: true,

            });
        }
    });
}
    function btn_add() {
        var url = "/QuotationHeatModule/BY_QuotationHeatBeout/Form"
        openDialog(url, "Form", "热处理委外申请", 800, 595, function (iframe) {
            top.frames[iframe].AcceptClick();
            windowload();
        });
    }
    //编辑
    function btn_edit() {
        var Status = GetJqGridRowValue("#gridTable", "Status");
        var view = 0;
        if (Status == "是") {
            view = 1;
        }
        if ("@DNS.Utilities.ManageProvider.Provider.Current().UserName" == "超级管理员") {
            view = 0;
        }
        var GetedAmount = GetJqGridRowValue("#gridTable", "GetedAmount");
        if (GetedAmount > 0) {
            alertDialog("当前申请单已收款", 0);
            return false;
        }
        var PayCheckSheetCode = GetJqGridRowValue("#gridTable", "PayCheckSheetCode");
        if (!!PayCheckSheetCode) {
            alertDialog("当前申请单已对账", 0);
            return false;
        }
        var KeyValue = GetJqGridRowValue("#gridTable", "QuotationHeatBeoutId");
        if (IsChecked(KeyValue)) {
            var url = "/QuotationHeatModule/BY_QuotationHeatBeout/Form?KeyValue=" + KeyValue + "&view=" + view;
            if (view == 0) {
                openDialog(url, "Form", "热处理委外申请", 800, 595, function (iframe) {
                    top.frames[iframe].AcceptClick();
                });
            }
            else {
                Dialog(url, "Form", "编辑钢材购买申请", 800, 595, function (iframe) {
                });
            }

        }
    }
    //删除
    function btn_delete() {

        if ("@DNS.Utilities.ManageProvider.Provider.Current().UserName" != "超级管理员") {
            var Status = GetJqGridRowValue("#gridTable", "Status");
            if (Status == "是") {
                alertDialog("当前采购单已审核", 0);
                return false;
            }
        }

        var GetedAmount = GetJqGridRowValue("#gridTable", "GetedAmount");
        if (GetedAmount > 0) {
            alertDialog("当前申请单已收款", 0);
            return false;
        }
        var PayCheckSheetCode = GetJqGridRowValue("#gridTable", "PayCheckSheetCode");
        if (!!PayCheckSheetCode) {
            alertDialog("当前申请单已对账", 0);
            return false;
        }

        var KeyValue = GetJqGridRowValue("#gridTable", "QuotationHeatBeoutId");
        if (IsDelData(KeyValue)) {
            var delparm = 'KeyValue=' + KeyValue;
            delConfig('/QuotationHeatModule/BY_QuotationHeatBeout/Delete1', delparm, KeyValue.split(",").length);
        }
    }

    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入
    }

    function btn_audit() {
        var Status = GetJqGridRowValue("#gridTable", "Status");
        if (Status == "是" && "@DNS.Utilities.ManageProvider.Provider.Current().UserName" != "超级管理员") {
            alertDialog("当前采购单已审核", 0);
            return false;
        }
        var KeyValue = GetJqGridRowValue("#gridTable", "QuotationHeatBeoutId");
        if (IsChecked(KeyValue)) {
            confirmDialog("提示", "确定要审核通过？", function (r) {
                if (r) {
                    Loading(true, "正在提交数据...");
                    window.setTimeout(function () {
                        AjaxJson("/QuotationHeatModule/BY_QuotationHeatBeout/Update?Status=1&QuotationHeatBeoutId=" + KeyValue, "", function (data) {
                            tipDialog(data.Message, 3, data.Code);
                            windowload();
                        });
                    }, 200);
                }
            });
        }
    }

    //查询
    function btn_Search() {


        var tempstatus = "";
        if ($("#Status").prop("checked")) {
            tempstatus = 0;
        }
        if ($("#Status1").prop("checked")) {
            tempstatus = 1;
        }
        if ($("#Status1").prop("checked") && $("#Status").prop("checked")) {
            tempstatus = "";
        }
        var Parameter = [{
            paramName: "Base_SteelDDPerchaseCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR",
            LeftBrace: "("
        }, {
            paramName: "CustomerCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR",
        }, {
            paramName: "MnemonicCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "AND",
            RightBrace: ")"
        }, {
            paramName: "CustomerName",
            paramValue: $("#CustomerName").val(),
            Operation: "Like",
            Logic: "AND"
        }
         , {
             paramName: "Status",
             paramValue: tempstatus,
             Operation: "Equal",
             Logic: "AND"
         }, {
             paramName: "CreateUserName",
             paramValue: $("#CreateUserName").val(),
             Operation: "Like",
             Logic: "AND"
         }
        , {
            paramName: "CreateDate",
            paramValue: !!$("#CreateDate_StartTime").val() ? $("#CreateDate_StartTime").val() + " 00:00:00" : "",
            Operation: "GreaterThan",
            Logic: "AND"
        }, {
            paramName: "CreateDate",
            paramValue: !!$("#CreateDate_EndTime").val() ? $("#CreateDate_EndTime").val() + " 23:59:59" : "",
            Operation: "LessThan",
            Logic: "AND"
        }
        ]

        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/QuotationHeatModule/BY_QuotationHeatBeout/GridPageJson1")?ParameterJson=" + escape(JSON.stringify(Parameter)), page: 1 }).trigger('reloadGrid');
    }

    //function btn_printall() {
    //    var QuotationHeatBeoutId = GetJqGridRowValue("#gridTable", "QuotationHeatBeoutId");
    //    if (IsChecked(QuotationHeatBeoutId)) {
    //        PrintDialog("/OrderModule/Base_SteelDDPerchase/BeOutPrintList?YH=0&QuotationHeatBeoutId=" + QuotationHeatBeoutId, "PrintPage", "打印", 850, 500, function (iframe) {
    //            top.frames[iframe].AcceptClick();
    //        });
    //    }
    //}

    //导出
    function btn_Export() {
        SetDeriveExcel("#gridTable", "钢材购买报表");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }

    function btn_printall1() {
        var QuotationHeatBeoutId = GetJqGridRowValue("#gridTable", "QuotationHeatBeoutId");
        if (IsChecked(QuotationHeatBeoutId)) {
            PrintDialog("/QuotationHeatModule/BY_QuotationHeatBeout/BeOutPrint?perType=A4&QuotationHeatBeoutId=" + QuotationHeatBeoutId, "PrintPage", "打印", 850, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
</script>
<!--工具栏-->
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>关键字：</th>
            <td>
                <input id="keywords" type="text" class="txt" style="width: 200px" />
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
                 <input id="btn_export" type="button" class="btnSearch" value="导 出" onclick="btn_Export()" />
                 <input id="btn_expaaort" type="button" class="btnSearch" value="打印" onclick="btn_printall1()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
