    function filterSpecificCharacters(text) {
        // 转义所有特殊字符
        const regex = /(长|宽|厚|径|孔|密|高|\+|\-|\*|\/|1|2|3|4|5|6|7|8|9|0|\.)/g;
        const matches = text.match(regex);
        return matches ? matches.join('') : '';
    }

    //// 使用示例
    //const inputText = "长度100+宽度50-厚度20*直径30/孔径10.5";
    //const result = filterSpecificCharacters(inputText);
    //console.log(result); // "长100+宽50-厚20*直30/孔10.5"

    function calculateExpression(expression) {
        try {
            if (!expression) {
                return;
            }
            // 只允许数字和基本运算符
            if (!/^[\d+\-*/().\s]+$/.test(expression)) {
                throw new Error('表达式包含非法字符');
            }

            // 使用 Function 构造函数而不是 eval
            return new Function('return ' + expression)();
        } catch (error) {
            console.error('表达式计算错误:', error);
            return 0;
        }
    }

