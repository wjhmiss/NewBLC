                if (Number($("#Thick").val()) % 5 == 0) {
                    $("#AddThick").val(0);
                }
                else {
                    $("#AddThick").val(5 - Number($("#Thick").val()) % 5);
                }
            }
            else {
                if (Number($("#Thick").val()) % 10 == 0) {
                    $("#AddThick").val(0);
                }
                else {
                    $("#AddThick").val(10 - Number($("#Thick").val()) % 10);
                }

