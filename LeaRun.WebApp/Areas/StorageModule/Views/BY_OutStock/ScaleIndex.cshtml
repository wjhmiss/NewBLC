            //    tipDialog("请先！", 3, 0);
            //    return false;
            //}
        //}
        if ($("#BatchCode").val() == "") {
            tipDialog1("请选择批次号！", 2, 0);
            return;
        }
        if ($.trim($("#Weight").val()).replace("&nbsp;", "") == "" || $.trim($("#Weight").val()).replace("&nbsp;", "") == "0" || $.trim($("#Weight").val()).replace("&nbsp;", "") == "0.00") {
            tipDialog1("操作失败：库存为0，请选择其他替代料！", 2, 0);
            return;
