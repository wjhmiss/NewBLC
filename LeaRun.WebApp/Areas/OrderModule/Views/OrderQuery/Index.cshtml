            sortorder: 'asc',
            rownumbers: true,
            shrinkToFit: false,
            autoScroll: true,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            onSelectRow: function () {
                //$("#gridTable").trigger('reloadGrid');
                $("#lr-ModifyOrderStatus").addClass('disabled');
                $("#lr-ModifyQty,#lr-ModifyLineStatus").removeClass('disabled');
