            //订单明细列表
    function GetGridDetail() {
        $("#gridTable_Detail").jqGrid({
            url: "@Url.Content("~/OrderModule/OrderQuery/GridOrderDetailListJson")",
            datatype: "json",
            height: $(window).height() - 374,
            autowidth: true,
            colModel: [
                { label: "主键", name: "orderdetailid", hidden: true },
                { label: "quotationdetailid", name: "quotationdetailid", hidden: true},
                { label: "weightfact", name: "weightfact", hidden: true },
                { label: "行号", name: "linecode", index: "linecode", width: 40 },
                { label: "钢材编码", name: "steelcode", index: "steelcode", width: 50, hidden: true },
                { label: "钢材名称", name: "steeldescription", index: "steeldescription", width: 80 },
                { label: "客户品名", name: "productname", index: "productname", width: 50 },
                { label: "加工类型", name: "ordertype", index: "ordertype", width: 50, align: "center" },

                { label: "长度", name: "length", index: "length", width: 60, align: 'left', sortable: true, hidden: true },
                { label: "宽度", name: "weigh", index: "weigh", width: 60, align: 'left', sortable: true, hidden: true },
                { label: "厚/直径", name: "thick", index: "thick", width: 60, align: 'left', sortable: true, hidden: true },
                {
                    label: "规格(长宽厚)", name: "thick", index: "thick", width: 170,
                    formatter: function (cellvalue, options, rowobject) {
                        if (!!rowobject.weigh) {
                            return parseFloat(rowobject.length) + "*" + parseFloat(rowobject.weigh) + "*" + parseFloat(rowobject.thick);
                        }
                        else {
                            var BoreSize = "";
                            if (!!rowobject.boresize) {
                                BoreSize = "*Φ" + rowobject.boresize;
                            }
                            return "φ" + parseFloat(rowobject.thick) + BoreSize + "*" + parseFloat(rowobject.length);
                        }
                    }
                },


                { label: "件数", name: "qty", index: "qty", width: 50, align: "right" },
                { label: "理重", name: "weight", index: "weight", width: 50, align: "right" },
                { label: "交期", name: "delivery", index: "delivery", width: 80, align: "right" },
                {
                    label: '送货单日期', name: 'createdate1', index: 'createdate1', width: 100, align: 'right', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd');
                    }
                },
                { label: "完工件数", name: "completeqty", index: "completeqty", width: 50, align: "right" },
                { label: "打单件数", name: "printqty", index: "printqty", width: 50, align: "right" },
                { label: '当前状态', name: 'billstatus1', index: 'billstatus', width: 60, align: 'center', sortable: true},

                {
                    label: "订单状态", name: "billstatus", index: "billstatus", width: 60, align: "center",
                    formatter: function (cellvalue, options, rowobject) {
                        if (rowobject.billstatus == "正常生产") {
                            return !!rowobject.billstatus1 ? rowobject.billstatus1 : "正在开料";
                        }
                        else {
                            return cellvalue;
                        }
                    }
                },


                {
                    label: "是否委外", name: "isbeout", index: "isbeout", width: 50,
                    formatter: function (cellvalue, options, rowobject) {
                        return cellvalue == 1 ? "<a style='color:red'>是</a>" : "否";
                    }
                },
                { label: "过磅数", name: "oqty", index: "oqty", width: 50, align: "right", hidden: true },
                { label: "过磅重量", name: "oweight", index: "oweight", width: 50, align: "right", hidden: true },
                { label: "行备注", name: "execremark", index: "execremark", width: 180 },
                { label: "状态变更备注", name: "remark", index: "execremark", width: 180, hidden: true },
                {
                    label: '特殊工艺', name: '特殊工艺', width: 100,
                    formatter: function (cellvalue, options, rowObject) {
                        var str = "";
                        if (rowObject.ischamfer) {
                            str += "倒角,";
                        }
                        if (rowObject.liftinghole) {
                            str += "吊孔,";
                        }
                        if (rowObject.cnc) {
                            str += "CNC,";
                        }
                        if (rowObject.ym) {
                            str += "退火后研磨,";
                        }
                        if (rowObject.jq) {
                            str += "锯切";
                        }
                        if (!!str) {
                            return "<a  style='color:red' >" + str + "</a>";
                        }
                        else return "无";
                    }, hidden: true
                },
                { label: '倒角', name: 'ischamfer', width: 100, hidden: true },
                { label: '吊孔', name: 'liftinghole', width: 100, hidden: true },
                { label: 'CNC', name: 'cnc', width: 100, hidden: true },
                { label: '退火后研磨', name: 'ym', width: 100, hidden: true },
                { label: '锯切', name: 'jq', width: 100, hidden: true },
                {
                    label: '操作', name: '', index: '', width: 80, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        if (!!rowObject.quotationdetailid) {
                            var nums = Math.random();
                            return '<input style="display: inline;"  id="' + options.rowId + 'uploadifyQuodetail" name="uploadify"  type="file" /></div>';
                        }
                        return "";
                    }
                },
                {
                    label: '相关文件', name: 'fang1', index: 'fang1', width: 300, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        if (!!rowObject.quotationdetailid) {
                            return HtmlUtil.htmlDecode(cellvalue);
                        }
                        return "";
                    }
                },
            ],
            pager: false,
            rowNum: 1000,
            sortname: 'LineCode',
            sortorder: 'asc',
            rownumbers: true,
            shrinkToFit: false,
            autoScroll: true,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            onSelectRow: function () {
                //$("#gridTable").trigger('reloadGrid');
                $("#lr-ModifyOrderStatus").addClass('disabled');
                $("#lr-ModifyQty,#lr-ModifyLineStatus").removeClass('disabled');
            },
            //multiselect: true,
            gridComplete: function () {
                var data = $("#gridTable_Detail").jqGrid("getRowData");
                for (var i = 0; i < data.length; i++) {
                    var item = i + 1;
                    uploadifyQuodetail(item, data[i].quotationdetailid);
                    var dB = new Date(data[i].delivery.replace(/-/g, "/"));
                    if (new Date() > Date.parse(dB) && data[i].billstatus != "已发运") {
                        $("#gridTable_Detail").find("#" + item).find('td').css("background-color", "#CC0000");
                    }

                }

            },
            subGrid: true,
            subGridOptions: {
                "plusicon": "ui-icon-triangle-1-e",
                "minusicon": "ui-icon-triangle-1-s",
                "openicon": "ui-icon-arrowreturn-1-e"
            },
            subGridRowExpanded: function (subgrid_id, row_id) {
                var rowData = $("#gridTable_Detail").jqGrid('getRowData', row_id);
                var subgrid_table_id, pager_id;
                subgrid_table_id = subgrid_id + "_t";
                pager_id = "p_" + subgrid_table_id;
                $("#" + subgrid_id).html("<table id='" + subgrid_table_id + "' class='scroll'></table><div id='" + pager_id + "' class='scroll'></div>");
                var Parameter = [{
                    paramName: "quotationdetailid",
                    paramValue: rowData["quotationdetailid"],
                    Operation: "Equal",
                }]
                jQuery("#" + subgrid_table_id).jqGrid({
                    url: "@Url.Content("~/OrderDetailProcessModule/BY_OrderDetailProcess/GridPageJsonForIMG")?ParameterJson=" + escape(JSON.stringify(Parameter)),
                    datatype: "json",
                    height: $(window).height() - 400,
                    width: 189,
                    autowidth: true,
                    colModel: [
                        { label: '工单工序ID', name: 'OrderDetailProcessId', index: 'OrderDetailProcessId', width: 0, align: 'left', sortable: true, hidden: true },
                        { label: '工序', name: 'TechnologyId', index: 'TechnologyId', width: 80, align: 'left', sortable: true },
                        { label: '工序名称', name: 'TechnologyName', index: 'TechnologyName', width: 80, align: 'left', sortable: true },
                        { label: '加工费', name: 'WorkerTotal', index: 'WorkerTotal', width: 80, align: 'left', sortable: true },
                        { label: '总数量', name: 'Qty', index: 'Qty', width: 80, align: 'left', sortable: true },
                        { label: '已加数', name: 'Area', index: 'Area', width: 80, align: 'left', sortable: true },
                        { label: '备注', name: 'Remark', index: 'Remark', width: 180, align: 'left', sortable: true },
                        {
                            label: '操作', name: '', index: '', width: 80, align: 'left', sortable: true,
                            formatter: function (cellvalue, options, rowObject) {
                                if (!!rowObject.OrderDetailProcessId) {
                                    var nums = Math.random();
                                    return '<input style="display: inline;"  id="' + options.rowId + 'uploadify" name="uploadify"  type="file" /></div>';
                                }
                                return "";
                            }
                        },
                        {
                            label: '相关文件', name: 'SteelOtherDescription', index: 'SteelOtherDescription', width: 300, align: 'left', sortable: true,
                            formatter: function (cellvalue, options, rowObject) {
                                if (!!rowObject.OrderDetailProcessId) {
                                    return HtmlUtil.htmlDecode(cellvalue);
                                }
                                return "";
                            }
                        },

                    ],
                    viewrecords: true,
                    rowNum: 999,
                    rowList: [999, 999, 999, 999, 999],
                    pager: false,
                    shrinkToFit: false,
                    rownumbers: true,
                    sortname: 'SortCode',
                    sortorder: 'asc',
                    gridview: true,
                    gridComplete: function () {
                        var data = $("#" + subgrid_table_id).jqGrid("getRowData");
                        for (var i = 0; i < data.length; i++) {
                            var item = i + 1;
                            uploadify(item, data[i].OrderDetailProcessId);
                        }
                    },

                });
            }
        });
        function uploadify(id, OrderDetailProcessId) {
            try {
                if ($("#" + id + "uploadify").length > 0) { //注意jquery下检查一个元素是否存在必须使用 .length >0 来判断
                    $("#" + id + "uploadify").uploadify('destroy');
                }
                $("#" + id + "uploadify").uploadify({
                    uploader: '/Utility/Upload?saveDocument=LJ/' + $("#QuotationCode").val().substring(2, 6) + $("#QuotationCode").val().substring(8) + '/' + OrderDetailProcessId + '&filenameid=' + OrderDetailProcessId,
                    swf: '/Content/Scripts/uploadify/uploadify.swf',
                    buttonText: "上传",
                    height: 24,
                    width: 70,
                    onFallback: function () {
                        alert("您未安装FLASH控件，无法上传！请安装FLASH控件后再试。");
                    },
                    onUploadSuccess: function (file, data, response) {
                        //var DataJson = JSON.parse(data);
                        windowload();
                        //window.location.reload();
                    }
                });
            } catch (e) {
            }
        }
        function uploadifyQuodetail(id, QuotationDetailId) {
            try {
                if ($("#" + id + "uploadifyQuodetail").length > 0) { //注意jquery下检查一个元素是否存在必须使用 .length >0 来判断
                    $("#" + id + "uploadifyQuodetail").uploadify('destroy');
                }
                $("#" + id + "uploadifyQuodetail").uploadify({
                    uploader: '/Utility/Upload?saveDocument=LJ/' + $("#QuotationCode").val().substring(2, 6) + $("#QuotationCode").val().substring(8) + '/' + QuotationDetailId + '&filenameid=' + QuotationDetailId,
                    swf: '/Content/Scripts/uploadify/uploadify.swf',
                    buttonText: "上传",
                    height: 24,
                    width: 70,
                    onFallback: function () {
                        alert("您未安装FLASH控件，无法上传！请安装FLASH控件后再试。");
                    },
                    onUploadSuccess: function (file, data, response) {
                        //var DataJson = JSON.parse(data);
                        windowload();
                        //window.location.reload();
                    }
                });
            } catch (e) {
            }
        }
    }
    function OpearLog(BillId, BillCode) {
        Dialog("/QuotationModule/QuotationQuery/QuotationOpearLog?BillId=" + BillId + "&BillCode=" + BillCode, "QuotationOpearLog", "订单操作记录【" + BillCode + "】", 650, 250);
    }

    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入
        $("#gridTable_Detail").trigger("reloadGrid"); //重新载入
    }
    //整单变更状态
    function btn_ModifyOrderStatus() {
        var OrderId = GetJqGridRowValue("#gridTable", "orderid");
        var OrderStatus = GetJqGridRowValue("#gridTable", "orderstatus");
        if (!OrderStatus || !OrderId) {
            return false;
        }
        if (OrderStatus.indexOf("正常生产") >= 0 || OrderStatus.indexOf("已取消") >= 0 || OrderStatus.indexOf("暂停") >= 0 || OrderStatus.indexOf("已审核") >= 0 || OrderStatus.indexOf("部分暂停") >= 0 || OrderStatus.indexOf("部分取消") >= 0) {
            if (IsChecked(OrderId)) {
                var url = "/OrderModule/OrderStatus/Form?OrderId=" + OrderId + "&BillStatus=" + escape(OrderStatus)
                openDialog(url, "Form", "整单变更状态", 400, 120, function (iframe) {
                    top.frames[iframe].AcceptClick();
                });
            }
        } else {
            tipDialog("当前订单状态不允许变更", 3, 0);
        }
    }
    //修改数量
    function btn_ModifyQty() {
        tipDialog("权限不足！", 3, 0);
        return false;
        var OrderDetailId = GetJqGridRowValue("#gridTable_Detail", "OrderDetailId");
        var BillStatus = GetJqGridRowValue("#gridTable_Detail", "BillStatus");
        var Qty = GetJqGridRowValue("#gridTable_Detail", "Qty");
        var Weight = GetJqGridRowValue("#gridTable_Detail", "Weight");
        if (BillStatus.indexOf("正常生产") >= 0) {
            if (IsChecked(OrderDetailId)) {
                var url = "/OrderModule/OrderStatus/UpdataNumber?OrderDetailId=" + OrderDetailId + "&present=" + escape(Qty) + "&Weight=" + escape(Weight)
                openDialog(url, "Form", "修改数量", 400, 120, function (iframe) {
                    top.frames[iframe].AcceptClick();
                });
            }
        } else {
            tipDialog("只有正常生产状态才允许变更", 3, 0);
        }
    }
    //某行变更状态
    function btn_ModifyLineStatus() {
        var OrderStatus = GetJqGridRowValue("#gridTable_Detail", "billstatus");
        if (!OrderStatus) {
            return false;
        }
        if (OrderStatus.indexOf("发运") >= 0 || OrderStatus.indexOf("完工") >= 0) {
            tipDialog("当前订单状态不允许变更", 3, 0);
            return false;
        }

        var OrderId = GetJqGridRowValue("#gridTable", "orderid");
        var OrderDetailId = GetJqGridRowValue("#gridTable_Detail", "orderdetailid");
        var BillStatus = GetJqGridRowValue("#gridTable_Detail", "billstatus");
        if (IsChecked(OrderDetailId)) {
            var url = "/OrderModule/OrderStatus/OrderDetailStatus?OrderDetailId=" + OrderDetailId + "&BillStatus=" + escape(BillStatus) + "&OrderId=" + OrderId;
            openDialog(url, "Form", "某行变更状态", 400, 120, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }

    }

    function OrderPurchase() {
        var MnemonicCode = GetJqGridRowValue("#gridTable", "mnemoniccode");

        var selr = jQuery('#gridTable_Detail').jqGrid('getGridParam', 'selarrrow');
        var s = "";
        var remark = "";
        if (selr.length) {
            for (var i = 0; i < selr.length; i++) {
                var myrow = jQuery('#gridTable_Detail').jqGrid('getRowData', selr[i]);

                s = s + myrow.orderdetailid + ",";
                remark = myrow.execremark;
            }

            var url = "/OrderModule/BY_OrderDetailBeOut/AllFrom?IsPurchaseOrBeout=Purchase&s=" + s + "&MnemonicCode=" + MnemonicCode + "&remark=" + remark;
            openDialog(url, "Form", "委外加工", 870, 470, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //委外加工
    function OrderBeOut() {
        var MnemonicCode = GetJqGridRowValue("#gridTable", "mnemoniccode");

        var selr = jQuery('#gridTable_Detail').jqGrid('getGridParam', 'selarrrow');
        var s = "";
        var remark = "";
        if (selr.length) {
            for (var i = 0; i < selr.length; i++) {
                var myrow = jQuery('#gridTable_Detail').jqGrid('getRowData', selr[i]);

                s = s + myrow.orderdetailid + ",";
                remark = myrow.execremark;
            }

            var url = "/OrderModule/BY_OrderDetailBeOut/AllFrom?IsPurchaseOrBeout=Beout&s=" + s + "&MnemonicCode=" + MnemonicCode + "&remark=" + remark;
            openDialog(url, "Form", "委外加工", 870, 470, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }

    }

    //精料单打印预览
    function BJPrintPreview() {
        var selr = jQuery('#gridTable_Detail').jqGrid('getGridParam', 'selarrrow');
        var s = "";
        if (selr.length) {
            for (var i = 0; i < selr.length; i++) {
                var myrow = jQuery('#gridTable_Detail').jqGrid('getRowData', selr[i]);
                s = s + myrow.OrderDetailId + ","
            }
            PrintDialog("/OrderModule/OrderPrint/BJPrintPreview?ids=" + s, "PrintPage", "打印", 440, 450, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }

    }
    //精料单打印预览
    function BJPrintPreview2() {
        var selr = jQuery('#gridTable_Detail').jqGrid('getGridParam', 'selarrrow');
        var s = "";
        if (selr.length) {
            for (var i = 0; i < selr.length; i++) {
                var myrow = jQuery('#gridTable_Detail').jqGrid('getRowData', selr[i]);
                s = s + myrow.OrderDetailId + ","
            }
            PrintDialog("/OrderModule/OrderPrint/BCPrintPreview?ids=" + s, "PrintPage", "打印", 850, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }

    }
    //精料单打印预览
    function BJPrintPreview1() {
        var selr = jQuery('#gridTable_Detail').jqGrid('getGridParam', 'selarrrow');
        var s = "";
        if (selr.length) {
            for (var i = 0; i < selr.length; i++) {
                var myrow = jQuery('#gridTable_Detail').jqGrid('getRowData', selr[i]);
                s = s + myrow.OrderDetailId + ","
            }
            PrintDialog("/OrderModule/OrderPrint/BJPrintList?ids=" + s, "PrintPage", "打印", 850, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }

    }
    function btn_tb() {
        var OrderCode = GetJqGridRowValue("#gridTable", "ordercode");
        if (IsChecked(OrderCode)) {
            AjaxJson("/OrderModule/OrderQuery/SetOrderStatus?OrderCode=" + OrderCode, {}, function (data) {
                //tipDialog(data.Message, 3, data.Code);
                windowload();
            })
        }
    }

    function btn_detail() {
        var KeyValue = GetJqGridRowValue("#gridTable", "quotationid");
        if (IsChecked(KeyValue)) {
            AddTabMenu('65590e2c-f46c-41de-8cfb-9be9a6bf74bf', '@Url.Content("~/QuotationModule/QuotationAudit/Detail")?KeyValue=' + KeyValue, '报价单详细', "application_view_detail.png", true, true);
        }
    }
</script>
