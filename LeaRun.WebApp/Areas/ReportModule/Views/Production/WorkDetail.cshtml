                            }
                            else {
                                if (!!rowObject.jx01qty) {
                                    return '0'
                                }
                                return ''
                            }
                        }
                    },

            ],
            viewrecords: true,
            rowNum: 50,
            rowList: [50, 100, 200,500,1000],
            pager: "#gridPager",
            sortname: 'createdate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            gridview: true,
            altRows: true,
            altclass: 'altclass',
            onSelectRow: function () {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
            },
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
                //合计
                //var strred = tempred.trim(';').split(';');
                //for (i = 0; i < strred.length; i++) {
                //    if (strred[i].split(',')[1] != "" && strred[i].split(',')[0] != "") {
                //        this.rows[strred[i].split(',')[1]].cells[strred[i].split(',')[0]].bgColor = "#FF3333";
                //    }
                    
                //}
                //tempred = "";
                var data = $("#gridTable").jqGrid("getRowData");
                var boostr = 0;
                for (var i = 0; i < data.length; i++) {
                    if (data[i].kqty > data[i].k001) {
                        boostr = 1;
                        this.rows[i+1].cells[18].bgColor = "#FF3333";
                    }
                    if (data[i].p001qty > data[i].p001) {
                        boostr = 1;
                        this.rows[i + 1].cells[20].bgColor = "#FF3333";
                    }
                    if (data[i].cx01qty > data[i].cx01) {
                        boostr = 1;
                        this.rows[i + 1].cells[22].bgColor = "#FF3333";
                    }
                    if (data[i].ym01qty > data[i].ym01) {
                        boostr = 1;
                        this.rows[i + 1].cells[24].bgColor = "#FF3333";
                    }
                    if (data[i].j001qty > data[i].j001) {
                        boostr = 1;
                        this.rows[i + 1].cells[26].bgColor = "#FF3333";
                    }
                    if (data[i].d001qty > data[i].d001) {
                        boostr = 1;
                        this.rows[i + 1].cells[28].bgColor = "#FF3333";
                    }
                    if (data[i].dk01qty > data[i].dk01) {
                        boostr = 1;
                        this.rows[i + 1].cells[30].bgColor = "#FF3333";
                    }
                    if (data[i].cncqty > data[i].cnc) {
                        boostr = 1;
                        this.rows[i + 1].cells[32].bgColor = "#FF3333";
                    }
                    if (data[i].ym02qty > data[i].ym02) {
                        boostr = 1;
                        this.rows[i + 1].cells[34].bgColor = "#FF3333";
                    }
                    if (data[i].jx01qty > data[i].jx01) {
                        boostr = 1;
                        this.rows[i + 1].cells[36].bgColor = "#FF3333";
                    }
                    
                    if (!boostr) {
                        //this.rows[i + 1].bgColor = "green";
                        $("#" + (i + 1)).find('td').css("background-color", "#008800");
                    }
                    boostr = 0;
                }
            }
        });
        $("#gridTable").jqGrid('setGroupHeaders', {
            useColSpanStyle: true,
            groupHeaders: [
              { startColumnName: 'kqty', numberOfColumns: 2, titleText: '开料' },
              { startColumnName: 'p001qty', numberOfColumns: 2, titleText: '铣平面' },
              { startColumnName: 'cx01qty', numberOfColumns: 2, titleText: '铣侧面' },
              { startColumnName: 'ym01qty', numberOfColumns: 2, titleText: '研磨' },
              { startColumnName: 'j001qty', numberOfColumns: 2, titleText: '精铣' },
              { startColumnName: 'd001qty', numberOfColumns: 2, titleText: '倒角' },
              { startColumnName: 'dk01qty', numberOfColumns: 2, titleText: '吊孔' },
              { startColumnName: 'cncqty', numberOfColumns: 2, titleText: 'CNC' },
              { startColumnName: 'ym02qty', numberOfColumns: 2, titleText: '退火后研磨' },
              { startColumnName: 'jx01qty', numberOfColumns: 2, titleText: '锯切' },
            ]
        });
