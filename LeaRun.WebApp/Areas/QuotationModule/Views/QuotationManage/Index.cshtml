@{
    ViewBag.Title = "报价单管理";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    //查询
    function btn_Search() {
        var Parameter = [{
            paramName: "QuotationCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "AND"
        },
        {
            paramName: "DeleteMark",
            paramValue: 0,
            Operation: "Equal",
            Logic: "AND"
        }]
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/QuotationModule/QuotationManage/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)), page: 1 }).trigger('reloadGrid');
    }
    //加载表格
    function GetGrid() {
        var SelectRowIndx = 1;
        var Parameter = [{
            paramName: "CheckStatus",
            paramValue: "is",
            Operation: "NotNull"
        }]
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/QuotationModule/QuotationManage/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)),
            datatype: "json",
            height: $(window).height() - 149,
            autowidth: true,
            colModel: [
                    { label: '报价单ID', name: 'QuotationId', hidden: true },
                    { label: 'PauseUserId', name: 'PauseUserId', hidden: true },
                    { label: '类型', name: 'OrderType', index: 'OrderType', width: 50, align: 'center', sortable: true },
                    { label: '报价单号', name: 'QuotationCode', index: 'QuotationCode', width: 95, align: 'left', sortable: true },
                    {
                        label: '单据状态', name: 'BillStatus', index: 'BillStatus', width: 50, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (rowObject.PauseUserId) {
                                return "已暂挂";
                            } else {
                                return cellvalue;
                            }
                        }
                    },
                    { label: '客户编号', name: 'CustomerCode', index: 'CustomerCode', width: 80, align: 'left', sortable: true },
                    { label: '客户名称', name: 'CustomerName', index: 'CustomerName', width: 150, align: 'left', sortable: true },
                    { label: '客户简称', name: 'ShortName', index: 'ShortName', width: 80, align: 'left', sortable: true },
                    { label: '客户PO', name: 'CustomerPO', index: 'CustomerPO', width: 80, align: 'left', sortable: true },
                    {
                        label: '入单日期', name: 'CreateDate', index: 'CreateDate', width: 65, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    {
                        label: '审核日期', name: 'CheckDate', index: 'CheckDate', width: 65, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    { label: '员工姓名', name: 'CreateUserName', index: 'CreateUserName', width: 80, align: 'left', sortable: true },
                    { label: '营业员', name: 'SalesMan', index: 'SalesMan', width: 80, align: 'left', sortable: true }
            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'CreateDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            onSelectRow: function () {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
            },
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
            }
        });
    }
    //暂挂
    function btn_SuspendMode() {
        var KeyValue = GetJqGridRowValue("#gridTable", "QuotationId");
        if (IsChecked(KeyValue)) {
            confirmDialog("提示", "确定要暂挂选中报价单吗？", function (r) {
                if (r) {
                    Loading(true, "正在提交数据...");
                    window.setTimeout(function () {
                        AjaxJson("/QuotationModule/QuotationManage/SubmitSuspendMode?KeyValue=" + KeyValue, { Mode: 1 }, function (data) {
                            tipDialog(data.Message, 3, data.Code);
                            windowload();
                        });
                    }, 200);
                }
            });
        }
    }
    //取消暂挂
    function btn_CancelSuspendMode() {
        var PauseUserId = GetJqGridRowValue("#gridTable", "PauseUserId");
        if (!PauseUserId) {
            alertDialog("操作无效，此报价单未暂挂", 0);
            return false;
        }
        var KeyValue = GetJqGridRowValue("#gridTable", "QuotationId");
        if (IsChecked(KeyValue)) {
            confirmDialog("提示", "确定要取消暂挂选中报价单吗？", function (r) {
                if (r) {
                    Loading(true, "正在提交数据...");
                    window.setTimeout(function () {
                        AjaxJson("/QuotationModule/QuotationManage/SubmitSuspendMode?KeyValue=" + KeyValue, { Mode: 2 }, function (data) {
                            tipDialog(data.Message, 3, data.Code);
                            windowload();
                        });
                    }, 200);
                }
            });
        }
    }
    //取消合同
    function btn_CancelContract() {
        var KeyValue = GetJqGridRowValue("#gridTable", "QuotationId");
        if (IsChecked(KeyValue)) {
            var url = "/QuotationModule/QuotationManage/CloseBills?KeyValue=" + KeyValue
            openDialog(url, "Form", "取消报价单", 350, 140, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入
    }
</script>
<!--工具栏-->
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>报价单号：</th>
            <td>
                <input id="keywords" type="text" class="txt" style="width: 200px" />
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
