@{
    ViewBag.Title = "送货单列印清单";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    //查询
    function btn_Search() {
        var Condition = GetParameterJson("QueryParameter");
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/ReportModule/Delivery/GridPageListJson")?Condition=" + escape(Condition), page: 1 }).trigger('reloadGrid');
    }
    //加载表格
    function GetGrid() {
        var SelectRowIndx = 0;
        var Condition = GetParameterJson("QueryParameter");
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/ReportModule/Delivery/GridPageListJson")?Condition=" + escape(Condition),
            datatype: "json",
            height: $(window).height() - 146,
            autowidth: true,
            colModel: [
                    {
                        label: '落单日期', name: 'placeorderdate', index: 'placeorderdate', width: 65, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd hh:mm');
                        }
                    },
                    { label: '区域', name: 'salesarea', index: 'salesarea', width: 50, align: 'center', sortable: true },
                    { label: '客户编号', name: 'customercode', index: 'customercode', width: 50, align: 'left', sortable: true },
                    { label: '客户名称', name: 'customername', index: 'customername', width: 100, align: 'left', sortable: true },
                    { label: '销售员', name: 'salesman', index: 'salesman', width: 50, align: 'left', sortable: true },
                    { label: '报价单号', name: 'quotationcode', index: 'quotationcode', width: 80, align: 'left', sortable: true },
                    { label: '订单单号', name: 'ordercode', index: 'ordercode', width: 80, align: 'left', sortable: true },
                    { label: '送货单号', name: 'deliverycode', index: 'deliverycode', width: 80, align: 'left', sortable: true },
                    { label: '订单行号', name: 'linecode', index: 'linecode', width: 40, align: 'center', sortable: true },
                    { label: '客户po', name: 'customerpo', index: 'customerpo', width: 50, align: 'left', sortable: true },

                    { label: '模号', name: 'diecode', index: 'diecode', width: 50, align: 'left', sortable: true },

                    { label: '钢种', name: 'steelcode', index: 'steelcode', width: 50, align: 'left', sortable: true },
                    { label: '状态', name: 'steelstate', index: 'steelstate', width: 50, align: 'center', sortable: true },
                    { label: '厚度', name: 'thick', index: 'thick', width: 50, align: 'center', sortable: true },
                    { label: '宽度', name: 'weigh', index: 'weigh', width: 50, align: 'center', sortable: true },
                    { label: '长度', name: 'length', index: 'length', width: 50, align: 'center', sortable: true },
                    { label: '数量', name: 'qty', index: 'qty', width: 40, align: 'center', sortable: true },
                    { label: '重量', name: 'weight', index: 'weight', width: 50, align: 'center', sortable: true },
                    { label: '材料单价', name: 'materialprice', index: 'materialprice', width: 50, align: 'center', sortable: true },
                    { label: '材料费', name: 'materialamount', index: 'materialamount', width: 50, align: 'center', sortable: true },
                    { label: '加工费', name: 'workamount', index: 'workamount', width: 50, align: 'center', sortable: true },
                    { label: '热处理费', name: 'heatamount', index: 'heatamount', width: 50, align: 'center', sortable: true },
                    { label: '送货单金额', name: 'salesamount', index: 'salesamount', width: 50, align: 'center', sortable: true },
                    //{ label: '合计金额', name: 'totalsalesamount', index: 'totalsalesamount', width: 60, align: 'center', sortable: true },
                    {
                        label: '送货单格式', name: 'printtype', index: 'printOne', width: 50, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (cellvalue == "0") {
                                return "格式一";
                            }
                            if (cellvalue == "1") {
                                return "格式二";
                            }
                        }
                    },

                    {
                        label: '送货单创建时间', name: 'deliverydate', index: 'deliverydate', width: 65, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd hh:mm');
                        }
                    },
                    {
                        label: '送货单列印时间', name: 'printdate', index: 'printdate', width: 65, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd hh:mm');
                        }
                    }
            ],
            viewrecords: true,
            rowNum: 99999,
            rowList: [30, 50, 100, 500, 5000],
            //pager: "#gridPager",
            sortname: 'deliverydate',
            sortorder: 'asc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: false,
            altclass: 'altclass',
            gridview: true,
            footerrow: true,
            onSelectRow: function () {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
            },
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
                //合计
                $(this).footerData("set", {
                    "salesarea": "合计",
                    "qty": FormatCurrency($("#gridTable").getCol('qty', false, 'sum')),
                    "materialamount": FormatCurrency($("#gridTable").getCol('materialamount', false, 'sum')),
                    "weight": FormatCurrency($("#gridTable").getCol('weight', false, 'sum')),
                    "workamount": FormatCurrency($("#gridTable").getCol('workamount', false, 'sum')),
                    "heatamount": FormatCurrency($("#gridTable").getCol('heatamount', false, 'sum')),
                    "totalsalesamount": FormatCurrency($("#gridTable").getCol('totalsalesamount', false, 'sum')),
                    "salesamount": FormatCurrency($("#gridTable").getCol('salesamount', false, 'sum'))
                });
            }
        });
    }
    //导出
    function btn_Export() {
        SetDeriveExcel("#gridTable", "送货单列印清单");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }

</script>
<div class="leftline rightline topline QueryArea" style="margin: 1px; margin-bottom: 0px;">
    <table class="form-find" id="QueryParameter" style="height: 45px;">
        <tr>
            <th>创建日期 从：</th>
            <td>
                <input id="CreateDate_StartTime" type="text" value="@DNS.Utilities.DateTimeHelper.FirstDayOfMonth()"  class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd'})" style="width: 120px" /></td>
            <th>客户编号：</th>
            <td>
                <input id="CustomerCode" type="text" class="txt" style="width: 120px" /></td>
            <td>
                <span class="item" style="cursor: pointer;">
                    <input type="checkbox" class="checkbox" name="checkbox" id="WorkTypeA" checked="checked" />
                    <label for="WorkTypeA">不含退数单</label>
                </span>
            </td>
            <th>钢种：</th>
            <td>
                <input id="SteelCode" type="text" class="txt" style="width: 120px" /></td>

            <td rowspan="2">
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" /></td>
            <td rowspan="2">
                <input id="btn_export" type="button" class="btnSearch" value="导 出" onclick="btn_Export()" />
            </td>

        </tr>
        <tr>
            <th>创建日期 至：</th>
            <td>
                <input id="CreateDate_EndTime" type="text" class="txt Wdate" value="@DNS.Utilities.DateTimeHelper.LastDayOfMonth()"  onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd'})" style="width: 120px" />
            </td>
            <td>
                <select id="BillType" class="select" style="width: 80px">
                    <option value="1">加工单号</option>
                    <option value="2">合同编号</option>
                    <option value="3">送货单号</option>
                </select>
            </td>
            <td>
                <input id="OrderCode" type="text" class="txt" style="width: 120px" />
            </td>
            <td>
                <select id="Simple" class="select" style="width: 80px">
                    <option value="1">全部单类</option>
                    <option value="2">粗料单</option>
                    <option value="3">精料单</option>
                    <option value="4">热处理单</option>
                </select>
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
