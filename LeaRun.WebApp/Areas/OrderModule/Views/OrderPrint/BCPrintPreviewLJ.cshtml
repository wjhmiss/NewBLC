                    Orderhtml += '<tr>';
                    Orderhtml += '    <td  style="border: 1px solid #000;font-size: 10pt;text-align: center;" colspan="9">';
                    Orderhtml += '            <div style="float: center; "><div id="barcodeTarget" barcode=' + OrderDetail.OrderCode + "-" + OrderDetail.LineCode + '  class="barcodeTarget"></div></div>';
                    Orderhtml += '    </td>';
