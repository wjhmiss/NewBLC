                        Orderhtml += '        </td>';
                        Orderhtml += '        <td colspan="2"  style="vertical-align:top;">';
                        Orderhtml += '        小计重量：' + totalweightPer.toFixed(2);
                        Orderhtml += '        kg</td>';
                        Orderhtml += '        <td colspan="2"  style="vertical-align:top;">';
                        Orderhtml += '        客户PO：' + QuotationEntiy.CustomerPO;
                        Orderhtml += '        </td>';
                        Orderhtml += '        <td colspan="2"  style="vertical-align:top;">';
                        Orderhtml += '        部门：' + QuotationEntiy.DepartName;
                        Orderhtml += '        </td>';
                        Orderhtml += '    </tr>';
                        Orderhtml += '</table>';
                        mark = "";
                        nu1 = 0;
                        nu2 = 0;
                        Delivery = "";
                        totalper = 0;
                        totalweightPer = 0;
                    }
                    index++;
                });
