    <script type="text/javascript">
        $(document).ready(function (e) {
            if ("@DNS.Utilities.ManageProvider.Provider.Current().ObjectId".indexOf("20178431-3604-46b6-a75b-f7ba13548aed") < 0) {
                tipDialog("错误：无权限！", -1,"return");
                return false;
            }

            var Condition = '{"OrderCode":"","SalesArea":"","CreateDate_StartTime":"","CreateDate_EndTime":"","WorkTypeA":"1","WorkTypeB":"1","WorkTypeC":"","CustomerCode":"","ShortName":"","OrderStatusA":"1","OrderStatusB":"1","OrderStatusC":"1","CancelState":"1","btnSearch":"搜 索","btn_export":"导 出","btn_showcusmerName":"显示客户简称"}';
        $.ajax({
            url: "@Url.Content("~/ReportModule/Production/GridPageListJson")?rows=30&page=1&Condition=" + escape(Condition),
            type: "post",
            dataType: "json",
            async: true,
            success: function (data) {
                $("#list").append("");
                $.each(data.rows, function (i) {
                    var html = ' <tr>';
                    html += '                                <td>' + data.rows[i].ordercode + '</td>';
                    html += '                       <td>' + data.rows[i].linecode + '</td>';
                    html += '                       <td class="numeric">' + data.rows[i].shortname + '</td>';
                    html += '                       <td class="numeric">' + data.rows[i].size + '</td>';
                    html += '                       <td class="numeric">' + data.rows[i].unopenqty + '</td>';
                    html += '                       <td class="numeric">' + data.rows[i].uncompleteqty + '</td>';
                    html += '                       <td class="numeric">' + data.rows[i].billstatus + '</td>';
                    html += '                       <td class="numeric">' + data.rows[i].createdate + '</td>';
                    html += '                       <td class="numeric">' + data.rows[i].delivery + '</td>';
                    html += '                       <td class="numeric">' + data.rows[i].overday + '</td>';
                    html += '                       <td class="numeric">' + data.rows[i].weight + '</td>';
                    html += '                   </tr>';
                    $("#list").append(html);
                });

            },
            error: function (data) {
                alert(data.responseText);
            }

        });

    });

    function locationInputQuot() {
        location.href = "@Url.Content("~/WeiWebSite/WeiLogin/QueryOrder")";
    }



</script>
