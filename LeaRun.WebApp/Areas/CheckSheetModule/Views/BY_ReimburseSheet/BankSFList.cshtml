@{
    ViewBag.Title = "费用申请单";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        BindDropItem("#BankNum", "银行名称", "==请选择==");
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })

    function BankChange(BankNum) {
        if (IsChecked(BankNum)) {

            openDialog("/CheckSheetModule/BY_ReimburseSheet/BankChange?BankNum=" + escape(BankNum), "Qudery", "转账", 550, 160, function (iframe) {
                top.frames[iframe].AcceptClick()
            });
        }
    }

    //加载表格
    function GetGrid() {
        var rowScrod = 0;
        var SelectRowIndx = 0;
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/CheckSheetModule/BY_ReimburseSheet/GridBankList")?BankNum=" + escape($("#BankNum").val()),
            datatype: "json",
            height: $(window).height() - 100,
            autowidth: true,
            colModel: [
                    { label: '银行账户', name: 'fullname', index: 'fullname', width: 120, align: 'left', sortable: true },
                    { label: '已收款', name: 'getmoney', index: 'getmoney', width: 80, align: 'left', sortable: true },
                    { label: '已使用', name: 'usemoney', index: 'usemoney', width: 80, align: 'left', sortable: true },
                    { label: '剩余', name: 'nowmoney', index: 'nowmoney', width: 80, align: 'left', sortable: true },
                    {
                        label: '转账', name: 'orderstatus', index: 'orderstatus', width: 60, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowobject) {
                            return "<a  style='color:red;cursor:pointer' onclick='BankChange(\"" + rowobject.fullname + "\")'>转账</a>";
                        }
                    },
                     {
                         label: '明细', name: 'orderstatus', index: 'orderstatus', width: 60, align: 'center', sortable: true,
                         formatter: function (cellvalue, options, rowobject) {
                             return "<a  style='color:red;cursor:pointer' onclick='btn_Detail(\"" + rowobject.fullname + "\")'>查看</a>";
                         }
                     },
            ],
            viewrecords: true,
            rowNum: 999999,
            rowList: [999999, 999999, 999999, 999999, 999999],
            pager: false,

            rownumbers: true,
            shrinkToFit: false,
            gridview: true,
            footerrow: false,
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);

                $(".ui-jqgrid-bdiv").first().scrollTop(rowScrod);
            },
            onSelectRow: function (rowid, status) {
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
                rowScrod = $("#" + rowid).position().top;

            },
            ondblClickRow: function (rowid, iRow, iCol, e) {
                btn_Detail();
            },

        });
    }

    //查询
    function btn_Search() {

        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/CheckSheetModule/BY_ReimburseSheet/GridBankList")?BankNum=" + escape($("#BankNum").val()) + "&CreateDate_EndTime=" + escape($("#CreateDate_EndTime").val()), page: 1 }).trigger('reloadGrid');
    }


    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入

    }

    function btn_Export() {
        SetDeriveExcel("#gridTable", "应收款明细导出");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }

    function btn_Detail(fullname) {

        var fullname = (!!fullname) ? fullname : GetJqGridRowValue("#gridTable", "fullname");
        if (IsChecked(fullname)) {
            Dialog("/CheckSheetModule/BY_ReimburseSheet/BankDetail?BankNum=" + escape(fullname), "IndexList", "银行明细！", 1150, 600, function (iframe) {
            });
        }
    }
</script>

<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th style="width: 20px;">截止时间：</th>
            <td>
                <input id="CreateDate_EndTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 23:59'})" style="width: 100px" />
            </td>
            <th style="width: 40px;">银行账户：</th>
            <td>
                 <select id="BankNum"  class="select" datacol="yes" err="银行账户" checkexpession="NotNull">
                     <option value="">全部</option>
                 </select>
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜索" onclick="btn_Search()" />
                <input id="btn_export" type="button" class="btnSearch" value="导出" onclick="btn_Export()" />
                <input id="btn_Detail" type="button" class="btnSearch" value="明细" onclick="btn_Detail()" />
            </td>
        </tr>
    </table>
</div>






<div id="layout2" class="layout2">
    <!--左边-->
    <div class="layoutPanel layout-west" style="">
        <div class="btnbartitle">
            <div>
                账务收支明细
            </div>
        </div>
        <div class="topline rightline" style="margin: 1px; margin-top: -1px;">
            <table id="gridTable"></table>
            <div id="gridPager"></div>
        </div>
    </div>
 
</div>
