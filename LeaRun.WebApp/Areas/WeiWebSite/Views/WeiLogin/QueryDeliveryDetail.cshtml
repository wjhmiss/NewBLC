@{
    ViewBag.Title = "仓库";
    Layout = "~/Views/Shared/_LayoutMobile.cshtml";
}
<link href="~/Content/Scripts/Mobile/templates/mobile/css/mobiscroll.custom-2.6.2.min.css" rel="stylesheet" />
<script src="~/Content/Scripts/Mobile/templates/mobile/js/mobiscroll.custom-2.6.2.min.js"></script>
<script type="text/javascript">
    var DeliveryId = GetQuery('DeliveryId');


    $(document).ready(function (e) {
        if (DeliveryId == "") {
            tipDialog("错误：未能获取发运单信息", -1);
            location.href = "@Url.Content("~/WeiWebSite/WeiLogin/QueryOrder")";
            return;
        }
        AjaxJsonNoMassge("/DeliveryModule/BY_Delivery/PrintDataJson", { DeliveryId: DeliveryId }, function (data) {
            var Delivery = data.Delivery;
            var DeliveryDetail = data.DeliveryDetail;
            $("#DeliveryCode").html(Delivery.DeliveryCode);
            $("#OrderCode").html(Delivery.OrderCode);
            $("#QuotationCode").html(Delivery.QuotationCode);
            $("#CustomerName").html(Delivery.CustomerName);
            $("#ContactName").html(Delivery.ContactName);
            $("#MobileCodeContactTel").html(Delivery.MobileCode + "/" + Delivery.ContactTel);
            $("#CustomerAddress").html(Delivery.CustomerAddress);
            $("#Qty").html(data.QtySum);
            $("#Weight").html(data.WeightSum);
            $("#TotalAmount").html(data.MaterialAmountSum);
            $("#CreateDate").html(Delivery.CreateDate);
            $.each(DeliveryDetail, function (i) {
                var html = '<div class="wrap-box"><h2>' + DeliveryDetail[i].SteelCode + '</h2><dl>';
                html += '<dt>金额</dt><dd>' + DeliveryDetail[i].SalesAmount + '</dd></dl><dl>';
                html += '<dt>数量</dt><dd>' + DeliveryDetail[i].Qty + '</dd></dl><dl>';
                html += '<dt>厚、宽、长</dt><dd>' + DeliveryDetail[i].Thick + '*' + DeliveryDetail[i].Weigh + '*' + DeliveryDetail[i].Length + '</dd></dl><dl>';
                html += '<dt>出货重量</dt><dd>' + DeliveryDetail[i].Weight + 'kg</dd></dl><dl>';
                html += '<dt>公差备注</dt><dd>' + DeliveryDetail[i].Remark + '</dd></dl></div>';
                $("#listdetail").append(html);

            });
        });

    });

    function locationInputQuot() {
        location.href = "@Url.Content("~/WeiWebSite/WeiLogin/QueryDelivery")";
    }



</script>
