@{
    ViewBag.Title = "BY_JXReport》明细页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/QualityModule/BY_JXReport/SetForm", { KeyValue: GetQuery('KeyValue') }, function (data) {
                SetWebControls(data);
            });
        }
    }
</script>
<form id="form1" style="margin: 1px">
    <table class="form">
        <tr>
            <th class='formTitle'>JXReportId：</th>
            <td class='formValue'>
                <label id="JXReportId" />
            </td>
            <th class='formTitle'>JXReportCode：</th>
            <td class='formValue'>
                <label id="JXReportCode" />
            </td>
