@{
    ViewBag.Title = "付款管理》明细页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/PaymentModule/BY_PayReimburseSheet/SetForm", { KeyValue: GetQuery('KeyValue') }, function (data) {
                SetWebControls(data);
            });
        }
    }
</script>
<form id="form1" style="margin: 1px">
    <table class="form">
        <tr>
            <th class='formTitle'>申请单ID：</th>
            <td class='formValue'>
                <label id="PayReimburseSheetID" />
            </td>
            <th class='formTitle'>申请单号：</th>
            <td class='formValue'>
                <label id="PayReimburseSheetCode" />
            </td>
            <th class='formTitle'>Code：</th>
            <td class='formValue'>
                <label id="Code" />
            </td>
            <th class='formTitle'>：</th>
            <td class='formValue'>
                <label id="CodeType" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>申请人：</th>
            <td class='formValue'>
                <label id="RequiredMan" />
            </td>
            <th class='formTitle'>申请日期：</th>
            <td class='formValue'>
                <label id="RequiredDate" />
            </td>
            <th class='formTitle'>申请金额：</th>
            <td class='formValue'>
                <label id="RequiredMoney" />
            </td>
            <th class='formTitle'>审核人：</th>
            <td class='formValue'>
                <label id="AuditMan" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>AuditDateTime：</th>
            <td class='formValue'>
                <label id="AuditDateTime" />
            </td>
            <th class='formTitle'>AuditRemark：</th>
            <td class='formValue'>
                <label id="AuditRemark" />
            </td>
            <th class='formTitle'>状态0未审核，1已审核，-1拒绝：</th>
            <td class='formValue'>
                <label id="Status" />
            </td>
            <th class='formTitle'>备注：</th>
            <td class='formValue'>
                <label id="Remark" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>有效：</th>
            <td class='formValue'>
                <label id="Enabled" />
            </td>
            <th class='formTitle'>排序码：</th>
            <td class='formValue'>
                <label id="SortCode" />
            </td>
            <th class='formTitle'>删除标记：</th>
            <td class='formValue'>
                <label id="DeleteMark" />
            </td>
            <th class='formTitle'>创建时间：</th>
            <td class='formValue'>
                <label id="CreateDate" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>创建用户主键：</th>
            <td class='formValue'>
                <label id="CreateUserId" />
            </td>
            <th class='formTitle'>创建用户：</th>
            <td class='formValue'>
                <label id="CreateUserName" />
            </td>
            <th class='formTitle'>修改时间：</th>
            <td class='formValue'>
                <label id="ModifyDate" />
            </td>
            <th class='formTitle'>修改用户主键：</th>
            <td class='formValue'>
                <label id="ModifyUserId" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>修改用户：</th>
            <td class='formValue'>
                <label id="ModifyUserName" />
            </td>
            <th class='formTitle'>供应商ID：</th>
            <td class='formValue'>
                <label id="CustomerId" />
            </td>
            <th class='formTitle'>供应商编号：</th>
            <td class='formValue'>
                <label id="CustomerCode" />
            </td>
            <th class='formTitle'>供应商名称：</th>
            <td class='formValue'>
                <label id="CustomerName" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>助记码：</th>
            <td class='formValue'>
                <label id="MnemonicCode" />
            </td>
            <th class='formTitle'>报价单号：</th>
            <td class='formValue'>
                <label id="QuotationCode" />
            </td>
            <th class='formTitle'>折让：</th>
            <td class='formValue'>
                <label id="ZRMoney" />
            </td>
            <th class='formTitle'>实收：</th>
            <td class='formValue'>
                <label id="GETMoney" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>还未收到：</th>
            <td class='formValue'>
                <label id="NotGetMoney" />
            </td>
            <th class='formTitle'>现金,支票，承兑：</th>
            <td class='formValue'>
                <label id="GetType" />
            </td>
            <th class='formTitle'>预收款，现金应收款：</th>
            <td class='formValue'>
                <label id="Opions" />
            </td>
            <th class='formTitle'>可用金额：</th>
            <td class='formValue'>
                <label id="CanUseMoney" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>应付：</th>
            <td class='formValue'>
                <label id="TotalAmount" />
            </td>
            <th class='formTitle'>InvoiceNum：</th>
            <td class='formValue'>
                <label id="InvoiceNum" />
            </td>
        </tr>
    </table>
</form>
