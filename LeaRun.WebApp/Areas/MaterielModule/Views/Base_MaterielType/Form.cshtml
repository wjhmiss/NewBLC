@{
    ViewBag.Title = "物料种类》表单页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    var KeyValue = GetQuery('KeyValue');//主键
    $(function () {
        //客户编码自动补全
        CustomerAutocomplete();
        //类型
        BindDropItem("#MaterielType", "MaterielType", "==请选择==");
        InitControl();
        document.onkeydown = enterInput;
    })
    function enterInput() {
        var e = e || window.event || arguments.callee.caller.arguments[0];
        var tar = e.srcElement || e.target;
        if (e && e.keyCode == 13) {//回车
            window.event.keyCode = 9;
            if ($(tar).attr('id') == "Remark") {
                AcceptClick();
            }
            return;
        }
    }
    function CustomerAutocomplete() {
        var $CustomerCode = $("#CustomerCode");
        $CustomerCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("CustomerCode", function (data) {
            $("#CustomerId").val(data.CustomerId);
            $("#CustomerCode").val(data.CustomerCode);
            $("#CustomerName").val(data.FullName);
        });
        //获取数据源
        function DataSource() {
            AjaxJson("/CommonModule/Base_Supplier/GetAutoCompleJson", { keywords: $CustomerCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="CustomerId" style="display: none;">' + DataJson[i].SupplierId + '</td>';
                    html += '<td id="CustomerCode" style="width: 30%;">' + DataJson[i].Code + '</td>';
                    html += '<td id="FullName" style="width: 70%;">' + DataJson[i].FullName + '</td>';
                    html += '<td id="ShortName" style="display: none;">' + DataJson[i].ShortName + '</td>';
                    html += '<td id="Sellpeople" style="display: none;">' + DataJson[i].Sellpeople + '</td>';
                    html += '<td id="SalesArea" style="display: none;">' + DataJson[i].Sellarea + '</td>';
                    html += '<td id="DiscountRate" style="display: none;">' + DataJson[i].DiscountRate + '</td>';
                    html += '<td id="TransitMode" style="display: none;">' + DataJson[i].TransitMode + '</td>';
                    html += '<td id="PaymentMode" style="display: none;">' + DataJson[i].PaymentMode + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("CustomerCode", "300px", "200px", html, function (data) {
                    $("#CustomerId").val(data.CustomerId);
                    $("#CustomerCode").val(data.CustomerCode);
                    $("#CustomerName").val(data.FullName);
                });
            });
        }
    }

    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/MaterielModule/Base_MaterielType/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
            });
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        $(".ui_state_highlight").attr("disabled", true);
        var postData = GetWebControls("#form1");
        AjaxJson("/MaterielModule/Base_MaterielType/SubmitForm?KeyValue=" + KeyValue, postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            if (!!GetQuery('KeyValue')) {
                top.frames[tabiframeId()].windowload();
                window.setTimeout(function () {closeDialog();}, 500);
            }
            else {
                top.frames[tabiframeId()].windowload();
                location.href = location.href;
            }
            
            //window.setTimeout(function () {closeDialog();}, 500);
        });
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            
            <th class='formTitle'>物料号：</th>
            <td class='formValue'>
                <input id="MaterielCode" maxlength=50 type="text" class="txt"  datacol="yes" err="物料号" checkexpession="NotNull"  />
            </td>
            <th class='formTitle'>物料名称：</th>
            <td class='formValue'>
                <input id="MaterielName" maxlength=50 type="text" class="txt" datacol="yes" err="物料名称" checkexpession="NotNull"  />
            </td>
            
            
        </tr>
        <tr>
            <th class='formTitle'>物料类型：</th>
            <td class='formValue'>
                 <select id="MaterielType"  class="txtselect" datacol="yes" err="加工类型" checkexpession="NotNull">
                        </select>
            </td>
            <th class='formTitle'>尺寸：</th>
            <td class='formValue'>
                <input id="MaterielSize" maxlength=50 type="text" class="txt"   />
            </td>
            
            
        </tr>
        <tr>
            <th class='formTitle'>供应商编号：</th>
            <td class='formValue'>
                <input id="CustomerId" type="hidden"  />
                <input id="CustomerCode" maxlength=50 type="text" class="txt" datacol="yes" err="客户编号" checkexpession="NotNull"   />
            </td>
            <th class='formTitle'>供应商名称：</th>
            <td class='formValue'>
                <input id="CustomerName" disabled maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>单价：</th>
            <td class='formValue'>
                <input id="PricePer" onfocus="IsMoney(this.id);" maxlength=18 type="text" class="txt" datacol="yes" err="单价" checkexpession="NotNull"  />
            </td>
            <th class='formTitle'>单位：</th>
            <td class='formValue'>
                <input id="Unit" maxlength=50 type="text" class="txt" datacol="yes" err="单位" checkexpession="NotNull"  />
            </td>
           
        </tr>
        <tr>
             <th class='formTitle'>报警库存：</th>
            <td class='formValue' colspan="3">
                <input id="AlarmNumber" maxlength=10 type="text" class="txt"  onfocus="IsMoney(this.id);" value="0" />
            </td>

        </tr>
        <tr>
            <th class='formTitle'>备注：</th>
            
             <td class="formValue" colspan="3">
                    <textarea id="Remark" class="txtArea" rows="15">无</textarea>
                </td>
        </tr>
       
    </table>
</form>
