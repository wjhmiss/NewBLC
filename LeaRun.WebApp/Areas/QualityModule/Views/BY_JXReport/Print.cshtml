        height: 40px; line-height: 40px;
        white-space: nowrap;
        width: 80px; 
        text-align: right;
        padding-right: 2px;
    }

    .form-print td {
        font-family: sans-serif;
        height: 40px;
        line-height: 40px;
        padding-right: 2px;
        font-size: 12pt;
    }

    .tb_Order_Detail td {
