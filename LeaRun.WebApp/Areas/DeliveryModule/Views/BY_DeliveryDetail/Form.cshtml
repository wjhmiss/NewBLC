    var KeyValue = GetQuery('KeyValue');
    var customerid = GetQuery('customerid');
    
    var Calc = 0;
    var Qty = 0;
    var count = 0;
    $(function () {
        document.onkeydown = enterInput;
        $("#WriteDate").val('@DateTime.Now.ToString("yyyy-MM-dd")');
        InitControl();
    })
