@{
    ViewBag.Title = "订单出仓查询";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
            btn_Search();
        }, 200);
        SteelAutocomplete();
    })
    //加载表格
    function GetGrid() {
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/StorageModule/BY_OutStock/GridPageListJson")?StartTime=" + $("#StartTime").val() + "&EndTime=" + $("#EndTime").val() + "&SteelCode=" + escape($("#SteelCode").val()) + "&BatchCode=" + $("#BatchCode").val(),
            datatype: "json",
            height: $(window).height() - 125,
            autowidth: true,
            colModel: [
                    { label: '出库单ID', name: 'outstockid', index: 'outstockid', width: 0, align: 'left', sortable: true, hidden: true },
                    { label: '订单号', name: 'ordercode', index: 'ordercode', width: 90, align: 'left', sortable: true },
                    { label: '行号', name: 'linecode', index: 'linecode', width: 50, align: 'left', sortable: true },
                    { label: '钢种', name: 'steelcode', index: 'steelcode', width: 50, align: 'left', sortable: true },
                    { label: '数量', name: 'qty', index: 'qty', width: 40, align: 'left', sortable: true },
                    { label: '厚/直径', name: 'thick', index: 'thick', width: 50, align: 'left', sortable: true },
                    { label: '宽度', name: 'weigh', index: 'weigh', width: 50, align: 'left', sortable: true },
                { label: '长度', name: 'length', index: 'length', width: 50, align: 'left', sortable: true },

                    { label: '理论重量', name: 'theoryweight', index: 'theoryweight', width: 50, align: 'left', sortable: true },
                    { label: '钢材编号', name: 'billcode', index: 'billcode', width: 60, align: 'left', sortable: true },
                    { label: '状态', name: 'steelstate', index: 'steelstate', width: 50, align: 'left', sortable: true },
                    { label: '销数重量', name: 'weight', index: 'weight', width: 50, align: 'left', sortable: true },
                    { label: '销数人', name: 'createusername', index: 'createusername', width: 80, align: 'left', sortable: true },
                    {
                        label: '销数时间', name: 'createdate', index: 'createdate', width: 65, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    {
                        label: '出库类型', name: 'outstocktype', index: 'outstocktype', width: 60, align: 'left', sortable: true
                    }

            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'createdate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
        });
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入

    }
    //查询
    function btn_Search() {
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/StorageModule/BY_OutStock/GridPageListJson")?StartTime=" + $("#StartTime").val() + "&EndTime=" + $("#EndTime").val() + "&SteelCode=" + escape($("#SteelCode").val()) + "&BillCode=" + $("#BillCode").val() + "&BatchCode=" + $("#BatchCode").val(), page: 1 }).trigger('reloadGrid');
    }
    //导出
    function btn_Export() {
        SetDeriveExcel("#gridTable", "订单出库信息");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }
    //钢材编码自动补全
    function SteelAutocomplete() {
        var $SteelCode = $("#SteelCode");
        $SteelCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("SteelCode", function (data) {
            $("#SteelCode").val(data.SteelCode);
        });
        //获取数据源
        function DataSource() {
            AjaxJson("/CommonModule/Steel/GetAutoCompleJson", { keywords: $SteelCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="SteelId" style="display: none;">' + DataJson[i].SteelId + '</td>';
                    html += '<td id="SteelCode" style="width: 50%;">' + DataJson[i].SteelCode + '</td>';
                    html += '<td id="SteelName" style="width: 100%;">' + DataJson[i].SteelName + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("SteelCode", $SteelCode.width() + "px", "200px", html, function (data) {
                    $("#SteelCode").val(data.SteelCode);
                });
            });
        }
    }
</script>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>销数日期：</th>
            <td>
                <input id="StartTime" type="text" class="txt Wdate" value="@DNS.Utilities.DateTimeHelper.GetTime(-7)" style="width: 120px" onfocus="var endDate=$dp.$('EndTime');WdatePicker({onpicked:function(){EndTime.focus();},maxDate:'#F{$dp.$D(\'EndTime\')}',dateFmt: 'yyyy-MM-dd 23:59'})" />
            </td>
            <td>-</td>
            <td>
                <input id="EndTime" type="text" class="txt Wdate" value="@DNS.Utilities.DateTimeHelper.GetTime()" style="width: 120px" onfocus="WdatePicker({minDate:'#F{$dp.$D(\'StartTime\')}',dateFmt: 'yyyy-MM-dd 23:59'})" />
            </td>
            <th>钢种：</th>
            <td>
                <input id="SteelCode" maxlength="50" type="text" class="txt" style="width:100px;" />
            </td>
            <th>订单号：</th>
            <td>
                <input id="BillCode" maxlength="50" type="text" class="txt" style="width:100px;" />
            </td>
            <th>钢材编号：</th>
            <td>
                <input id="BatchCode" maxlength="50" type="text" class="txt" style="width:100px;" />
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
            </td>
            <td>
                <input id="btnExport" type="button" class="btnSearch" value="导 出" onclick="btn_Export()" />
            </td>
        </tr>
    </table>
</div>
<div class="leftline rightline" style="margin-left: 1px; margin-right: 1px;">
    <div id="grid_List" class="topline" style="margin-top: 1px;">
        <table id="gridTable"></table>
        <div id="gridPager"></div>
    </div>
</div>
