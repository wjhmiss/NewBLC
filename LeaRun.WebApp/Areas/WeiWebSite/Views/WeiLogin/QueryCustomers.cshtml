@{
    ViewBag.Title = "用户中心";
    Layout = "~/Views/Shared/_LayoutMobile.cshtml";
}

<script>
    var FullName = GetQuery('FullName');
    function querys(page) {
        //var page = GetQuery("page") == "" ? 1 : GetQuery("page");
        $.ajax({
            url: "@Url.Content("~/CommonModule/Customer/GetCusInfo")?keywords=" + escape(FullName),
            type: "post",
            dataType: "json",
            data: { "rows": 30, "page": page },
            async: true,
            success: function (data) {
                $("#list").html("");
                $.each(data.rows, function (i) {
                    var html = '<li><a href="javascript:;" data-ignore="true">';
                    html += '<h2>客户名称：' + data.rows[i].fullname + '</h2>';
                    html += '<div class="note">';
                    html += '<p>联系人：' + data.rows[i].contact + ' 联系电话：' + data.rows[i].mobile + '  地址：' + data.rows[i].detailaddress + ' 线路：' + data.rows[i].sendpath + '</p>';
                    html += '<p><i class="hot" style="float: left;">客户编号：' + data.rows[i].code + ' 销售区域：' + data.rows[i].sellarea + '  备注：' + data.rows[i].remark + '</i></p>';
                    html += '</div></a></li>';
                    $("#list").append(html);
                });
                var htmlpage = '<span>共' + data.records + '记录</span>';
                if (data.page == 1) {
                    htmlpage += '<span class="disabled">«上一页</span>';
                }
                else {
                    htmlpage += '<a href="javascript:;" onclick="querys(' + (data.page - 1) + ')" data-ignore="true">«上一页</a>';
                }
                htmlpage += '<span class="current">' + data.page + '</span>';
                if (data.page == data.total || data.total == 1) {
                    htmlpage += '<span class="disabled">下一页»</span>';
                }
                else {
                    htmlpage += '<a href="javascript:;" onclick="querys(' + (data.page + 1) + ')" data-ignore="true">下一页»</a>';
                }
                $("#listPage").html("");
                $("#listPage").append(htmlpage);
            },
            error: function (data) {
                alert(data.responseText);
            }

        });
        }
    //初始化
    $(function () {
        querys(1);
        $("#getWhere").click(function () {
            location.href = "@Url.Content("~/WeiWebSite/WeiLogin/QueryCustomersWhere")";
        });
    })

    function locationInputQuot() {
        location.href = "@Url.Content("~/WeiWebSite/WeiLogin/WeiIndex")";
    }

</script>
