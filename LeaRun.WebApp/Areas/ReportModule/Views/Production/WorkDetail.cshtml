                            }
                        }
                    },
                    {
                        label: '退火后研磨', name: 'ym02qty', index: 'ym02qty', width: 50, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue;

                            }
                            else {
                                return ''
                            }
                        }
                    },
                    {
                        label: '已退火后研磨', name: 'ym02', index: 'ym02', width: 50, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue;

                            }
                            else {
                                if (!!rowObject.ym02qty) {
