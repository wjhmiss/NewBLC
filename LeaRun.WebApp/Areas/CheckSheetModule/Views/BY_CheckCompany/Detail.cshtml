@{
    ViewBag.Title = "应收款管理》明细页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/CheckSheetModule/BY_CheckCompany/SetForm", { KeyValue: GetQuery('KeyValue') }, function (data) {
                SetWebControls(data);
            });
        }
    }
</script>
<form id="form1" style="margin: 1px">
    <table class="form">
        <tr>
            <th class='formTitle'>应收单ID：</th>
            <td class='formValue'>
                <label id="CheckCompanyId" />
            </td>
            <th class='formTitle'>应收单单号：</th>
            <td class='formValue'>
                <label id="CheckCompanyCode" />
            </td>
            <th class='formTitle'>开始时间：</th>
            <td class='formValue'>
                <label id="BeginDate" />
            </td>
            <th class='formTitle'>结束时间：</th>
            <td class='formValue'>
                <label id="EndDate" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>客户ID：</th>
            <td class='formValue'>
                <label id="CustomerId" />
            </td>
            <th class='formTitle'>客户编号：</th>
            <td class='formValue'>
                <label id="CustomerCode" />
            </td>
            <th class='formTitle'>客户名称：</th>
            <td class='formValue'>
                <label id="CustomerName" />
            </td>
            <th class='formTitle'>联系人：</th>
            <td class='formValue'>
                <label id="ContactName" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>联系电话：</th>
            <td class='formValue'>
                <label id="ContactTel" />
            </td>
            <th class='formTitle'>传真：</th>
            <td class='formValue'>
                <label id="ContactFax" />
            </td>
            <th class='formTitle'>邮箱：</th>
            <td class='formValue'>
                <label id="ContactMail" />
            </td>
            <th class='formTitle'>手机：</th>
            <td class='formValue'>
                <label id="MobileCode" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>客户地址：</th>
            <td class='formValue'>
                <label id="CustomerAddress" />
            </td>
            <th class='formTitle'>总金额：</th>
            <td class='formValue'>
                <label id="TotalAmount" />
            </td>
            <th class='formTitle'>已获金额：</th>
            <td class='formValue'>
                <label id="GetedAmount" />
            </td>
            <th class='formTitle'>是否开票：</th>
            <td class='formValue'>
                <label id="IsInvoice" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>是否已还清，1还清，0未还清：</th>
            <td class='formValue'>
                <label id="IsOver" />
            </td>
            <th class='formTitle'>备注：</th>
            <td class='formValue'>
                <label id="Remark" />
            </td>
            <th class='formTitle'>有效：</th>
            <td class='formValue'>
                <label id="Enabled" />
            </td>
            <th class='formTitle'>排序码：</th>
            <td class='formValue'>
                <label id="SortCode" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>删除标记：</th>
            <td class='formValue'>
                <label id="DeleteMark" />
            </td>
            <th class='formTitle'>创建时间：</th>
            <td class='formValue'>
                <label id="CreateDate" />
            </td>
            <th class='formTitle'>创建用户主键：</th>
            <td class='formValue'>
                <label id="CreateUserId" />
            </td>
            <th class='formTitle'>创建用户：</th>
            <td class='formValue'>
                <label id="CreateUserName" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>修改时间：</th>
            <td class='formValue'>
                <label id="ModifyDate" />
            </td>
            <th class='formTitle'>修改用户主键：</th>
            <td class='formValue'>
                <label id="ModifyUserId" />
            </td>
            <th class='formTitle'>修改用户：</th>
            <td class='formValue'>
                <label id="ModifyUserName" />
            </td>
        </tr>
    </table>
</form>
