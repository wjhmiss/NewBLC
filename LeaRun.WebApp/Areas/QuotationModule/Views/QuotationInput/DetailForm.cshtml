    function enterInput() {


        var e = e || window.event || arguments.callee.caller.arguments[0];
        var tar = e.srcElement || e.target;
        if (e && e.keyCode == 13) {//回车
            if ($(tar).attr('id') == "SteelCode") {
                $("#Length").select();
            }
            else if ($(tar).attr('id') == "Length") {
                if (!!$(tar).val() && $(tar).val() != "0") {
                    $("#Weigh").select();
                }
            }
            else if ($(tar).attr('id') == "Weigh") {
                $("#Thick").select();
            }
            else if ($(tar).attr('id') == "Thick") {
                $("#BoreSize").select();
            }
            else if ($(tar).attr('id') == "BoreSize") {
                $("#Qty").select();
            }

            else if ($(tar).attr('id') == "Qty") {
                if ($(tar).val() != "0") {
                    $("#MaterialPrice").select();
                }
            }
            else if ($(tar).attr('id') == "MaterialPrice") {
                $("#AddLength").select();
            }

            
            else if ($(tar).attr('id') == "AddLength") {
                $("#AddWeigh").select();
            }
            
            else if ($(tar).attr('id') == "AddWeigh") {
                $("#AddThick").select();
            }
            
            else if ($(tar).attr('id') == "AddThick") {
                $("#BoreSizeAdd").select();
            }
            else if ($(tar).attr('id') == "BoreSizeAdd") {
                $("#CustomerProduct").select();

            }


            else if ($(tar).attr('id') == "CustomerProduct") {
                $("#WorkPrice").select();
            }

         
            
            else if ($(tar).attr('id') == "WorkPrice") {
                $("#SmallCost").select();

            }

            else if ($(tar).attr('id') == "SmallCost") {
                $("#RemarkKL").select();

                
            }

            
           
            else if ($(tar).attr('id') == "RemarkKL") {
                $("#Remark").select();

            }

            else if ($(tar).attr('id') == "Remark") {
                $("#ShipDescription").select();
            }
            
            else if ($(tar).attr('id') == "ShipDescription") {
                if (!$("#Delivery").val()) {
                    $("#Delivery").select();

                }
                else if (!$("#Kprocess").val())
                {
                    $("#Kprocess").select();
                }
                else {
                    if (!!KeyValue) {
                        //编辑
                        AcceptClick2(1);
                    }
                    else {
                        AcceptClick1();
                    }
                }

            }
            else if ($(tar).attr('id') == "Delivery") {
                //if ($("#Remark").val() != "") {
                if (!$("#Kprocess").val()) {
                    $("#Kprocess").select();
                }
                else if (!!KeyValue) {
                    //编辑
                    AcceptClick2(1);
                }
                else {
                    AcceptClick1();
                }
                //}
            }
            else if ($(tar).attr('id') == "Kprocess") {
                //if ($("#Remark").val() != "") {
                if (!!KeyValue) {
                    //编辑
                    AcceptClick2(1);
                }
                else {
                    AcceptClick1();
                }
                //}
            }
            else {
                $("#Delivery").select();
            }

        }
    }
