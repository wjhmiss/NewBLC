@{
    ViewBag.Title = "报价单查询";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script>
    var deliverycode = GetQuery('deliverycode');
    $(function () {
        

        window.setTimeout(function () {
            GetGrid();
            $('#gridTable').setGridWidth(830);
        }, 300);
        //if (GetQuery('steelPurchase') == "1") {
        //    $("#gridTable").jqGrid('setGridParam', {
        //        multiselect: true
        //    }).trigger('reloadGrid');
        //} 
        
    });
   
    //报价单列表
    function GetGrid() {
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/DeliveryModule/BY_DeliveryDetail/GridPageListJson2?deliverycode=")" + deliverycode,
            datatype: "json",
            height: 457,
            autowidth: true,
            colModel: [
                    { label: '钢种', name: 'steelcode', index: 'steelcode', width: 120, align: 'left', sortable: true },
                    { label: '单价', name: 'materialprice', index: 'materialprice', width: 120, align: 'left', sortable: true },
                    { label: '合计重量', name: 'weight', index: 'weight', width: 50, align: 'center', sortable: true },
            ],
            viewrecords: true,
            rowNum: 999,
            rowList: [999, 999, 999, 999, 999],
            pager: "#gridPager",
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            ondblClickRow: function () {
                AcceptClick();
            },
            
        });
    }
    //确认事件
    function AcceptClick() {
        $(".ui_state_highlight").attr("disabled", true);
        var QuotationCode = GetJqGridRowValue("#gridTable", "quotationcode");
        top.frames[tabiframeId()].$("#QuotationCode").val(QuotationCode);
        top.frames[tabiframeId()].btn_Search();
        window.setTimeout(function () {closeDialog();}, 500);
    }
</script>
