@{
    ViewBag.Title = "BY_JXReport》表单页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    var KeyValue = GetQuery('KeyValue');//主键
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/QualityModule/BY_JXReport/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
            });
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        $(".ui_state_highlight").attr("disabled", true);
        var postData = GetWebControls("#form1");
        AjaxJson("/QualityModule/BY_JXReport/SubmitForm?KeyValue=" + KeyValue, postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            window.setTimeout(function () {closeDialog();}, 500);
        });
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        
        <tr>
            <th class='formTitle'>送检单位：</th>
            <td class='formValue'>
                <input id="CheckCompany" maxlength=500 type="text" class="txt"   />
            </td>
            <th class='formTitle'>检测时间：</th>
            <td class='formValue'>
                <input id="CreateDate" type="text" class="txt Wdate" value="@DNS.Utilities.DateTimeHelper.GetToday()" onfocus="WdatePicker()" />
            </td>
        </tr>
       
        <tr>
            <th class='formTitle'>试样品种：</th>
            <td class='formValue' colspan="3">
                <input id="CheckSteelName" maxlength=200 type="text" class="txt"   />
            </td>
            
        </tr>
       
        <tr>
            <th class='formTitle'>检测项目<br />级别评定：</th>
            <td class='formValue' colspan="3">
                   <textarea id="CheckList" class="txtArea" rows="3">检测项目：球化组织
评定依据：NADCA#207-2003
评定级别：HS4</textarea>
            </td>
        </tr>
       
        <tr>
            <th class='formTitle'>原材料编号：</th>
            <td class='formValue'>
                <input id="SteelQualityreportCode" maxlength=50 type="text" class="txt"   />
            </td>
            <th class='formTitle'>热处理编号：</th>
            <td class='formValue'>
                <input id="QuotationHeatCode" maxlength=50 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>工单号：</th>
            <td class='formValue'>
                <input id="OrderLineCode" maxlength=50 type="text" class="txt"   />
            </td>
            <th class='formTitle'>备注：</th>
            <td class='formValue'>
                <input id="Remark" maxlength=500 type="text" class="txt" value="1:HS1-HS9 为合格产品"  />
            </td>
           
        </tr>
        <tr>
        </tr>
    </table>
</form>
