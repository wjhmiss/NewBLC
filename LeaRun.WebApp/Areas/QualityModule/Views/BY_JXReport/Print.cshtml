    <script>
        //初始化
        $(function () {
            AjaxJson("/QualityModule/BY_JXReport/SetForm", { KeyValue: GetQuery('KeyValue') }, function (data) {
                //var OrderEntiy = data.OrderEntiy;
                var Orderhtml = "";

                Orderhtml += '<table id="tb_Order" border="0" class="form-print" style="border-collapse:collapse;">';
                Orderhtml += '    <tr>';
                Orderhtml += '    <td colspan="4" align="center" style="padding: 2px;height: 20px; line-height: 20px;"><span style="font-size: 30px; CSBReportId">北仑机械锻造厂</span></td>';
                Orderhtml += '    </tr>';
                Orderhtml += '    <tr>';
                Orderhtml += '    <td colspan="4" align="center" style="padding: 2px;height: 20px; line-height: 20px;">DONGGUAN Xinze Steel Co.,Ltd.</td>';
                Orderhtml += '    </tr>';
                Orderhtml += '    <tr>';
                Orderhtml += '    <td colspan="4" align="center" style="padding: 2px;height: 20px; line-height: 20px;">地址：宁波市北仑区大矸龙潭山三路15号&nbsp;&nbsp;&nbsp;&nbsp;电话：18892600521&nbsp;&nbsp;&nbsp;&nbsp;邮箱：124176905@qq.com</td>';
                Orderhtml += '    </tr>';
            
                Orderhtml += '    <tr>';
                Orderhtml += '    <td colspan="4" align="center" style="padding: 2px;border-top: 2px solid #000;height: 40px; line-height: 40px;"><span style="font-size: 26px; CSBReportId">金相检验报告</td>';
                Orderhtml += '    </tr>';


                Orderhtml += '                <tr>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: center;width:25%;" >送检单位：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;width:25%;" >' + data.CheckCompany + '</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;width:25%;">送检时间：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;width:25%;">' + formatDate(data.CreateDate, 'yyyy-MM-dd') + '</td>';
                Orderhtml += '                </tr>';
                Orderhtml += '                <tr>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: center;width:25%;" >试样品种：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;width:25%;" colspan="3" >' + data.CheckSteelName + '</td>';
                Orderhtml += '                </tr>';

                Orderhtml += '                <tr>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: center;width:25%;height: 18px; line-height: 18px;" >检验项目：<br/>级别评定：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: left;width:25%;height: 18px; line-height: 18px;"  colspan="3"  >' + data.CheckList.replace(/@@/g, "<br/>") + '</td>';
                Orderhtml += '                </tr>';

               
                Orderhtml += '                <tr>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: left;width:100%;height:650px;" colspan="4" >图片：';
                var nums = Math.random();
                Orderhtml += '                    <img style="width:650px" src=../../Resource/Document/BY_JXReport/' + GetQuery('KeyValue') + '.jpg?' + nums + '>';
                
                    
                Orderhtml += '                       </td>';
                Orderhtml += '                </tr>';

                Orderhtml += '                <tr>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: center;width:25%;" >备注：</td>';

                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: left;" colspan="3"  >' + data.Remark + '';
                Orderhtml += '                    <img id="logo"  style="z-index: -1; right:25px;top:850px; width: 4cm;float:left;position: absolute; " src="@Url.Content("~/Content/Images/124.png")" />';
                Orderhtml += '                   <img id="logo1"  style="z-index: -1; right:225px;top:850px; width: 4cm;  float:left;position: absolute;" src="@Url.Content("~/Content/Images/125.png")" /> </td>';
                Orderhtml += '                </tr>';
                Orderhtml += '                <tr>';
                Orderhtml += '                    <td style=" text-align: right;width:25%;" >检验人：</td> ';
                Orderhtml += '                    <td style=" text-align: left;width:25%;" ></td>';
                Orderhtml += '                    <td style=" text-align: right;width:25%;">核对人：</td>';
                Orderhtml += '                    <td style=" text-align: left;width:25%;"></td>';
                Orderhtml += '                </tr>';
                Orderhtml += '            </table>';
                
                $("#my_area1").append(Orderhtml);
            });
        })
        //确认打印
        function AcceptClick() {
            MyPreview();
        }
    </script>

</head>
<body style="overflow-x: hidden;">
    <div id="my_area1" >
        <div style="float: left; position: absolute; ">
            @*<img style="width: 80px;padding: 5px;" src="@Url.Content("~/Content/Images/111.jpg")" />*@
        </div>
        @*<div id="reprint" style="position: absolute; right: 15px; top: 15px; display: none; "><span style="font-size: 18px; CSBReportId"></span></div>*@
    </div>

</body>
<script language="javascript" type="text/javascript">
    function MyPreview() {
        ////var LODOP = getLodop();
        LODOP.PRINT_INIT("打印初始化");
        LODOP.SET_PRINT_COPIES(1);
        LODOP.SET_PRINT_PAGESIZE(1, "", "", "A4")
        var strHTML = document.getElementsByTagName("html")[0].innerHTML;
        LODOP.ADD_PRINT_HTM(0, 0, "100%", "100%", strHTML);
        LODOP.PREVIEW();
        //LODOP.PRINTA();
        window.setTimeout(function () {closeDialog();}, 500);
    };
</script>
<style>
    .form-print th {
        font-size: 12pt;
        font-family: sans-serif;
