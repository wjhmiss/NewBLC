@{
    ViewBag.Title = "付款单》明细页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/PaymentModule/Base_PaySheet/SetForm", { KeyValue: GetQuery('KeyValue') }, function (data) {
                SetWebControls(data);
            });
        }
    }
</script>
<form id="form1" style="margin: 1px">
    <table class="form">
        <tr>
            <th class='formTitle'>付款id：</th>
            <td class='formValue'>
                <label id="PaySheetId" />
            </td>
            <th class='formTitle'>付款号：</th>
            <td class='formValue'>
                <label id="PaySheetCode" />
            </td>
            <th class='formTitle'>付款事项：</th>
            <td class='formValue'>
                <label id="PayName" />
            </td>
            <th class='formTitle'>规格：</th>
            <td class='formValue'>
                <label id="Size" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>单价：</th>
            <td class='formValue'>
                <label id="PricePer" />
            </td>
            <th class='formTitle'>数量：</th>
            <td class='formValue'>
                <label id="Qty" />
            </td>
            <th class='formTitle'>总金额：</th>
            <td class='formValue'>
                <label id="TotalAmount" />
            </td>
            <th class='formTitle'>状态0未审核，1已审核，-1拒绝：</th>
            <td class='formValue'>
                <label id="Status" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>已付款：</th>
            <td class='formValue'>
                <label id="IsPay" />
            </td>
            <th class='formTitle'>已开票：</th>
            <td class='formValue'>
                <label id="IsInvoice" />
            </td>
            <th class='formTitle'>支付方式：</th>
            <td class='formValue'>
                <label id="PayType" />
            </td>
            <th class='formTitle'>员工ID：</th>
            <td class='formValue'>
                <label id="WorkerId" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>员工姓名：</th>
            <td class='formValue'>
                <label id="WorkerName" />
            </td>
            <th class='formTitle'>工号：</th>
            <td class='formValue'>
                <label id="WorkerCode" />
            </td>
            <th class='formTitle'>备注：</th>
            <td class='formValue'>
                <label id="Remark" />
            </td>
            <th class='formTitle'>有效：</th>
            <td class='formValue'>
                <label id="Enabled" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>排序码：</th>
            <td class='formValue'>
                <label id="SortCode" />
            </td>
            <th class='formTitle'>删除标记：</th>
            <td class='formValue'>
                <label id="DeleteMark" />
            </td>
            <th class='formTitle'>创建时间：</th>
            <td class='formValue'>
                <label id="CreateDate" />
            </td>
            <th class='formTitle'>创建用户主键：</th>
            <td class='formValue'>
                <label id="CreateUserId" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>创建用户：</th>
            <td class='formValue'>
                <label id="CreateUserName" />
            </td>
            <th class='formTitle'>修改时间：</th>
            <td class='formValue'>
                <label id="ModifyDate" />
            </td>
            <th class='formTitle'>修改用户主键：</th>
            <td class='formValue'>
                <label id="ModifyUserId" />
            </td>
            <th class='formTitle'>修改用户：</th>
            <td class='formValue'>
                <label id="ModifyUserName" />
            </td>
        </tr>
        <tr>
        </tr>
    </table>
</form>
