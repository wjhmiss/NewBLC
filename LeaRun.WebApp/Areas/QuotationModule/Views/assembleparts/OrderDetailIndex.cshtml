                    { label: '数量', name: 'qty', index: 'qty', width: 50, align: 'left', sortable: true },
                    //{
                    //    label: '热处理', name: 'technology', index: 'technology', width: 50, align: 'center', sortable: true,
                    //    formatter: function (cellvalue, options, rowObject) {
                    //        //if (cellvalue.replace("&nbsp;", "")) return "<img src='../../Content/Images/checkokmark.gif'/>";
                    //        //else return "<img src='../../Content/Images/checknomark.gif'/>";
                    //        if (cellvalue.replace("&nbsp;", "")) return "是";
                    //        else return "否";
                    //    }
                    //},
                    {
                        label: '落单日期', name: 'createdate', index: 'createdate', width: 100, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    {
                        label: '要求完工期', name: 'delivery', index: 'delivery', width: 100, align: 'center', sortable: true 
                    },
                     { label: '重量', name: 'weight', index: 'weight', width: 50, align: 'center', sortable: true },
                    { label: '路线', name: 'shiproute', index: 'shiproute', width: 80, align: 'center', sortable: true },
                    { label: '备注', name: 'remark', index: 'remark', width: 150, align: 'left', sortable: true },
                    { label: '未完成数', name: 'uncompleteqty', index: 'uncompleteqty', width: 50, align: 'center', sortable: true },
                    { label: '未开料数', name: 'unopenqty', index: 'unopenqty', width: 50, align: 'center', sortable: true },
                    { label: '当前状态', name: 'billstatus', index: 'billstatus', width: 80, align: 'center', sortable: true },
                    { label: '类型', name: 'ordertype', index: 'ordertype', width: 80, align: 'center', sortable: true },

                    { label: '过期天数', name: 'overday', index: 'overday', width: 50, align: 'center', sortable: true },
                    {
