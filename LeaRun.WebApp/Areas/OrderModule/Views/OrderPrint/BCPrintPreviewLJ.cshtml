                        Orderhtml += '                               <td style="border: 1px solid #000; text-align: center;width: 70px;font-size:10px;"></td>';
                        Orderhtml += '                               <td style="border: 1px solid #000; text-align: center;width: 70px;font-size:10px;"></td>';
                        Orderhtml += '                               <td style="border: 1px solid #000; text-align: center;width: 70px;font-size:10px;"></td>';
