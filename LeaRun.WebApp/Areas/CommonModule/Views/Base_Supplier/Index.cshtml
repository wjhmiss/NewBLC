@{
    ViewBag.Title = "Base_Supplier";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    //加载表格
    function GetGrid() {
        $("#gridTable").jqGrid({
        url: "@Url.Content("~/CommonModule/Base_Supplier/GridPageJson")",
        datatype: "json",
        height: $(window).height() - 149,
        autowidth: true,
        colModel: [
                { label: '供应商主键', name: 'SupplierId', hidden: true },
                { label: '供应商编号', name: 'Code', index: 'Code', width: 50, align: 'left',sortable: true  },
                { label: '供应商名称', name: 'FullName', index: 'FullName', width: 100, align: 'left',sortable: true  },
                { label: '拼音', name: 'Spell', hidden: true },
                { label: '供应商简称', name: 'ShortName', index: 'ShortName', width: 60, align: 'left',sortable: true  },
                { label: '账期', name: 'PaymentMode', index: 'PaymentMode', width: 60, align: 'left',sortable: true  },
                { label: '销售大区', name: 'Sellregion', index: 'Sellregion', width: 60, align: 'left',sortable: true  },
                { label: '销售区域', name: 'Sellarea', index: 'Sellarea', width: 60, align: 'left',sortable: true  },
                { label: '销售人员', name: 'Sellpeople', index: 'Sellpeople', width: 80, align: 'left', sortable: true },
                { label: '销售人员电话', name: 'SellpeoplePhone', index: 'SellpeoplePhone', width: 80, align: 'left', sortable: true },
                { label: '公司电话', name: 'GSPhone', index: 'GSPhone', width: 80, align: 'left', sortable: true },
                { label: '公司传真', name: 'Fax', index: 'Fax', width: 80, align: 'left', sortable: true },
                { label: 'QQ/微信', name: 'SellpeopleQQ', index: 'SellpeopleQQ', width: 80, align: 'left', sortable: true },
                { label: '其他联系人', name: 'SellpeopleOther', index: 'SellpeopleOther', width: 80, align: 'left', sortable: true },
                { label: '联系人电话', name: 'OtherPhone', index: 'OtherPhone', width: 80, align: 'left', sortable: true },
                { label: '供应商地址', name: 'Address', index: 'Address', width: 80, align: 'left', sortable: true },
                {
                    label: '含税', name: 'IsInvoice', index: 'IsInvoice', width: 45, align: 'center',
                    formatter: function (cellvalue, options, rowObject) {
                        if (cellvalue == '1') return "<img src='../../Content/Images/checkokmark.gif'/>";
                        if (cellvalue == '0') return "<img src='../../Content/Images/checknomark.gif'/>";
                    }
                },
                { label: '创建用户', name: 'CreateUserName', index: 'CreateUserName', width: 0, align: 'left', sortable: true },
                {
                    label: '创建时间', name: 'CreateDate', index: 'CreateDate', width: 0, align: 'left', sortable: true,
                    formatter: function (cellvalue, options, rowObject) {
                        return formatDate(cellvalue, 'yyyy-MM-dd');
                    }
                }
        ],
        viewrecords: true,
        rowNum: 30,
        rowList: [30, 50, 100, 500, 5000],
        pager: "#gridPager",
        sortname: 'CreateDate',
        sortorder: 'desc',
        rownumbers: true,
        shrinkToFit: false,
        gridview: true,
        ondblClickRow: function (rowid, iRow, iCol, e) {
            btn_edit();
        }
    });
}
    //新增
    function btn_add() {
        var url = "/CommonModule/Base_Supplier/Form"
        openDialog(url, "Form", "新增供应商", 770, 395, function (iframe) {
            top.frames[iframe].AcceptClick()
        });
    }
    //编辑
    function btn_edit() {
        var KeyValue = GetJqGridRowValue("#gridTable", "SupplierId");
        if (IsChecked(KeyValue)) {
            var url = "/CommonModule/Base_Supplier/Form?KeyValue=" + KeyValue;
            openDialog(url, "Form", "编辑供应商", 770, 395, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //删除
    function btn_delete() {
        var KeyValue = GetJqGridRowValue("#gridTable", "SupplierId");
        if (IsDelData(KeyValue)) {
            var delparm = 'KeyValue=' + KeyValue;
            delConfig('/CommonModule/Base_Supplier/Delete', delparm, KeyValue.split(",").length);
        }
    }
    //明细
    function btn_detail() {
        var KeyValue = GetJqGridRowValue("#gridTable", "SupplierId");
        if (IsChecked(KeyValue)) {
            var url = "/CommonModule/Base_Supplier/Detail?KeyValue=" + KeyValue;
            Dialog(url, "Detail", "供应商明细", 820, 500, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入
        
    }
    //查询
    function btn_Search() {
        var Parameter = [{
            paramName: "Code",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR"
        }, {
            paramName: "FullName",
            paramValue: $("#keywords").val(),
            Operation: "Like"
        }]
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/CommonModule/Base_Supplier/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)), page: 1 }).trigger('reloadGrid');
    }
</script>
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>关键字：</th>
            <td>
                <input id="keywords" type="text" class="txt" style="width: 200px" />
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
