@{
    ViewBag.Title = "设置绩效》表单页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    var KeyValue = GetQuery('KeyValue');//主键
    $(function () {
        //工序
        BindDropItemName("#TechnologyName", "Operation", "==请选择==");
        //加工类型
        BindDropItem("#OrderType", "ProcessType", "==请选择==");
        //钢材类型
        BindDropItem("#SteelType", "SteelType", "==请选择==");

        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/CommonModule/Base_SetPerformance/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
            });
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        var postData = GetWebControls("#form1");
        $(".ui_state_highlight").attr("disabled", true);
        AjaxJson("/CommonModule/Base_SetPerformance/SubmitForm?KeyValue=" + KeyValue, postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            window.setTimeout(function () {closeDialog();}, 500);
        });
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class='formTitle'>工艺名称：</th>
            <td class='formValue'>
                <select id="TechnologyName" class="txt required"  datacol="yes" err="比例" checkexpession="NotNull">
                    <option value="">请选择</option>
                </select>
            </td>
            <th class='formTitle'>单位：</th>
            <td class='formValue'>
                <select id="Unit" class="txt" datacol="yes" err="单位" checkexpession="NotNull">
                    <option value="公斤">公斤</option>
                    <option value="件">件</option>
                </select>
            </td>
           
        </tr>
