@{
    ViewBag.Title = "发运单";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        CustomerAutocomplete();


        getAjax('/CommonModule/Company/ListJson', { ParentId: "1" }, function (data) {
            $("#CompanyName").append($("<option></option>").val("").html("请选择！"));
            var itemjson = eval("(" + data + ")");
            $.each(itemjson, function (i) {
                $("#CompanyName").append($("<option></option>").val(itemjson[i].FullName).html(itemjson[i].FullName));
            });
            Loading(false);
        });

        window.setTimeout(function () {
            GetGrid();
            GetDetailgridTable();
        }, 200);
    })
    var customerid = "";
    //客户编码自动补全
    function CustomerAutocomplete() {
        var $CustomerCode = $("#CustomerCode");
        $CustomerCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("CustomerCode", function (data) {
            $("#CustomerId").val(data.CustomerId);
            $("#CustomerCode").val(data.CustomerCode);
            $("#CustomerName").val(data.FullName);
            $("#PaymentMode").val(data.PaymentMode);
            btn_Search();
        });
        //获取数据源
        function DataSource() {
            $("#CustomerId").val('');
            AjaxJson("/CommonModule/Customer/GetAutoCompleJsonNXJ", { keywords: $CustomerCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="CustomerId" style="display: none;">' + DataJson[i].CustomerId + '</td>';
                    html += '<td id="CustomerCode" style="width: 30%;">' + DataJson[i].Code + '</td>';
                    html += '<td id="FullName" style="width: 70%;">' + DataJson[i].FullName + '</td>';
                    html += '<td id="ShortName" style="display: none;">' + DataJson[i].ShortName + '</td>';
                    html += '<td id="Sellpeople" style="display: none;">' + DataJson[i].Sellpeople + '</td>';
                    html += '<td id="SalesArea" style="display: none;">' + DataJson[i].Sellarea + '</td>';
                    html += '<td id="DiscountRate" style="display: none;">' + DataJson[i].DiscountRate + '</td>';
                    html += '<td id="TransitMode" style="display: none;">' + DataJson[i].TransitMode + '</td>';
                    html += '<td id="PaymentMode" style="display: none;">' + DataJson[i].PaymentMode + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("CustomerCode", "300px", "200px", html, function (data) {
                    $("#CustomerId").val(data.CustomerId);
                    $("#CustomerCode").val(data.CustomerCode);
                    $("#CustomerName").val(data.FullName);
                    $("#PaymentMode").val(data.PaymentMode);
                    btn_Search();
                });

            });
        }
    }
    //加载表格
    function GetGrid() {
        var rowScrod = 0;
        var SelectRowIndx = 0;
        var Condition = JSON.stringify(GetWebControls("#QueryParameter", true));
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/DeliveryModule/BY_Delivery/GetGridPageJson")?Condition=" + escape(Condition),
            datatype: "json",
            height: $(window).height() / 2 - 115,
            autowidth: true,
            colModel: [
                { label: '公司', name: 'companyname', index: 'companyname', width: 80, align: 'left', sortable: true },

                { label: '业务员', name: 'salesman',  width: 80, align: 'left' },
                { label: '创建用户', name: 'createusername', index: 'createusername', width: 80, align: 'left' },
                    { label: '发运单id', name: 'deliveryid', hidden: true },
                    { label: 'csgetedamount', name: 'csgetedamount', hidden: true },
                     {
                         label: '打印日期', name: 'printdate', index: 'printdate', width: 120, align: 'center',
                         formatter: function (cellvalue, options, rowobject) {
                             return formatDate(cellvalue, 'yyyy-MM-dd');
                         }
                     },
                    { label: '助记编码', name: 'mnemoniccode', index: 'mnemoniccode', width: 120, align: 'left' },
                    { label: '送货单号', name: 'deliverycode', index: 'deliverycode', width: 120, align: 'left' },
                    {
                        label: '原单号/客户PO', name: 'customerpo', index: 'customerpo', width: 150, align: 'left',
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");
                            } else {
                                return "";
                            }
                        }
                    },
                { label: '客户编号', name: 'customercode', index: 'customercode', width: 60, align: 'left' },
                    { label: '客户名称', name: 'customername', index: 'customername', width: 120, align: 'left' },
                      { label: '数量', name: 'qty', index: 'qty', width: 50, align: 'left' },
                      { label: '重量', name: 'weight', index: 'weight', width: 50, align: 'left' },
                    { label: '总金额', name: 'totalamount', index: 'totalamount', width: 80, align: 'left' },
                    { label: '已付金额', name: 'getedamount', index: 'getedamount', width: 80, align: 'left' },
                    { label: '报价单号', name: 'quotationcode', index: 'quotationcode', width: 120, align: 'left', hidden: true },
                    { label: '订单号', name: 'ordercode', index: 'ordercode', hidden: true },
                { label: '客户id', name: 'customerid', index: 'customerid', width: 60, align: 'left', hidden: true },
                    {
                        label: '部门', name: 'departname', index: 'departname', width: 60, align: 'left',
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");
                            } else {
                                return "";
                            }
                        }
                    },
                    {
                        label: '联系电话', name: 'contacttel', index: 'contacttel', width: 80, align: 'left',
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");
                            } else {
                                return "";
                            }
                        }
                    },
                    {
                        label: '联系人', name: 'contactname', index: 'contactname', width: 80, align: 'left',
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");
                            } else {
                                return "";
                            }
                        }
                    },
                    {
                        label: '送货地址', name: 'shipaddress', index: 'shipaddress', width: 150, align: 'left',
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");
                            } else {
                                return "";
                            }
                        }
                    },
                     {
                         label: '客来料', name: 'custmaterial', index: 'custmaterial', width: 60, align: 'center',
                         formatter: function (cellvalue, options, rowobject) {
                             if (cellvalue == 1) {
                                 return "<a  style='color:red' >是</a>";
                             }
                             return "否";
                         }
                     },
                    { label: '对账单号', name: 'checksheetcode', index: 'checksheetcode', width: 100, align: 'left' },
                { label: '发票号', name: 'invoicecodes', index: 'invoicecodes', width: 100, align: 'left' },
                {
                        label: '送货方式', name: 'shipmode', index: 'shipmode', width: 70, align: 'left',
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");
                            } else {
                                return "";
                            }
                        }
                    },
                    {
                        label: '账期', name: 'paymentmode', index: 'paymentmode', width: 70, align: 'left',
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");
                            } else {
                                return "";
                            }
                        }
                    },
                     {
                         label: '含税', name: 'isinvoice', index: 'isinvoice', width: 50, align: 'center',
                         formatter: function (cellvalue, options, rowObject) {
                             if (cellvalue) {
                                 return "<span style='color:blue'>含税</span>";
                             } else {
                                 return "<span style='color:red' >不含税</span>";
                             }
                         }
                     },


                    {
                        label: '发货说明', name: 'shipdescription', index: 'shipdescription', width: 150, align: 'left',
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");
                            } else {
                                return "";
                            }
                        }
                    },

                    { label: '钢印编码', name: 'diecode', index: 'diecode', width: 150, align: 'left', hidden: true },
                    { label: '创建时间', name: 'createdate', index: 'createdate', width: 100, align: 'left' },

                    {
                        label: '打印人', name: 'printuserid', index: 'printuserid', width: 80, align: 'center'
                    },
                    {
                        label: '回单日期', name: 'comebackdate', index: 'comebackdate', width: 120, align: 'center',
                        formatter: function (cellvalue, options, rowobject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    {
                        label: '审核日期', name: 'auditdate', index: 'auditdate', width: 120, align: 'center',
                        formatter: function (cellvalue, options, rowobject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    { label: 'printuserid', name: 'printuserid', hidden: true },
                    { label: 'comebackuserid', name: 'comebackuserid', hidden: true },
                    { label: 'audituserid', name: 'audituserid', hidden: true },
                    { label: '运输条款', name: 'shipclause', index: 'shipclause', width: 150, align: 'left', hidden: true },
                    {
                        label: '备注', name: 'remark', index: 'remark', width: 150, align: 'left',
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");
                            } else {
                                return "";
                            }
                        }
                    },
                    { label: 'enabled', name: 'enabled', index: 'enabled', hidden: true },

            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'createdate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            footerrow: true,
            gridview: true,
            onSelectRow: function (rowid, status) {
                var KeyValue = GetJqGridRowValue("#gridTable", "deliveryid");
                SelectRowIndx = GetJqGridRowIndx("#" + this.id);
                var Parameter = [{
                    paramName: "DeliveryId",
                    paramValue: KeyValue,
                    Operation: "Equal"
                }]

                 customerid = GetJqGridRowValue("#gridTable", "customerid");


                $("#DetailgridTable").jqGrid('setGridParam', {
                    url: "@Url.Content("~/DeliveryModule/BY_DeliveryDetail/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)), page: 1
                }).trigger('reloadGrid');
                rowScrod = $("#" + rowid).position().top;
            },
            gridComplete: function () {
                $("#" + this.id).jqGrid('setSelection', SelectRowIndx);
                var data = $("#gridTable").jqGrid("getRowData");
                for (var i = 0; i < data.length; i++) {
                    var item = i + 1;
                    //黄
                    if (!!data[i].audituserid) {
                        $("#" + item).find('td').css("background-color", "#BBBB00");
                    }
                        //蓝
                    else if (!!data[i].comebackuserid) {
                        $("#" + item).find('td').css("background-color", "#33CCFF");
                    }
                        //绿色
                    else if (!!data[i].printuserid) {
                        $("#" + item).find('td').css("background-color", "#008800");
                    }
                    if (data[i].enabled == "-1") {
                        $("#" + item).find('td').css("background-color", "#CC0000");
                    }

                }
                //合计
                $(this).footerData("set", {
                    "mnemoniccode": "合计",
                    "totalamount": FormatCurrency($("#gridTable").getCol('totalamount', false, 'sum')),
                    "qty": FormatCurrency($("#gridTable").getCol('qty', false, 'sum')),
                    "getedamount": FormatCurrency($("#gridTable").getCol('getedamount', false, 'sum')),
                    "weight": FormatCurrency($("#gridTable").getCol('weight', false, 'sum')),

                });
                $(".ui-jqgrid-bdiv").first().scrollTop(rowScrod);
            },
            ondblClickRow: function (rowid, iRow, iCol, e) {
                customerid = GetJqGridRowValue("#gridTable", "customerid");

                var IsInvoice = GetJqGridRowValue("#gridTable", "audituserid");
                if (!!IsInvoice) {
                    alertDialog("当前送货单已审核", 0);
                    return false;
                }
                var getedamount = GetJqGridRowValue("#gridTable", "getedamount");
                if (getedamount > 0) {
                    alertDialog("已收款，请删除后回退！", 0);
                    return false;
                }
                var checksheetcode = GetJqGridRowValue("#gridTable", "checksheetcode");
                if (!!checksheetcode) {
                    alertDialog("已对账，请删除后回退！", 0);
                    return false;
                }

                var deliveryid = GetJqGridRowValue("#gridTable", "deliveryid");
                if (IsChecked(deliveryid)) {
                    var url = "/DeliveryModule/BY_Delivery/Form?KeyValue=" + deliveryid;
                    openDialog(url, "Form", "修改对账时间", 650, 460, function (iframe) {
                        top.frames[iframe].AcceptClick();
                    });
                }
            },
        });
    }

    function edit() {
        var IsInvoice = GetJqGridRowValue("#gridTable", "audituserid");
        if (!!IsInvoice) {
            alertDialog("当前送货单已审核", 0);
