                $("#OpenSize").select();
                return;
            }
            var OpenSize = Number($("#OpenSize").val());
            if (OpenSize < OrderData.weigh && OpenSize < OrderData.length) {
                tipDialog1("开料尺寸小于工件尺寸，请检查！", 2, 0);
                $("#OpenSize").select();
                return;
            }
        }


        var orderdetailid = OrderData.orderdetailid;
        var index = GetJqGridRowIndx("#gridTable");
        Weight = GetJqGridValue("#gridTable", index, "Weight");
        var QTY = GetJqGridValue("#gridTable", index, "Qty");
        TheoryWeight = GetJqGridValue("#gridTable", index, "TheoryWeight");


        var temqty = $("#O_Qty").val();
        if (temqty == "0") {
            tipDialog1("操作失败：此订单行可以消数件数为0", 2, 0);
            return false;
        }
        if (Number(temqty) < Number(QTY)) {
            tipDialog1("操作失败：消数件数大于订单行件数！", 2, 0);
            return false;
        }
        if (Weight == "0") {
            tipDialog1("操作失败：消数重量为零，不允许提交！", 2, 0);
            return false;
        }


        var InWeight = (Number(OrderData.weight) / Number(OrderData.qty)).toFixed(2);
        var DiffWeight = 0;
        if (InWeight < 0.5) {
            DiffWeight = InWeight * 1.5;
            if (Math.abs((Weight / QTY) - InWeight) > DiffWeight) {
                tipDialog1("小于0.5KG,消数重量不能超过理论重量的1.5倍！", 2, 0);
                return;
            }
        }
        else if (InWeight < 1) {
            DiffWeight = InWeight * 1.0;
            if (Math.abs((Weight / QTY) - InWeight) > DiffWeight) {
                tipDialog1("0.5至1KG,消数重量不能超过理论重量的1.0倍！", 2, 0);
                return;
            }
        }
        else if (InWeight < 2) {
            DiffWeight = InWeight * 0.7;
            if (Math.abs((Weight / QTY) - InWeight) > DiffWeight) {
                tipDialog1("1至2KG,消数重量不能超过理论重量的0.7倍！", 2, 0);
                return;
            }
        }
        else if (InWeight < 5) {
            DiffWeight = InWeight * 0.6;
            if (Math.abs((Weight / QTY) - InWeight) > DiffWeight) {
                tipDialog1("2至5KG,消数重量不能超过理论重量的0.6倍！", 2, 0);
                return;
            }
        }
        else if (InWeight < 10) {
            DiffWeight = InWeight * 0.5;
            if (Math.abs((Weight / QTY) - InWeight) > DiffWeight) {
                tipDialog1("5至10KG,消数重量不能超过理论重量的0.5倍！", 2, 0);
                return;
            }
        }
        else if (InWeight < 30) {
            DiffWeight = InWeight * 0.4;
            if (Math.abs((Weight / QTY) - InWeight) > DiffWeight) {
                tipDialog1("10至30KG,消数重量不能超过理论重量的0.4倍！", 2, 0);
                return;
            }
        }
        else if (InWeight < 50) {
            DiffWeight = InWeight * 0.3;
            if (Math.abs((Weight / QTY) - InWeight) > DiffWeight) {
                tipDialog1("30至50KG,消数重量不能超过理论重量的0.3倍！", 2, 0);
                return;
            }
        }
        else {
            DiffWeight = InWeight * 0.2;
            if (Math.abs((Weight / QTY) - InWeight) > DiffWeight) {
                tipDialog1("大于50KG,消数重量不能超过理论重量的0.2倍！", 2, 0);
                return;
            }
        }

        confirmDialog1("提示", "确认提交吗？", function (r) {
            if (r) {
                if (!!$("#BatchCode").val()) {
                    var postData = {
                        BatchCode: $("#BatchCode").val(),
                        SteelCode: $("#O_SteelCode").val(),
                        Thick: $("#O_Thick").val(),
                        Weigh: $("#O_Weigh").val(),
                        Length: $("#O_Length").val(),
                        Weight: Weight,
                        TheoryWeight:TheoryWeight,
                        OrderDetailId: orderdetailid,
                        Qty: QTY,
                        OpenSize: Number($("#OpenSize").val())
                        //OperatorID: $("#O_OperatorID").val()
                    }
                    AjaxJsonNoMassge("/StorageModule/BY_OutStock/SubmitScaleForm", postData, function (data) {
                        tipDialog1(data.Message, 2, data.Code);
                        if (data.Code == 1) {
                            $("#O_BillCode").val("");
                            $("#O_SteelCode").val("");
                            $("#O_SteelStatus").val("");
                            $("#O_Thick").val("");
                            $("#O_Weigh").val("");
                            $("#O_Length").val("");
                            $("#O_Qty").val("");
                            $("#O_Weight").val("");
                            $("#O_TotalWeight").val("");
                            $("#O_BillCode").select();
                            $("#BatchCode").val("");
                            $("#Weight").val("");
                            $('#gridTable').jqGrid("clearGridData");
                        }

                    });
                }
            }
        })
    }
