@{
    ViewBag.Title = "订单转序》明细页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/OrderDetailProcessModule/BY_OrderDetail/SetForm", { KeyValue: GetQuery('KeyValue') }, function (data) {
                SetWebControls(data);
            });
        }
    }
</script>
<form id="form1" style="margin: 1px">
    <table class="form">
        <tr>
            <th class='formTitle'>订单明细ID：</th>
            <td class='formValue'>
                <label id="OrderDetailId" />
            </td>
            <th class='formTitle'>订单ID：</th>
            <td class='formValue'>
                <label id="OrderId" />
            </td>
            <th class='formTitle'>行号：</th>
            <td class='formValue'>
                <label id="LineCode" />
            </td>
            <th class='formTitle'>板件编码：</th>
            <td class='formValue'>
                <label id="BoardId" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>板件描述：</th>
            <td class='formValue'>
                <label id="BoardDescription" />
            </td>
            <th class='formTitle'>数量：</th>
            <td class='formValue'>
                <label id="Qty" />
            </td>
            <th class='formTitle'>钢种：</th>
            <td class='formValue'>
                <label id="SteelId" />
            </td>
            <th class='formTitle'>钢种编号：</th>
            <td class='formValue'>
                <label id="SteelCode" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>钢种描述：</th>
            <td class='formValue'>
                <label id="SteelDescription" />
            </td>
            <th class='formTitle'>钢种其它描述：</th>
            <td class='formValue'>
                <label id="SteelOtherDescription" />
            </td>
            <th class='formTitle'>钢种状态：</th>
            <td class='formValue'>
                <label id="SteelState" />
            </td>
            <th class='formTitle'>模号：</th>
            <td class='formValue'>
                <label id="DieCode" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>厚度：</th>
            <td class='formValue'>
                <label id="Thick" />
            </td>
            <th class='formTitle'>宽：</th>
            <td class='formValue'>
                <label id="Weigh" />
            </td>
            <th class='formTitle'>长：</th>
            <td class='formValue'>
                <label id="Length" />
            </td>
            <th class='formTitle'>完工件数：</th>
            <td class='formValue'>
                <label id="CompleteQty" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>打单件数：</th>
            <td class='formValue'>
                <label id="PrintQty" />
            </td>
            <th class='formTitle'>执行备注信息：</th>
            <td class='formValue'>
                <label id="ExecRemark" />
            </td>
            <th class='formTitle'>单据状态：</th>
            <td class='formValue'>
                <label id="BillStatus" />
            </td>
            <th class='formTitle'>磨四角：</th>
            <td class='formValue'>
                <label id="IsGrindAngle" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>倒角：</th>
            <td class='formValue'>
                <label id="IsChamfer" />
            </td>
            <th class='formTitle'>有效：</th>
            <td class='formValue'>
                <label id="Enabled" />
            </td>
            <th class='formTitle'>排序码：</th>
            <td class='formValue'>
                <label id="SortCode" />
            </td>
