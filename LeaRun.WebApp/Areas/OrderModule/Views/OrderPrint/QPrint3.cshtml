    <script>
        var YH = GetQuery('YH');
        var JKCost = 0;
        var SmallCost = 0;
        var WorkPrice = 0;
        var DDCostPer = 0;
        var rownum = 20
        //初始化
        $(function () {
            AjaxJson("/QuotationModule/QuotationPrint/BCPrintDataJson", { QuotationId: GetQuery('QuotationId'),rownum:rownum }, function (data) {
                var Quotation = data.Quotation;
                var QuotationDetail = data.QuotationDetail;
                var Customer = data.Customer;
                var base_customerprocessJ = data.base_customerprocessJ;
                var base_customerprocessG = data.base_customerprocessG;
                var CompanyName = data.Quotation.CompanyName;

                $("#CompanyName").text(data.Quotation.CompanyName);
                $("#CompanyName1").text(data.Quotation.CompanyName);
                $("#CompanyName2").text(data.Quotation.CompanyName);

                $("#CustomerPO").text($.trim(Quotation.CustomerPO));
                $("#OrderType").text("精料");

                if (!!base_customerprocessJ.Price) {
                    $("#PriceJ").text(base_customerprocessJ.Price);
                }
                else {
                    $("#PriceJ").text(0);

                }
                if (!!base_customerprocessJ.WhereQty) {
                    $("#WhereQtyJ").text(base_customerprocessJ.WhereQty);
                } else {

                    $("#WhereQtyJ").text(0);
                }
                if (!!base_customerprocessG.Price) {
                    $("#PriceG").text(base_customerprocessG.Price);
                } else {
                    $("#PriceG").text(0);

                }
                if (!!base_customerprocessG.WhereQty) {
                    $("#WhereQtyG").text(base_customerprocessG.WhereQty);
                } else {
                    $("#WhereQtyG").text(0);

                }
                if (!!Customer.LimitWeight) {
                    $("#LimitWeight1").text(Customer.LimitWeight);
                } else {
                    $("#LimitWeight1").text(0);

                }
                if (!!Customer.LimitWeight) {
                    $("#LimitWeight2").text(Customer.LimitWeight);
                } else {
                    $("#LimitWeight2").text(0);

                }
                if (!!Customer.LimitWeight) {
                    $("#LimitWeight3").text(Customer.LimitWeight);
                } else {
                    $("#LimitWeight3").text(0);

                }
                if (!!Customer.LimitWeight) {
                    $("#LimitWeight4").text(Customer.LimitWeight);
                } else {
                    $("#LimitWeight4").text(0);

                }
                if (!!Customer.LimitWeight) {
                    $("#LimitWeight5").text(Customer.LimitWeight);
                } else {
                    $("#LimitWeight5").text(0);

                }
                if (!!Customer.LimitWeight) {
                    $("#LimitWeight6").text(Customer.LimitWeight);
                } else {
                    $("#LimitWeight6").text(0);

                }


                if (!!Quotation.PaymentMode) {
                    $("#PaymentMode").text(Quotation.PaymentMode.replace("&nbsp;", ""));
                }
                if (!!Quotation.Remark) {
                    $("#Remark").text(Quotation.Remark.replace("&nbsp;", ""));
                }
                if (!!Quotation.ShipMode) {
                    $("#ShipMode").text(Quotation.ShipMode.replace("&nbsp;", ""));
                }
                if (!!Quotation.QuotationCode) {
                    $("#QuotationCode").text("NO：" + Quotation.QuotationCode.replace("&nbsp;", ""));
                }
                if (!!Quotation.CustomerName) {
                    $("#CustomerName").text(Quotation.CustomerName.replace("&nbsp;", ""));
                }
            
                if (!!Quotation.ShipAddress) {
                    $("#CustomerAddress").text(Quotation.ShipAddress.replace("&nbsp;", ""));
                }
                if (!!Customer.LeaderTele) {
                    $("#LeaderTele").text(Customer.LeaderTele.replace("&nbsp;", ""));
                }
                if (!!Customer.CheckFaxs) {
                    $("#CheckFaxs").text(Customer.CheckFaxs.replace("&nbsp;", ""));
                }
                if (!!Customer.Leader) {
                    $("#Leader").text(Customer.Leader.replace("&nbsp;", ""));
                }
                if (!!Customer.BankName) {
                    $("#BankName").text(Customer.BankName.replace("&nbsp;", ""));
                }
                if (!!Customer.TaxNumber) {
                    $("#TaxNumber").text(Customer.TaxNumber.replace("&nbsp;", ""));
                }
                if (!!Customer.Account) {
                    $("#Account").text(Customer.Account.replace("&nbsp;", ""));
                }
                if (!!data.QtySum) {
                    $("#QtySum").text(data.QtySum.toFixed(0));
                }
                if (!!data.WeightSum) {
                    $("#WeightSum").text(FormatCurrency(data.WeightSum));
                }

                var PriceSum = 0;
                var tempAddLength = 0;
                var tempAddWeigh = 0;

                $.each(QuotationDetail, function (i) {
                    tempAddLength = QuotationDetail[i].AddLength;
                    tempAddWeigh = QuotationDetail[i].AddWeigh;
                    if (Number(QuotationDetail[i].Weigh) > 0) {
                        // var Weigh = Number(QuotationDetail[i].Weigh);
                        // var Thick = Number(QuotationDetail[i].Thick);
                        // var Length = Number(QuotationDetail[i].Length);
                        // var values = [Weigh, Thick, Length];
                        // values.sort(compare);
                        // if (QuotationDetail[i].Length == values[2]) {
                        //     QuotationDetail[i].AddLength = QuotationDetail[i].AddThick;
                        //     QuotationDetail[i].AddWeigh = tempAddWeigh;
                        //     QuotationDetail[i].AddThick = tempAddWeigh;
                        // }
                        //else if (QuotationDetail[i].Weigh == values[2]) {
                        //     QuotationDetail[i].AddLength = tempAddWeigh;
                        //     QuotationDetail[i].AddWeigh = QuotationDetail[i].AddThick;
                        //     QuotationDetail[i].AddThick = tempAddWeigh;
                        // }

                    }

                    var size = "";
                    if (QuotationDetail[i].Length > 0) {
                        if (parseFloat(QuotationDetail[i].Weigh) <= 0) {
                            var BoreSize = "";
                            if (!!QuotationDetail[i].BoreSize) {
                                BoreSize = "xΦ" + QuotationDetail[i].BoreSize;
                            }
                            size = "Φ" + parseFloat(QuotationDetail[i].Thick) + BoreSize + '*' + parseFloat(QuotationDetail[i].Length);
                        }
                        else {
                            size = parseFloat(QuotationDetail[i].Length) + '*' + parseFloat(QuotationDetail[i].Weigh) + '*' + parseFloat(QuotationDetail[i].Thick);
                        }
                    }
                    var sizeall = "";
                    if (QuotationDetail[i].Length > 0) {
                        if (parseFloat(QuotationDetail[i].Weigh) <= 0) {
                            var BoreSize = "";
                            if (!!QuotationDetail[i].BoreSize) {
                                BoreSize = "xΦ" + QuotationDetail[i].BoreSize;
                            }
                            sizeall = "Φ" + parseFloat(QuotationDetail[i].Thick + QuotationDetail[i].AddThick) + BoreSize + '*' + parseFloat(QuotationDetail[i].Length + QuotationDetail[i].AddLength);
                        }
                        else {
                            sizeall = parseFloat(QuotationDetail[i].Length + QuotationDetail[i].AddLength) + '*' + parseFloat(QuotationDetail[i].Weigh + QuotationDetail[i].AddWeigh) + '*' + parseFloat(QuotationDetail[i].Thick + QuotationDetail[i].AddThick);
                        }
                    }

                    var QuotationDetailhtml = "";


                    if (QuotationDetail[i].LineCode == "99999") {
                        QuotationDetailhtml += '<tr>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ; " colspan="3">合计金额：' + data.UpperMaterialAmountSum + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].Qty + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].Weight + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;" ></td>';
                        QuotationDetailhtml += '     <td name="WorkPrice" style="border: 1px solid #000;text-align:center ;"></td>';
                        QuotationDetailhtml += '     <td name="WorkPrice" style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].WorkAmount + '</td>';
                        QuotationDetailhtml += '     <td name="SmallCost" style="border: 1px solid #000;text-align:center ;"></td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].SalesAmount + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;" colspan="2"></td>';
                        QuotationDetailhtml += '</tr>';
                    }
                    else {
                        if (QuotationDetail[i].LineCode == "999") {
                            QuotationDetail[i].LineCode = "";
                            size = "";
                            sizeall = "";
                            QuotationDetail[i].MaterialPrice = "";
                            QuotationDetail[i].WorkPrice = "";
                            QuotationDetail[i].SmallCost = "";
                            QuotationDetail[i].JKCost = "";
                            QuotationDetail[i].DDCostPer = "";
                            QuotationDetail[i].Qty = "";
                            QuotationDetail[i].Weight = "";
                            QuotationDetail[i].SalesAmount = "";
                            QuotationDetail[i].WorkAmount = "";
                        }
                        QuotationDetailhtml += '<tr>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].LineCode + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].ProductName + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + size + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].Qty + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].Weight + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].MaterialPrice + '</td>';
                        QuotationDetailhtml += '     <td name="WorkPrice" style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].WorkPrice + '</td>';

                        QuotationDetailhtml += '     <td name="WorkPrice" style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].WorkAmount + '</td>';
                        

                        QuotationDetailhtml += '     <td name="SmallCost" style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].SmallCost + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].SalesAmount + '</td>';
                        QuotationDetailhtml += '     <td style="border: 1px solid #000;text-align:center ;">' + QuotationDetail[i].CustomerProduct + '</td>';
                        QuotationDetailhtml += '</tr>';
                    }



                    $("#tb_QuotationDetail").append(QuotationDetailhtml);
                    PriceSum += Number(QuotationDetail[i].SalesAmount);
                    if (QuotationDetail[i].DDCostPer > 0) {
                        DDCostPer = 1;
                    }
                    if (QuotationDetail[i].WorkPrice > 0) {
                        WorkPrice = 1;
                    }
                    if (QuotationDetail[i].SmallCost > 0) {
                        SmallCost = 1;
                    }
                    if (QuotationDetail[i].JKCost > 0) {
                        JKCost = 1;
                    }
                });
                $("#PriceSum").text(FormatCurrency(PriceSum));
                if (JKCost == 0) {
                    $("td[name='JKCost']").hide();
                    $("th[name='JKCost']").hide();
                }
                if (SmallCost == 0) {
                    $("td[name='SmallCost']").hide();
                    $("th[name='SmallCost']").hide();
                }
                if (WorkPrice == 0) {
                    $("td[name='WorkPrice']").hide();
                    $("th[name='WorkPrice']").hide();
                }
                if (DDCostPer == 0) {
                    $("td[name='DDCostPer']").hide();
                    $("th[name='DDCostPer']").hide();
                }
            });
        })
        //确认打印
        function AcceptClick() {
            //AjaxJson("/QuotationModule/QuotationPrint/StateModify", { KeyValue: GetQuery('QuotationId') }, function (data) {
            
            MyPreview();

            //});
        }
    </script>
</head>
<body style="overflow-x: hidden;">
