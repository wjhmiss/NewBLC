@{
    ViewBag.Title = "设置成本》表单页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    var KeyValue = "10000";//主键
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!KeyValue) {
            AjaxJson("/CommonModule/Base_SetCost/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
            });
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        var postData = GetWebControls("#form1");
        $(".ui_state_highlight").attr("disabled", true);
        AjaxJson("/CommonModule/Base_SetCost/SubmitForm?KeyValue=" + KeyValue, postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            window.setTimeout(function () {closeDialog();}, 500);
        });
    }
</script>
<div class="tools_bar" style="margin-top: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>

</div>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>

            <th class='formTitle' style="width: 120px;">光硬价格(平方)：</th>
            <td class='formValue'>
                <input id="GYPrice" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" datacol="yes" err="钢材编码" checkexpession="NotNull" />
            </td>

            <th class='formTitle' style="width: 120px;">光软价格(平方)：</th>
            <td class='formValue'>
                <input id="GRPrice" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" datacol="yes" err="钢材编码" checkexpession="NotNull" />
            </td>
            <th class='formTitle' style="width: 120px;">精板价格(平方)：</th>
            <td class='formValue'>
                <input id="JBPrice" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" datacol="yes" err="钢材编码" checkexpession="NotNull" />
            </td>
            <th class='formTitle' style="width: 120px;">热处理价格(平方)：</th>
            <td class='formValue'>
                <input id="RclPrice" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" datacol="yes" err="钢材编码" checkexpession="NotNull" />
            </td>
        </tr>
        <tr>

            <th class='formTitle'>总光硬保底面积：</th>
            <td class='formValue'>
                <input id="GYLimiteArea" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" datacol="yes" err="钢材编码" checkexpession="NotNull" />
            </td>

            <th class='formTitle'>总光软保底面积：</th>
            <td class='formValue'>
                <input id="GRLimiteArea" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" datacol="yes" err="钢材编码" checkexpession="NotNull" />
            </td>
            <th class='formTitle'>总精板保底面积：</th>
            <td class='formValue'>
                <input id="JBLimiteArea" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" datacol="yes" err="钢材编码" checkexpession="NotNull" />
            </td>

            <th class='formTitle'>总热处理保底面积：</th>
            <td class='formValue'>
                <input id="RclLimiteArea" maxlength="18" type="text" class="txt" onfocus="IsMoney(this.id);" datacol="yes" err="钢材编码" checkexpession="NotNull" />
            </td>

        </tr>
