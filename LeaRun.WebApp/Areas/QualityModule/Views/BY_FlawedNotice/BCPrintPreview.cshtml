<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>粗料单打印预览</title>
    @*   <link href="~/Content/Styles/learunui-framework.css" rel="stylesheet" />
    <script src="~/Content/Scripts/jquery/jquery-1.8.2.min.js"></script>
    <script src="~/Content/Scripts/learunui-framework.js"></script>
    <script src="~/Content/Scripts/barcode/jquery-barcode.min.js"></script>
    <script src="~/Content/Scripts/lodop/LodopFuncs.js"></script>*@
    @Scripts.Render("~/Content/Scripts/frameworkjquery")
    @Styles.Render("~/Content/Styles/frameworkcss")
    @Scripts.Render("~/Content/Scripts/barcode/barcodejquery1")
    <script src='http://127.0.0.1:8000/CLodopfuncs.js'></script>

    <script>
        //初始化
        $(function () {
            AjaxJson("/OrderModule/OrderPrint/BCPrintDataJsonForFlawe", { OrderDetailId: GetQuery('orderdetailid'), KeyValueQ: GetQuery('KeyValueQ') }, function (data) {
                var OrderEntiy = data.OrderEntiy;
                var OrderDetail = data.OrderDetail;
                var QuotationEntiy = data.QuotationEntiy;
                var printed = ""
                if (OrderEntiy.PrintUserId) {
                    printed = "重印：@DNS.Utilities.ManageProvider.Provider.Current().UserName";
                }
                var index = 0;
                var pageindex = 0;
                var Orderhtml = '';
                var total = 0
                if (OrderDetail.length % 9 == 0) {
                    total = OrderDetail.length / 9;
                }
                else {
                    total = Math.floor(OrderDetail.length / 9) + 1
                }
                var quotitle = "";
                if (QuotationEntiy.CustMaterial == "1") {
                    quotitle = quotitle + "客来料 "
                }
                if (QuotationEntiy.FreeBill == "1") {
                    quotitle = quotitle + "补料单 "
                }
                if (OrderEntiy.OrderCode.substr(0, 1) == "B") {
                    quotitle = quotitle + "补料单 "
                }
                var mark = "";
                var nu1 = 0;
                var nu2 = 0;
                var Delivery = "";
                var totalper = 0;
                var totalweightPer = 0;
                var tempAddLength = 0;
                var tempAddWeigh = 0;
                var RepalceMl = "";
                $.each(OrderDetail, function (i) {

                    


                    totalper += Number(OrderDetail[i].Qty);
                    totalweightPer += Number(OrderDetail[i].Weight);

                    tempAddLength = OrderDetail[i].AddLength;
                    tempAddWeigh = OrderDetail[i].AddWeigh;

                    if (!!OrderDetail[i].RepalceMl) {
                        RepalceMl = OrderDetail[i].RepalceMl;
                    }

                    if (Number(OrderDetail[i].Weigh) > 0) {
                        //var Weigh = Number(OrderDetail[i].Weigh);
                        //var Thick = Number(OrderDetail[i].Thick);
                        //var Length = Number(OrderDetail[i].Length);

                        //var values = [Weigh, Thick, Length];

                        //values.sort(compare);
                        //if (OrderDetail[i].Length == values[2]) {
                        //    OrderDetail[i].AddLength = OrderDetail[i].AddThick;
                        //    OrderDetail[i].AddWeigh = tempAddWeigh;
                        //    OrderDetail[i].AddThick = tempAddWeigh;
                        //}
                        //else if (OrderDetail[i].Weigh == values[2]) {
                        //    OrderDetail[i].AddLength = tempAddWeigh;
                        //    OrderDetail[i].AddWeigh = OrderDetail[i].AddThick;
                        //    OrderDetail[i].AddThick = tempAddWeigh;
                        //}
                        //OrderDetail[i].Length = values[0];
                        //OrderDetail[i].Weigh = values[1];
                        //OrderDetail[i].Thick = values[2];
                    }
                    


                    
                    var size = "";
                    if (parseFloat(OrderDetail[i].Weigh) <= 0) {

                        var BoreSize = "";
                        if (!!OrderDetail[i].BoreSize) {
                            BoreSize = "XΦ" + OrderDetail[i].BoreSize;
                        }
                        size = "Φ" + parseFloat(OrderDetail[i].Thick)+ BoreSize + '*' + parseFloat(OrderDetail[i].Length) ;
                    }
                    else {
                        size = parseFloat(OrderDetail[i].Length) + '*' + parseFloat(OrderDetail[i].Weigh) + '*' + parseFloat(OrderDetail[i].Thick);
                    }

                    var sizeM = "";
                    if (parseFloat(OrderDetail[i].Weigh) <= 0) {
                        sizeM = "Φ" + parseFloat(OrderDetail[i].Thick + OrderDetail[i].AddThick) + '*' + parseFloat(OrderDetail[i].Length + OrderDetail[i].AddLength);
                    }
                    else {
                        sizeM = parseFloat(OrderDetail[i].Length + OrderDetail[i].AddLength) + '*' + parseFloat(OrderDetail[i].Weigh + OrderDetail[i].AddWeigh) + '*' + parseFloat(OrderDetail[i].Thick + OrderDetail[i].AddThick);
                    }

                    if (!!OrderDetail[i].ExecRemark) {
                        if (OrderDetail[i].ProductName.indexOf("毛") > 0 && nu1 == 0) {
                            mark = mark + "毛料：" + OrderDetail[i].ExecRemark
                            nu1 = 1;
                        }
                        if (OrderDetail[i].ProductName.indexOf("板") > 0 && nu2 == 0) {
                            mark = mark + "  精/光：" + OrderDetail[i].ExecRemark
                            nu2 = 1;
                        }
                        if (!mark) {
                            mark = OrderDetail[i].ExecRemark;
                        }
                    }

                    if (index % 9 == 0) {
                        pageindex++;
                        Orderhtml += '<table id="tb_Order" border="0" class="form-print" style="width: 100%;page-break-after:always;">';
                        Orderhtml += '    <tr>';
                        Orderhtml += '        <td colspan="10" align="center" style="height: 16px;line-height:16px;" >';
                        Orderhtml += '            <span style="font-size: 22px; font-weight: bold;">补料单</span><span style="font-size: 12px; font-weight: bold;">共：' + data.OrderDetailTotal + '件（' + pageindex + '/' + total + '）</span>';
                        Orderhtml += '        </td>';
                        Orderhtml += '    </tr>';

                        Orderhtml += '    <tr>';
                        Orderhtml += '        <th style="height: 14px;line-height:14px;font-size: 10pt;border-bottom: 1px solid #000;">编码：</th>';
                        Orderhtml += '        <td style="height: 14px;line-height:14px;font-size: 10pt;border-bottom: 1px solid #000;" colspan="2">' + QuotationEntiy.MnemonicCode + '</td>';
                        Orderhtml += '        <th style="height: 14px;line-height:14px;font-size: 10pt;border-bottom: 1px solid #000;">客户：</th>';
                        Orderhtml += '        <td style="height: 14px;line-height:14px;font-size: 10pt;border-bottom: 1px solid #000;" colspan="2">' + QuotationEntiy.CustomerCode + '</td>';
                        Orderhtml += '        <th style="height: 14px;line-height:14px;font-size: 10pt;border-bottom: 1px solid #000;">客服：</th>';
                        Orderhtml += '        <td style="height: 14px;line-height:14px;font-size: 10pt;border-bottom: 1px solid #000;" colspan="2">' + QuotationEntiy.CreateUserName + '</td>';
                        Orderhtml += '    </tr>';

                        Orderhtml += '    <tr>';
                        Orderhtml += '        <td colspan="10"  style="vertical-align:top;">';
                        Orderhtml += '            <table id="tb_OrderDetail" border="0" cellpadding="0" cellspacing="0" class="form-print" style="width: 100%; ">';
                        //Orderhtml += '                <tr>';OrderDetail[i].ProductName
                        //Orderhtml += '                    <td style=" border-bottom: 1px solid #000;font-size: 10pt">钢种-' + OrderDetail[i].SteelType + '</td>';
                        //Orderhtml += '                    <td style="border-bottom: 1px solid #000;" ></td>';
                        //Orderhtml += '                    <td style=" border-bottom: 1px solid #000;width:150px;font-size: 10pt" >条码</td>';
                        //Orderhtml += '                    <td style="border-bottom: 1px solid #000;" ></td>';
                        //Orderhtml += '                </tr>';
                    }
                    if (OrderDetail[i].SteelCode == "") {
                        Orderhtml += '<tr style="height: 4mm;">';
                        Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;" colspan="2">&nbsp;</td>';
                        Orderhtml += '    <td style="border-bottom: 2px dotted #000;" rowspan="2">&nbsp;</td>';
                        Orderhtml += '    <td colspan="7" >&nbsp;</td>';
                        Orderhtml += '</tr>';
                        Orderhtml += '<tr style="height: 4mm;">';
                        Orderhtml += '        <td  style="border-bottom: 2px dotted #000;">&nbsp;</td>';
                        Orderhtml += '        <td style="border-bottom: 2px dotted #000;" colspan="9" >&nbsp;</td>';
                        Orderhtml += '</tr>';
                    }
                    
                    else {
                        Orderhtml += '<tr style="height: 4mm;">';
                        Orderhtml += '    <td  style="font-size: 10pt;border-bottom: 2px dotted #000;" rowspan="2" >' + OrderDetail[i].LineCode + ',' + OrderDetail[i].SteelDescription.replace("板","") + OrderDetail[i].OrderType.substr(0, 2) + '</td>';
                        var tfang = "(" + OrderDetail[i].Fang+")";
                        //if (OrderDetail[i].SteelCode.toUpperCase().indexOf("45") < 0) {
                        //    tfang = "";
                        //}
                        var jingORmao = "";
                        if (Number(OrderDetail[i].Weigh) > 0) {
                            if (Number(tempAddLength) > 0 || Number(tempAddWeigh) > 0) {
                                jingORmao = "净";
                            }
                            else {
                                jingORmao = "毛";
                            }
                        }
                        else {
                            if (Number(tempAddLength) > 0) {
                                jingORmao = "净";
                            }
                            else {
                                jingORmao = "毛";
                            }
                        }

                        if (OrderDetail[i].SteelDescription.indexOf("锻") >= 0) {
                            Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;" >'  + size + '(切角尺寸:' + sizeM + ')-' + OrderDetail[i].Qty + '件<span style="font-size: 11px;"></span></td>';
                        }
                        else {
                            Orderhtml += '    <td style="font-size: 12pt;white-space:nowrap;font-weight: bold;" >'  + size + tfang + '-' + OrderDetail[i].Qty + '件<span style="font-size: 11px;"></span></td>';
                        }

                        Orderhtml += '    <td rowspan="2" style="border-bottom: 2px dotted #000;font-size: 10pt;text-align: right;" colspan="2">';
                        Orderhtml += '    </td>';
                        var weightPer = (OrderDetail[i].Weight / OrderDetail[i].Qty).toFixed(2);

                        Orderhtml += '    <td  style="font-size: 10pt;" colspan="3">' + '理重:' + OrderDetail[i].Weight + '</td>';
                        Orderhtml += '</tr>';
                        Orderhtml += '<tr style="height: 4mm;">';
                        var BatchCodeForInput = "";
                        if (!!OrderDetail[i].BatchCodeForInput) {
                            BatchCodeForInput = OrderDetail[i].BatchCodeForInput;
                        }
                        var tremark = (OrderDetail[i].Kprocess + OrderDetail[i].ExecRemark + " " + OrderDetail[i].CustomerProduct).replace("，", ",").replace("。", ".").replace("；", ";").replace("：", ":");
                        Orderhtml += '        <td style="border-bottom: 2px dotted #000;font-size: 10pt;white-space:nowrap;" colspan="2">' + tremark + '</td>';
                       

                        if (QuotationEntiy.CustomerName.indexOf("精双") >= 0 || QuotationEntiy.CustomerName.indexOf("宜信") >= 0 || QuotationEntiy.CustomerName.indexOf("海伦") >= 0 || QuotationEntiy.CustomerName.indexOf("邱信中") >= 0 || QuotationEntiy.CustomerName.indexOf("姚海尧") >= 0 ||
                            QuotationEntiy.CustomerName.indexOf("炫安") >= 0 || QuotationEntiy.CustomerName.indexOf("博大梧桐") >= 0 || QuotationEntiy.CustomerName.indexOf("红毅") >= 0 ||
                            QuotationEntiy.CustomerName.indexOf("吉亿德") >= 0 || QuotationEntiy.CustomerName.indexOf("金记") >= 0 || QuotationEntiy.CustomerName.indexOf("精睦") >= 0 ||
                            QuotationEntiy.CustomerName.indexOf("龙山船厂") >= 0 || QuotationEntiy.CustomerName.indexOf("盛辉") >= 0 || QuotationEntiy.CustomerName.indexOf("雄腾") >= 0) {
                            if (OrderDetail[i].SteelDescription.indexOf("锻") >= 0) {
                                Orderhtml += '        <td style="border-bottom: 2px dotted #000;font-size: 10pt;white-space:nowrap;text-align: right;" colspan="5">' + IsChamfer + DD + '单重:' + weightPer + '毛称: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </td>';
                            }
                            else {
                                Orderhtml += '        <td style="border-bottom: 2px dotted #000;font-size: 10pt;white-space:nowrap;text-align: right;" colspan="5">' + IsChamfer + DD + '毛称: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </td>';

                            }

                        }
                        else {
                            if (OrderDetail[i].SteelDescription.indexOf("锻") >= 0) {
                                Orderhtml += '        <td style="border-bottom: 2px dotted #000;font-size: 10pt;white-space:nowrap;" colspan="5">' + IsChamfer + DD + '单重:' + weightPer + '</td>';
                            }
                            else {
                                Orderhtml += '        <td style="border-bottom: 2px dotted #000;font-size: 10pt;white-space:nowrap;" colspan="5">' + IsChamfer + DD + '</td>';

                            }

                        }
                        Orderhtml += '</tr>';

                    }
                    if ((index + 1) % 9 == 0) {
                        Orderhtml += '            </table>';

                        Orderhtml += '        </td>';
                        Orderhtml += '    </tr>';
                        Orderhtml += '    <tr>';
                        Orderhtml += '        <td colspan="6"  style="vertical-align:top;">';
                        Orderhtml += '        下单：' + formatDate(OrderEntiy.CreateDate, 'yyyy-MM-dd');
                        Orderhtml += '        &nbsp;&nbsp;重量：' + totalweightPer.toFixed(0) + "kg";
                        Orderhtml += '        &nbsp;&nbsp;件数：' + totalper;
                        Orderhtml += '        &nbsp;&nbsp;交期：' + QuotationEntiy.Delivery;
                        Orderhtml += '        </td>';
                        Orderhtml += '        <td colspan="2"   style="vertical-align:top;">';
                        Orderhtml += '        </td>';
                        Orderhtml += '    </tr>';
                        Orderhtml += '    <tr>';
                        Orderhtml += '        <td colspan="8"  style="vertical-align:top;font-size: 10pt;">';
                        Orderhtml += '        锯/割：&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
                        Orderhtml += '       铣平面：&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
                        Orderhtml += '        铣四侧：&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
                        Orderhtml += '        磨平面/精铣平面：&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
                        Orderhtml += '        精铣四侧：&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
                        Orderhtml += '        </td>';
                        Orderhtml += '    </tr>';
                        Orderhtml += '</table>';
                        mark = "";
                        nu1 = 0;
                        nu2 = 0;
                        Delivery = "";
                        totalper = 0;
                        totalweightPer = 0;
                    }
                    index++;
                });
                if (OrderDetail.length % 9 != 0) {
                    Orderhtml += '            </table>';

                    Orderhtml += '        </td>';
                    Orderhtml += '    </tr>';
                    Orderhtml += '    <tr>';
                    Orderhtml += '        <td colspan="6"  style="vertical-align:top;">';
                    Orderhtml += '        下单：' + formatDate(OrderEntiy.CreateDate, 'yyyy-MM-dd');
                    Orderhtml += '        &nbsp;&nbsp;重量：' + totalweightPer.toFixed(0) + "kg";
                    Orderhtml += '        &nbsp;&nbsp;件数：' + totalper;
                    Orderhtml += '        &nbsp;&nbsp;交期：' + Delivery;
                    Orderhtml += '        </td>';
                    Orderhtml += '        <td colspan="2"  style="vertical-align:top;">';
                    Orderhtml += '        </td>';
                    Orderhtml += '    </tr>';
                    Orderhtml += '    <tr>';
                    Orderhtml += '        <td colspan="8"  style="vertical-align:top;font-size: 10pt;">';
                    Orderhtml += '        锯/割：&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
                    Orderhtml += '       铣平面：&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
                    Orderhtml += '        铣四侧：&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
                    Orderhtml += '        磨平面/精铣平面：&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
                    Orderhtml += '        精铣四侧：&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;';
                    Orderhtml += '        </td>';
                    Orderhtml += '    </tr>';
                    Orderhtml += '</table>';
                    mark = "";
                    nu1 = 0;
                    nu2 = 0;
                    Delivery = ""
                    totalper = 0;
                    totalweightPer = 0;
                }
                $("#my_area").append(Orderhtml);
            });
            $(".barcodeTarget").each(function () {
                $(this).barcode($(this).attr('barcode'), "code128", { barWidth: 1, barHeight: 20 });
            });
        })
        //确认打印
        function AcceptClick() {
            AjaxJson("/OrderModule/OrderPrint/UpdateOrderStatus", { OrderId: GetQuery('OrderId'), KeyValueQ: GetQuery('KeyValueQ') }, function (data) {
                MyPreview();

            });
        }
    </script>

</head>
<body style="overflow-x: hidden;">
    <div id="my_area" style="background: #fff;">

        @*<div id="reprint" style="position: absolute; right: 15px; top: 15px; display: none; "><span style="font-size: 18px; font-weight: bold;"></span></div>*@
    </div>

</body>
