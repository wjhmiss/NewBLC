@{
    ViewBag.Title = "生产报表";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        
        window.setTimeout(function () {
            GetGrid();
        }, 200);

    })
    //查询
    function btn_Search() {
        var Condition = GetParameterJson("QueryParameter");
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/ReportModule/Production/GridPageListWorkDetail")?Condition=" + escape(Condition), page: 1 }).trigger('reloadGrid');
    }
    var tempred = "";
    //加载表格
    function GetGrid() {
        var SelectRowIndx = 1;
        var Condition = GetParameterJson("QueryParameter");
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/ReportModule/Production/GridPageListWorkDetail")?Condition=" + escape(Condition),
            datatype: "json",
            height: $(window).height() - 130,
            autowidth: true,
            colModel: [
                    {
                        label: '落单时间', name: 'createdate', index: 'createdate', width: 70, sortable: true,
                        formatter: function (cellvalue, options, rowobject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    { label: '编号', name: 'mnemoniccode', index: 'mnemoniccode', width: 70, sortable: true },
                    { label: '订单单号', name: 'ordercode', index: 'ordercode', width: 100, sortable: true },
                    { label: '行号', name: 'linecode', index: 'linecode', width: 50, align: 'center', sortable: true },
                    { label: '客户名称', name: 'customername', index: 'customername', width: 50, align: 'left', sortable: true },
                    { label: '品名', name: 'productname', index: 'productname', width: 60, align: 'left', sortable: true },

                    { label: '钢种', name: 'steeldescription', index: 'steeldescription', width: 50, align: 'left', sortable: true },
                    {
                        label: '规格', name: '规格', index: '规格', width: 150, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!rowObject.weigh) {
                                return parseFloat(rowObject.length) + " ×" + parseFloat(rowObject.weigh) + " ×" + parseFloat(rowObject.thick);
                            }
                            else {
                                return "Φ" + parseFloat(rowObject.thick) + "*" + parseFloat(rowObject.length);
                            }
                        }
                    },
                    { label: '数量', name: 'qty', index: 'qty', width: 50, align: 'center', sortable: true, hidden: true },
                    {
                        label: '当前状态', name: 'billstatus', index: 'billstatus', width: 60, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (rowObject.billstatus != "已发运" && rowObject.billstatus != "已完工" && rowObject.billstatus != "部分发运" && rowObject.billstatus != "部分完工") {
                                return !!rowObject.billstatus1 ? rowObject.billstatus1 : "正在开料";
                            }
                            else {
                                return cellvalue;
                            }
                        }
                    },
                    { label: '加工类型', name: 'ordertype', index: 'ordertype', width: 60, align: 'left', sortable: true },
                    { label: '当前状态', name: 'billstatus1', index: 'billstatus', width: 60, align: 'center', sortable: true, hidden: true },

                    { label: 'isbeout', name: 'isbeout', index: 'isbeout', hidden: true },
                    { label: 'length', name: 'length', index: 'length', hidden: true },
                    { label: 'thick', name: 'thick', index: 'thick', hidden: true },
                    { label: 'weigh', name: 'weigh', index: 'weigh', hidden: true },
                    
                    {
                        label: '开料数', name: 'kqty', index: 'kqty', width: 50, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue;

                            }
                            else {
                                return ''
                            }
                        }
                    },
                    {
                        label: '已开料', name: 'k001', index: 'k001', width: 50, align: 'center', sortable: true,
