                var rowData = $("#gridTable").jqGrid('getRowData', row_id);
                var Parameter = [{
                    paramName: "ReimburseSheetCode",
                    paramValue: rowData["ReimburseSheetID"],
                    Operation: "Equal",
                    Logic: "AND"
                }]
                var subgrid_table_id, pager_id;
                subgrid_table_id = subgrid_id + "_t";
                pager_id = "p_" + subgrid_table_id;
                $("#" + subgrid_id).html("<table id='" + subgrid_table_id + "' class='scroll'></table><div id='" + pager_id + "' class='scroll'></div>");
                jQuery("#" + subgrid_table_id).jqGrid({
                    url: "@Url.Content("~/CheckSheetModule/BY_ReimburseSheet/GridPageJson11")?ParameterJson=" + escape(JSON.stringify(Parameter)),
                    datatype: "json",
                    height: $(window).height() - 250,
                    width: 189,
                    autowidth: true,
                    colModel: [
                        { label: '申请单ID', name: 'ReimburseSheetID', index: 'ReimburseSheetID', width: 0, align: 'left', sortable: true, hidden: true },
                    { label: '单号', name: 'ReimburseSheetCode', index: 'ReimburseSheetCode', width: 120, align: 'left', sortable: true, hidden: true },
                    { label: '助记码', name: 'MnemonicCode', index: 'MnemonicCode', width: 120, align: 'left', sortable: true, hidden: true },
                    { label: '报价单号', name: 'QuotationCode', index: 'QuotationCode', width: 120, align: 'left', sortable: true, hidden: true },
                    { label: 'CanUseMoney', name: 'CanUseMoney', index: 'CanUseMoney', width: 120, align: 'left', sortable: true, hidden: true },
                    {
                        label: '收款项', name: 'Type0', index: 'Type0', width: 50, align: 'left', sortable: true, hidden: true
                    },
                    {
                        label: '收款项1', name: 'Type1', index: 'Type1', width: 80, align: 'left', sortable: true, hidden: true
                    },
                    {
                        label: '收款项2', name: 'Type2', index: 'Type2', width: 80, align: 'left', sortable: true, hidden: true
                    },
                    {
                        label: '单号类型', name: 'Opions', index: 'Opions', width: 80, align: 'left', sortable: true, hidden: true
                    },
                    { label: '客户名称', name: 'CustomerName', index: 'CustomerName', width: 120, align: 'left', sortable: true },
                    {
                        label: '类型', name: 'GetType', index: 'GetType', width: 80, align: 'left', sortable: true
                    },
                    { label: '关联单号', name: 'Code', index: 'Code', width: 120, align: 'left', sortable: true },
                    { label: '发票号', name: 'InvoiceNum', index: 'InvoiceNum', width: 120, align: 'left', sortable: true },
                    {
                        label: '计价金额', name: 'TotalAmount', index: 'TotalAmount', width: 50, align: 'left', sortable: true
                    },
                    {
                        label: '实收金额', name: 'GETMoney', index: 'GETMoney', width: 50, align: 'left', sortable: true
                    },
                    { label: '折让金额', name: 'ZRMoney', index: 'ZRMoney', width: 50, align: 'left', sortable: true, },
                    {
                        label: '剩余金额', name: 'NotGetMoney', index: 'NotGetMoney', width: 50, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (rowObject.Opions == "预收款") {
                                return rowObject.CanUseMoney;
                            }
                            else {
                                return cellvalue;
                            }
                        }
                    },
                    { label: '收款人', name: 'RequiredMan', index: 'RequiredMan', width: 60, align: 'left', sortable: true },
                    {
                        label: '收款日期', name: 'RequiredDate', index: 'RequiredDate', width: 120, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    { label: '收款银行', name: 'BankNum', index: 'BankNum', width: 120, align: 'left', sortable: true },

                    {
                        label: '备注', name: 'Remark', index: 'Remark', width: 300, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");
                            }
                            return "";
                        }
                    },

                    { label: '创建人', name: 'CreateUserName', index: 'CreateUserName', width: 60, align: 'left', sortable: true, hidden: true },
                    { label: '审核人', name: 'AuditMan', index: 'AuditMan', width: 60, align: 'left', sortable: true, hidden: true },
                    {
                        label: '状态', name: 'Status', index: 'Status', width: 50, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (cellvalue == "1") {
                                return "审核通过";
                            }
                            if (cellvalue == "-1") {
                                return "拒绝";
                            }
                            if (cellvalue == "0") {
                                return "未审核";
                            }
                        }, hidden: true
                    },
                    { label: '备注', name: 'AuditRemark', index: 'AuditRemark', width: 240, align: 'left', sortable: true, hidden: true },
                    {
                        label: '操作', name: 'orderstatus', index: 'orderstatus', width: 60, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowobject) {
                            return "<a  style='color:red;cursor:pointer' onclick='Deletereid(\"" + rowobject.ReimburseSheetID + "\")'>删除</a>";
                        }
                    },
                    ],
                    viewrecords: true,
                    rowNum: 999,
                    rowList: [999, 999, 999, 999, 999],
                    pager: false,
                    shrinkToFit: false,
                    rownumbers: true,
                    sortname: 'SortCode',
                    sortorder: 'asc',
                    gridview: true,
                    ondblClickRow: function (rowid, iRow, iCol, e) {

                    },
                });
            }





        });
    }

    function Deletereid(KeyValue) {
        if (IsDelData(KeyValue)) {
            var delparm = 'KeyValue=' + KeyValue;
            delConfig('/CheckSheetModule/BY_ReimburseSheet/Delete', delparm, KeyValue.split(",").length);
        }
    }


    //查询
    function btn_Search() {
        var tempstatus = "";
        if ($("#Status").prop("checked")) {
            tempstatus = 0;
        }
        if ($("#Status1").prop("checked")) {
            tempstatus = 1;
        }
        if ($("#Status1").prop("checked") && $("#Status").prop("checked")) {
            tempstatus = "";
        }


        //var Parameter = [{
        //    paramName: "ReimburseSheetCode",
        //    paramValue: "is",
        //    Operation: "Null",
        //}]

        //Parameter.push({
        //    paramName: "r.RequiredDate",
        //    paramValue: $("#CreateDate_StartTime").val(),
        //    Operation: "GreaterThan",
        //    Logic: "AND"
        //});


        var Parameter = [{
            paramName: "ReimburseSheetCode",
            paramValue: "is",
            Operation: "Null",
            Logic: "AND"
        }];
        if (!!$("#CreateDate_StartTime").val()) {
            Parameter.push({
                paramName: "r.RequiredDate",
                paramValue: $("#CreateDate_StartTime").val(),
                Operation: "GreaterThan",
                Logic: "AND"
            })
        }
        if (!!$("#CreateDate_EndTime").val()) {
            Parameter.push({
                paramName: "r.RequiredDate",
                paramValue: $("#CreateDate_EndTime").val(),
                Operation: "LessThan",
                Logic: "AND"
            })
        }
        
        if (!!$("#WorkerName").val()) {
            Parameter.push({
                paramName: "r.WorkerName",
                paramValue: escape($("#WorkerName").val()),
                Operation: "Like",
                Logic: "AND"
            })
        }

        if (!!$("#Code").val()) {
            Parameter.push({
                paramName: "r.Code",
                paramValue: $("#Code").val(),
                Operation: "Like",
                Logic: "OR",
                LeftBrace: "("
            })
            Parameter.push({
                paramName: "r.InvoiceNum",
                paramValue: $("#Code").val(),
                Operation: "Like",
                Logic: "AND",
                RightBrace: ")"
            })
        }


        if (!!$("#CustomerName").val()) {
            Parameter.push({
                paramName: "r.CustomerName",
                paramValue: escape($("#CustomerName").val()),
                Operation: "Like",
                Logic: "OR",
                LeftBrace: "("
            })
            Parameter.push({
                paramName: "r.CustomerCode",
                paramValue: escape($("#CustomerName").val()),
                Operation: "Like",
                Logic: "AND",
                RightBrace: ")"
            })
        }


        if (!!$("#LType").val()) {
            Parameter.push({
                paramName: "r.LType",
                paramValue: escape($("#LType").val()),
                Operation: "Equal",
                Logic: "AND"
            })
        }

        if (!!$("#CreateUserName").val()) {
            Parameter.push({
                paramName: "r.CreateUserName",
                paramValue: escape($("#CreateUserName").val()),
                Operation: "Like",
                Logic: "AND"
            })
        }

        if (!!$("#Opions").val()) {
            Parameter.push({
                paramName: "r.Opions",
                paramValue: escape($("#Opions").val()),
                Operation: "Equal",
                Logic: "AND"
            })
        }
        if (!!$("#BankNum").val()) {
            Parameter.push({
                paramName: "r.BankNum",
                paramValue: escape($("#BankNum").val()),
                Operation: "Like",
                Logic: "AND"
            })
        }

        if (!!$("#Type0").val()) {
            Parameter.push({
                paramName: "r.Type0",
                paramValue: escape($("#Type0").val()),
                Operation: "Equal",
                Logic: "AND"
            })
        }

        if (!!$("#Type1").val()) {
            Parameter.push({
                paramName: "r.Type1",
                paramValue: escape($("#Type1").val()),
                Operation: "Equal",
                Logic: "AND"
            })
        }

        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/CheckSheetModule/BY_ReimburseSheet/GridPageJson11")?ParameterJson=" + JSON.stringify(Parameter), page: 1 }).trigger('reloadGrid');
    }
