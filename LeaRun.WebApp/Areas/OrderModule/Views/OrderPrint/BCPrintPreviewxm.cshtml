<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>粗料单打印预览</title>
    @*   <link href="~/Content/Styles/learunui-framework.css" rel="stylesheet" />
        <script src="~/Content/Scripts/jquery/jquery-1.8.2.min.js"></script>
        <script src="~/Content/Scripts/learunui-framework.js"></script>
        <script src="~/Content/Scripts/barcode/jquery-barcode.min.js"></script>
        <script src="~/Content/Scripts/lodop/LodopFuncs.js"></script>*@
    @Scripts.Render("~/Content/Scripts/frameworkjquery")
    @Styles.Render("~/Content/Styles/frameworkcss")
    @Scripts.Render("~/Content/Scripts/barcode/barcodejquery")
    <script src='http://127.0.0.1:8000/CLodopfuncs.js'></script>
    <script src="~/Content/Scripts/qrcodejs-master/qrcode.js"></script>

    <script>
        //初始化
        var RowNum = 0;

        $(function () {
            if (GetQuery('perType') == "A4") {
                RowNum = 18;
            }
            else {
                RowNum = 6;
            }

            AjaxJson("/OrderModule/OrderPrint/BCPrintListJsonJY", { OrderId: GetQuery('OrderId'), OrderDetailIds: GetQuery('OrderDetailIds'), QuotationId: GetQuery('QuotationId'), KL: "xm", RowNum: RowNum, LType: GetQuery('LType') }, function (data) {
                var OrderEntiy = data.OrderEntiy;
                var OrderDetail = data.OrderDetail;
                var QuotationEntiy = data.QuotationEntiy;
                var printed = ""
                if (OrderEntiy.PrintUserId) {
                    printed = "重印：@DNS.Utilities.ManageProvider.Provider.Current().UserName";
                }

                if (!OrderEntiy.Delivery) {
                    $.each(OrderDetail, function (i) {
                        if (DateCompare(OrderDetail[i].Delivery, OrderEntiy.Delivery)) {
                            OrderEntiy.Delivery = OrderDetail[i].Delivery;
                        }
                    })
                }
                if (!OrderEntiy.XMRequery) {
                    OrderEntiy.XMRequery = ""
                }
                if (!OrderEntiy.KLRequery) {
                    OrderEntiy.KLRequery = ""
                }
                var index = 0;
                var pageindex = 0;
                var Orderhtml = '';
                var total = 0

                if (OrderDetail.length % RowNum == 0) {
                    total = OrderDetail.length / RowNum;
                }
                else {
                    total = Math.floor(OrderDetail.length / RowNum) + 1
                }
                var quotitle = "";
                if (QuotationEntiy.CustMaterial == "1") {
                    quotitle = quotitle + "客来料 "
                }
                if (QuotationEntiy.FreeBill == "1") {
                    quotitle = quotitle + "补料单 "
                }
                if (OrderEntiy.OrderCode.substr(0, 1) == "B") {
                    quotitle = quotitle + "补料单 "
                }
                var mark = "";
                var nu1 = 0;
                var nu2 = 0;
                var Delivery = "";
                var totalper = 0;
                var totalweightPer = 0;
                var tempAddLength = 0;
                var tempAddWeigh = 0;
                $.each(OrderDetail, function (i) {




                    totalper += Number(OrderDetail[i].Qty);
                    totalweightPer += Number(OrderDetail[i].Weight);

                    var size = "";
                    if (parseFloat(OrderDetail[i].Weigh) <= 0) {

                        var BoreSize = "";
                        if (!!OrderDetail[i].BoreSize) {
                            BoreSize = "xΦ" + OrderDetail[i].BoreSize;
                        }
                        size = "Φ" + parseFloat(OrderDetail[i].Thick) + BoreSize + '*' + parseFloat(OrderDetail[i].Length);
                    }
                    else {
                        size = parseFloat(OrderDetail[i].Length) + '*' + parseFloat(OrderDetail[i].Weigh) + '*' + parseFloat(OrderDetail[i].Thick);
                    }

                    var sizeM = "";
                    if (parseFloat(OrderDetail[i].Weigh) <= 0) {
                        sizeM = "Φ" + parseFloat(OrderDetail[i].Thick + OrderDetail[i].AddThick) + ' x ' + parseFloat(OrderDetail[i].Length + OrderDetail[i].AddLength);
                    }
                    else {
                        sizeM = parseFloat(OrderDetail[i].Length + OrderDetail[i].AddLength) + ' x ' + parseFloat(OrderDetail[i].Weigh + OrderDetail[i].AddWeigh) + ' x ' + parseFloat(OrderDetail[i].Thick + OrderDetail[i].AddThick);
                    }

                    if (!!OrderDetail[i].ExecRemark) {
                        if (OrderDetail[i].ProductName.indexOf("毛") > 0 && nu1 == 0) {
                            mark = mark + "毛料：" + OrderDetail[i].ExecRemark
                            nu1 = 1;
                        }
                        if (OrderDetail[i].ProductName.indexOf("板") > 0 && nu2 == 0) {
                            mark = mark + "  精/光：" + OrderDetail[i].ExecRemark
                            nu2 = 1;
                        }
                        if (!mark) {
                            mark = OrderDetail[i].ExecRemark;
                        }
                    }
                    if (!QuotationEntiy.Remark) {
                        QuotationEntiy.Remark = ""
                    }




                    if (!QuotationEntiy.MnemonicCode) {
                        QuotationEntiy.MnemonicCode = ""
                    }
                    if (!QuotationEntiy.BuildNum) {
                        QuotationEntiy.BuildNum = ""
                    }
                    if (!QuotationEntiy.Delivery) {
                        QuotationEntiy.Delivery = "1999-01-01"
                    }
                    if (OrderDetail[i].Delivery > QuotationEntiy.Delivery) {
                        QuotationEntiy.Delivery = OrderDetail[i].Delivery
                    }
                    var mo = "";
                    if (!!data.Customer.PrintTypeGS) {
                        //mo = "ZD"
                    }
                    if (!!data.Customer.PrintTypeST && !!OrderDetail[i].ProductName) {
                        mo = mo + OrderDetail[i].ProductName + "_";
                    }
                    if (!!data.Customer.PrintTypeSZ) {
                        mo = mo + size;
                    }
                    if (!!data.Customer.PrintTypeMO && !!OrderDetail[i].CustomerProduct) {
                        mo = mo + OrderDetail[i].CustomerProduct;
                    }
                    mo = mo.replace(/ /g, '').trim('_').replace(/，/g, '_');

                    if (index % RowNum == 0) {
                        pageindex++;
                        Orderhtml += '<table id="tb_Order" border="0" class="form-print" style=" width: 100%;page-break-after: always;">';
                        Orderhtml += '    <tr>';
                        Orderhtml += '        <td colspan="10" align="center" style="" >';
