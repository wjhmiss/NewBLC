                    if ((index + 1) % num == 0) {
                        Orderhtml += '            </table>';

                        Orderhtml += '        </td>';
                        Orderhtml += '    </tr>';
                        if (!OrderEntiy.LJPlan) {
                            OrderEntiy.LJPlan = "";
                        }
                        else {
                            OrderEntiy.LJPlan = '        维修方案：' + OrderEntiy.LJPlan;
