<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>粗料单打印预览</title>
    @*   <link href="~/Content/Styles/learunui-framework.css" rel="stylesheet" />
    <script src="~/Content/Scripts/jquery/jquery-1.8.2.min.js"></script>
    <script src="~/Content/Scripts/learunui-framework.js"></script>
    <script src="~/Content/Scripts/barcode/jquery-barcode.min.js"></script>
    <script src="~/Content/Scripts/lodop/LodopFuncs.js"></script>*@
    @Scripts.Render("~/Content/Scripts/frameworkjquery")
    @Styles.Render("~/Content/Styles/frameworkcss")
    @Scripts.Render("~/Content/Scripts/barcode/barcodejquery")
    <script src='http://127.0.0.1:8000/CLodopfuncs.js'></script>

    <script>
        //初始化
        $(function () {
            AjaxJson("/QualityModule/BY_FlawedNotice/FlawedNoticeListJson", { flawednoticeid: GetQuery('flawednoticeid') }, function (data) {
                //var OrderEntiy = data.OrderEntiy;
                var BY_FlawedNotice = data.BY_FlawedNotice;
                var BY_OrderDetail = data.BY_OrderDetail;
                var BY_Order = data.BY_Order;
                var Orderhtml = '';
                if (!BY_OrderDetail.BillCode) {
                    BY_OrderDetail.BillCode = "";
                }

                Orderhtml += '<table id="tb_Order" border="0" class="form-print" style="width: 100%;border-collapse:collapse;">';
                Orderhtml += '    <tr>';
                Orderhtml += '        <td colspan="8" align="center" style="padding: 2px;line-height:22px;">';
                Orderhtml += '            <span style="font-size: 30px; font-weight: bold; height: 30px;line-height:30px;">北仑品质异常单</span>';
                Orderhtml += '        </td>';
                Orderhtml += '    </tr>';
                Orderhtml += '    <tr>';
                Orderhtml += '        <td style=" text-align: right;" colspan="2">单号：</td>';
                Orderhtml += '        <td style=" text-align: left;" colspan="2">' + BY_FlawedNotice.BillCode + '</td>';
                Orderhtml += '        <td style=" text-align: right;" colspan="2">责任人：</td>';
                Orderhtml += '        <td style=" text-align: left;" colspan="2">' + BY_FlawedNotice.DutyUserName + '</td>';
                Orderhtml += '    </tr>';
                Orderhtml += '</table>';
                Orderhtml += '  <span style="font-size: 16px; font-weight: bold; height: 30px;line-height:30px;"> 1：原始单信息：</span>';
                Orderhtml += '<table border="0" class="form-print" style="width: 100%;border-collapse:collapse;">';
                Orderhtml += '                <tr>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: center;width:10%;" >单号：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;width:20%;" >' + BY_Order.MnemonicCode + '</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;width:10%;">补料单：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;width:20%;">' + BY_FlawedNotice.BillCode + '</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;width:10%;">客户简称：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;width:20%;">' + BY_Order.CustomerName + '</td>';
                Orderhtml += '                </tr>';
               
                Orderhtml += '                <tr>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: center;">钢种：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;" >' + BY_OrderDetail.SteelDescription + '</td>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: center;" >数量：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;" >' + BY_FlawedNotice.Qty + '</td>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: center;">理论重量：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;" >' + BY_OrderDetail.Weight + '</td>';
 
                Orderhtml += '                </tr>';
                Orderhtml += '                <tr>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;">厚度：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;">' + BY_OrderDetail.Thick + '</td>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: center;">宽度：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;" >' + BY_OrderDetail.Weigh + '</td>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: center;" >长度：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;" >' + BY_OrderDetail.Length + '</td>';

                Orderhtml += '                </tr>';
                Orderhtml += '            </table>';
                Orderhtml += '   <span style="font-size: 16px; font-weight: bold; height: 30px;line-height:30px;"> 2：不合格通知单详情：</span>';

                Orderhtml += '<table border="0" class="form-print" style="width: 100%;border-collapse:collapse;">';
                Orderhtml += '                <tr>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: center;width:10%;" >超差工序：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;width:20%;" >' + BY_FlawedNotice.ErrorProcess + '</td>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: center;width:10%;">是否联客：</td>';
                var IsRelationCust = "否";
                if (!!BY_FlawedNotice.IsRelationCust) {
                    IsRelationCust = "是";
                }

                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;width:20%;" >' + IsRelationCust + '</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;width:10%;">质量判定：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;width:20%;">' + BY_FlawedNotice.SituationCode + '</td>';
                Orderhtml += '                </tr>';
                Orderhtml += '                <tr>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: center;" >客户结果：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;" >' + BY_FlawedNotice.DealResultCode + '</td>';
                Orderhtml += '                    <td style="border: 1px solid #000000;text-align: center;">处罚金额：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;" >' + BY_FlawedNotice.FMoney + '</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;">不合格：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;">' + BY_FlawedNotice.ReasonCode + '</td>';
                Orderhtml += '                </tr>';
                Orderhtml += '                <tr>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: center;">处理意见：</td>';
                Orderhtml += '                    <td style=" border: 1px solid #000000;text-align: left;" colspan="5">' + BY_FlawedNotice.Remark + '</td>';
                Orderhtml += '                </tr>';
                Orderhtml += '            </table>';
                Orderhtml += '<table id="tb_Order" border="0" class="form-print" style="width: 100%;border-collapse:collapse;">';
                Orderhtml += '    <tr>';
                Orderhtml += '        <td style=" text-align: right;" colspan="2">开单人：</td>';
                Orderhtml += '        <td style=" text-align: left;" colspan="2">' + BY_FlawedNotice.WriteUserName + '</td>';
                Orderhtml += '        <td style=" text-align: right" colspan="2">开单时间：</td>';
                Orderhtml += '        <td style=" text-align: left;" colspan="2">' + formatDate(BY_FlawedNotice.WriteDate, 'yyyy-MM-dd') + '</td>';

                Orderhtml += '    </tr>';
                Orderhtml += '</table>';
                $("#my_area").append(Orderhtml);
            });
        })
        //确认打印
        function AcceptClick() {
            MyPreview();
        }
    </script>

</head>
<body style="overflow-x: hidden;">
    <div id="my_area" style="background: #fff;">
        <div style="float: left; position: absolute; ">
            @*<img style="width: 40px;padding: 5px;" src="@Url.Content("~/Content/Images/111.jpg")" />*@
        </div>
        @*<div id="reprint" style="position: absolute; right: 15px; top: 15px; display: none; "><span style="font-size: 18px; font-weight: bold;"></span></div>*@
    </div>

</body>
<script language="javascript" type="text/javascript">
    function MyPreview() {
        ////var LODOP = getLodop();
        LODOP.PRINT_INIT("打印初始化");
        LODOP.SET_PRINT_PAGESIZE(1, "217mm", "140mm", "")
        var strHTML = document.getElementsByTagName("html")[0].innerHTML;
        LODOP.ADD_PRINT_HTM(0, 0, "100%", "100%", strHTML);
        LODOP.PREVIEW();
        //LODOP.PRINTA();
        top.frames[tabiframeId()].windowload();
        window.setTimeout(function () {closeDialog();}, 500);
        //if (LODOP.PRINTA()) {
        //    LODOP.PRINT();
        //    tipDialog("打印成功", 3, 1);
        //    top.frames[tabiframeId()].windowload();
        //    window.setTimeout(function () {closeDialog();}, 500);

        //}
        //else
        //    //alert("");
        //    tipDialog("放弃打印！", 3, 1);

    };
</script>
<style>
    .form-print th {
        font-size: 12pt;
        font-family: sans-serif;
        background-color: #fff;
        height: 25px;
        line-height: 25;
        white-space: nowrap;
        width: 80px;
        font-weight: bold;
        text-align: right;
        padding-right: 2px;
    }

    .form-print td {
        font-family: sans-serif;
        height: 25px;
        line-height: 25px;
        padding-right: 2px;
        font-size: 12pt;
        font-weight: bold;
    }

    .tb_Order_Detail td {
        border: 1px solid #000000;
    }

    .tb_Order_Detail th {
        text-align: center;
    }

    .topline {
        border-top: 1px solid #000000;
        text-align: center;
    }

    .rightline {
        border-right: 1px solid #000000;
    }

    .bottomline {
        border-bottom: 1px solid #000000;
    }
</style>
</html>
