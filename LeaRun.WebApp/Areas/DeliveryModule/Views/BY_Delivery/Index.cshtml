        }

        function DeliveryPrint(perType, printType, edit, deliverycodes) {
            //var DeliveryId = GetJqGridRowValue("#gridTable", "deliveryid");
            //if (IsChecked(DeliveryId)) {
                PrintDialog("/DeliveryModule/BY_Delivery/" + printType + "?DeliveryIds=" + deliverycodes + "&perType=" + perType + "&edit=" + edit, "PrintPage", "报价单打印", 850, 500, function (iframe) {
                    top.frames[iframe].AcceptClick();
                });
            //}
        }

        function btn_Invoice() {
            //var IsInvoice = GetJqGridRowValue("#gridTable", "comebackuserid");
            //if (!!IsInvoice) {
            //    alertDialog("当前送货单已回单", 0);
            //    return false;
            //}
            var IsInvoice = GetJqGridRowValue("#gridTable", "audituserid");
            if (!!IsInvoice) {
               alertDialog("当前送货单已审核", 0);
               return false;
            }
            var KeyValue = GetJqGridRowValue("#gridTable", "deliveryid");
            if (IsChecked(KeyValue)) {
                confirmDialog("提示", "确定回单？", function (r) {
                    if (r) {
                        Loading(true, "正在提交数据...");
                        window.setTimeout(function () {
                            AjaxJson("/DeliveryModule/BY_Delivery/Update", { KeyValue: KeyValue, ComeBackUserId: "1" }, function (data) {
                                tipDialog(data.Message, 3, data.Code);
                                windowload();
                            });
                        }, 200);
                    }
                });
            }
        }
        function btn_audit() {
            //var IsInvoice = GetJqGridRowValue("#gridTable", "audituserid");
            //if (!!IsInvoice) {
            //    alertDialog("当前送货单已审核", 0);
            //    return false;
            //}
            var KeyValue = GetJqGridRowValue("#gridTable", "deliveryid");
            if (IsChecked(KeyValue)) {
                confirmDialog("提示", "确定要审核通过？", function (r) {
                    if (r) {
                        Loading(true, "正在提交数据...");
                        window.setTimeout(function () {
                            AjaxJson("/DeliveryModule/BY_Delivery/Update", { KeyValue: KeyValue, AuditUserId: "1" }, function (data) {
                                tipDialog(data.Message, 3, data.Code);
                                windowload();
                            });
                        }, 200);
                    }
                });
            }
        }
        function btn_zuofei() {
            var IsInvoice = GetJqGridRowValue("#gridTable", "audituserid");
            if (!!IsInvoice) {
                alertDialog("当前送货单已审核", 0);
                return false;
            }
            var getedamount = GetJqGridRowValue("#gridTable", "getedamount");
            if (getedamount > 0) {
                alertDialog("已收款，请删除后作废！", 0);
                return false;
            }
            var checksheetcode = GetJqGridRowValue("#gridTable", "checksheetcode");
            if (!!checksheetcode) {
                alertDialog("已对账，请删除后作废！", 0);
                return false;
            }
            var KeyValue = GetJqGridRowValue("#gridTable", "deliveryid");
            if (IsChecked(KeyValue)) {
                confirmDialog("提示", "确定要取消此订单吗？", function (r) {
                    if (r) {
                        Loading(true, "正在提交数据...");
                        window.setTimeout(function () {
                            AjaxJson("/DeliveryModule/BY_Delivery/Update", { KeyValue: KeyValue, Enabled: "-1" }, function (data) {
                                tipDialog(data.Message, 3, data.Code);
                                windowload();
                            });
                        }, 200);
                    }
                });
            }
        }
        function btn_Printed() {
            var DeliveryId = GetJqGridRowValue("#gridTable", "deliveryid");
            if (IsChecked(DeliveryId)) {
                confirmDialog("提示", "确定此送货单已打印？", function (r) {
                    if (r) {
                        Loading(true, "正在提交数据...");
                        window.setTimeout(function () {
                            AjaxJson("/DeliveryModule/BY_Delivery/Update", { KeyValue: DeliveryId, PrintUserId: "1" }, function (data) {
                                windowload();
                            });
                        }, 200);
                    }
                });
            }
        }
        //导出
        function btn_Export() {
            SetDeriveExcel("#gridTable", "送货单");

            Loading(true, "正在处理要导出数据...");
            window.setTimeout(function () {
                location.href = "/Utility/GetDeriveExcel";
                Loading(false);
            }, 200);
        }
        function btn_Export1() {
            var Condition = GetParameterJson("QueryParameter");
            Loading(true, "正在处理要导出数据...");
            window.setTimeout(function () {
                location.href = "@Url.Content("~/DeliveryModule/BY_Delivery/DownLoadExcel1")?Condition=" + escape(Condition);
                Loading(false);
            }, 200);
    }
    function btn_Export2() {
            var Condition = GetParameterJson("QueryParameter");
            Loading(true, "正在处理要导出数据...");
            window.setTimeout(function () {
                location.href = "@Url.Content("~/DeliveryModule/BY_Delivery/DownLoadExcel2")?Condition=" + escape(Condition);
                Loading(false);
            }, 200);
        }
    function btn_Weight() {
        var deliverycode = GetJqGridRowValue("#gridTable", "deliverycode");
        if (IsChecked(deliverycode)) {
            openDialog("/DeliveryModule/BY_Delivery/QueryWeight?deliverycode=" + deliverycode, "Query", "重量明细查询", 850, 560, function (iframe) {
                top.frames[iframe].AcceptClick()
            });
        }
    }
    function btn_edit() {
        var IsInvoice = GetJqGridRowValue("#gridTable", "audituserid");
        if (!!IsInvoice) {
            alertDialog("当前送货单已审核", 0);
            return false;
        }
        var getedamount = GetJqGridRowValue("#gridTable", "getedamount");
        if (getedamount > 0) {
            alertDialog("已收款，请删除后作废！", 0);
            return false;
        }
        var checksheetcode = GetJqGridRowValue("#gridTable", "checksheetcode");
        if (!!checksheetcode) {
            alertDialog("已对账，请删除后作废！", 0);
            return false;
        }

        var deliveryid = GetJqGridRowValue("#gridTable", "deliveryid");
        if (IsChecked(deliveryid)) {
            var url = "/DeliveryModule/BY_Delivery/Form?KeyValue=" + deliveryid;
            openDialog(url, "Form", "修改对账时间", 650, 460, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
</script>
