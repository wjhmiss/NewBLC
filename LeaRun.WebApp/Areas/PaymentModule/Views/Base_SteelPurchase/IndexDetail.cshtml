@{
    ViewBag.Title = "库存表";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    var tempred = "";
    $(function () {
        //钢种下拉框
        //SteelAutocomplete();
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    //加载表格
    function GetGrid() {
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/PaymentModule/Base_SteelPurchase/GridPageListJson")?MaterialType=" + $("input[name=MaterialType]:checked").val() + "&SteelCode=" + escape($.trim($("#SteelCode").val())) + "&BatchCode=" + escape($.trim($("#BatchCode").val())),
            datatype: "json",
            height: $(window).height() - 193,
            autowidth: true,
            colModel: [
                    { label: '库存ID', name: 'inventoryid', index: 'inventoryid', width: 0, align: 'left', sortable: true, hidden: true },
                    {
                        label: '入库日期', name: 'instockdate', index: 'instockdate', width: 120, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    { label: '钢种编号', name: 'steelcode', index: 'steelcode', width: 80, align: 'left', sortable: true },
                    { label: '钢材编码', name: 'batchcode', index: 'batchcode', width: 120, align: 'left', sortable: true },
                    { label: '厚度(直径)', name: 'othick', index: 'thick', width: 60, align: 'left', sortable: true },
                    { label: '宽度', name: 'oweigh', index: 'weigh', width: 60, align: 'left', sortable: true },
                    { label: '长度', name: 'olength', index: 'length', width: 60, align: 'left', sortable: true },
                    { label: '件数', name: 'qty', index: 'qty', width: 60, align: 'left', sortable: true },


                    { label: '孔径', name: 'boresize', index: 'boresize', width: 60, align: 'left', sortable: true },

                    {
                        label: '来重', name: 'oweight', index: 'weight', width: 80, align: 'left', sortable: true
                    },
                    {
                        label: '称重', name: 'weightcheng', index: 'weightcheng', width: 80, align: 'left', sortable: true
                    },
                     {
                         label: '单价', name: 'price', index: 'price', width: 80, align: 'left', sortable: true
                     },
                      {
                          label: '总额', name: 'totalamount', index: 'totalamount', width: 80, align: 'left', sortable: true
                      },


                    //{
                    //    label: '剩余重量', name: 'weight', index: 'weight', width: 80, align: 'left', sortable: true
                    //},
                    //{
                    //    label: '剩余长度', name: 'length', index: 'length', width: 80, align: 'left', sortable: true
                    //},
                    { label: '炉号', name: 'stovecode', index: 'stovecode', width: 100, align: 'left', sortable: true },

                    { label: '采购单', name: 'steelpurchasecode', index: 'steelpurchasecode', width: 100, align: 'left', sortable: true },
                    { label: '供应商编码', name: 'customercode', index: 'customercode', hidden: true },
                    { label: '供应商名称', name: 'customername', index: 'customername', width: 100, sortable: true },
                    { label: '原始尺寸', name: 'originalsize', index: 'originalsize', hidden: true },
                    { label: '备注', name: 'remark', index: 'remark', hidden: true },
                    { label: '创建人', name: 'createusername', index: 'createusername', hidden: true }, ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'instockdate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: false,
            altclass: 'altclass',
            gridview: true,
            footerrow: true,
            gridComplete: function () {
                //合计
                //var strred = tempred.trim(',').split(',');
                //for (i = 0; i < strred.length; i++) {
                //    $("#" + strred[i]).find('td').css("background-color", "red");
                //}
                //tempred = "";
                if ($("#alarmck").prop("checked")) {
                    $("#gridTable").find('td').css("background-color", "red");
                }

                $(this).footerData("set", {
                    "steelcode": "合计",
                    "oweight": $("#gridTable").getCol('oweight', false, 'sum'),
                    "totalamount": $("#gridTable").getCol('totalamount', false, 'sum')
                });
            },
            ondblClickRow: function (rowid, iRow, iCol, e) {
                btn_edit();
            }
        });
    }
    //编辑
    function btn_edit() {
        var KeyValue = GetJqGridRowValue("#gridTable", "inventoryid");
        if (IsChecked(KeyValue)) {
            var url = "/PaymentModule/Base_SteelPurchase/Form?KeyValue=" + KeyValue;
            openDialog(url, "Form", "修改库存", 770, 170, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //删除
    function btn_delete() {
        var KeyValue = GetJqGridRowValue("#gridTable", "inventoryid");
        if (IsDelData(KeyValue)) {
            var delparm = 'KeyValue=' + KeyValue;
            delConfig('/PaymentModule/Base_SteelPurchase/Delete', delparm, KeyValue.split(",").length);
        }
    }

    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入
    }
    //查询
    function btn_Search() {
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/PaymentModule/Base_SteelPurchase/GridPageListJson")?MaterialType=" + $("input[name=MaterialType]:checked").val() + "&SteelCode=" + escape($.trim($("#SteelCode").val())) + "&BatchCode=" + escape($.trim($("#BatchCode").val())) + "&Thick=" + $.trim($("#Thick").val()) + "&Weigh=" + $.trim($("#Weigh").val()) + "&Length=" + $.trim($("#Length").val()) + "&alarmck=" + $("#alarmck").attr("checked") + "&SteelPurchaseCode=" + $("#SteelPurchaseCode").val() + "&CustomerCode=" + escape($("#CustomerCode").val()) + "&StartTime=" + $("#StartTime").val() + "&EndTime=" + $("#EndTime").val(), page: 1 }).trigger('reloadGrid');
    }
    //导出
    function btn_Export() {
        SetDeriveExcel("#gridTable", "库存信息");

        Loading(true, "正在处理要导出数据...");
        window.setTimeout(function () {
            location.href = "/Utility/GetDeriveExcel";
            Loading(false);
        }, 200);
    }

    //钢材编码自动补全
    function SteelAutocomplete() {
        var $SteelCode = $("#SteelCode");
        $SteelCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("SteelCode", function (data) {
            $("#SteelCode").val(data.SteelCode);
        });
        //获取数据源
        function DataSource() {
            AjaxJson("/CommonModule/Steel/GetAutoCompleJson", { keywords: $SteelCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="SteelId" style="display: none;">' + DataJson[i].SteelId + '</td>';
                    html += '<td id="SteelCode" style="width: 50%;">' + DataJson[i].SteelCode + '</td>';
                    html += '<td id="SteelName" style="width: 100%;">' + DataJson[i].SteelName + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("SteelCode", $SteelCode.width() + "px", "200px", html, function (data) {
                    $("#SteelCode").val(data.SteelCode);
                });
            });
        }
    }
    //新增
    function btn_add() {
        var url = "/StorageModule/BY_InStock/BoardForm"
        openDialog(url, "Form", "板件入仓", 650, 230, function (iframe) {
            top.frames[iframe].AcceptClick()
        });
    }
</script>

<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr style="display:none;">
            <th>类型：</th>
            <td colspan="2">
                <span class="item">
                    <input type="radio" name="MaterialType" value="-1" checked="checked" id="all" />
                    <label for="all">&nbsp; 全部&nbsp; &nbsp; </label>
                </span>
                <span class="item">
                    <input type="radio" name="MaterialType" value="0" id="board" />
                    <label for="board">&nbsp; 条钢&nbsp;&nbsp;  </label>
                </span>
                <span class="item">
                    <input type="radio" name="MaterialType" value="1" id="broken" />
                    <label for="broken">&nbsp; 碎料&nbsp; </label>
                </span>
            </td>
           
            <td colspan="6"><span class="item" style="cursor: pointer;">
                <input type="checkbox" class="checkbox" name="checkbox" id="alarmck" />
                <label for="Refresh">报警</label>
            </span>(报警规则：相同钢种、厚度、宽度，如果最长长度小于2米，即报警)</td>
        </tr>
        <tr>
            <th>钢种：</th>
            <td>
                <input id="SteelCode" maxlength="50" type="text" class="txt" />
            </td>
             <th>采购单：</th>
            <td>
                <input id="SteelPurchaseCode" maxlength="50" type="text" class="txt" />
            </td>
            <th style="width: 20px;">厚：</th>
            <td>
                <input id="Thick" maxlength="50" type="text" class="txt" style="width: 50px;" />
            </td>
            <th style="width: 20px;">宽：</th>
            <td>
                <input id="Weigh" maxlength="50" type="text" class="txt" style="width: 50px;" />
            </td>
            <th style="width: 20px;">长：</th>
            <td>
                <input id="Length" maxlength="50" type="text" class="txt" style="width: 50px;" />
            </td>
            <th style="width: 20px;">供应商：</th>
            <td>
                <input id="CustomerCode" maxlength="50" type="text" class="txt" style="width: 100px;" />
            </td>
            <th>采购时间：</th>
            <td>
                <input id="StartTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 00:00'})" style="width: 120px" />
                <input id="EndTime" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd 23:59'})" style="width: 120px" />
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
                <input id="btnExport" type="button" class="btnSearch" value="导 出" onclick="btn_Export()" />

            </td>
            <td>
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
