            </div>
            <div class="swiper-slide">
                <img src="~/Content/Scripts/Mobile/templates/mobile/images/banner2.jpg" />
            </div>
            <div class="swiper-slide">
                <img src="~/Content/Scripts/Mobile/templates/mobile/images/banner3.jpg" />
            </div>
        </div>
