    function WorkerNameAutocomplete(objectid) {
        var $WorkerName = $("#" + objectid);
        $WorkerName.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown(objectid, function (data) {
            if (!!data.WorkerName) {
                $("#" + objectid).val(data.WorkerName);
            }

        });
        //获取数据源
        function DataSource() {
            AjaxJson("/CommonModule/Worker/GetAutoCompleJson", { keywords: $WorkerName.val(), DepartmentName: "热处理" }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="WorkerId" style="display: none;">' + DataJson[i].WorkerId + '</td>';
                    html += '<td id="WorkerCode" style="width: 30%;">' + DataJson[i].WorkerCode + '</td>';
                    html += '<td id="WorkerName" style="width: 40%;">' + DataJson[i].WorkerName + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete(objectid,   "200px", "280px", html, function (data) {
                    if (!!data.WorkerName) {
                        $("#" + objectid).val(data.WorkerName);

                    }
                });
            });
        }
    }


