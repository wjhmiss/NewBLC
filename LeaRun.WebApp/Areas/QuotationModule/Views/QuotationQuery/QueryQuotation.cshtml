@{
    ViewBag.Title = "报价单查询";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script>
    var LTpye = GetQuery('LTpye');
    $(function () {

        window.setTimeout(function () {
            GetGrid();
            $('#gridTable').setGridWidth(830);
        }, 300);
        //if (GetQuery('steelPurchase') == "1") {
        //    $("#gridTable").jqGrid('setGridParam', {
        //        multiselect: true
        //    }).trigger('reloadGrid');
        //}

    });
    //查询
    function btn_Search() {

        $("#gridTable").jqGrid('setGridParam', {
            url: "@Url.Content("~/QuotationModule/QuotationQuery/GridPageListJson1")?Size=" + $("#Size").val() + "&CustomerCode=" + $("#CustomerCode").val() + "&MnemonicCode=" + $("#MnemonicCode").val()
                + "&LTpye=" + $("#LTpye").val(), page: 1
        }).trigger('reloadGrid');
    }
    //报价单列表
    function GetGrid() {
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/QuotationModule/QuotationQuery/GridPageListJson1?Size=999*9*9")",
            datatype: "json",
            height: 457,
            autowidth: true,
            colModel: [
                    { label: '主键', name: 'quotationdetailid', hidden: true },
            { label: '助记号', name: 'mnemoniccode', index: 'mnemoniccode', width: 120, align: 'left', sortable: true },
                    { label: '报价单号', name: 'quotationcode', index: 'quotationcode', width: 120, align: 'left', sortable: true },
                    { label: '行号', name: 'linecode', index: 'linecode', width: 50, align: 'center', sortable: true },
                    { label: '客户编号', name: 'customercode', index: 'customercode', width: 50, align: 'center', sortable: true },
                    { label: '客户品名', name: 'productname', index: 'productname', width: 120, align: 'left', sortable: true },
                    { label: '数量', name: 'qty', index: 'qty', width: 50, align: 'left', sortable: true },
                    { label: '长', name: 'length', index: 'length', width: 50, align: 'left', sortable: true },
                    { label: '宽', name: 'weigh', index: 'weigh', width: 50, align: 'left', sortable: true },
                    { label: '厚', name: 'thick', index: 'thick', width: 50, align: 'left', sortable: true },
                    { label: '公差', name: 'remark', index: 'remark', width: 120, align: 'left', sortable: true },
            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 1000],
            pager: "#gridPager",
            sortname: 'CreateDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
            ondblClickRow: function () {
                AcceptClick();
            },

        });
    }
    //确认事件
    function AcceptClick() {
        var QuotationCode = GetJqGridRowValue("#gridTable", "quotationcode");
        top.frames[tabiframeId()].$("#QuotationCode").val(QuotationCode);
        top.frames[tabiframeId()].btn_Search();
        window.setTimeout(function () {closeDialog();}, 500);
    }
</script>
<div class="leftline rightline topline QueryArea" style="margin: 1px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>尺寸：</th>
            <td>
                <input id="Size" type="text" class="txt" style="width: 100px" />
            </td>
            <th>杠号：</th>
            <td>
                <input id="MnemonicCode" type="text" class="txt" style="width: 100px" />
            </td>
            <th>客户编码：</th>
            <td>
                <input id="CustomerCode" type="text" class="txt" style="width: 100px" />
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="查 询" onclick="btn_Search()" />Φ
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
