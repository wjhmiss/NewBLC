@{
    ViewBag.Title = "设置绩效》表单页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    var KeyValue = GetQuery('KeyValue');//主键
    $(function () {
        //工序
        BindDropItemName("#TechnologyName", "Operation", "==请选择==");
        //加工类型
        BindDropItem("#OrderType", "ProcessType", "==请选择==");
        //钢材类型
        BindDropItem("#SteelType", "SteelType", "==请选择==");

        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/CommonModule/Base_SetPerformanceForArea/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
            });
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        var postData = GetWebControls("#form1");
        $(".ui_state_highlight").attr("disabled", true);
        AjaxJson("/CommonModule/Base_SetPerformanceForArea/SubmitForm?KeyValue=" + KeyValue, postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            window.setTimeout(function () {closeDialog();}, 500);
        });
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class='formTitle'>工艺名称：</th>
            <td class='formValue'>
                <select id="TechnologyName" class="txtselect" datacol="yes" err="工艺名称" checkexpession="NotNull">
                    <option value="">请选择</option>
                </select>
            </td>
        </tr>
        <tr>
            <th class='formTitle'>钢材类型：</th>
            <td class='formValue'>
                <select id="SteelType" class="txtselect" datacol="yes" err="钢材类型" checkexpession="NotNull">
                    <option value="">请选择</option>
                </select>
            </td>
        </tr>
        <tr>
            <th class='formTitle'>加工类型：</th>
            <td class='formValue'>
                <select id="OrderType" class="txtselect" datacol="yes" err="加工类型" checkexpession="NotNull">
                    <option value="">请选择</option>
                </select>
            </td>
        </tr>
          <tr>
            <th class='formTitle'>单价/面积：</th>
            <td class='formValue'>
                <input id="PriceArea"  onfocus="IsMoney(this.id);"  maxlength="50" type="text" class="txt" datacol="yes" err="加工类型" checkexpession="NotNull" />
            </td>
        </tr>
          <tr>
            <th class='formTitle'>保底面积：</th>
            <td class='formValue'>
                <input id="LimitArea"  onfocus="IsMoney(this.id);"  maxlength="50" type="text" class="txt" datacol="yes" err="加工类型" checkexpession="NotNull" />
            </td>
        </tr>
         <tr>
            <th class='formTitle'>单价/件：</th>
            <td class='formValue'>
                <input id="PriceByPer"  onfocus="IsMoney(this.id);"  maxlength="50" type="text" class="txt" datacol="yes" err="系数" checkexpession="NotNull" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>系数：</th>
            <td class='formValue'>
                <input id="NumberC"  onfocus="IsMoney(this.id);"  maxlength="50" type="text" class="txt" datacol="yes" err="系数" checkexpession="NotNull" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>备注：</th>
            <td class='formValue'>
                <input id="Remark" maxlength="2000" type="text" class="txt" />
            </td>
        </tr>

    </table>
</form>
