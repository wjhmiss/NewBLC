                                size = "";
                                QuotationDetail[i].MaterialPrice = "";
                                QuotationDetail[i].WorkPrice = "";
                                QuotationDetail[i].SmallCost = "";
                                QuotationDetail[i].JKCost = "";
                                QuotationDetail[i].DDCostPer = "";
                                QuotationDetail[i].Qty = "";
                                QuotationDetail[i].Weight = "";
                                QuotationDetail[i].SalesAmount = "";
                                 Length = "";
                                 Weigh = "";
                                 Thick = "";
                                 AddLength = "";
                                 AddWeigh = "";
                                 AddThick = "";
                                 weightper = "";
