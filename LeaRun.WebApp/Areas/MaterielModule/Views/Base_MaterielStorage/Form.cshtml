                <input id="CustomerName" maxlength=50 type="text" class="txt"   />
            </td>
            <th class='formTitle'>单价：</th>
            <td class='formValue'>
                <input id="PricePer" maxlength=18 type="text" class="txt"   />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>数量：</th>
            <td class='formValue'>
                <input id="Qty" maxlength=10 type="text" class="txt"   />
            </td>
            <th class='formTitle'>总金额：</th>
