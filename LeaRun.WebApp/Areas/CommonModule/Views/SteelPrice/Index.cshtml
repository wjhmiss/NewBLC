@{
    ViewBag.Title = "钢材价目表";
    Layout = "~/Views/Shared/_LayoutIndex.cshtml";
}
<script type="text/javascript">
    $(function () {
        window.setTimeout(function () {
            GetGrid();
        }, 200);
    })
    //查询
    function btn_Search() {
        var Parameter = [{
            paramName: "SteelCode",
            paramValue: $("#keywords").val(),
            Operation: "Like",
            Logic: "OR"
        }, {
            paramName: "SteelName",
            paramValue: $("#keywords").val(),
            Operation: "Like"
        }]
        $("#gridTable").jqGrid('setGridParam', { url: "@Url.Content("~/CommonModule/SteelPrice/GridPageJson")?ParameterJson=" + escape(JSON.stringify(Parameter)), page: 1 }).trigger('reloadGrid');
    }
    //加载表格
    function GetGrid() {
        $("#gridTable").jqGrid({
            url: "@Url.Content("~/CommonModule/SteelPrice/GridPageJson")",
            datatype: "json",
            height: $(window).height() - 149,
            autowidth: true,
            colModel: [
                    { label: '钢材价目主键', name: 'SteelPriceId', hidden: true },
                    { label: '加工类型', name: 'ProcessType', index: 'ProcessType', width: 80, align: 'center', sortable: true },
                    { label: '钢材编码', name: 'SteelCode', index: 'SteelCode', width: 80, align: 'left', sortable: true },
                    { label: '钢材名称', name: 'SteelName', index: 'SteelName', width: 200, align: 'left', sortable: true },
                    { label: '通用编码', name: 'CommonCode', index: 'CommonCode', width: 80, align: 'left', sortable: true },
                    { label: '厚度/直径从', name: 'SizeStart', index: 'SizeStart', width: 80, align: 'center', sortable: true },
                    { label: '厚度/直径至', name: 'SizeEnd', index: 'SizeEnd', width: 80, align: 'center', sortable: true },
                    { label: '单位', name: 'Unit', index: 'Unit', width: 80, align: 'center', sortable: true },
                    {
                        label: '圆料', name: 'RoundFeed', index: 'RoundFeed', width: 45, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (cellvalue == '1') return "<img src='../../Content/Images/checkokmark.gif'/>";
                            if (cellvalue == '0') return "<img src='../../Content/Images/checknomark.gif'/>";
                        }
                    },
                    { label: '单价', name: 'Price', index: 'Price', width: 60, align: 'center', sortable: true },
                    { label: '折扣', name: 'DiscountRate', index: 'DiscountRate', width: 60, align: 'center', sortable: true },
                    { label: '折扣单价', name: 'DiscountPrice', index: 'DiscountPrice', width: 60, align: 'center', sortable: true },
                    {
                        label: '备注', name: 'Remark', index: 'Remark', width: 200, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (!!cellvalue) {
                                return cellvalue.replace(/,/g, "，");;

                            }
                            return "";
                        }
                    },
                    {
                        label: '有效', name: 'Enabled', index: 'Enabled', width: 45, align: 'center', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            if (cellvalue == '1') return "<img src='../../Content/Images/checkokmark.gif'/>";
                            if (cellvalue == '0') return "<img src='../../Content/Images/checknomark.gif'/>";
                        }
                    },
                    {
                        label: '最近更新时间', name: 'ModifyDate', index: 'ModifyDate', width: 120, align: 'left', sortable: true,
                        formatter: function (cellvalue, options, rowObject) {
                            return formatDate(cellvalue, 'yyyy-MM-dd');
                        }
                    },
                    { label: '最后修改人', name: 'ModifyUserName', index: 'ModifyUserName', width: 80, align: 'left', sortable: true },
            ],
            viewrecords: true,
            rowNum: 30,
            rowList: [30, 50, 100, 500, 5000],
            pager: "#gridPager",
            sortname: 'CreateDate',
            sortorder: 'desc',
            rownumbers: true,
            shrinkToFit: false,
            altRows: true,
            altclass: 'altclass',
            gridview: true,
        });
    }
    //新增
    function btn_add() {
        var url = "/CommonModule/SteelPrice/Form"
        openDialog(url, "Form", "新增钢材价目", 650, 270, function (iframe) {
            top.frames[iframe].AcceptClick()
        });
    }
    //编辑
    function btn_edit() {
        var KeyValue = GetJqGridRowValue("#gridTable", "SteelPriceId");
        if (IsChecked(KeyValue)) {
            var url = "/CommonModule/SteelPrice/Form?KeyValue=" + KeyValue;
            openDialog(url, "Form", "编辑钢材价目", 650, 270, function (iframe) {
                top.frames[iframe].AcceptClick();
            });
        }
    }
    //删除
    function btn_delete() {
        var KeyValue = GetJqGridRowValue("#gridTable", "SteelPriceId");
        if (IsDelData(KeyValue)) {
            var delparm = 'KeyValue=' + KeyValue;
            delConfig('/CommonModule/SteelPrice/Delete', delparm, KeyValue.split(",").length);
        }
    }
    //刷新
    function windowload() {
        $("#gridTable").trigger("reloadGrid"); //重新载入

    }
</script>
<!--工具栏-->
<div class="tools_bar leftline rightline" style="margin: 1px; margin-bottom: 0px;">
    <div class="PartialButton">
        @Html.Partial("_PartialButton")
    </div>
</div>
<div class="leftline rightline QueryArea" style="margin: 1px; margin-top: 0px; margin-bottom: 0px;">
    <table border="0" class="form-find" style="height: 45px;">
        <tr>
            <th>关键字：</th>
            <td>
                <input id="keywords" type="text" class="txt" style="width: 200px" />
            </td>
            <td>
                <input id="btnSearch" type="button" class="btnSearch" value="搜 索" onclick="btn_Search()" />
            </td>
        </tr>
    </table>
</div>
<div class="topline rightline" style="margin: 1px; margin-top: -1px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
