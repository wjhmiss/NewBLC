@{
    ViewBag.Title = "BY_CSBReport》明细页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    $(function () {
        InitControl();
    })
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/QualityModule/BY_CSBReport/SetForm", { KeyValue: GetQuery('KeyValue') }, function (data) {
                SetWebControls(data);
            });
        }
    }
</script>
<form id="form1" style="margin: 1px">
    <table class="form">
        <tr>
            <th class='formTitle'>CSBReportId：</th>
            <td class='formValue'>
                <label id="CSBReportId" />
            </td>
            <th class='formTitle'>CSBReportCode：</th>
            <td class='formValue'>
                <label id="CSBReportCode" />
            </td>
            <th class='formTitle'>订单明细ID：</th>
            <td class='formValue'>
                <label id="OrderDetailId" />
            </td>
            <th class='formTitle'>订单号：</th>
