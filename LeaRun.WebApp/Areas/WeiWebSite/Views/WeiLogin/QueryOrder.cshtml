@{
    ViewBag.Title = "用户中心";
    Layout = "~/Views/Shared/_LayoutMobile.cshtml";
}

<script>
    var CreateDate_StartTime = GetQuery('StartTime') == "" ? "" : GetQuery('StartTime')+" 00:00";
    var CreateDate_EndTime = GetQuery('EndTime') == "" ? "" : GetQuery('EndTime') + " 23:59";
    var OrderCode = GetQuery('OrderCode');
    var QuotationCode = GetQuery('QuotationCode');
    var ShortName = GetQuery('ShortName');
    var OrderStatus = GetQuery('OrderStatus');
    
    function querys(page) {
        //var page = GetQuery("page") == "" ? 1 : GetQuery("page");
        var Condition = '{CreateDate_StartTime:' + CreateDate_StartTime + ',CreateDate_EndTime:' + CreateDate_EndTime + ',OrderCode:' + OrderCode + ',QuotationCode:' + QuotationCode + ',ShortName:' + ShortName + ',OrderStatus:' + OrderStatus + '}'
        $.ajax({
            url: "@Url.Content("~/OrderModule/OrderQuery/GridPageListJson")?Condition=" + escape(Condition),
            type: "post",
            dataType: "json",
            data: { "rows": 30, "page": page },
            async: true,
            success: function (data) {
                $("#list").html("");
                $.each(data.rows, function (i) {
                    var html = '<li><a href="@Url.Content("~/WeiWebSite/WeiLogin/QueryOrderDetail")?orderid=' + data.rows[i].orderid + '&quotationcode=' + data.rows[i].quotationcode + '" data-ignore="true">';
                    html += '<div style="font-weight: 900; font-size: 1.11em; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; float: left; text-align: center; width: 75px; height: 75px; line-height: 75px; border: 1px solid #0088D1; vertical-align: middle; display: inline-block; margin-right: 5px;">';
                    html += '<b class="#0088D1" style="color: red;">' + data.rows[i].orderstatus + '</b>';
                    html += '</div><h2>加工单号：' + data.rows[i].ordercode + '</h2><div class="note">';
                    html += '<p>客户名称：' + data.rows[i].shortname + ' 合同：' + data.rows[i].quotationcode + ' 时间：' + data.rows[i].placeorderdate + '</p>';
                    html += '<p><i class="hot">总金额：￥' + data.rows[i].amount + '</i><i class="hot" style="float: left;">总件数：' + data.rows[i].qty + '件</i></p>';
                    $("#list").append(html);
                });
                var htmlpage = '<span>共' + data.records + '记录</span>';
                if (data.page == 1) {
                    htmlpage += '<span class="disabled">«上一页</span>';
                }
                else {
                    htmlpage += '<a href="javascript:;" onclick="querys(' + (data.page - 1) + ')" data-ignore="true">«上一页</a>';
                }
                htmlpage += '<span class="current">' + data.page + '</span>';
                if (data.page == data.total || data.total == 1) {
                    htmlpage += '<span class="disabled">下一页»</span>';
                }
                else {
                    htmlpage += '<a href="javascript:;" onclick="querys(' + (data.page + 1) + ')" data-ignore="true">下一页»</a>';
                }
                $("#listPage").html("");
                $("#listPage").append(htmlpage);
            },
            error: function (data) {
                alert(data.responseText);
            }

        });
        }
    //初始化
    $(function () {
        querys(1);
        $("#getWhere").click(function () {
            location.href = "@Url.Content("~/WeiWebSite/WeiLogin/QueryOrderWhere")";
        });
    })

    function locationInputQuot() {
        location.href = "@Url.Content("~/WeiWebSite/WeiLogin/WeiIndex")";
    }

</script>



<div id="mainPanel" class="panel" data-header="main_header" data-footer="main_footer">
    <!--筛选按钮-->
    <div class="select-bar">
        <div class="col">
            <a href="javascript:;" class="icon-back" onclick="history.back(-1);">返回上一页</a>
        </div>
        <div class="col">
            <a id="getWhere" href="javascript:;" class="icon-carat-r">加工单筛选</a>
