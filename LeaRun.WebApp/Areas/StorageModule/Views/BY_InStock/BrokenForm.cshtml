@{
    ViewBag.Title = "入仓表》表单页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    var KeyValue = GetQuery('KeyValue');//主键
    $(function () {
        BindCombobox();
        InitControl();
    })
    //初始化绑定下拉框
    function BindCombobox() {
        //外观类型下拉框
        //BindDropItem("#SteelType", "FaceType", "==请选择==");
        //钢板状态下拉框
        //BindDropItem("#SteelStatus", "SteelStatus", "==请选择==");
        //钢种下拉框
        SteelAutocomplete();
    }
    //钢材编码自动补全
    function SteelAutocomplete() {
        var $SteelCode = $("#SteelCode");
        $SteelCode.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("SteelCode", function (data) {
            $("#SteelId").val(data.SteelId);
            $("#SteelCode").val(data.SteelCode);
            $("#SteelDescription").val(data.SteelName);
            Density = data.Density;
        });
        //获取数据源
        function DataSource() {
            AjaxJson("/CommonModule/Steel/GetAutoCompleJson", { keywords: $SteelCode.val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="SteelId" style="display: none;">' + DataJson[i].SteelId + '</td>';
                    html += '<td id="SteelCode" style="width: 50%;">' + DataJson[i].SteelCode + '</td>';
                    html += '<td id="SteelName" style="width: 100%;">' + DataJson[i].SteelName + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("SteelCode", $SteelCode.width() + "px", "200px", html, function (data) {
                    $("#SteelId").val(data.SteelId);
                    $("#SteelCode").val(data.SteelCode);
                    $("#SteelDescription").val(data.SteelName);
                });
            });
        }
    }
    //得到一个对象实体
    function InitControl() {
        if (!!GetQuery('KeyValue')) {
            AjaxJson("/StorageModule/BY_InStock/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
            });
        }
    }
    //保存事件
    function AcceptClick() {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        $(".ui_state_highlight").attr("disabled", true);
        var postData = GetWebControls("#form1");
        AjaxJson("/StorageModule/BY_InStock/SubmitBrokenForm?InStockType=1", postData, function (data) {
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            window.setTimeout(function () {closeDialog();}, 500);
        });
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class='formTitle'>钢种：</th>
            <td class='formValue'>
                <input id="SteelId" type="hidden" class="txt" />
                <input id="SteelCode" maxlength="50" type="text" class="txt" datacol="yes" err="钢材编码" checkexpession="NotNull" />
                <input id="SteelDescription" type="hidden" class="txt" />
            </td>
        </tr>
        @*<tr>
            <th class='formTitle'>类型：</th>
            <td class='formValue'>
                <select id="SteelType" class="txtselect"  datacol="yes" err="类型" checkexpession="NotNull" ></select>
            </td>
        </tr>
        <tr>
            <th class='formTitle'>钢板状态：</th>
            <td class='formValue'>
                <select id="SteelStatus" class="txtselect"  datacol="yes" err="钢板状态" checkexpession="NotNull" ></select>
            </td>
        </tr>*@
        <tr>
            <th class='formTitle'>实际重量：</th>
            <td class='formValue'>
                <input id="Weight" maxlength="18" type="text" class="txt"  datacol="yes" err="实际重量" checkexpession="Double" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>价格：</th>
            <td class='formValue'>
                <input id="Price" maxlength="18" type="text" class="txt"  datacol="yes" err="价格" checkexpession="Double" />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>备注：</th>
            <td class='formValue'>
                <input id="Remark" maxlength="200" type="text" class="txt" />
            </td>
        </tr>
    </table>
</form>
