@{
    ViewBag.Title = "工单工序详情表》表单页面";
    Layout = "~/Views/Shared/_LayoutForm.cshtml";
}
<script type="text/javascript">
    var KeyValue ="";//主键
    var TechnologyId = "";//主键
    var id = 0;
    var CustomerName = "";
    var temp1 = 0;
    $(function () {
        document.onkeydown = enterInput;
        id = Number(GetQuery('id'));
        InitControl();
        WorkerNameAutocomplete();
    })
    function WorkerNameAutocomplete() {
        var $WorkerName = $("#OperatorId");
        $WorkerName.bind("keyup", function (e) {
            if (e.which != 13 && e.which != 40 && e.which != 38) {
                DataSource();
            }
        }).focus(function () {
            $(this).select();
            DataSource();
        });
        //上，下键盘回调
        autocompletekeydown("OperatorId", function (data) {
            $("#OperatorName").val(data.WorkerName);
            $("#OperatorId").val(data.WorkerCode);
        });
        //获取数据源
        function DataSource() {
            AjaxJson("/CommonModule/Worker/GetAutoCompleJson", { keywords: $WorkerName.val(), DepartmentName: $("#DepartmentName").val() }, function (DataJson) {
                var html = "";
                $.each(DataJson, function (i) {
                    html += "<tr>";
                    html += '<td id="WorkerId" style="display: none;">' + DataJson[i].WorkerId + '</td>';
                    html += '<td id="WorkerCode" style="width: 30%;">' + DataJson[i].WorkerCode + '</td>';
                    html += '<td id="WorkerName" style="width: 40%;">' + DataJson[i].WorkerName + '</td>';
                    html += "</tr>";
                });
                //点击事件回调
                autocomplete("OperatorId", "400px", "200px", html, function (data) {
                    $("#OperatorName").val(data.WorkerName);
                    $("#OperatorId").val(data.WorkerCode);
                });
            });
        }
    }
    function enterInput() {
        var e = e || window.event || arguments.callee.caller.arguments[0];
        var tar = e.srcElement || e.target;
        if (e && e.keyCode == 13) {//回车
            AcceptClick(tar);
            return;
        }
    }


    //得到一个对象实体
    function InitControl() {
        KeyValue = top.frames[tabiframeId()].$("#gridTable").jqGrid('getRowData', id)["orderdetailprocessdetailid"];
        TechnologyId = top.frames[tabiframeId()].$("#gridTable").jqGrid('getRowData', id)["technologyid"];
        CustomerName = top.frames[tabiframeId()].$("#gridTable").jqGrid('getRowData', id)["customername"];
        if (!!KeyValue) {
            AjaxJson("/OrderDetailProcessModule/BY_OrderDetailProcessDetail/SetForm", { KeyValue: KeyValue }, function (data) {
                SetWebControls(data);
                $("#CustomerName").val(CustomerName);
                if (TechnologyId == "K001") {
                    $("#Weight").removeClass('disabled');
                   
                }
                else {
                    $("#Weight").addClass('disabled');
                    
                }
            });
        }
        else {
            top.frames[tabiframeId()].windowload();
            window.setTimeout(function () {closeDialog();}, 500);
        }
    }
    //保存事件
    function AcceptClick(tar) {
        if (!CheckDataValid('#form1')) {
            return false;
        }
        CountMoney();
        var postData = GetWebControls("#form1");
        AjaxJson("/OrderDetailProcessModule/BY_OrderDetailProcessDetail/SubmitForm?KeyValue=" + KeyValue, postData, function (data) {
            id = Number(id) + 1;
            InitControl();
            
            tipDialog(data.Message, 3, data.Code);
            top.frames[tabiframeId()].windowload();
            $(tar).select();
            //window.setTimeout(function () {closeDialog();}, 500);
        });
    }

    function CountMoney() {
        if (TechnologyId != "K001") {
            $("#Weight").val((Number($("#WeightPer").val()) * Number($("#Qty").val())).toFixed(2));
        }
        if ($("#WorkerUnit").val() == "件") {
            $("#WorkerAmount").val((Number($("#Qty").val()) * Number($("#WorkerPer").val())).toFixed(2));
        }
        else {
            $("#WorkerAmount").val((Number($("#Weight").val()) *  Number($("#WorkerPer").val())).toFixed(2));
        }
    }
</script>
<form id="form1" style="margin: 1px">
    <div id="message" style="display: none"></div>
    <table class="form">
        <tr>
            <th class='formTitle'>客户：</th>
            <td class='formValue'>
                <input id="CustomerName" maxlength=18 type="text" class="txt" disabled />
            </td>
            <th class='formTitle'>钢种：</th>
            <td class='formValue'>
                <input id="SteelDescription" maxlength=10 type="text" class="txt" disabled />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>员工ID：</th>
            <td class='formValue'>
                <input id="OperatorId" maxlength=18 type="text" class="txt" />
            </td>
            <th class='formTitle'>员工姓名：</th>
            <td class='formValue'>
                <input id="OperatorName" maxlength=10 type="text" class="txt" disabled />
            </td>
        </tr>
        <tr>
            <th class='formTitle'>工单号：</th>
            <td class='formValue'>
                <input id="OrderCode" maxlength=10 type="text" class="txt" value="0" disabled />
            </td>
            <th class='formTitle'>行号：</th>
            <td class='formValue'>
                <input id="LineCode" maxlength=10 type="text" class="txt" value="0" disabled />
            </td>
        </tr>
        <tr>

            <th class='formTitle'>数量：</th>
            <td class='formValue'>
                <input id="Qty" maxlength=10 type="text" class="txt" value="0" onfocus="IsMoney(this.id);" onkeyup="CountMoney();" datacol="yes" err="数量" checkexpession="NotNull" />
            </td>
            <th class='formTitle'>重量(公斤)：</th>
            <td class='formValue'>
                <input id="OrderDetailProcessDetailId" type="hidden" />
                <input id="WeightPer" type="hidden" />
                <input id="Weight" maxlength=18 type="text" class="txt" onfocus="IsMoney(this.id);" onkeyup="CountMoney();" datacol="yes" err="重量" checkexpession="NotNull" />
            </td>
        </tr>
        <tr>

            <th class='formTitle'>单价：</th>
            <td class='formValue'>
                <input id="WorkerPer" maxlength=10 type="text" onfocus="IsMoney(this.id);" class="txt" value="0" onkeyup="CountMoney();" datacol="yes" err="单价" checkexpession="NotNull" />
            </td>
            <th class='formTitle'>单位：</th>
            <td class='formValue'>
                <select id="WorkerUnit" onchange="CountMoney();" class="txtselect" datacol="yes" err="单位" checkexpession="NotNull">
                    <option value="公斤">公斤</option>
                    <option value="件">件</option>

                </select>
            </td>
        </tr>

        <tr>

            <th class='formTitle'>上机时间：</th>
            <td class='formValue'>
                <input id="OperatorDate" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd HH:mm:ss'})" style="width: 180px" />
            </td>
            <th class='formTitle'>下机时间：</th>
            <td class='formValue'>
                <input id="OperatorOverDate" type="text" class="txt Wdate" onfocus="WdatePicker({dateFmt: 'yyyy-MM-dd HH:mm:ss'})" style="width: 180px" />
            </td>
        </tr>

        <tr>
            <th class='formTitle'>员工获取金额：</th>
            <td class='formValue' colspan="3">
                <input id="WorkerAmount" maxlength=10 type="text" class="txt" value="0" onfocus="IsMoney(this.id);" disabled datacol="yes" err="员工获取金额" checkexpession="NotNull" />
            </td>
        </tr>

    </table>
</form>
