@{
    ViewBag.Title = "用户中心";
    Layout = "~/Views/Shared/_LayoutMobile.cshtml";
}

<script>
    var Delivery_StartTime = GetQuery('Delivery_StartTime') == "" ? "" : GetQuery('Delivery_StartTime') + " 00:00";
    var Delivery_EndTime = GetQuery('Delivery_EndTime') == "" ? "" : GetQuery('Delivery_EndTime') + " 23:59";
    var OrderCode = GetQuery('OrderCode');
    var QuotationCode = GetQuery('QuotationCode');
    var ShortName = GetQuery('ShortName');
    var OrderType = GetQuery('OrderType');
    var DeliveryCode = GetQuery('DeliveryCode');
    function querys(page) {
        //var page = GetQuery("page") == "" ? 1 : GetQuery("page");
        var Condition = '{Delivery_StartTime:' + Delivery_StartTime + ',Delivery_EndTime:' + Delivery_EndTime + ',OrderCode:' + OrderCode + ',QuotationCode:' + QuotationCode + ',ShortName:' + ShortName + ',OrderType:' + OrderType + ',DeliveryCode:' + DeliveryCode + '}'
        $.ajax({
            url: "@Url.Content("~/DeliveryModule/BY_Delivery/GetGridPageJson")?Condition=" + escape(Condition),
            type: "post",
            dataType: "json",
            data: { "rows": 30, "page": page },
            async: true,
            success: function (data) {
                $("#list").html("");
                $.each(data.rows, function (i) {
                    var html = '<li><a href="@Url.Content("~/WeiWebSite/WeiLogin/QueryDeliveryDetail")?DeliveryId=' + data.rows[i].deliveryid + '" data-ignore="true">';
                    html += '<div style="font-weight: 900; font-size: 1.11em; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; float: left; text-align: center; width: 75px; height: 75px; line-height: 75px; border: 1px solid #0088D1; vertical-align: middle; display: inline-block; margin-right: 5px;">';
                    html += '<b class="#0088D1" style="color: red;">' + data.rows[i].shortname + '</b></div>';
                    html += '<h2>发运单号：' + data.rows[i].deliverycode + '</h2><div class="note">';
                    html += '<p>送货地址：' + data.rows[i].shipaddress + ' 联系人：' + data.rows[i].contactname + ' 生产订单：' + data.rows[i].ordercode + ' 总重量：' + data.rows[i].weight + 'kg 时间：' + data.rows[i].createdate + ' </p>';
                    html += '<p><i class="hot">总金额：￥' + data.rows[i].totalamount + '</i><i class="hot" style="float: left;">总件数：' + data.rows[i].qty + '件</i></p>';
                    html += '</div></a></li>';
                    $("#list").append(html);
                });
                var htmlpage = '<span>共' + data.records + '记录</span>';
                if (data.page == 1) {
                    htmlpage += '<span class="disabled">«上一页</span>';
                }
                else {
                    htmlpage += '<a href="javascript:;" onclick="querys(' + (data.page - 1) + ')" data-ignore="true">«上一页</a>';
                }
                htmlpage += '<span class="current">' + data.page + '</span>';
                if (data.page == data.total || data.total == 1) {
                    htmlpage += '<span class="disabled">下一页»</span>';
                }
                else {
                    htmlpage += '<a href="javascript:;" onclick="querys(' + (data.page + 1) + ')" data-ignore="true">下一页»</a>';
                }
                $("#listPage").html("");
                $("#listPage").append(htmlpage);
            },
            error: function (data) {
                alert(data.responseText);
            }

        });
    }

    //初始化
    $(function () {
        querys(1);
        $("#getWhere").click(function () {
            location.href = "@Url.Content("~/WeiWebSite/WeiLogin/QueryDeliveryWhere")";
        });
    })

    function locationInputQuot() {
        location.href = "@Url.Content("~/WeiWebSite/WeiLogin/WeiIndex")";
    }

</script>



