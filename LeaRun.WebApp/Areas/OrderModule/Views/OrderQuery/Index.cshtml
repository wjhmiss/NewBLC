                var rowData = $("#gridTable_Detail").jqGrid('getRowData', row_id);
                var Condition = [{
                    orderdetailid: rowData["orderdetailid"]
                }]

                var Parameter = [{
                    paramName: "odd.orderdetailid",
                    paramValue: rowData["orderdetailid"],
                    Operation: "Equal",
                    Logic: "AND"
                }];

                var subgrid_table_id, pager_id;
                subgrid_table_id = subgrid_id + "_t";
                pager_id = "p_" + subgrid_table_id;
                $("#" + subgrid_id).html("<table id='" + subgrid_table_id + "' class='scroll'></table><div id='" + pager_id + "' class='scroll'></div>");
                jQuery("#" + subgrid_table_id).jqGrid({
                    url: "@Url.Content("~/OrderDetailProcessModule/BY_OrderDetailProcessDetail/GridPageJson1")?ParameterJson=" + escape(JSON.stringify(Parameter)),
                    datatype: "json",
                    height: $(window).height() / 2 - 115,
                    autowidth: true,
                    colModel: [
                        { label: '工序编号', name: 'technologyid', index: 'technologyid', width: 60, align: 'left', sortable: true, hidden: true },
                        { label: '工序名称', name: 'technologyname', index: 'technologyname', width: 120, align: 'left', sortable: true },
                        { label: '扫描数量', name: 'qty', index: 'Qty', width: 60, align: 'left', sortable: true },
                        { label: '扫描人', name: 'operatorname', index: 'operatorname', width: 80, align: 'left', sortable: true },
                         {
                             label: '扫描时间', name: 'operatordate', index: 'operatordate', width: 140, align: 'left', sortable: true,
                             formatter: function (cellvalue, options, rowObject) {
                                 return formatDate(cellvalue, 'yyyy-MM-dd HH:mm:ss');
                             }
                         }
                    ],
                    viewrecords: true,
                    rowNum: 30,
                    rowList: [30, 50, 100, 500, 5000],
                    pager: "#" + pager_id,
                    sortname: 'CreateDate',
                    sortorder: 'asc',
                    rownumbers: true,
                    shrinkToFit: false,
                    altRows: false,
                    altclass: 'altclass',
                    gridview: true,
                });
            }
        });
    }
