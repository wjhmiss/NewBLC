        <div style="float: left; position: absolute;">
            @*<img id="logo1" style="width: 60px;padding: 5px; padding-left:20px;" src="@Url.Content("~/Content/Images/111.jpg")" />*@
        </div>
        <table id="tb_Order" border="0" class="form-print" style="width: 100%;">
            <tr>
                <td colspan="4" align="center" style="padding: 2px;"><span style="font-size: 30px; font-weight: bold;" id="companyname"></span></td>
            </tr>
            @*<tr>
                <td colspan="4" align="center">NINGBO HAOLI Steel Co.,Ltd.</td>
            </tr>*@
            <tr>
                <td colspan="4" align="center">地址：<label id="Address"></label>&nbsp;&nbsp;&nbsp;&nbsp;电话：<label id="Phone"></label>&nbsp;&nbsp;&nbsp;&nbsp;邮箱：124176905@qq.com</td>
            </tr>
            
            <tr>
                <td colspan="4" align="center" style="padding: 2px;border-top: 2px solid #000;"><span style="font-size: 26px; font-weight: bold;">产品订货合同(<label id="QuotationCode"></label>)</span></td>
            </tr>
          
            <tr>
                <th style="width: 10%">客&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;户：</th>
                <td style="width: 40%">
                    <label style="font-size: 11pt;font-family: Arial;" id="CustomerName"></label>
                </td>
                <th style="width: 10%">供&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;方：</th>
                <td ><label id="companyname1"></label>
                </td>
            </tr>
            <tr>
                <th >地&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;址：</th>
                <td>
                    <label style="font-size: 11pt;font-family: Arial;" id="CustomerAddress"></label>
                </td>
                <th>地&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;址：</th>
                <td><label id="Address1"></label></td>
            </tr>
            <tr>
                <th >联&nbsp;系&nbsp;人：</th>
                <td>
                    <label style="font-size: 11pt;font-family: Arial;" id="Leader"></label>
                </td>
                <th>联&nbsp;系&nbsp;人：</th>
                <td><label style="font-size: 11pt;font-family: Arial;" id="SalesMan"></label></td>
            </tr>
            <tr>
